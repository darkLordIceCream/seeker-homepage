---
import '@/styles/global.css';
// 中文衬线 webfont（unicode-range 切片，按页面用字按需下载）：
// 苹果设备字体栈命中原生 Songti SC 不下载；安卓/Windows 无系统衬线，落到这两档
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/700.css';
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 进入页面时的默认主题（不传则按 localStorage / 系统偏好）；用户仍可手动切换 */
  defaultTheme?: 'dark' | 'light';
}

const {
  title = 'Seeker追光者',
  description = 'Seeker追光者官网，拍一张照片，交一个朋友',
  image,
  defaultTheme,
} = Astro.props;
---

<script define:vars={{ defaultTheme: defaultTheme ?? '' }} is:inline>
  document.documentElement.classList.add('js');

  const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const theme = defaultTheme || stored || (systemDark ? 'dark' : 'light');
  document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');

  if (typeof localStorage !== 'undefined') {
    // 只在深浅真正变化时落盘：同值的 class 属性重写（如外部工具整体赋值 className）
    // 不应覆盖用户的主题选择
    let lastDark = document.documentElement.classList.contains('dark');
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark === lastDark) {
        return;
      }
      lastDark = isDark;
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<style>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
		line-height: 1.6;
		color: var(--foreground);
		background-color: var(--background);
	}

	* {
		box-sizing: border-box;
	}

	.skip-to-content {
		position: absolute;
		top: -100%;
		left: 0;
		background: var(--primary);
		color: var(--primary-foreground);
		padding: 8px 16px;
		z-index: 10000;
		font-weight: 600;
		text-decoration: none;
		border-radius: 0 0 4px 0;
	}

	.skip-to-content:focus {
		top: 0;
	}
</style>

<html lang="zh-CN">
  <head>
    <!-- 预载 Archivo 可变字体（400-700 全档同文件，眉标/导航/数字的主力字体）；
         字体即使同域也必须 crossorigin。Archivo 已自托管，无需 Google Fonts preconnect -->
    <link
      href="/fonts/archivo/archivo-latin.woff2"
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEOHead description={description} image={image} title={title} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-to-content" href="#main-content">跳转到主要内容</a>
    <slot />
  </body>
</html>
