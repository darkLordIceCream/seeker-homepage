---
// 公益文章模板 B：哈苏（Hasselblad）式图集排版
// 居中头版 → 全宽封面 → 居中宽字距章节标题 → 等高图组 → 居中窄列文字；文末延伸阅读互链
// 配色沿用站点 Catppuccin 令牌；由 /welfare/[slug].astro 按 layout: 'hasselblad' 分发
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../Navigation.astro';
import Footer from '../Footer.astro';

interface Props {
  article: import('astro:content').CollectionEntry<'welfare'>;
  others: import('astro:content').CollectionEntry<'welfare'>[];
}

const { article, others } = Astro.props;
const { Content } = await render(article);

const fmtDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(article.data.pubDate);

/** 延伸阅读方向：按 order（文章顺序）判断指向上一篇还是下一篇 */
const relLabel = (from: Props['article'], to: Props['article']) =>
  to.data.order < from.data.order ? '上一篇 PREVIOUS STORY' : '下一篇 NEXT STORY';

/** 延伸阅读：优先紧邻的下一篇（order 更大中最小者），无下一篇则取上一篇 */
const adjacent =
  others.filter(o => o.data.order > article.data.order).sort((a, b) => a.data.order - b.data.order)[0] ??
  others.filter(o => o.data.order < article.data.order).sort((a, b) => b.data.order - a.data.order)[0];
---

<Layout
  description={article.data.excerpt}
  image={article.data.cover}
  title={`${article.data.title} | Seeker公益`}
>
  <Navigation />

  <main class="article-page" id="main-content">
    <header class="article-hero">
      <p class="hero-kicker">SEEKER · {article.data.kicker}</p>
      <h1 class="hero-title">{article.data.title}</h1>
      {article.data.subtitle && <p class="hero-dek">{article.data.subtitle}</p>}
      <div class="hero-meta">
        <span>{fmtDate}</span>
        <span aria-hidden="true" class="meta-dot">·</span>
        <span>{article.data.author}</span>
        <span aria-hidden="true" class="meta-dot">·</span>
        <span>Seeker公益</span>
      </div>
    </header>

    <figure class="hero-media">
      <Image
        alt={`${article.data.title}——${article.data.coverLine ?? '项目封面'}`}
        fetchpriority="high"
        height={720}
        loading="eager"
        src={article.data.cover}
        width={1080}
      />
    </figure>

    <div class="article-body">
      {article.data.quote && (
        <figure class="pull-quote">
          <blockquote>{article.data.quote}</blockquote>
          {article.data.quoteAuthor && <figcaption>——{article.data.quoteAuthor}</figcaption>}
        </figure>
      )}

      <div class="welfare-prose">
        <Content />
      </div>

      {adjacent && (
        <section aria-label="延伸阅读" class="more-stories">
          <a class="next-card" href={`/welfare/${adjacent.id}/`}>
            <span aria-hidden="true" class="next-media">
              <img alt="" height="720" loading="lazy" src={adjacent.data.cover} width="1080" />
            </span>
            <span class="next-text">
              <span class="side-kicker">{relLabel(article, adjacent)}</span>
              <span class="next-title">{adjacent.data.cardTitle ?? adjacent.data.title}</span>
              {adjacent.data.subtitle && <span class="next-sub">{adjacent.data.subtitle}</span>}
              <span class="next-cta">
                阅读全文 <span aria-hidden="true" class="cta-arrow">→</span>
              </span>
            </span>
          </a>
        </section>
      )}

      <footer class="article-foot">
        <a class="back-link" href="/welfare/">← 返回「带上她的眼睛」</a>
      </footer>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // 正文图片统一懒加载（md 渲染产物，构建期无法注入属性）
  document
    .querySelectorAll<HTMLImageElement>('.welfare-prose img')
    .forEach(img => {
      img.loading = 'lazy';
      img.decoding = 'async';
    });

  // 图组等高排版：不裁切（这批图带拍立得水印），按组内比例计算统一高度，
  // 保证整组不超出容器。双联目标 380px 高，三联及以上 300px。
  const GAP = 10;
  const rows = [...document.querySelectorAll<HTMLElement>('.welfare-prose p:has(img + img)')];

  const layoutRow = (row: HTMLElement) => {
    if (window.innerWidth <= 900) {
      row.querySelectorAll('img').forEach(i => {
        i.style.height = '';
        i.style.width = '';
      });
      return;
    }
    const imgs = [...row.querySelectorAll('img')];
    const ratios = imgs.map(i => (i.naturalWidth > 0 ? i.naturalWidth / i.naturalHeight : 0));
    if (ratios.some(r => r === 0)) {return;}
    const target = imgs.length === 2 ? 380 : 300;
    const sum = ratios.reduce((s, r) => s + r, 0);
    const h = Math.min(target, (row.clientWidth - GAP * (imgs.length - 1)) / sum);
    imgs.forEach(i => {
      i.style.height = `${Math.floor(h)}px`;
      i.style.width = 'auto';
    });
  };

  const layoutAll = () => rows.forEach(layoutRow);

  rows.forEach(row => {
    row.querySelectorAll('img').forEach(img => {
      img.addEventListener('load', () => layoutRow(row), { once: true });
    });
  });
  window.addEventListener('resize', layoutAll);
  layoutAll();
</script>

<style>
  .article-page {
    min-height: 100vh;
    background: var(--background);
    padding-top: 70px;
    color: var(--foreground);
    /* 头版、正文、图组共用左基线；超宽屏容器居中 */
    --edge: max(6vw, calc((100vw - 1360px) / 2 + 56px));
    /* 与画册模板一致的字体体系：标题/正文衬线，辅助行 Archivo 无衬线 */
  }

  /* —— 居中头版 —— */
  .article-hero {
    max-width: 860px;
    margin: 0 auto;
    padding: 72px 24px 44px;
    text-align: center;
  }

  .hero-kicker {
    margin: 0 0 24px;
    font-family: var(--font-archivo);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--link);
  }

  .hero-title {
    margin: 0 0 16px;
    font-family: var(--font-serif-song);
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-indent: 0.14em;
    line-height: 1.35;
    color: var(--foreground);
  }

  .hero-dek {
    margin: 0 0 30px;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--muted-foreground);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-archivo);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .meta-dot {
    opacity: 0.6;
  }

  /* —— 封面：与其他图片同规则，限宽限高 —— */
  .hero-media {
    display: flex;
    justify-content: center;
    margin: 0 var(--edge);
  }

  .hero-media :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 68vh;
    border-radius: 0;
  }

  /* —— 正文：单栏流，图片全出血，文字窄列居中（哈苏式） —— */
  .article-body {
    padding: 64px var(--edge) 0;
  }

  /* 金句：居中大字（哈苏无装饰，留白即层次） */
  .pull-quote {
    margin: 0 auto 64px;
    max-width: 720px;
    text-align: center;
  }

  .pull-quote blockquote {
    margin: 0;
    font-size: 1.18rem;
    line-height: 2;
    letter-spacing: 0.06em;
    color: var(--foreground);
  }

  .pull-quote figcaption {
    margin-top: 12px;
    font-family: var(--font-archivo);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
  }

  /* —— 正文：文字窄列居中，衬线（与站内文章一致） —— */
  .welfare-prose {
    font-family: var(--font-serif-song);
    font-size: 16px;
    line-height: 2.1;
    color: var(--foreground);
  }

  /* 纯文字段落：窄列居中，与全出血图组形成大小对比 */
  .welfare-prose :global(p) {
    max-width: 640px;
    margin: 0 auto 1.9em;
    text-align: center;
  }

  /* 章节标题：居中 + 宽字距（哈苏章节名） */
  .welfare-prose :global(h2) {
    margin: 3.4em 0 2em;
    text-align: center;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--foreground);
  }

  /* 引文（歌词 / 诗句 / 章节引言）：居中淡色 */
  .welfare-prose :global(blockquote) {
    margin: 2.4em auto;
    padding: 0;
    border: none;
    max-width: 560px;
    text-align: center;
    font-size: 14.5px;
    line-height: 2.2;
    color: var(--muted-foreground);
  }

  /* 长歌词：左对齐的引用块（区别于短引文的居中） */
  .welfare-prose :global(blockquote.song-lyrics) {
    max-width: 560px;
    text-align: left;
  }

  .welfare-prose :global(blockquote.song-lyrics p) {
    max-width: none;
    margin: 0;
    text-align: left;
  }

  /* 合作教师名单：姓名 + 学校逐条排列（微信原文布局） */
  .welfare-prose :global(.teachers) {
    max-width: 640px;
    margin: 2.4em auto;
    text-align: center;
  }

  .welfare-prose :global(.teachers .t-name) {
    max-width: none;
    margin: 0 0 0.3em;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--foreground);
  }

  .welfare-prose :global(.teachers .t-school) {
    max-width: none;
    margin: 0 0 1.7em;
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--muted-foreground);
  }

  /* 照片：不裁切（图带拍立得水印），限宽限高保证一屏可见，居中 */
  .welfare-prose :global(p:has(> img)) {
    max-width: none;
    margin: 2.4em 0;
  }

  .welfare-prose :global(p:has(> img:only-child) img) {
    width: auto;
    height: auto;
    max-width: min(100%, 820px);
    max-height: 68vh;
    margin-inline: auto;
  }

  /* 成组作品：等高并排不裁切，高度由 JS 按组内比例计算，整组居中 */
  .welfare-prose :global(p:has(img + img)) {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 10px;
    max-width: 1080px;
    margin: 2.4em auto;
  }

  .welfare-prose :global(p:has(img + img) img) {
    flex: 0 1 auto;
    min-width: 0;
    height: auto;
    max-width: 100%;
  }

  /* 图注：紧跟照片的斜体行，居中小字 */
  .welfare-prose :global(p:has(> img) + p em) {
    display: block;
    font-style: normal;
    font-family: var(--font-archivo);
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1.8;
    text-align: center;
    color: var(--muted-foreground);
    margin-top: -0.9em;
  }

  /* 鸣谢 / 名单（最后一个章节后的段落）：小一号、更淡 */
  .welfare-prose :global(h2:last-of-type ~ p) {
    font-size: 13.5px;
    line-height: 2.1;
    color: var(--muted-foreground);
  }

  /* —— 文末延伸阅读：左图右文横幅卡 —— */
  .more-stories {
    max-width: 900px;
    margin: 24px auto 0;
  }

  .side-kicker {
    display: block;
    margin: 0 0 16px;
    font-family: var(--font-archivo);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--link);
  }

  .side-en {
    margin-left: 4px;
    color: var(--muted-foreground);
  }

  .next-card {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 36px;
    align-items: center;
    text-decoration: none;
  }

  .next-media {
    display: block;
    overflow: hidden;
    border-radius: 2px;
    background-color: var(--secondary);
  }

  .next-media img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.3s ease;
  }

  .next-card:hover .next-media img {
    opacity: 0.88;
  }

  .next-title {
    display: block;
    font-family: var(--font-serif-song);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
    color: var(--foreground);
    transition: color 0.2s ease;
  }

  .next-sub {
    display: block;
    margin-top: 10px;
    font-size: 13.5px;
    letter-spacing: 0.14em;
    color: var(--muted-foreground);
  }

  .next-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 22px;
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--link);
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .next-card:hover .next-title {
    color: var(--link);
  }

  .next-card:hover .cta-arrow {
    transform: translateX(4px);
  }

  .next-card:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* —— 尾部 —— */
  .article-foot {
    margin-top: 88px;
    padding: 36px 0 88px;
    border-top: 1px solid var(--divider);
    text-align: center;
  }

  .back-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--link);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .back-link:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .article-hero {
      padding: 48px 24px 36px;
    }

    .article-body {
      padding: 48px 24px 0;
    }

    /* 手机上组图退单列、全宽不裁切（覆盖 JS 计算的内联高度） */
    .welfare-prose :global(p:has(img + img)) {
      flex-direction: column;
      gap: 18px;
    }

    .welfare-prose :global(p:has(img + img) img) {
      height: auto !important;
      width: 100% !important;
    }

    /* 横幅卡改上下堆叠 */
    .next-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
