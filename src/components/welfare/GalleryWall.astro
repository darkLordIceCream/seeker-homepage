---
// 「小摄影师的作品集」画廊主体：主题分章 + 序列式观看器 + 缩放 lightbox
// - 数据来自 src/data/welfare-gallery.ts（脚本生成，40 张定稿 + 5 主题）
// - 章头排版借鉴杂志画册：超大幽灵期号 + 衬线主题名 + 编辑导语
// - 观看器：一次一张不裁切（object-fit: contain），←/→ 翻页，可展开缩略图索引
// - lightbox 移植自 photoreason/skills portfolio-site-builder（MIT）：
//   点击点锚定缩放 1–4x、拖拽平移、分层 Esc、缩略图条（见脚本头部署名注释）
import {
  WELFARE_GALLERY_THEMES,
  WELFARE_GALLERY_BATCH,
  type WelfareGalleryPhoto,
} from '@/data/welfare-gallery';

// 期数短标（「第1-2周」），从完整 label 里截取括号前部分
const batchShort = WELFARE_GALLERY_BATCH.label.split('（')[0];
const pad = (n: number) => String(n).padStart(2, '0');

const cap = (p: WelfareGalleryPhoto) => `${p.school} · ${batchShort}`;

// LQIP 占位渐变：tone = "#top,#bottom"
const phBg = (tone: string) => {
  const [top, bottom] = tone.split(',');
  return `linear-gradient(180deg, ${top}, ${bottom})`;
};

// 预解析每章首图与期号（noUncheckedIndexedAccess 下 photos[0] 需要 guard）
const chapters = WELFARE_GALLERY_THEMES.flatMap((theme, ti) => {
  const first = theme.photos[0];
  if (!first) {return [];}
  return [
    {
      theme,
      first,
      no: pad(ti + 1),
      count: theme.photos.length,
    },
  ];
});

// 章节流：附带下一辑信息（章间编辑交接行用）
const flow = chapters.map((ch, i) => {
  const next = chapters[i + 1];
  return { ...ch, nextId: next?.theme.id, nextTitle: next?.theme.title };
});
---

<section aria-labelledby="bhe-gallery-title" class="bhe-gallery">
  <header class="g-hero">
    <a class="g-back" href="/welfare/">
      <span aria-hidden="true">←</span> 带上她的眼睛 · 图文手记
    </a>
    <p class="section-kicker">SEEKER 公益 · WELFARE</p>
    <h1 class="g-title" id="bhe-gallery-title">小摄影师的作品集</h1>
    <p class="g-dek">
      每两周，我们把相机交到山里孩子手上，再把他们拍下的世界带回来。
      这里，是每一次快门之后被留下来的那一张。
    </p>
    <p class="g-stats">
      <strong>第 {WELFARE_GALLERY_BATCH.id.replace('w', '')} 期</strong>
      <span aria-hidden="true">·</span> {WELFARE_GALLERY_BATCH.label}
      <span aria-hidden="true">·</span> {WELFARE_GALLERY_BATCH.photoCount} 张照片
      <span aria-hidden="true">·</span> {WELFARE_GALLERY_BATCH.schoolCount} 所学校
    </p>
    <nav aria-label="主题目录" class="g-toc">
      {chapters.map(ch => (
        <a href={`#${ch.theme.id}`}>
          <span class="g-toc-no">{ch.no}</span>
          {ch.theme.title}
        </a>
      ))}
    </nav>
  </header>

  {flow.map((ch, ti) => (
    <Fragment key={ch.theme.id}>
    <section aria-label={`主题：${ch.theme.title}`} class="g-chapter" id={ch.theme.id}>
      <header class="g-chapter-head reveal">
        <span aria-hidden="true" class="g-chapter-no">{ch.no}</span>
        <div class="g-chapter-text">
          <h2 class="g-chapter-title">{ch.theme.title}</h2>
          <p class="g-chapter-note">{ch.theme.note}</p>
        </div>
      </header>

      <div
        aria-label={`${ch.theme.title}，共 ${ch.count} 张`}         aria-roledescription="图片序列"         class="g-viewer reveal"         data-theme={ch.theme.id}         data-viewer         tabindex="0"
      >
        <figure class="g-stage">
          <button
            aria-label={`放大查看：${ch.first.alt}`}             class="g-shutter"             data-enlarge             style={`--ph-bg:${phBg(ch.first.tone)}`}             type="button"
          >
            <span class="g-mount">
              <img
                alt={ch.first.alt}                 decoding="async"                 fetchpriority={ti === 0 ? 'high' : 'auto'}                 height={ch.first.h}                 loading={ti === 0 ? 'eager' : 'lazy'}                 src={ch.first.src}                 width={ch.first.w}
              />
            </span>
          </button>
          <figcaption class="g-caption">
            <span class="g-caption-info">
              <span class="g-caption-school">
                <b class="g-caption-no" aria-hidden="true">{ch.no}</b>
                {cap(ch.first)}
              </span>
              <span aria-live="polite" class="g-counter">1 / {ch.count}</span>
            </span>
            <span class="g-controls">
              <button aria-label={`上一张（${ch.theme.title}）`} class="g-step" data-step="-1" type="button" disabled>←</button>
              <button aria-label={`下一张（${ch.theme.title}）`} class="g-step" data-step="1" type="button">→</button>
              <span aria-hidden="true" class="g-kbd-hint">← → 键翻页</span>
            </span>
          </figcaption>
        </figure>

        <details class="g-index">
          <summary>全部照片 <span class="g-index-count">{ch.count}</span></summary>
          <div class="g-thumbs" data-thumbs></div>
        </details>
      </div>
    </section>
      {ch.nextId && (
        <a class="g-handoff reveal" href={`#${ch.nextId}`}>
          <span class="g-handoff-label">下一辑</span>
          <span class="g-handoff-title">{ch.nextTitle}</span>
          <span class="g-handoff-arrow" aria-hidden="true">↓</span>
        </a>
      )}
    </Fragment>
  ))}

  <footer class="g-foot reveal">
    <p class="g-foot-line">下一期，正在山里曝光。</p>
    <a class="mini-cta g-foot-cta" href="/welfare/">
      回到「带上她的眼睛」——读孩子们的故事 <span aria-hidden="true">→</span>
    </a>
  </footer>
</section>

<dialog aria-labelledby="lb-title" class="lb" id="bhe-lightbox">
  <header class="lb-bar">
    <div class="lb-bar-info">
      <span id="lb-title"></span>
      <span aria-live="polite" class="lb-count" id="lb-count"></span>
    </div>
    <div class="lb-tools">
      <button aria-expanded="false" class="lb-tool" id="lb-index-btn" type="button">全部照片</button>
      <button aria-pressed="false" class="lb-tool" id="lb-zoom-btn" type="button">放大</button>
      <label class="lb-zoom-range">
        <input aria-label="缩放比例" disabled id="lb-zoom-input" max="400" min="100" step="10" type="range" value="100" />
        <output for="lb-zoom-input" id="lb-zoom-out">100%</output>
      </label>
      <button aria-label="关闭大图" autofocus class="lb-tool lb-close" id="lb-close" type="button">×</button>
    </div>
  </header>
  <div class="lb-stage">
    <button aria-label="上一张" class="lb-nav lb-prev" id="lb-prev" type="button">‹</button>
    <div class="lb-canvas" id="lb-canvas">
      <div class="lb-surface" id="lb-surface">
        <button aria-label="放大或还原" class="lb-imgbtn" id="lb-imgbtn" type="button">
          <img alt="" class="lb-img" draggable="false" id="lb-img" />
        </button>
      </div>
      <p class="lb-error" hidden id="lb-error" role="status">这张照片暂时加载不出来。</p>
    </div>
    <button aria-label="下一张" class="lb-nav lb-next" id="lb-next" type="button">›</button>
  </div>
  <footer class="lb-foot">
    <p class="lb-caption" id="lb-caption"></p>
    <div class="lb-thumbs" id="lb-thumbs"></div>
  </footer>
  <section aria-labelledby="lb-sheet-title" class="lb-sheet" hidden id="lb-sheet">
    <h2 id="lb-sheet-title">全部照片</h2>
    <div class="lb-sheet-grid" id="lb-sheet-grid"></div>
  </section>
</dialog>

<script>
  /*
   * lightbox 交互移植自 photoreason/skills · portfolio-site-builder（MIT License）
   * https://github.com/photoreason/skills —— 锚定缩放 / 拖拽平移 / 分层 Esc。
   * 按「带上她的眼睛」的数据结构与站内 token 重写，样式独立。
   */
  import {
    WELFARE_GALLERY_THEMES,
    WELFARE_GALLERY_BATCH,
    type WelfareGalleryPhoto,
  } from '@/data/welfare-gallery';

  interface Seq { themeTitle: string; photos: WelfareGalleryPhoto[]; no: string }

  const seqs = new Map<string, Seq>(
    WELFARE_GALLERY_THEMES.map((t, i) => [
      t.id,
      {
        themeTitle: t.title,
        photos: t.photos,
        no: String(i + 1).padStart(2, '0'),
      },
    ]),
  );

  // 期数短标（「第1-2周」），与模板侧同一截取规则
  const BATCH_SHORT = WELFARE_GALLERY_BATCH.label.split('（')[0];

  // LQIP 占位渐变（与模板侧 phBg 同一规则）
  const phBg = (tone: string) => {
    const [top, bottom] = tone.split(',');
    return `linear-gradient(180deg, ${top}, ${bottom})`;
  };

  /* ---------- 观看器：每章一次一张，←/→ 翻页 ---------- */
  // 邻图预热：当前图就位后，idle 时把前后张拉进缓存（「预热」模式）
  // 节流保护：saveData / 慢速连接不预热；Set 去重避免重复请求
  const preheated = new Set<string>();
  const navConn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const saveData = navConn?.saveData === true;
  const preheat = (photos: { src: string }[], i: number, active?: boolean) => {
    if (saveData || active === false) { return; }
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 300);
    idle(() => {
      [i + 1, i - 1].forEach(j => {
        const n = photos[((j % photos.length) + photos.length) % photos.length];
        if (n && !preheated.has(n.src)) {
          preheated.add(n.src);
          const im = new Image();
          im.src = n.src;
        }
      });
    });
  };

  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach(viewer => {
    const seq = seqs.get(viewer.dataset.theme ?? '');
    if (!seq) {return;}
    const {photos} = seq;

    const img = viewer.querySelector<HTMLImageElement>('.g-shutter img')!;
    const shutter = viewer.querySelector<HTMLButtonElement>('[data-enlarge]')!;
    const schoolEl = viewer.querySelector<HTMLElement>('.g-caption-school')!;
    const counterEl = viewer.querySelector<HTMLElement>('.g-counter')!;
    const thumbsBox = viewer.querySelector<HTMLElement>('[data-thumbs]')!;
    const details = viewer.querySelector<HTMLDetailsElement>('.g-index')!;
    const prevBtn = viewer.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const nextBtn = viewer.querySelector<HTMLButtonElement>('[data-step="1"]')!;

    let index = 0;
    let thumbsBuilt = false;

    // 换页淡入：新图 load 后淡入，避免生硬跳变（reduced-motion 下 CSS 直接关闭过渡）
    const fadeInOnLoad = () => {
      img.classList.add('is-loading');
      const reveal = () => { img.classList.remove('is-loading'); };
      if (img.complete && img.naturalWidth > 0) {
        // 已缓存：直接显示（rAF 在后台标签页会被挂起，不能作为恢复通道）
        reveal();
      } else {
        img.addEventListener('load', reveal, { once: true });
        img.addEventListener('error', reveal, { once: true });
      }
    };

    // 箭头函数（声明在收窄之后），避免 function 提升破坏 seq 收窄
    const render = (i: number) => {
      index = Math.min(photos.length - 1, Math.max(0, i));
      const p = photos[index]!;
      img.src = p.src;
      img.width = p.w;
      img.height = p.h;
      img.alt = p.alt;
      // 重建含章号的结构（textContent 会抹掉 <b> 章号）
      schoolEl.innerHTML = `<b class="g-caption-no" aria-hidden="true">${seq.no}</b>${p.school} · ${BATCH_SHORT}`;
      counterEl.textContent = `${index + 1} / ${photos.length}`;
      prevBtn.disabled = index === 0;
      nextBtn.disabled = index === photos.length - 1;
      // 章首图定调：展示规格放大一档（「开篇大作」惯例）
      shutter.classList.toggle('is-opener', index === 0);
      shutter.setAttribute('aria-label', `放大查看：${p.alt}`);
      shutter.style.setProperty('--ph-bg', phBg(p.tone));
      fadeInOnLoad();
      preheat(photos, index, viewer.classList.contains('in-view'));
      viewer
        .querySelectorAll('.g-thumbs [data-photo]')
        .forEach(el => el.setAttribute('aria-current', String(Number((el as HTMLElement).dataset.photo) === index)));
    };

    const buildThumbs = () => {
      if (thumbsBuilt) {return;}
      thumbsBuilt = true;
      photos.forEach((p, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.photo = String(i);
        b.className = 'g-thumb';
        b.style.background = phBg(p.tone); // 动态节点无 astro-cid，占位色走内联
        b.setAttribute('aria-label', `第 ${i + 1} 张：${p.alt}`);
        const t = document.createElement('img');
        t.src = p.thumb; // 480px 变体，不拉原图
        t.alt = '';
        t.loading = 'lazy';
        t.decoding = 'async';
        t.width = 160;
        t.height = 120;
        b.appendChild(t);
        b.addEventListener('click', () => {
          render(i);
          details.open = false;
          shutter.focus({ preventScroll: true });
        });
        thumbsBox.appendChild(b);
      });
      render(index);
    };

    details.addEventListener('toggle', () => {
      if (details.open) {buildThumbs();}
    });

    viewer.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(btn => {
      btn.addEventListener('click', () => render(index + Number(btn.dataset.step)));
    });

    viewer.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); render(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); render(index + 1); }
    });

    // 触屏滑动翻页（物理感）：横向位移 >48px 且大于纵向 1.5 倍才算；
    // 明显滑动后浏览器不会派发 click，不会误开 lightbox，仍加时间戳护栏
    let touchStart: { x: number; y: number; t: number } | null = null;
    viewer.addEventListener('pointerdown', e => {
      if (e.pointerType === 'mouse') { return; }
      touchStart = { x: e.clientX, y: e.clientY, t: Date.now() };
    });
    viewer.addEventListener('pointerup', e => {
      if (!touchStart) { return; }
      const dx = e.clientX - touchStart.x;
      const dy = e.clientY - touchStart.y;
      const dt = Date.now() - touchStart.t;
      touchStart = null;
      if (dt > 800) { return; }
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        // 经 dataset 告知 lightbox 入口：滑动余波（400ms 内）不放大
        viewer.dataset.lastSwipe = String(Date.now());
        render(index + (dx < 0 ? 1 : -1));
      }
    });

    render(0);
  });

  /* ---------- lightbox ---------- */
  const dialog = document.getElementById('bhe-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const lbImg = dialog.querySelector<HTMLImageElement>('#lb-img')!;
    const lbImgBtn = dialog.querySelector<HTMLButtonElement>('#lb-imgbtn')!;
    const lbCanvas = dialog.querySelector<HTMLElement>('#lb-canvas')!;
    const lbSurface = dialog.querySelector<HTMLElement>('#lb-surface')!;
    const lbTitle = dialog.querySelector<HTMLElement>('#lb-title')!;
    const lbCount = dialog.querySelector<HTMLElement>('#lb-count')!;
    const lbCaption = dialog.querySelector<HTMLElement>('#lb-caption')!;
    const lbError = dialog.querySelector<HTMLElement>('#lb-error')!;
    const lbPrev = dialog.querySelector<HTMLButtonElement>('#lb-prev')!;
    const lbNext = dialog.querySelector<HTMLButtonElement>('#lb-next')!;
    const lbClose = dialog.querySelector<HTMLButtonElement>('#lb-close')!;
    const lbZoomBtn = dialog.querySelector<HTMLButtonElement>('#lb-zoom-btn')!;
    const lbZoomInput = dialog.querySelector<HTMLInputElement>('#lb-zoom-input')!;
    const lbZoomOut = dialog.querySelector<HTMLElement>('#lb-zoom-out')!;
    const lbIndexBtn = dialog.querySelector<HTMLButtonElement>('#lb-index-btn')!;
    const lbSheet = dialog.querySelector<HTMLElement>('#lb-sheet')!;
    const lbSheetGrid = dialog.querySelector<HTMLElement>('#lb-sheet-grid')!;
    const lbThumbs = dialog.querySelector<HTMLElement>('#lb-thumbs')!;

    let seq: Seq | null = null;
    let index = 0;
    let zoomed = false;
    let zoomScale = 1;
    let imageReady = false;
    let imageFailed = false;
    let thumbsBuilt = false;
    let pushed = false;
    let opener: HTMLElement | null = null;

    const setZoom = (value: number | boolean, point?: { x: number; y: number }) => {
      const frame = lbCanvas.getBoundingClientRect();
      const old = lbImg.getBoundingClientRect();
      const x = point ? point.x - frame.left : lbCanvas.clientWidth / 2;
      const y = point ? point.y - frame.top : lbCanvas.clientHeight / 2;
      const u = old.width ? (frame.left + x - old.left) / old.width : 0.5;
      const v = old.height ? (frame.top + y - old.top) / old.height : 0.5;
      zoomScale = typeof value === 'boolean' ? (value ? 2 : 1) : value;
      zoomScale = Math.max(1, Math.min(4, zoomScale));
      if (!imageReady || imageFailed) {zoomScale = 1;}
      zoomed = zoomScale > 1;
      lbCanvas.classList.toggle('is-zoomed', zoomed);
      const percent = Math.round(zoomScale * 100);
      lbZoomInput.value = String(percent);
      lbZoomInput.setAttribute('aria-valuetext', `${percent}%`);
      lbZoomOut.textContent = `${percent}%`;
      lbZoomBtn.textContent = zoomed ? '适应' : '放大';
      lbZoomBtn.setAttribute('aria-pressed', String(zoomed));
      lbImgBtn.setAttribute('aria-label', zoomed ? '适应屏幕' : '放大或还原');
      const disabled = !imageReady || imageFailed || !lbSheet.hidden;
      lbZoomBtn.disabled = lbZoomInput.disabled = disabled;
      if (!dialog.open || !lbCanvas.clientWidth || !lbCanvas.clientHeight) {return;}
      const nw = lbImg.naturalWidth || lbCanvas.clientWidth;
      const nh = lbImg.naturalHeight || lbCanvas.clientHeight;
      const fit = Math.min(lbCanvas.clientWidth / nw, lbCanvas.clientHeight / nh);
      const w = nw * fit * zoomScale;
      const h = nh * fit * zoomScale;
      lbSurface.style.width = `${Math.ceil(Math.max(lbCanvas.clientWidth, w))}px`;
      lbSurface.style.height = `${Math.ceil(Math.max(lbCanvas.clientHeight, h))}px`;
      lbImgBtn.style.width = `${w}px`;
      lbImgBtn.style.height = `${h}px`;
      if (!zoomed) {
        lbCanvas.scrollLeft = lbCanvas.scrollTop = 0;
      } else {
        const cur = lbImg.getBoundingClientRect();
        lbCanvas.scrollLeft += cur.left - frame.left + u * cur.width - x;
        lbCanvas.scrollTop += cur.top - frame.top + v * cur.height - y;
      }
    };

    const setSheet = (open: boolean) => {
      lbSheet.hidden = !open;
      lbIndexBtn.setAttribute('aria-expanded', String(open));
      dialog.querySelector('.lb-stage')?.setAttribute('inert', open ? 'true' : 'false');
      dialog.querySelector('.lb-foot')?.setAttribute('inert', open ? 'true' : 'false');
      if (!open) {lbIndexBtn.focus({ preventScroll: true });}
      setZoom(zoomScale);
    };

    const buildThumbs = () => {
      if (thumbsBuilt || !seq) {return;}
      thumbsBuilt = true;
      seq.photos.forEach((p, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.photo = String(i);
        b.className = 'lb-thumb';
        b.style.background = 'var(--paper-face)'; // 印样规格：纸面垫底，不放主色
        b.setAttribute('aria-label', `第 ${i + 1} 张：${p.alt}`);
        const t = document.createElement('img');
        t.src = p.thumb; // 480px 变体，不拉原图
        t.alt = '';
        t.loading = 'lazy';
        t.decoding = 'async';
        t.width = 160;
        t.height = 120;
        b.appendChild(t);
        b.addEventListener('click', () => show(i));
        lbThumbs.appendChild(b);
        const b2 = b.cloneNode(true) as HTMLButtonElement;
        b2.addEventListener('click', () => {
          show(i);
          setSheet(false);
        });
        lbSheetGrid.appendChild(b2);
      });
      markThumbs();
    };

    const markThumbs = () => {
      dialog.querySelectorAll('[data-photo]').forEach(el => {
        el.setAttribute('aria-current', String(Number((el as HTMLElement).dataset.photo) === index));
      });
      const cur = lbThumbs.children[index] as HTMLElement | undefined;
      cur?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
    };

    const show = (i: number) => {
      if (!seq) {return;}
      index = Math.min(seq.photos.length - 1, Math.max(0, i));
      const p = seq.photos[index]!;
      imageFailed = false;
      imageReady = false;
      lbError.hidden = true;
      setZoom(false);
      lbImg.classList.add('is-loading');
      lbImgBtn.style.setProperty('--ph-bg', phBg(p.tone));
      lbImg.src = p.src;
      preheat(seq.photos, index);
      lbImg.alt = p.alt;
      lbTitle.textContent = seq.themeTitle;
      lbCaption.textContent = `${seq.no} · ${p.school} · ${BATCH_SHORT}`;
      lbCount.textContent = `${index + 1} / ${seq.photos.length}`;
      lbPrev.disabled = index === 0;
      lbNext.disabled = index === seq.photos.length - 1;
      markThumbs();
    };

    const openAt = (seqId: string, i: number, from: HTMLElement) => {
      const s = seqs.get(seqId);
      if (!s) {return;}
      const firstOpen = !dialog.open;
      seq = s;
      index = i;
      opener = from;
      if (firstOpen) {
        buildThumbs();
        setSheet(false);
        document.body.style.overflow = 'hidden'; // 模态期间锁背景滚动
        dialog.showModal();
        if (!pushed) {
          history.pushState({ bheLb: true }, '');
          pushed = true;
        }
      }
      show(index);
    };

    const close = (fromPop = false) => {
      if (!dialog.open) {return;}
      document.body.style.overflow = ''; // 恢复背景滚动
      dialog.close();
      setZoom(false);
      lbImg.removeAttribute('src');
      imageReady = false;
      if (pushed && !fromPop) {
        pushed = false;
        history.back();
      } else {
        pushed = false;
      }
      opener?.focus({ preventScroll: true });
      opener = null;
    };

    // 数据文件里的期数短标（第1-2周）已由 BATCH_SHORT 提供
    dialog.addEventListener('cancel', e => {
      e.preventDefault();
      if (!lbSheet.hidden) {setSheet(false);}
      else if (zoomed) {setZoom(false);}
      else {close();}
    });
    lbClose.addEventListener('click', () => close());
    // 点击遮罩（::backdrop 区域）关闭：仅当点在 dialog 元素本身
    dialog.addEventListener('click', e => {
      if (e.target === dialog && !zoomed) { close(); }
    });
    window.addEventListener('popstate', () => {
      if (dialog.open) {close(true);}
    });

    lbPrev.addEventListener('click', () => show(index - 1));
    lbNext.addEventListener('click', () => show(index + 1));
    lbIndexBtn.addEventListener('click', () => {
      setZoom(false);
      setSheet(Boolean(lbSheet.hidden));
    });
    lbZoomBtn.addEventListener('click', () => setZoom(!zoomed));
    lbImgBtn.addEventListener('click', e => {
      setZoom(!zoomed, e.detail ? { x: e.clientX, y: e.clientY } : undefined);
    });
    lbZoomInput.addEventListener('input', () => setZoom(Number(lbZoomInput.value) / 100));
    lbImg.addEventListener('load', () => {
      if (!dialog.open) {return;}
      imageFailed = false;
      imageReady = true;
      lbError.hidden = true;
      lbImg.classList.remove('is-loading');
      setZoom(false);
    });
    lbImg.addEventListener('error', () => {
      if (!dialog.open) {return;}
      imageFailed = true;
      imageReady = false;
      lbError.hidden = false;
      setZoom(false);
    });
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => {
        if (dialog.open && imageReady) {setZoom(zoomScale);}
      }).observe(lbCanvas, { box: 'border-box' });
    }

    // 触屏滑动翻页：未缩放时横向 >48px 判定（缩放态交给原生滚动平移）
    let lbTouch: { x: number; y: number; t: number } | null = null;
    lbCanvas.addEventListener('pointerdown', e => {
      if (e.pointerType === 'mouse' || zoomed) { return; }
      lbTouch = { x: e.clientX, y: e.clientY, t: Date.now() };
    });
    lbCanvas.addEventListener('pointerup', e => {
      if (!lbTouch) { return; }
      const dx = e.clientX - lbTouch.x;
      const dy = e.clientY - lbTouch.y;
      const dt = Date.now() - lbTouch.t;
      lbTouch = null;
      if (dt > 800) { return; }
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        show(index + (dx < 0 ? 1 : -1));
      }
    });
    lbCanvas.addEventListener('pointercancel', () => { lbTouch = null; });

    // 拖拽平移（鼠标）：click 与 drag 用位移阈值区分
    let drag: { x: number; y: number; left: number; top: number; moved: boolean } | null = null;
    lbCanvas.addEventListener('pointerdown', e => {
      if (!zoomed || e.pointerType !== 'mouse' || e.button !== 0) {return;}
      drag = { x: e.clientX, y: e.clientY, left: lbCanvas.scrollLeft, top: lbCanvas.scrollTop, moved: false };
      lbCanvas.setPointerCapture(e.pointerId);
    });
    lbCanvas.addEventListener('pointermove', e => {
      if (!drag) {return;}
      if (Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y) > 5) {drag.moved = true;}
      lbCanvas.scrollLeft = drag.left + drag.x - e.clientX;
      lbCanvas.scrollTop = drag.top + drag.y - e.clientY;
    });
    lbCanvas.addEventListener('pointerup', e => {
      if (lbCanvas.hasPointerCapture(e.pointerId)) {lbCanvas.releasePointerCapture(e.pointerId);}
    });
    lbCanvas.addEventListener('pointercancel', () => { drag = null; });
    lbCanvas.addEventListener(
      'click',
      e => {
        if (drag && drag.moved) {
          e.preventDefault();
          e.stopPropagation();
        } else if (drag && (e.target === lbCanvas || e.target === lbSurface)) {
          setZoom(false);
        }
        drag = null;
      },
      true,
    );

    // 全页键盘：lightbox 内 ←/→；Esc 已由 dialog cancel 处理
    document.addEventListener('keydown', e => {
      if (!dialog.open) {return;}
      if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && e.target !== lbZoomInput) {
        e.preventDefault();
        show(index + (e.key === 'ArrowLeft' ? -1 : 1));
      }
    });

    // 入口绑定：每章的放大按钮 → lightbox
    document.querySelectorAll<HTMLElement>('[data-viewer]').forEach(viewer => {
      const id = viewer.dataset.theme ?? '';
      const btn = viewer.querySelector<HTMLButtonElement>('[data-enlarge]');
      btn?.addEventListener('click', () => {
        // 触屏滑动翻页后的余波不打开 lightbox
        const lastSwipe = Number(viewer.dataset.lastSwipe ?? 0);
        if (Date.now() - lastSwipe < 400) { return; }
        const cur = Number(viewer.querySelector<HTMLElement>('.g-counter')!.textContent?.split(' / ')[0] ?? 1) - 1;
        openAt(id, cur, btn);
      });
    });
  }

  /* ---------- 目录 scrollspy：高亮当前所在主题 ---------- */
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.g-toc a')];
  if (tocLinks.length) {
    const byHash = new Map(tocLinks.map(a => [a.getAttribute('href') ?? '', a]));
    const spy = new IntersectionObserver(
      entries => {
        entries.forEach(en => {
          const link = byHash.get(`#${en.target.id}`);
          if (!link) { return; }
          if (en.isIntersecting) {
            tocLinks.forEach(a => a.classList.toggle('is-active', a === link));
          }
        });
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    document.querySelectorAll('.g-chapter').forEach(sec => spy.observe(sec));
  }

  /* ---------- 入场动画：滚动到可视区时加 .in-view ---------- */
  const revealables = document.querySelectorAll('.reveal');
  if (revealables.length) {
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(en => {
          if (en.isIntersecting) {
            en.target.classList.add('in-view');
            io.unobserve(en.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    revealables.forEach(el => io.observe(el));
  }
</script>

