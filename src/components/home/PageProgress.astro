---
// 首页右侧进度圆点：滚动叙事模式的章节指示器（仅桌面端显示）
const sections = [
  { id: 'home', label: '首页' },
  { id: 'works', label: '作品' },
  { id: 'activities', label: '活动' },
  { id: 'about', label: '小组介绍' },
];
---

<nav aria-label="页面章节" class="page-progress">
  <ul class="progress-list">
    {sections.map(section => (
      <li>
        <a
          aria-label={section.label}           class="progress-dot"           data-progress={section.id}           href={`#${section.id}`}
        >
          <span class="dot-tip">{section.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .page-progress {
    position: fixed;
    right: 22px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
  }

  .progress-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .progress-dot {
    position: relative;
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent);
    border: 1px solid var(--glass-border);
    transition:
      background 0.25s ease,
      height 0.25s ease;
  }

  .progress-dot:hover {
    background: var(--muted-foreground);
  }

  .progress-dot.active {
    height: 22px;
    background: linear-gradient(180deg, var(--grad-a), var(--grad-b));
    border-color: transparent;
  }

  .progress-dot:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 3px;
  }

  .dot-tip {
    position: absolute;
    right: 22px;
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    white-space: nowrap;
    font-size: 12px;
    color: var(--foreground);
    background: var(--popover);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    padding: 4px 10px;
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .progress-dot:hover .dot-tip,
  .progress-dot:focus-visible .dot-tip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 768px) {
    .page-progress {
      display: none;
    }
  }
</style>

<script>
  // 进度圆点与章节滚动状态同步
  const dots = document.querySelectorAll<HTMLElement>('.progress-dot[data-progress]');
  const dotById = new Map<string, HTMLElement>();
  dots.forEach(dot => {
    const id = dot.dataset.progress;
    if (id) {dotById.set(id, dot);}
  });

  const targets = Array.from(document.querySelectorAll<HTMLElement>('section[id]')).filter(
    section => dotById.has(section.id),
);

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            dotById.forEach((dot, id) => {
              dot.classList.toggle('active', id === entry.target.id);
            });
          }
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
  );

    targets.forEach(target => spy.observe(target));
  }
</script>
