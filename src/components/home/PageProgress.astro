---
// 首页右侧进度圆点：滚动叙事模式的章节指示器（仅桌面端显示）
const sections = [
  { id: 'home', label: '首页' },
  { id: 'works', label: '作品' },
  { id: 'activities', label: '活动' },
  { id: 'about', label: '小组介绍' },
];
---

<nav aria-label="页面章节" class="page-progress">
  <ul class="progress-list">
    {sections.map(section => (
      <li>
        <a
          aria-label={section.label}           class="progress-dot"           data-progress={section.id}           href={`#${section.id}`}
        >
          <span class="dot-tip">{section.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .page-progress {
    position: fixed;
    right: 22px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
  }

  .progress-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .progress-dot {
    position: relative;
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent);
    border: 1px solid var(--glass-border);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .progress-dot:hover {
    background: var(--muted-foreground);
  }

  /* 激活：水滴落入——拉长 → 回弹到位 */
  .progress-dot.active {
    height: 24px;
    background: linear-gradient(180deg, var(--grad-a), var(--grad-b));
    border-color: transparent;
    animation: dot-drop 0.6s cubic-bezier(0.3, 1.25, 0.55, 1);
  }

  @keyframes dot-drop {
    0% {
      width: 10px;
      height: 10px;
    }
    35% {
      width: 7px;
      height: 31px;
    }
    62% {
      width: 12px;
      height: 19px;
    }
    82% {
      width: 9px;
      height: 26px;
    }
    100% {
      width: 10px;
      height: 24px;
    }
  }

  /* 失活：水滴分离——被拉断的压扁 → 弹回小圆 */
  .progress-dot.pop-out {
    animation: dot-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes dot-pop {
    0% {
      width: 10px;
      height: 24px;
      background: linear-gradient(180deg, var(--grad-a), var(--grad-b));
      border-color: transparent;
    }
    35% {
      width: 13px;
      height: 4px;
    }
    68% {
      width: 7px;
      height: 14px;
    }
    100% {
      width: 10px;
      height: 10px;
    }
  }

  .progress-dot:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-dot.active,
    .progress-dot.pop-out {
      animation: none;
    }
  }

  .dot-tip {
    position: absolute;
    right: 22px;
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    white-space: nowrap;
    font-size: 12px;
    color: var(--foreground);
    background: var(--popover);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    padding: 4px 10px;
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .progress-dot:hover .dot-tip,
  .progress-dot:focus-visible .dot-tip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 768px) {
    .page-progress {
      display: none;
    }
  }
</style>

<script>
  // 进度圆点与章节滚动状态同步
  const dots = document.querySelectorAll<HTMLElement>('.progress-dot[data-progress]');
  const dotById = new Map<string, HTMLElement>();
  dots.forEach(dot => {
    const id = dot.dataset.progress;
    if (id) {dotById.set(id, dot);}
  });

  const targets = Array.from(document.querySelectorAll<HTMLElement>('section[id]')).filter(
    section => dotById.has(section.id),
);

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    let currentId: string | null = null;

    // 激活切换：新点播放「水滴落入」，失去激活的点播放「水滴分离」
    const setActive = (id: string) => {
      if (id === currentId) {
        return;
      }
      dotById.forEach((dot, dotId) => {
        const shouldBeActive = dotId === id;
        const wasActive = dot.classList.contains('active');

        if (shouldBeActive && !wasActive) {
          dot.classList.add('active');
        } else if (!shouldBeActive && wasActive) {
          dot.classList.remove('active');
          dot.classList.add('pop-out');
          dot.addEventListener(
            'animationend',
            () => {
              dot.classList.remove('pop-out');
            },
            { once: true },
          );
        }
      });
      currentId = id;
    };

    const spy = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    targets.forEach(target => spy.observe(target));
  }
</script>
