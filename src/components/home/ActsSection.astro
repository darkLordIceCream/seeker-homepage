---
// 首页第3层「活动」：拍立得照片堆——白框厚底照片卡错位叠放
// hover 抽出转正；未落地的活动指向占位页，公益项目直达 /welfare/
const storyCover = 'https://r2.xn--seeker-ng2jm403afb4a.club/activities/2026-08/cover.webp';

type Act = {
  name: string;
  desc: string;
  tag: string;
  href: string;
  rot: string;
  dy: string;
  /** 渐变占位（无真实配图时用） */
  g?: string;
  /** 真实封面图 */
  img?: string;
};

const events: Act[] = [
  {
    name: '时间的故事',
    desc: '长期摄影企划',
    tag: '长期企划',
    href: '/activities/story-of-time/',
    rot: '-4deg',
    dy: '12px',
    img: storyCover,
  },
  {
    name: 'Seeker公益 · 带上她的眼睛',
    desc: '山村中的摄影课',
    tag: '公益项目',
    href: '/welfare/',
    rot: '2.2deg',
    dy: '-8px',
    img: 'https://r2.xn--seeker-ng2jm403afb4a.club/welfare/bring-her-eyes/in-a-faraway-place/01.jpg',
  },
  {
    name: 'Young Blood · 年度大赛',
    desc: '新人专场与年度摄影比拼',
    tag: '赛事',
    href: '/under-construction',
    rot: '-1.4deg',
    dy: '18px',
    g: 'radial-gradient(circle at 80% 30%, rgba(251,146,60,0.40), transparent 55%), radial-gradient(circle at 15% 75%, rgba(56,189,248,0.32), transparent 52%), linear-gradient(100deg, #242028 0%, #120f16 100%)',
  },
  {
    name: '七周年 · 追光七载',
    desc: '水印工坊 · 成员地图墙 · 七周年手记',
    tag: '七周年',
    href: '/7th/',
    rot: '2.6deg',
    dy: '14px',
    g: "url('/templates/seeker-7th-portrait.webp') center 22% / cover no-repeat, linear-gradient(100deg, #0a0a0c 0%, #17171b 100%)",
  },
];
---

<section aria-labelledby="acts-title" class="section acts-section" id="activities">
  <header class="acts-head">
    <h2 class="acts-title" id="acts-title">
      活动 <span class="acts-en">Activities</span>
    </h2>
    <a class="acts-link" href="/under-construction">全部活动 →</a>
  </header>

  <div class="photo-stack">
    {events.map((event, index) => (
      <a
        aria-label={`${event.name}：${event.desc}`}
        class:list={['stack-card', { active: index === 1 }]}
        data-stack-card
        href={event.href}
        style={`--rot:${event.rot};--dy:${event.dy}`}
      >
        <span
          class:list={['stack-img', { 'ph-tile': !event.img }]}
          style={event.img ? `background-image:url('${event.img}')` : `background:${event.g}`}
        >
          <span class="stack-tag">{event.tag}</span>
        </span>
        <span class="stack-meta">
          <strong>{event.name}</strong>
          <small>{event.desc}</small>
        </span>
      </a>
    ))}
  </div>
</section>

<script>
  // 突出状态跟随鼠标/焦点：放到哪张哪张突出，移开后保持，直到放到其他卡片
  const cards = document.querySelectorAll<HTMLElement>('[data-stack-card]');

  if (cards.length > 0) {
    const setActive = (card: HTMLElement) => {
      cards.forEach(c => c.classList.toggle('active', c === card));
    };

    cards.forEach(card => {
      card.addEventListener('mouseenter', () => setActive(card));
      card.addEventListener('focus', () => setActive(card));
    });
  }
</script>

<style>
  .acts-section {
    background: var(--background);
    padding-top: 88px;
  }

  .acts-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto 10px;
  }

  .acts-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    letter-spacing: 0.06em;
  }

  .acts-en {
    font-family: 'Archivo', sans-serif;
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 6px;
  }

  .acts-link {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--grad-a);
    text-decoration: none;
  }

  .acts-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .acts-link:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* —— 拍立得照片堆 —— */
  .photo-stack {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 0 36px;
    min-height: 0;
  }

  .stack-card {
    position: relative;
    width: min(30%, 330px);
    aspect-ratio: 4 / 3.9;
    flex-shrink: 0;
    background: var(--paper-face);
    padding: 10px 10px 56px;
    border-radius: 6px;
    box-shadow: var(--paper-shadow);
    transform: rotate(var(--rot)) translateY(var(--dy));
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
    text-decoration: none;
  }

  .stack-card:nth-child(n + 2) {
    margin-left: -7%;
  }

  .stack-card:nth-child(2) {
    z-index: 2;
  }

  /* 突出态由 .active 驱动（JS 跟随鼠标/焦点），移开后保持到下一张 */
  .stack-card.active {
    transform: rotate(0deg) translateY(calc(var(--dy) - 22px)) scale(1.06);
    z-index: 10;
    box-shadow: var(--paper-shadow-lift);
  }

  .stack-card:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
  }

  .stack-img {
    display: flex;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }

  /* 真实封面图铺满拍立得相框 */
  .stack-img[style*='background-image'] {
    background-size: cover;
    background-position: center;
  }

  .stack-tag {
    align-self: flex-start;
    margin: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    /* 深色玻璃底：浅色照片上白字也可读 */
    background: rgba(30, 34, 46, 0.42);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: 'Archivo', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
  }

  /* 拍立得下方白边：活动名 + 一句话 */
  .stack-meta {
    position: absolute;
    left: 16px;
    right: 12px;
    bottom: 17px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .stack-meta strong {
    font-size: 15px;
    color: var(--paper-ink);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stack-meta small {
    font-size: 11px;
    color: var(--paper-sub);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .photo-stack {
      flex-direction: column;
      gap: 0;
      padding-bottom: 30px;
    }

    .stack-card {
      width: min(86%, 380px);
    }

    .stack-card {
      width: min(86%, 380px);
    }

    .stack-card:nth-child(n + 2) {
      margin-left: 0;
      margin-top: -34px;
    }

    .stack-card:nth-child(n + 3) {
      margin-top: -30px;
    }
  }
</style>
