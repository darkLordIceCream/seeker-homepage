---
// 首页第3层「活动」：哈苏式「一屏一图」（direction-approved 2026-10-22）
// 桌面：满幅单图舞台，底部四等分标签兼自动轮换进度条（悬停交互区/离屏暂停，reduced-motion 不轮换）；
// 移动端：同一组卡片变为横向滑动卡轨（与书架页横滑手势一致），板块 min-height:100svh 满屏 +
// 移动端唯一吸附点（global.css ≤768px），滚动靠近时刚好铺满整屏。
// 双主题：舞台（照片/白字/标签/底部深色渐变）两主题完全一致、无任何柔光；
// 随主题切换的只有 header 一族——底带、标题行、七周年排印幅、圆点
// （组件级 --acts-* 令牌，不使用 --anniv-*：那套只认 7th 页的 data-theme，与主站开关无关）。
// 四张卡片即四个入口链接；七周年为无图排印幅。层次：图 z0 → 纱幕 ::after z1 → 文字/「07」 z2。
import { getCollection } from 'astro:content';

// 时间的故事跟随最新一期：构建期取 activities collection 中 order 最大的那期
// （新增期数 md 即自动切换，无需手改本文件；期数计数 = collection 全量）
const stories = (await getCollection('activities')).sort((a, b) => b.data.order - a.data.order);
const latestStory = stories[0];
const storyCount = stories.length;

// 追光之旅跟随最新一届：取 lightChasing collection 年份最大的总冠军
const latestChasing = (await getCollection('lightChasing')).sort(
  (a, b) => b.data.year - a.data.year,
)[0];
const chasingYear = latestChasing?.data.year;
const chasingPrize = latestChasing?.data.grandPrize;

/** 舞台暗化档位：仅 NIGHT 使用（白字需要压图）；DAYLIGHT 墨字需要亮背景，全部为 none */
type Dim = 'hi' | 'mid' | 'lo';

type Act = {
  id: string;
  kicker: string;
  name: string;
  fact: string;
  cta: string;
  href: string;
  img?: string;
  alt?: string;
  dim: Dim;
  seventh?: boolean;
};

const acts: Act[] = [
  {
    id: 'story',
    kicker: 'SEEKER · STORY OF TIME',
    name: '时间的故事',
    fact: `2021 年起每月一期，已 ${storyCount} 期 · 最新一期「${
      latestStory?.data.issue ?? ''
    } · ${latestStory?.data.subtitle ?? ''}」`,
    cta: '进入',
    href: '/activities/story-of-time/',
    img: latestStory?.data.cover,
    alt: `《时间的故事》${latestStory?.data.issue ?? ''}封面`,
    dim: 'mid',
  },
  {
    id: 'welfare',
    kicker: 'SEEKER · WELFARE',
    name: '带上她的眼睛',
    fact: '山村中的摄影课 · 公益项目',
    cta: '进入',
    href: '/welfare/',
    img: 'https://r2.xn--seeker-ng2jm403afb4a.club/welfare/bring-her-eyes/in-a-faraway-place/01.jpg',
    alt: '「带上她的眼睛」公益项目：山村里孩子们上摄影课',
    dim: 'hi',
  },
  {
    id: 'chasing',
    kicker: 'SEEKER · CHASING THE LIGHT',
    name: '追光之旅 · 摄影大赛',
    fact: `一年一度的追光者摄影大赛 · ${chasingYear ?? ''} 总冠军《${
      chasingPrize?.title ?? ''
    }》${chasingPrize?.author ?? ''}`,
    cta: '进入',
    href: '/activities/chasing-light/',
    img: chasingPrize?.cover,
    alt: `${chasingYear ?? ''} 追光之旅总冠军作品《${chasingPrize?.title ?? ''}》`,
    dim: 'lo',
  },
  {
    id: 'seventh',
    kicker: 'SEEKER · 2019—2026',
    name: '七周年 · 光影七载，看见彼此',
    fact: 'SEEKER 七年影像与故事档案',
    cta: 'ENTER ARCHIVE',
    href: '/7th/',
    dim: 'lo',
    seventh: true,
  },
];

const tabLabel = (act: Act) => (act.seventh ? '七周年' : (act.name.split(' · ')[0] ?? act.name));
const tabIndexLabel = (act: Act, i: number) => (act.seventh ? '07' : String(i + 1).padStart(2, '0'));
---

<section
  aria-labelledby="acts-title"
  class="section acts-section"
  data-acts
  id="activities"
>
  <header class="acts-head">
    <h2 class="acts-title" id="acts-title">
      活动 <span class="acts-en">Activities</span>
    </h2>
    <a class="acts-link" href="/under-construction">全部活动 →</a>
  </header>

  <div class="acts-stage" data-stage>
    {
      acts.map((act, i) => (
        <a
          aria-label={`${act.name}：${act.fact}`}
          class:list={['act', { 'act--seventh': act.seventh, 'is-active': i === 0 }]}
          data-act
          data-dim={act.dim}
          href={act.href}
        >
          {act.img && (
            <img
              alt={act.alt ?? ''}
              class="act-img"
              decoding="async"
              loading={i === 0 ? 'eager' : 'lazy'}
              src={act.img}
            />
          )}
          {act.seventh && (
            <span aria-hidden="true" class="act-num-wrap">
              <span class="act-glow" />
              <span class="act-num">07</span>
            </span>
          )}
          <span class="act-body">
            <span class="act-kicker">{act.kicker}</span>
            <span class="act-name">{act.name}</span>
            <span class="act-fact">{act.fact}</span>
            <span class="act-enter">{act.cta}</span>
          </span>
        </a>
      ))
    }
  </div>

  <nav aria-label="活动切换" class="acts-tabs">
    {
      acts.map((act, i) => (
        <button
          aria-pressed={i === 0 ? 'true' : 'false'}
          class:list={['acts-tab', { 'is-active': i === 0 }]}
          data-tab={i}
          type="button"
        >
          <span aria-hidden="true" class="tab-ix">
            {tabIndexLabel(act, i)}
          </span>
          <span class="tab-tx">{tabLabel(act)}</span>
          <span aria-hidden="true" class="tab-bar" />
        </button>
      ))
    }
  </nav>

  <div aria-hidden="true" class="acts-dots">
    {acts.map((_, i) => (
      <i class:list={['dot', { 'is-active': i === 0 }]} data-dot={i} />
    ))}
  </div>
</section>

<script>
  // 桌面（>768px）：标签 hover/focus/click 切换当前幅；6s 自动轮换（离屏 / 指针悬在
  // 标签或正文上 / 键盘焦点在板块内 / 读屏减动效偏好 → 暂停）。
  // 移动端（≤768px）：同一组卡片改为横向滑动卡轨（CSS scroll-snap），圆点跟随，自动轮换关闭。
  const section = document.querySelector<HTMLElement>('[data-acts]');
  const stage = section?.querySelector<HTMLElement>('[data-stage]');
  const cards = [...(stage?.querySelectorAll<HTMLElement>('[data-act]') ?? [])];
  const tabs = [...(section?.querySelectorAll<HTMLButtonElement>('[data-tab]') ?? [])];
  const dots = [...(section?.querySelectorAll<HTMLElement>('[data-dot]') ?? [])];

  if (section && stage && cards.length > 0 && tabs.length === cards.length) {
    const desktop = matchMedia('(min-width: 769px)');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let cur = 0;
    let acc = 0;
    let last = 0;
    let raf = 0;
    let visible = false;

    const show = (i: number) => {
      cur = i;
      acc = 0;
      // 第七帧是纸底/深底排印幅：激活时让底部标签行跟随 header 一族配色
      section.classList.toggle('is-seventh', i === cards.length - 1);
      cards.forEach((card, k) => {
        const on = k === i;
        card.classList.toggle('is-active', on);
        if (desktop.matches) {
          card.toggleAttribute('inert', !on);
          card.setAttribute('aria-hidden', String(!on));
        } else {
          card.removeAttribute('inert');
          card.removeAttribute('aria-hidden');
        }
      });
      tabs.forEach((tab, k) => {
        tab.classList.toggle('is-active', k === i);
        tab.setAttribute('aria-pressed', String(k === i));
        if (k !== i) {
          tab.style.setProperty('--p', '0');
        }
      });
    };

    const applyMode = () => {
      if (desktop.matches) {
        show(cur);
      } else {
        cards.forEach((card) => {
          card.removeAttribute('inert');
          card.removeAttribute('aria-hidden');
        });
      }
    };

    tabs.forEach((tab, k) => {
      ['pointerenter', 'focus', 'click'].forEach((ev) =>
        tab.addEventListener(ev, () => show(k)),
      );
    });

    const startRaf = () => {
      if (desktop.matches && !reduce.matches && raf === 0) {
        raf = requestAnimationFrame(tick);
      }
    };

    const stopRaf = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
    };

    // 暂停条件：指针悬在标签/正文上，或键盘焦点在标签/当前卡内
    const pointerPaused = () =>
      section.querySelector('.acts-tabs:hover, .act.is-active .act-body:hover') !== null;
    const focusPaused = () =>
      section.querySelector('.acts-tabs :focus, .act.is-active :focus') !== null;

    function tick(t: number) {
      if (last > 0) {
        const paused = !visible || !desktop.matches || reduce.matches || pointerPaused() || focusPaused();
        if (!paused) {
          acc += t - last;
          if (acc >= 6000) {
            show((cur + 1) % cards.length);
          } else {
            tabs[cur]?.style.setProperty('--p', String(acc / 6000));
          }
        }
      }
      last = t;
      raf = requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false;
        last = 0;
      },
      { threshold: 0.5 },
    );
    io.observe(section);

    desktop.addEventListener('change', () => {
      applyMode();
      if (desktop.matches) {
        startRaf();
      } else {
        stopRaf();
      }
    });
    startRaf();
    applyMode();

    // 移动端圆点跟随卡轨滚动
    if (dots.length === cards.length) {
      const dotIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) {
              continue;
            }
            const i = cards.indexOf(entry.target as HTMLElement);
            if (i >= 0) {
              dots.forEach((dot, k) => dot.classList.toggle('is-active', k === i));
            }
          }
        },
        { root: stage, threshold: 0.6 },
      );
      cards.forEach((card) => dotIo.observe(card));
    }
  }
</script>

<style>
  /* ============ 令牌 ============
     舞台（照片/文字/标签/按钮/纱幕）两种主题完全一致：夜幕白字 + 底部深色渐变（同深色模式效果）；
     随主题切换的只有「header 一族」：底带、标题行、七周年排印幅、圆点。
     无任何柔光：文字只带深色投影（图上）/无投影（排印幅上） */
  .acts-section {
    /* —— 舞台令牌：不随主题 —— */
    --stage-fg: #ffffff;
    --stage-fg-soft: rgba(234, 244, 255, 0.78);
    --stage-kicker: var(--seeker-pale-blue);
    --stage-name-shadow:
      0 2px 34px rgba(4, 16, 30, 0.75),
      0 1px 5px rgba(4, 16, 30, 0.45);
    --stage-fact-shadow:
      0 1px 22px rgba(4, 16, 30, 0.8),
      0 1px 4px rgba(4, 16, 30, 0.5);
    /* 纱幕：清晰优先——文字区用收敛的暗 vignette 兜底（实测 WCAG ≥4.5:1），边缘近乎透明 */
    --veil-core: rgba(4, 16, 30, 0.68);
    --veil-edge: rgba(4, 16, 30, 0.2);
    --veil-top: rgba(4, 16, 30, 0.14);
    --veil-bottom: rgba(4, 16, 30, 0.9);
    --card-veil-core: rgba(4, 16, 30, 0.66);
    --card-veil-edge: rgba(4, 16, 30, 0.3);
    --card-veil-top: rgba(4, 16, 30, 0.25);
    --card-veil-bottom: rgba(4, 16, 30, 0.6);
    --enter-border: rgba(255, 255, 255, 0.75);
    --enter-bg: rgba(4, 16, 30, 0.12);
    --enter-hover-bg: #ffffff;
    --enter-hover-fg: var(--seeker-navy);
    --tab-line: rgba(255, 255, 255, 0.28);
    --tab-fg: rgba(234, 244, 255, 0.68);
    --tab-bar: #ffffff;
    --dim-hi: brightness(0.6) saturate(0.92);
    --dim-mid: brightness(0.75) saturate(0.95);
    --dim-lo: brightness(0.88);

    /* —— header 一族：随主题切换 —— */
    --acts-bg: var(--background);
    --acts-fg: var(--foreground);
    --acts-muted: var(--muted-foreground);
    --acts-accent: var(--link);
    --num-stroke: color-mix(in srgb, var(--foreground) 46%, transparent);
    --dot-bg: var(--border);
    --dot-active: var(--foreground);

    --head-space: 96px;
    background: var(--acts-bg);
    padding: 0;
    overflow: hidden;
  }

  :global(.dark) .acts-section {
    --acts-bg: #04101e;
    --acts-fg: #eaf4ff;
    --acts-muted: rgba(234, 244, 255, 0.55);
    --acts-accent: #8fc9ff;
    --num-stroke: rgba(234, 244, 255, 0.5);
    --dot-bg: rgba(234, 244, 255, 0.32);
    --dot-active: #eaf4ff;
  }

  .acts-section::before {
    display: none;
  }

  /* —— 顶部标题行：桌面悬在图上，移动端回落底带，颜色都走令牌 —— */
  .acts-head {
    position: absolute;
    top: var(--head-space);
    left: 0;
    right: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(24px, 4vw, 56px);
    padding: 0 clamp(24px, 4vw, 56px);
    color: var(--acts-fg);
  }

  .acts-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: inherit;
  }

  .acts-en {
    margin-left: 6px;
    font-family: var(--font-archivo);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: color-mix(in srgb, var(--acts-fg) 72%, transparent);
  }

  .acts-link {
    display: inline-flex;
    align-items: center;
    height: 44px;
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    color: var(--acts-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .acts-link:hover,
  .acts-link:focus-visible {
    color: var(--acts-accent);
    border-color: transparent;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .acts-link:focus-visible {
    outline: 2px solid var(--acts-accent);
    outline-offset: 4px;
  }

  /* —— 桌面舞台：一屏一图 —— */
  .acts-stage {
    position: absolute;
    inset: 0;
    background: var(--acts-bg);
  }

  .act {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: opacity;
  }

  .act.is-active {
    opacity: 1;
    z-index: 2;
  }

  .act-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 纱幕：图之上、文字之下（每卡自带，移动端换轻遮罩；颜色随主题） */
  .act::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(52% 42% at 50% 47%, var(--veil-core), transparent 100%),
      radial-gradient(120% 95% at 50% 44%, transparent 40%, var(--veil-edge) 100%),
      linear-gradient(to bottom, var(--veil-top), transparent 17%),
      linear-gradient(to top, var(--veil-bottom), transparent 30%);
  }

  /* 图片曝光分档（仅 NIGHT 压暗；DAYLIGHT 为 none） */
  .act[data-dim='hi'] .act-img {
    filter: var(--dim-hi);
  }

  .act[data-dim='mid'] .act-img {
    filter: var(--dim-mid);
  }

  .act[data-dim='lo'] .act-img {
    filter: var(--dim-lo);
  }

  /* 七周年：无图排印幅，不需要照片纱幕 */
  .act--seventh {
    background: var(--acts-bg);
  }

  .act--seventh::after {
    display: none;
  }

  .act-num-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .act-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(46% 40% at 50% 44%, rgba(46, 134, 222, 0.14), transparent 100%);
  }

  .act-num {
    align-self: flex-start;
    margin-top: 18vh;
    font-family: var(--font-archivo);
    font-size: clamp(96px, 12vw, 168px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--num-stroke);
  }

  .act-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(24px, 6vw, 96px);
    color: var(--stage-fg-soft);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
  }

  .act.is-active .act-body {
    opacity: 1;
    transform: none;
  }

  .act-kicker {
    margin-bottom: clamp(14px, 2.4vh, 26px);
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.34em;
    color: var(--stage-kicker);
  }

  .act-name {
    font-family: var(--font-serif-song);
    font-size: clamp(40px, 6vw, 88px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: 0.04em;
    color: var(--stage-fg);
    text-shadow: var(--stage-name-shadow);
    text-wrap: balance;
  }

  .act-fact {
    margin-top: clamp(14px, 2.6vh, 26px);
    max-width: 900px;
    font-family: var(--font-archivo);
    font-size: 16px;
    letter-spacing: 0.1em;
    line-height: 1.7;
    color: var(--stage-fg-soft);
    text-shadow: var(--stage-fact-shadow);
    text-wrap: balance;
  }

  .act-enter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: clamp(20px, 4vh, 40px);
    padding: 0 clamp(32px, 3.6vw, 52px);
    border: 1px solid var(--enter-border);
    background: var(--enter-bg);
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    color: var(--stage-fg);
    transition:
      background 0.35s,
      color 0.35s,
      border-color 0.35s;
  }

  /* 反色只发生在指针/键盘明确指向按钮时——整卡 hover 不再触发，
     否则满幅舞台上鼠标停在照片任意处都会让按钮"时不时变深色" */
  .act-enter:hover {
    background: var(--enter-hover-bg);
    border-color: var(--enter-hover-bg);
    color: var(--enter-hover-fg);
  }

  .act:focus-visible .act-enter {
    background: var(--enter-hover-bg);
    border-color: var(--enter-hover-bg);
    color: var(--enter-hover-fg);
  }

  /* 七周年排印幅属于 header 一族：随主题切换（纸底墨字 / 深底月光白），无投影 */
  .act--seventh .act-kicker {
    color: var(--acts-accent);
  }

  .act--seventh .act-name {
    color: var(--acts-fg);
    text-shadow: none;
  }

  .act--seventh .act-fact {
    color: var(--acts-muted);
    text-shadow: none;
  }

  .act--seventh .act-enter {
    border-color: color-mix(in srgb, var(--acts-fg) 52%, transparent);
    background: transparent;
    color: var(--acts-fg);
  }

  .act--seventh .act-enter:hover {
    background: var(--acts-fg);
    border-color: var(--acts-fg);
    color: var(--acts-bg);
  }

  .act:focus-visible {
    outline: none;
  }

  .act.is-active:focus-visible {
    outline: 2px solid var(--acts-fg);
    outline-offset: -6px;
  }

  /* —— 底部标签行：四等分 + 自动轮换进度（桌面专属） —— */
  .acts-tabs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
  }

  .acts-tab {
    position: relative;
    flex: 1;
    height: clamp(64px, 10vh, 92px);
    padding: 18px 8px 0;
    background: none;
    border: 0;
    border-top: 1px solid var(--tab-line);
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: center;
