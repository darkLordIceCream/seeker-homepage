---
// 首页第3层「活动」：拍立得照片堆——白框厚底照片卡错位叠放
// hover 抽出转正；未落地的活动指向占位页，公益项目直达 /welfare/
import { getCollection } from 'astro:content';

// 时间的故事卡封面跟随最新一期：构建期取 activities collection 中 order 最大的那期
// （新增期数 md 即自动切换，无需手改本文件；与 /activities/story-of-time/ 的「新」标同源）
const latestStory = (await getCollection('activities')).sort(
  (a, b) => b.data.order - a.data.order,
)[0];
const storyCover = latestStory?.data.cover;

type Act = {
  name: string;
  desc: string;
  tag: string;
  href: string;
  rot: string;
  dy: string;
  /** 渐变占位（无真实配图时用） */
  g?: string;
  /** 真实封面图 */
  img?: string;
};

const events: Act[] = [
  {
    name: '时间的故事',
    desc: '长期摄影企划',
    tag: '长期企划',
    href: '/activities/story-of-time/',
    rot: '-4deg',
    dy: '12px',
    img: storyCover,
  },
  {
    name: 'Seeker公益 · 带上她的眼睛',
    desc: '山村中的摄影课',
    tag: '公益项目',
    href: '/welfare/',
    rot: '2.2deg',
    dy: '-8px',
    img: 'https://r2.xn--seeker-ng2jm403afb4a.club/welfare/bring-her-eyes/in-a-faraway-place/01.jpg',
  },
  {
    name: '追光之旅 · 摄影大赛',
    desc: '一年一度的追光者摄影大赛',
    tag: '赛事',
    href: '/activities/chasing-light/',
    rot: '-1.4deg',
    dy: '18px',
    img: 'https://r2.xn--seeker-ng2jm403afb4a.club/activities/chasing-light/2024/grand-prize/01.webp',
  },
];
---

<section aria-labelledby="acts-title" class="section acts-section" id="activities">
  <header class="acts-head">
    <h2 class="acts-title" id="acts-title">
      活动 <span class="acts-en">Activities</span>
    </h2>
    <a class="acts-link" href="/under-construction">全部活动 →</a>
  </header>

  <div class="photo-stack">
    {events.map((event, index) => (
      <a
        aria-label={`${event.name}：${event.desc}`}
        class:list={['stack-card', { active: index === 1 }]}
        data-stack-card
        href={event.href}
        style={`--rot:${event.rot};--dy:${event.dy}`}
      >
        <span
          class:list={['stack-img', { 'ph-tile': !event.img }]}
          style={event.img ? `background-image:url('${event.img}')` : `background:${event.g}`}
        >
          <span class="stack-tag">{event.tag}</span>
        </span>
        <span class="stack-meta">
          <strong>{event.name}</strong>
          <small>{event.desc}</small>
        </span>
      </a>
    ))}
  </div>

  {/* 七周年特殊入口：Activities 中的非普通活动（理性入口），区别于右下角感性入口 */}
  <a class="acts-anniv" href="/7th/" aria-label="七周年纪念册：光影七载，看见彼此">
    <span class="acts-anniv-rule" aria-hidden="true"></span>
    <span class="acts-anniv-no">07 / SEVEN YEARS</span>
    <span class="acts-anniv-body">
      <strong class="acts-anniv-title">七周年 · 光影七载，看见彼此。</strong>
      <span class="acts-anniv-range">2019 — 2026 · SEEKER 七年影像与故事档案</span>
    </span>
    <span class="acts-anniv-cta">ENTER ARCHIVE →</span>
  </a>
</section>

<script>
  // 突出状态跟随鼠标/焦点：放到哪张哪张突出，移开后保持，直到放到其他卡片
  const cards = document.querySelectorAll<HTMLElement>('[data-stack-card]');

  if (cards.length > 0) {
    const setActive = (card: HTMLElement) => {
      cards.forEach(c => c.classList.toggle('active', c === card));
    };

    cards.forEach(card => {
      card.addEventListener('mouseenter', () => setActive(card));
      card.addEventListener('focus', () => setActive(card));
    });
  }
</script>

<style>
  .acts-section {
    background: var(--background);
    padding-top: 88px;
  }

  .acts-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto 10px;
  }

  .acts-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    letter-spacing: 0.06em;
  }

  .acts-en {
    font-family: 'Archivo', sans-serif;
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 6px;
  }

  .acts-link {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--grad-a);
    text-decoration: none;
  }

  .acts-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .acts-link:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* —— 拍立得照片堆 —— */
  .photo-stack {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 0 36px;
    min-height: 0;
  }

  .stack-card {
    position: relative;
    width: min(30%, 330px);
    aspect-ratio: 4 / 3.9;
    flex-shrink: 0;
    background: var(--paper-face);
    padding: 10px 10px 56px;
    border-radius: 6px;
    box-shadow: var(--paper-shadow);
    transform: rotate(var(--rot)) translateY(var(--dy));
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
    text-decoration: none;
  }

  .stack-card:nth-child(n + 2) {
    margin-left: -7%;
  }

  .stack-card:nth-child(2) {
    z-index: 2;
  }

  /* 突出态由 .active 驱动（JS 跟随鼠标/焦点），移开后保持到下一张 */
  .stack-card.active {
    transform: rotate(0deg) translateY(calc(var(--dy) - 22px)) scale(1.06);
    z-index: 10;
    box-shadow: var(--paper-shadow-lift);
  }

  .stack-card:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
  }

  .stack-img {
    display: flex;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }

  /* 真实封面图铺满拍立得相框 */
  .stack-img[style*='background-image'] {
    background-size: cover;
    background-position: center;
  }

  .stack-tag {
    align-self: flex-start;
    margin: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    /* 深色玻璃底：浅色照片上白字也可读 */
    background: rgba(30, 34, 46, 0.42);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: 'Archivo', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
  }

  /* 拍立得下方白边：活动名 + 一句话 */
  .stack-meta {
    position: absolute;
    left: 16px;
    right: 12px;
    bottom: 17px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .stack-meta strong {
    font-size: 15px;
    color: var(--paper-ink);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stack-meta small {
    font-size: 11px;
    color: var(--paper-sub);
    white-space: nowrap;
  }

  /* —— 七周年特殊块：暗房底片风格的编辑排版条，非普通活动卡 —— */
  .acts-anniv {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem 1.6rem;
    max-width: 1200px;
    width: 100%;
    margin: 26px auto 0;
    padding: 1.4rem 1.5rem 1.5rem;
    background:
      radial-gradient(120% 200% at 85% -50%, color-mix(in srgb, var(--anniv-accent) 14%, transparent), transparent 55%),
      var(--anniv-bg);
    border: 1px solid var(--anniv-border);
    text-decoration: none;
    transition: border-color 0.25s ease;
  }

  .acts-anniv:hover {
    border-color: color-mix(in srgb, var(--anniv-accent) 55%, transparent);
  }

  .acts-anniv-rule {
    position: absolute;
    top: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--anniv-accent) 60%, transparent), transparent 70%);
  }

  .acts-anniv-no {
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--anniv-accent);
  }

  .acts-anniv-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    flex: 1;
    min-width: 0;
  }

  .acts-anniv-title {
    font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'SimSun', serif;
    font-size: clamp(1.02rem, 2.4vw, 1.3rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--anniv-fg);
  }

  .acts-anniv-range {
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: rgba(242, 240, 235, 0.55);
  }

  .acts-anniv-cta {
    font-family: 'Archivo', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--anniv-accent);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .photo-stack {
      flex-direction: column;
      gap: 0;
      padding-bottom: 30px;
    }

    .stack-card {
      width: min(86%, 380px);
    }

    .stack-card {
      width: min(86%, 380px);
    }

    .stack-card:nth-child(n + 2) {
      margin-left: 0;
      margin-top: -34px;
    }

    .stack-card:nth-child(n + 3) {
      margin-top: -30px;
    }

    /* 七周年条改纵向堆叠：横排时中间标题体（flex:1 basis 0）会被
       「07 / SEVEN YEARS」和「ENTER ARCHIVE」挤成一字一行 */
    .acts-anniv {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      padding: 1.3rem 1.25rem 1.4rem;
    }

    .acts-anniv-body {
      display: block;
    }

    .acts-anniv-title,
    .acts-anniv-range {
      display: block;
    }

    .acts-anniv-range {
      margin-top: 0.45rem;
    }

    .acts-anniv-cta {
      margin-top: 0.35rem;
    }
  }
</style>
