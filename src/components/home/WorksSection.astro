---
/**
 * 首页第 2 屏「画廊 Gallery」：编辑式摄影展墙（feat-016）。
 * 设计原则：不模拟摄影，直接展示摄影——照片是唯一视觉主体，UI 极少。
 * 数据来自 src/data/gallery.ts（换作品只改那个文件）；R2 只读。
 * 全部图位轮换：每格持有多张候选，由下方小段脚本以 3~6s/次的独立随机
 * 间隔切换（各图位节奏互不相同，形成不对称感）；悬停暂停该格轮换；
 * prefers-reduced-motion 下脚本不启动、全部静态展示首张。
 * 入场复用全局 .reveal 机制（--reveal-delay 错峰）。
 */
import {
  type GalleryImage,
  GALLERY_HERO,
  GALLERY_SUPPORT_SQUARE,
  GALLERY_SUPPORT_TALL,
} from '@/data/gallery';

/** 入场错峰延迟 */
const delay = (i: number) => `--reveal-delay:${80 + i * 70}ms`;

/** 图位样式：入场延迟 + 首图真实宽高比（--slot-ar）。
 *  移动端杂志网格用 --slot-ar 按原生比例展示，替代展墙的固定裁切比例 */
const slotStyle = (i: number, pool: readonly GalleryImage[]) => {
  const first = pool[0];
  return first ? `${delay(i)}; --slot-ar:${first.w} / ${first.h}` : delay(i);
};

/** 图注：有作品名带名，无题只署名 */
const credit = (img: GalleryImage) =>
  img.title ? `@${img.author}《${img.title}》` : `@${img.author}`;

/** 主图池图的无障碍描述附署名（视觉署名随轮换，读屏走 alt） */
const heroAlt = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
---

<section aria-labelledby="works-title" class="section gallery-section" id="works">
  <header class="gallery-head reveal">
    <h2 class="gallery-title" id="works-title">
      画廊 <span class="gallery-en">Gallery</span>
    </h2>
  </header>

  <div class="gallery-wall">
    {/* 主视觉 + 竖幅一排 */}
    <div class="wall-row wall-row--hero">
      <div class="wall-slot wall-slot--hero reveal" data-cycle style={slotStyle(0, GALLERY_HERO)}>
        <div class="slot-frame">
          {
            GALLERY_HERO.map((img, i) => (
              <img
                alt={heroAlt(img)}
                class:list={['slot-img', i === 0 && 'is-active']}
                data-fade-img
                decoding="async"
                height={img.h}
                loading="lazy"
                src={img.src}
                width={img.w}
              />
            ))
          }
        </div>
        <p class="slot-credit">
          {
            GALLERY_HERO.map((img, i) => (
              <span class:list={['slot-credit-name', i === 0 && 'is-active']} data-fade-credit>
                {credit(img)}
              </span>
            ))
          }
        </p>
      </div>
      {
        GALLERY_SUPPORT_TALL.map((pool, slotIndex) => (
          <div class="wall-slot wall-slot--tall reveal" data-cycle style={slotStyle(slotIndex + 1, pool)}>
            <div class="slot-frame">
              {pool.map((img, i) => (
                <img
                  alt={img.alt}
                  class:list={['slot-img', i === 0 && 'is-active']}
                  data-fade-img
                  decoding="async"
                  height={img.h}
                  loading="lazy"
                  src={img.src}
                  width={img.w}
                />
              ))}
            </div>
            <p class="slot-credit">
              {pool.map((img, i) => (
                <span class:list={['slot-credit-name', i === 0 && 'is-active']} data-fade-credit>
                  {credit(img)}
                </span>
              ))}
            </p>
          </div>
        ))
      }
    </div>

    {/* 方幅一排 */}
    <div class="wall-row wall-row--square">
      {
        GALLERY_SUPPORT_SQUARE.map((pool, slotIndex) => (
          <div class="wall-slot wall-slot--square reveal" data-cycle style={slotStyle(slotIndex + 4, pool)}>
            <div class="slot-frame">
              {pool.map((img, i) => (
                <img
                  alt={img.alt}
                  class:list={['slot-img', i === 0 && 'is-active']}
                  data-fade-img
                  decoding="async"
                  height={img.h}
                  loading="lazy"
                  src={img.src}
                  width={img.w}
                />
              ))}
            </div>
            <p class="slot-credit">
              {pool.map((img, i) => (
                <span class:list={['slot-credit-name', i === 0 && 'is-active']} data-fade-credit>
                  {credit(img)}
                </span>
              ))}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // 每个图位独立随机轮换：每次切换间隔 3~6s 随机，各格节奏互不相同（不对称感）。
  // 渐进增强：脚本不运行（含 prefers-reduced-motion）时各格静态展示首张。
  const slots = document.querySelectorAll<HTMLElement>('[data-cycle]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!reduced.matches) {
    for (const slot of slots) {
      const imgs = slot.querySelectorAll<HTMLElement>('[data-fade-img]');
      const names = slot.querySelectorAll<HTMLElement>('[data-fade-credit]');
      if (imgs.length < 2) {
        continue;
      }

      let current = 0;
      let timer = 0;
      let paused = false;

      const show = (next: number) => {
        imgs[current]?.classList.remove('is-active');
        names[current]?.classList.remove('is-active');
        current = next;
        imgs[current]?.classList.add('is-active');
        names[current]?.classList.add('is-active');
      };

      // 切换间隔：3~6s 均匀随机
      const nextDelay = () => 3000 + Math.random() * 3000;

      const schedule = () => {
        timer = window.setTimeout(() => {
          show((current + 1) % imgs.length);
          schedule();
        }, nextDelay());
      };

      // 悬停暂停该格轮换，移开后继续（触屏无 hover 语义，不受影响）
      slot.addEventListener('mouseenter', () => {
        paused = true;
        window.clearTimeout(timer);
      });
      slot.addEventListener('mouseleave', () => {
        if (!paused) {
          return;
        }
        paused = false;
        schedule();
      });

      schedule();
    }
  }
</script>

<style>
  .gallery-section {
    background: var(--background);
    padding-top: 88px;
    padding-bottom: 32px;
  }

  .gallery-head {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto 22px;
  }

  .gallery-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    letter-spacing: 0.06em;
  }

  .gallery-en {
    font-family: 'Archivo', sans-serif;
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 6px;
  }

  /* —— 编辑式展墙 —— */
  .gallery-wall {
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(14px, 2vh, 20px);
  }

  .wall-row {
    display: grid;
    gap: clamp(12px, 1.5vw, 18px);
    align-items: start;
    min-width: 0;
  }

  /* 主图（4 份宽）+ 三张 2:3 竖幅（各 2 份宽）→ 同行等高 */
  .wall-row--hero {
    grid-template-columns: 4fr 2fr 2fr 2fr;
  }

  /* 方幅一排收窄居中，留出展墙呼吸感 */
  .wall-row--square {
    grid-template-columns: repeat(3, 1fr);
    width: 62%;
    margin: 0 auto;
  }

  .slot-frame {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: var(--muted);
  }

  .wall-slot--hero .slot-frame {
    aspect-ratio: 4 / 3;
    max-height: 44vh;
  }

  .wall-slot--tall .slot-frame {
    aspect-ratio: 2 / 3;
    max-height: 44vh;
  }

  .wall-slot--square .slot-frame {
    aspect-ratio: 1 / 1;
    max-height: 24vh;
  }

  /* 轮换图层：绝对定位叠放，切换时 opacity 交叉过渡 */
  .slot-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .slot-img.is-active {
    opacity: 1;
  }

  .slot-credit {
    position: relative;
    height: 1.4em;
    margin: 8px 2px 0;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    overflow: hidden;
  }

  .slot-credit-name {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .slot-credit-name.is-active {
    opacity: 1;
  }

  /* —— 克制的 hover：图片轻微 scale，仅 opacity/transform —— */
  @media (hover: hover) {
    .slot-img {
      transition:
        opacity 1.1s ease,
        transform 0.5s ease;
    }

    .wall-slot:hover .slot-img.is-active {
      transform: scale(1.02);
    }
  }

  /* —— reduced-motion：无切换（脚本不启动），过渡一并移除 —— */
  @media (prefers-reduced-motion: reduce) {
    .slot-img,
    .slot-credit-name {
      transition: none;
    }
  }

  /* —— 响应式 —— */
  @media (max-width: 900px) {
    /* 主图 + 一张竖幅；方幅一排放开到整行宽 */
    .wall-row--hero {
      grid-template-columns: 2fr 1fr;
    }

    .wall-row--hero .wall-slot:nth-child(3),
    .wall-row--hero .wall-slot:nth-child(4) {
      display: none;
    }

    .wall-row--square {
      width: 100%;
    }
  }

  /* —— 移动端：两列杂志作品流 ——
     不再沿用展墙的固定裁切比例：全部图位入列，按首图原生比例（--slot-ar）展示，
     主图通栏压阵，竖幅与方幅两两成行；间距 8px 保持画册般的紧密排布 */
  @media (max-width: 768px) {
    .gallery-section {
      padding-top: 72px;
      padding-bottom: 24px;
    }

    .gallery-head {
      margin-bottom: 16px;
    }

    .gallery-wall {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    /* 两排展墙的行容器并入同一网格流（≤900 的行列规则随之失效） */
    .wall-row {
      display: contents;
    }

    /* ≤900 隐藏的第 3、4 图位全部恢复参展 */
    .wall-row--hero .wall-slot:nth-child(3),
    .wall-row--hero .wall-slot:nth-child(4) {
      display: block;
    }

    .wall-slot--hero {
      grid-column: 1 / -1;
    }

    /* 原生比例替代固定裁切；轮换切换图以 cover 轻微裁切，可接受 */
    .slot-frame {
      aspect-ratio: var(--slot-ar, 3 / 2);
      max-height: none;
    }
  }
</style>
