---
/**
 * 首页第 2 屏「画廊 Gallery」：丝带呼吸（Gallery 2.0，feat-043）。
 * 等高丝带定理：一行内所有图等高时，行高 = 行宽 ÷ 各图宽高比之和（Σar）。
 * 实现：槽 flex-grow = 自身 ar、aspect-ratio = 自身 ar → 行永远满宽、等高、
 * 零裁切，与轮换出什么比例无关；换图时槽尺寸走 rAF 指数平滑（防抖，见脚本），
 * 整面墙如呼吸般重排。照片按原始比例随机轮换（每槽 3~6s 独立间隔，
 * 引擎见 src/lib/gallery-cycle.ts：预载交叉淡入、hover 暂停、防同屏重复）。
 * 满宽模型：桌面 6 张（主带 1 横 2 竖 + 辅带 3 横），两行同宽铺满视口
 * （max-width 1728px 防超宽屏行高爆表），区块高约 1.1 屏——少而大，
 * snap 为 proximity 就近吸附；无 JS 时静态首图 flex + aspect-ratio 兜底。
 * 移动端：主带只留一张竖图满宽（竖图在窄屏才有冲击力），辅带 3 横矮带。
 * 数据来自 src/data/gallery.ts 的 GALLERY_POOL（换作品只改那个文件）；R2 只读。
 */
import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

const arOf = (img: GalleryImage) => img.w / img.h;

/** 比例分池：横 1.2–2.2 / 竖 0.5–0.85（超宽与近方各成一类不入轮换池）。
 *  主带竖槽用 V_MAIN（0.6–0.85，排除 0.56 极端竖图），配合 fitWall 保证
 *  任何轮换组合都不超出首屏 */
const H_POOL = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 1.2 && ar < 2.2;
});
const V_POOL = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 0.5 && ar < 0.85;
});
const V_MAIN = V_POOL.filter(i => arOf(i) >= 0.6);

/** 按文件名片段取指定首图（真实池内引用，不复制字段） */
const pick = (pool: readonly GalleryImage[], key: string): GalleryImage => {
  const hit = pool.find(i => i.src.includes(key));
  if (!hit) {
    throw new Error(`首页画廊首图缺失：${key}`);
  }
  return hit;
};

interface SlotCfg {
  kind: 'h' | 'v' | 'v-main';
  first: GalleryImage;
  /** 移动端是否隐藏 */
  mHide?: boolean;
}

/** 主带 3 张：1 横 2 竖（V_MAIN 池，满宽下行高约 420–470px）；辅带 3 张全横
 *  （满宽下行高约 280–340px）。桌面共 6 张——少而大，两行同宽铺满视口。
 *  移动端只保留主带竖图满宽 + 辅带 3 横矮带 */
const MAIN_SLOTS: SlotCfg[] = [
  { kind: 'h', first: pick(H_POOL, '心游万仞'), mHide: true },
  { kind: 'v-main', first: pick(V_MAIN, 'Henry浩麟') },
  { kind: 'v-main', first: pick(V_MAIN, '南迦巴瓦'), mHide: true },
];
const AUX_SLOTS: SlotCfg[] = [
  { kind: 'h', first: pick(H_POOL, 'Michelle_Chen') },
  { kind: 'h', first: pick(H_POOL, 'Tommic') },
  { kind: 'h', first: pick(H_POOL, '王哼哼') },
];

const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
const capOf = (img: GalleryImage) =>
  img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`;
---

<section aria-labelledby="works-title" class="section gallery-section" id="works">
  <header class="gallery-head reveal">
    <h2 class="gallery-title" id="works-title">
      画廊 <span class="gallery-en">Gallery</span>
    </h2>
  </header>

  <div class="gallery-wall reveal" data-wall style="--reveal-delay:120ms">
    <div class="ribbon-row ribbon-row--main" aria-label="主带作品">
      {
        MAIN_SLOTS.map(cfg => {
          const img = cfg.first;
          const ar = arOf(img).toFixed(4);
          return (
            <figure class:list={['gslot', cfg.mHide && 'gslot--mhide']} data-kind={cfg.kind} style={`--ar:${ar};--fg:${ar}`}>
              <button
                aria-label={`放大查看 ${capOf(img)}`}
                class="shot"
                data-author={img.author}
                data-full={img.src}
                data-title={img.title ?? ''}
                type="button"
              >
                <img
                  alt={altOf(img)}
                  class="gimg is-active"
                  decoding="async"
                  fetchpriority={cfg.kind === 'h' ? 'high' : undefined}
                  height={img.h}
                  loading={cfg.kind === 'h' ? 'eager' : 'lazy'}
                  src={img.src}
                  width={img.w}
                />
                <img alt="" aria-hidden="true" class="gimg" decoding="async" />
              </button>
              <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
            </figure>
          );
        })
      }
    </div>

    <div class="ribbon-row ribbon-row--aux" aria-label="辅带作品">
      {
        AUX_SLOTS.map(cfg => {
          const img = cfg.first;
          const ar = arOf(img).toFixed(4);
          return (
            <figure class:list={['gslot', cfg.mHide && 'gslot--mhide']} data-kind={cfg.kind} style={`--ar:${ar};--fg:${ar}`}>
              <button
                aria-label={`放大查看 ${capOf(img)}`}
                class="shot"
                data-author={img.author}
                data-full={img.src}
                data-title={img.title ?? ''}
                type="button"
              >
                <img
                  alt={altOf(img)}
                  class="gimg is-active"
                  decoding="async"
                  height={img.h}
                  loading="lazy"
                  src={img.src}
                  width={img.w}
                />
                <img alt="" aria-hidden="true" class="gimg" decoding="async" />
              </button>
              <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>

  <div aria-label="查看大图" aria-modal="true" class="gl-lightbox" hidden role="dialog">
    <button aria-label="关闭图片查看器" class="gl-btn gl-close" type="button">
      <svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24" width="22"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
    <button aria-label="下一张作品" class="gl-btn gl-next" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M9 18l6-6-6-6" /></svg>
    </button>
    <figure class="gl-stage">
      <img alt="" class="gl-img" decoding="async" />
      <figcaption class="gl-cap"></figcaption>
    </figure>
    <button aria-label="上一张作品" class="gl-btn gl-prev" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <p aria-live="polite" class="gl-count"></p>
  </div>
</section>

<script>
  import { startGalleryCycle } from '@/lib/gallery-cycle';
  import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

  const arOf = (img: GalleryImage) => img.w / img.h;
  const H_POOL = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 1.2 && ar < 2.2;
  });
  const V_POOL = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 0.5 && ar < 0.85;
  });
  const V_MAIN = V_POOL.filter(i => arOf(i) >= 0.6);

  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const isDesktop = () => window.matchMedia('(min-width: 769px)').matches;

  // —— 丝带几何：rAF 指数平滑（防抖核心）——
  // 槽尺寸不使用 CSS transition：高频换图下 transition 被反复重定向，
  // ease-in-out 重定向时速度瞬间归零再加速 = 全墙"刹车再起步"式抖动。
  // JS 维护每槽 cur/tgt，rAF 循环指数趋近（速度 = k×(tgt−cur)，帧率无关，
  // τ = 130ms；目标变化速度天然连续，不归零不超调；静止自动停循环）。
  // 行几何 = 等高丝带定理：行高 H = (行宽 − gaps)/Σar，槽宽 = H × ar；
  // 行宽直接取满容器（满宽模型），无 JS 时槽回退 flex-grow + aspect-ratio 兜底。
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const rowGap = (row: Element | null) =>
    parseFloat(getComputedStyle(row ?? document.body).columnGap) || 0;

  // —— 槽尺寸动画：rAF 指数平滑（防抖核心）——
  // CSS transition 在高频换图下被反复重定向（8 槽平均 0.56s 一次 fitWall 全墙
  // 重设目标 < 1.1s 过渡时长），ease-in-out 重定向时速度瞬间归零再加速——
  // 全墙每半秒"刹车再起步"，比例差越大位移越大抖感越强。
  // 指数平滑对目标变化速度天然连续（速度 = k×(tgt−cur)，不归零不超调），
  // 静止后自动停循环。帧率无关：k = 1 − exp(−dt/τ)，τ = 130ms。
  interface SlotAnim {
    el: HTMLElement;
    cur: { w: number; h: number };
    tgt: { w: number; h: number };
    init: boolean;
  }
  const anims = new Map<HTMLElement, SlotAnim>();
  let rafId = 0;
  let animRunning = false;
  let lastTick = 0;

  const applySize = (a: SlotAnim) => {
    a.el.style.width = `${a.cur.w.toFixed(1)}px`;
    a.el.style.height = `${a.cur.h.toFixed(1)}px`;
  };

  const tick = () => {
    const now = performance.now();
    const dt = Math.min(64, now - lastTick);
    lastTick = now;
    const k = 1 - Math.exp(-dt / 130);
    let settled = true;
    anims.forEach(a => {
      const dw = a.tgt.w - a.cur.w;
      const dh = a.tgt.h - a.cur.h;
      if (Math.abs(dw) > 0.5 || Math.abs(dh) > 0.5) {
        settled = false;
        a.cur.w += dw * k;
        a.cur.h += dh * k;
        applySize(a);
      } else if (a.cur.w !== a.tgt.w || a.cur.h !== a.tgt.h) {
        a.cur.w = a.tgt.w;
        a.cur.h = a.tgt.h;
        applySize(a);
      }
    });
    if (settled) {
      animRunning = false;
      return;
    }
    rafId = requestAnimationFrame(tick);
  };

  const kick = () => {
    if (animRunning || reducedMotion) {
      return;
    }
    animRunning = true;
    lastTick = performance.now();
    rafId = requestAnimationFrame(tick);
  };

  const layoutRow = (row: Element | null, rowW: number) => {
    if (!row) {return;}
    const slots = [...row.querySelectorAll<HTMLElement>('.gslot')].filter(
      g => getComputedStyle(g).display !== 'none',
    );
    if (slots.length === 0) {return;}
    const sum = slots.reduce(
      (acc, g) => acc + (parseFloat(g.style.getPropertyValue('--fg')) || 0),
      0,
    );
    if (sum <= 0) {return;}
    const gaps = rowGap(row) * (slots.length - 1);
    const h = (rowW - gaps) / sum;
    for (const g of slots) {
      const ar = parseFloat(g.style.getPropertyValue('--fg')) || 0;
      if (ar <= 0) {continue;}
      const w = Math.round(h * ar);
      const hh = Math.round(h);
      g.style.flex = '0 0 auto';
      let a = anims.get(g);
      if (!a) {
        // 首次注册：直接落到目标（无入场动画），后续换图走指数平滑
        a = { el: g, cur: { w, h: hh }, tgt: { w, h: hh }, init: true };
        anims.set(g, a);
        applySize(a);
        continue;
      }
      a.tgt = { w, h: hh };
      if (reducedMotion) {
        a.cur = { w, h: hh };
        applySize(a);
      }
    }
    if (!reducedMotion) {
      kick();
    }
  };

  /** 跨断点时清掉内联 px 布局与动画状态，交还给 CSS（移动端 flex + aspect-ratio 兜底） */
  const clearLayout = () => {
    if (animRunning) {
      cancelAnimationFrame(rafId);
      animRunning = false;
    }
    anims.clear();
    wall?.querySelectorAll<HTMLElement>('.gslot').forEach(g => {
      g.style.removeProperty('flex');
      g.style.removeProperty('width');
      g.style.removeProperty('height');
    });
  };

  const fitWall = () => {
    if (!wall || !isDesktop()) {
      clearLayout();
      return;
    }
    // 满宽模型：墙宽直接取满容器（CSS max-width 1728px 防超宽屏爆行高），
    // 两行各自按等高丝带定理解行高。不再反解压缩墙宽——6 张大图铺满优先，
    // 区块高度约 1.1 屏（snap 为 proximity 就近吸附，多滚一点自然看完）。
    const w = wall.clientWidth;
    if (w < 320) {return;}
    layoutRow(wall.querySelector('.ribbon-row--main'), w);
    layoutRow(wall.querySelector('.ribbon-row--aux'), w);
  };

  // —— 轮换：换图后更新槽位比例变量 → flex-grow/aspect-ratio 过渡 → 整墙呼吸重排 ——
  const slots = [...document.querySelectorAll<HTMLElement>('.gslot')].map(el => ({
    el,
    pool:
      el.dataset.kind === 'h'
        ? H_POOL
        : el.dataset.kind === 'v-main'
          ? V_MAIN
          : V_POOL,
  }));
  startGalleryCycle(slots, {
    onSwap: (el, img) => {
      const ar = arOf(img).toFixed(4);
      el.style.setProperty('--ar', ar);
      el.style.setProperty('--fg', ar);
      fitWall();
    },
  });

  if (wall) {
    fitWall();
    window.addEventListener('resize', fitWall, { passive: true });
  }

  // —— 灯箱：点击照片全屏浏览，Esc 关闭、←→ 切换（渐进增强，无依赖） ——
  const lightbox = document.querySelector<HTMLElement>('.gl-lightbox');
  const img = lightbox?.querySelector<HTMLImageElement>('.gl-img');
  const cap = lightbox?.querySelector<HTMLElement>('.gl-cap');
  const count = lightbox?.querySelector<HTMLElement>('.gl-count');
  const shutters = [...document.querySelectorAll<HTMLButtonElement>('.shot')];

  let current = -1;
  let lastFocus: HTMLElement | null = null;

  // 触发按钮的 dataset 会被轮换引擎实时更新（随机播放），打开/切换时现读
  const readSlide = (index: number) => {
    const d = shutters[index]?.dataset;
    if (!d) {
      return null;
    }
    return { full: d.full ?? '', title: d.title ?? '', author: d.author ?? '' };
  };

  const renderSlide = () => {
    const slide = readSlide(current);
    if (!img || !cap || !count || !slide) {return;}
    img.classList.remove('gl-img--error');
    img.src = slide.full;
    img.alt = slide.title
      ? `《${slide.title}》——${slide.author}作品`
      : `${slide.author}作品`;
    cap.textContent = slide.title
      ? `《${slide.title}》 @${slide.author}`
      : `@${slide.author}`;
    count.textContent = `${current + 1} / ${shutters.length}`;
  };

  const openLightbox = (index: number) => {
    if (!lightbox) {return;}
    current = index;
    renderSlide();
    lastFocus = document.activeElement as HTMLElement | null;
    // 锁定 html 滚动（overflow 方案天然保留滚动位置）
    document.documentElement.style.overflow = 'hidden';
    lightbox.hidden = false;
    lightbox.querySelector<HTMLElement>('.gl-close')?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) {return;}
    lightbox.hidden = true;
    document.documentElement.style.overflow = '';
    lastFocus?.focus();
    current = -1;
  };

  const step = (delta: number) => {
    if (current < 0 || shutters.length === 0) {return;}
    current = (current + delta + shutters.length) % shutters.length;
    renderSlide();
  };

  shutters.forEach((btn, i) => {
    btn.addEventListener('click', () => openLightbox(i));
  });
  lightbox?.querySelector('.gl-close')?.addEventListener('click', closeLightbox);
  lightbox?.querySelector('.gl-prev')?.addEventListener('click', () => step(-1));
  lightbox?.querySelector('.gl-next')?.addEventListener('click', () => step(1));
  // 点背景关闭（点在图片/按钮上不关）
  lightbox?.addEventListener('click', e => {
    if (e.target === lightbox) {closeLightbox();}
  });

  // 键盘：Esc 关闭 / ←→ 切换 / Tab 焦点圈禁在灯箱内
  const FOCUSABLE = '.gl-close, .gl-prev, .gl-next';
  document.addEventListener('keydown', e => {
    if (current < 0 || !lightbox) {return;}
    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowRight') {
      step(1);
    } else if (e.key === 'ArrowLeft') {
      step(-1);
    } else if (e.key === 'Tab') {
      const items = [...lightbox.querySelectorAll<HTMLElement>(FOCUSABLE)];
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) {return;}
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // 触屏左右轻滑切换
  let touchX = 0;
  let touchY = 0;
  lightbox?.addEventListener(
    'touchstart',
    e => {
      const t = e.touches[0];
      if (t) {
        touchX = t.clientX;
        touchY = t.clientY;
      }
    },
    { passive: true },
  );
  lightbox?.addEventListener(
    'touchend',
    e => {
      const t = e.changedTouches[0];
      if (!t) {return;}
      const dx = t.clientX - touchX;
      const dy = t.clientY - touchY;
      if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        step(dx < 0 ? 1 : -1);
      }
    },
    { passive: true },
  );

  // 加载失败：可理解的错误态，灯箱仍可关闭/切换
  img?.addEventListener('error', () => {
    if (current < 0 || !cap || !count) {return;}
    img.classList.add('gl-img--error');
    cap.textContent = '图片加载失败——请检查网络后重试，仍可切换其他作品或关闭查看器。';
    count.textContent = `${current + 1} / ${shutters.length}`;
  });
</script>

<style>
  .gallery-section {
    background: var(--background);
    padding-top: 72px;
    padding-bottom: 40px;
  }

  .gallery-head {
    max-width: 1728px;
    width: 100%;
    margin: 0 auto 22px;
  }

  .gallery-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    letter-spacing: 0.06em;
  }

  .gallery-en {
    font-family: var(--font-archivo);
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 6px;
  }

  /* —— 丝带墙：flex-grow = ar 是无 JS 兜底；JS 布局用槽宽高 px（见 fitWall），
     满宽模型（max-width 1728 防超宽屏行高爆表）—— */
  .gallery-wall {
    width: 100%;
    max-width: 1728px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ribbon-row {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    min-width: 0;
  }

  .ribbon-row--aux {
    margin-top: 24px;
    width: 100%;
  }

  .gslot {
    flex: var(--fg) 1 0%;
    min-width: 0;
    margin: 0;
    /* 桌面端槽尺寸由 rAF 指数平滑驱动（见 script），不使用 CSS transition：
       CSS 过渡在高频换图下被反复重定向，速度归零再起步 = 抖动 */
  }

  .shot {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ar);
    padding: 0;
    border: 0;
    /* 透明底：交叉淡入期旧图的 letterbox 融入页面背景而非露出灰块
       （比例差大时灰底面积大，是抖动/闪烁感的另一来源） */
    background: transparent;
    overflow: hidden;
    cursor: pointer;
    /* 悬浮感：近影定边 + 远影抬升；纯 paint 不参与布局（不引发重排抖动） */
    --shot-shadow:
      0 1px 2px rgba(8, 41, 74, 0.1),
      0 14px 34px -10px rgba(8, 41, 74, 0.22);
    box-shadow: var(--shot-shadow);
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }

  :global(.dark) .shot {
    --shot-shadow:
      0 1px 3px rgba(0, 0, 0, 0.45),
      0 14px 34px -10px rgba(0, 0, 0, 0.55);
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .gimg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
