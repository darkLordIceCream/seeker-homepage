---
/**
 * 首页第 2 屏「作品 Gallery」：编辑式摄影展墙（feat-016）。
 * 设计原则：不模拟摄影，直接展示摄影——照片是唯一视觉主体，UI 极少。
 * 数据来自 src/data/gallery.ts（换作品只改那个文件）；R2 只读。
 * 主图位以纯 CSS 慢速 crossfade 轮换主图池（hover 暂停）；
 * reduced-motion 下全部静态。入场复用全局 .reveal 机制（--reveal-delay 错峰）。
 */
import {
  type GalleryImage,
  GALLERY_HERO,
  GALLERY_SUPPORT_SQUARE,
  GALLERY_SUPPORT_TALL,
} from '@/data/gallery';

/** 入场错峰延迟 */
const delay = (i: number) => `--reveal-delay:${80 + i * 70}ms`;

/** 图注：有作品名带名，无题只署名 */
const credit = (img: GalleryImage) =>
  img.title ? `@${img.author}《${img.title}》` : `@${img.author}`;

/** 主图池图的无障碍描述附署名（视觉署名随 crossfade 轮换，读屏走 alt） */
const heroAlt = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
---

<section aria-labelledby="works-title" class="section gallery-section" id="works">
  <header class="gallery-head reveal">
    <h2 class="gallery-title" id="works-title">
      作品 <span class="gallery-en">Gallery</span>
    </h2>
  </header>

  <div class="gallery-wall">
    {/* 主视觉 + 竖幅一排 */}
    <div class="wall-row wall-row--hero">
      <div class="wall-hero reveal" style={delay(0)}>
        <div class="hero-frame">
          {
            GALLERY_HERO.map((img, i) => (
              <img
                alt={heroAlt(img)}
                class:list={['hero-img', `hero-img--${i}`]}
                decoding="async"
                height={img.h}
                loading="lazy"
                src={img.src}
                width={img.w}
              />
            ))
          }
        </div>
        <div class="hero-credit">
          {
            GALLERY_HERO.map((img, i) => (
              <span class:list={[`hero-credit-name`, `hero-credit-name--${i}`]}>
                {credit(img)}
              </span>
            ))
          }
        </div>
      </div>
      {
        GALLERY_SUPPORT_TALL.map((img, i) => (
          <div class="wall-item reveal" style={delay(i + 1)}>
            <img
              alt={img.alt}
              decoding="async"
              height={img.h}
              loading="lazy"
              src={img.src}
              width={img.w}
            />
            <p class="wall-credit">{credit(img)}</p>
          </div>
        ))
      }
    </div>

    {/* 方幅一排 */}
    <div class="wall-row wall-row--square">
      {
        GALLERY_SUPPORT_SQUARE.map((img, i) => (
          <div class="wall-item reveal" style={delay(i + 4)}>
            <img
              alt={img.alt}
              decoding="async"
              height={img.h}
              loading="lazy"
              src={img.src}
              width={img.w}
            />
            <p class="wall-credit">{credit(img)}</p>
          </div>
        ))
      }
    </div>
  </div>

  <p class="gallery-note reveal" style={delay(7)}>小组成员摄影作品 · @ 为作者署名</p>
</section>

<style>
  .gallery-section {
    background: var(--background);
    padding-top: 88px;
    padding-bottom: 32px;
  }

  .gallery-head {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto 22px;
  }

  .gallery-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    letter-spacing: 0.06em;
  }

  .gallery-en {
    font-family: 'Archivo', sans-serif;
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 6px;
  }

  /* —— 编辑式展墙 —— */
  .gallery-wall {
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(14px, 2vh, 20px);
  }

  .wall-row {
    display: grid;
    gap: clamp(12px, 1.5vw, 18px);
    align-items: start;
    min-width: 0;
  }

  /* 主图（4 份宽）+ 三张 2:3 竖幅（各 2 份宽）→ 同行等高 */
  .wall-row--hero {
    grid-template-columns: 4fr 2fr 2fr 2fr;
  }

  /* 方幅一排收窄居中，留出展墙呼吸感 */
  .wall-row--square {
    grid-template-columns: repeat(3, 1fr);
    width: 62%;
    margin: 0 auto;
  }

  .wall-item img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 10px;
    background: var(--muted);
  }

  .wall-item img {
    aspect-ratio: 2 / 3;
    max-height: 44vh;
  }

  .wall-row--square .wall-item img {
    aspect-ratio: 1 / 1;
    max-height: 24vh;
  }

  .wall-credit {
    margin: 8px 2px 0;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* —— 主图位：慢速 crossfade（27s 循环，每张约 9s，淡入淡出交叠约 1s） —— */
  .hero-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 44vh;
    border-radius: 10px;
    overflow: hidden;
    background: var(--muted);
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: gallery-hero-fade 27s linear infinite;
  }

  .hero-img--0 {
    animation-delay: 0s;
  }

  .hero-img--1 {
    animation-delay: -18s;
  }

  .hero-img--2 {
    animation-delay: -9s;
  }

  @keyframes gallery-hero-fade {
    0% {
      opacity: 0;
    }

    3.7% {
      opacity: 1;
    }

    31.5% {
      opacity: 1;
    }

    35.2% {
      opacity: 0;
    }

    100% {
      opacity: 0;
    }
  }

  /* 主图署名随图轮换（与 hero-img 同一组 delay），置于图下与其他图注一致 */
  .hero-credit {
    position: relative;
    height: 1.4em;
    margin: 8px 2px 0;
  }

  .hero-credit-name {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--muted-foreground);
    opacity: 0;
    animation: gallery-hero-fade 27s linear infinite;
  }

  .hero-credit-name--0 {
    animation-delay: 0s;
  }

  .hero-credit-name--1 {
    animation-delay: -18s;
  }

  .hero-credit-name--2 {
    animation-delay: -9s;
  }

  /* —— 克制的 hover：图片轻微 scale，仅 opacity/transform —— */
  @media (hover: hover) {
    .wall-item img,
    .hero-frame .hero-img {
      transition: transform 0.5s ease;
    }

    .wall-item:hover img {
      transform: scale(1.02);
    }

    .wall-hero:hover .hero-img {
      transform: scale(1.015);
    }
  }

  /* 悬停主图时暂停轮换，方便看画 */
  .wall-hero:hover .hero-img,
  .wall-hero:hover .hero-credit-name,
  .wall-hero:focus-within .hero-img,
  .wall-hero:focus-within .hero-credit-name {
    animation-play-state: paused;
  }

  /* —— reduced-motion：全部静态，只显示第一张主图 —— */
  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .hero-credit-name {
      animation: none;
    }

    .hero-img--0,
    .hero-credit-name--0 {
      opacity: 1;
    }
  }

  /* —— 响应式 —— */
  @media (max-width: 900px) {
    /* 主图 + 一张竖幅；方幅一排放开到整行宽 */
    .wall-row--hero {
      grid-template-columns: 2fr 1fr;
    }

    .wall-row--hero .wall-item:nth-child(3),
    .wall-row--hero .wall-item:nth-child(4) {
      display: none;
    }

    .wall-row--square {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .gallery-head {
      margin-bottom: 16px;
    }

    .gallery-section {
      padding-top: 72px;
      padding-bottom: 24px;
    }

    /* 主图通栏 + 两张竖幅并排，收敛在一屏之内（方幅一排让位） */
    .wall-row--square {
      display: none;
    }

    .wall-row--hero {
      grid-template-columns: 1fr 1fr;
    }

    .wall-hero {
      grid-column: 1 / -1;
    }

    .wall-row--hero .wall-item:nth-child(4) {
      display: block;
    }
  }
</style>
