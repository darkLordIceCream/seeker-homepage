---
/**
 * 首页第 2 屏「画廊 Gallery」：白盒美术馆门厅（Gallery 3.0）。
 * 策展语言：单一主作建立尺度 + 一件反差竖件建立张力 + 博物馆标签 +
 * 一扇门（右上「更多精彩 →」进 /gallery 档案馆）——Hasselblad / Leica /
 * Magnum 首页的共同语法；替代上一版「丝带呼吸」6 格随机拼贴（无主次、
 * 视线无处落地）。
 *
 * 几何：两件作品等高满宽、零裁切、直角。行高 H = (W − gap)/Σar；墙宽由
 * fitWall 双重反解——视口高预算（严格一屏且标题可见）与白盒余白下限
 * clamp(48px, 6vw, 120px)（美术馆的墙不贴边），上限 1728px。
 *
 * 策展纪律（GalleryArtCritic P0）：
 * - 开场定妆：第一眼永远固定为 GALLERY_OPENING 组合，轮换由
 *   gallery-cycle.ts 的视口门控保证（进入视口才起表，Hero 停留不偷跑）；
 * - 槽内锁比例带：主作 1.48–1.62 / 竖图 0.657–0.686，换图墙宽漂移
 *   ±0.7% 不可感知；
 * - 两段式换场：旧帧整幅淡出 → 空墙 150ms → 新帧淡入（展厅换灯），
 *   替代大图交叉淡入中点的双曝叠影；错峰互斥 + 每槽洗牌袋。
 *
 * 移动端：竖图按高度预算居中作主视觉（9:16 类竖图在窄屏是原生构图），
 * 横图隐藏。灯箱片单 = 档案馆展示序（可与 No.XX 编号对上），翻遍全池，
 * 图注带「在档案馆查看 →」——灯箱是门厅与档案馆之间的走廊。
 * 数据来自 src/data/gallery.ts 的 GALLERY_POOL（单一事实来源）；R2 只读。
 */
import '../../styles/gallery-lightbox.css';
import { GALLERY_POOL, GALLERY_OPENING, type GalleryImage } from '@/data/gallery';

const arOf = (img: GalleryImage) => img.w / img.h;

/** 槽内比例带（P0：换图不越带，墙宽近乎恒定，只剩纯换场） */
const H_BAND = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 1.48 && ar <= 1.62;
});
const V_BAND = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 0.657 && ar <= 0.686;
});

const [OPENING_H, OPENING_V] = GALLERY_OPENING;

/** 定妆图必须落在对应比例带内（配置错位在构建期直接抛错拦住） */
if (!H_BAND.includes(OPENING_H) || !V_BAND.includes(OPENING_V)) {
  throw new Error('首页门厅定妆组合不在槽内比例带中——检查 GALLERY_OPENING 与 H_BAND/V_BAND');
}

const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
const capOf = (img: GalleryImage) =>
  img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`;

/** 门厅两槽：主作横图 + 反差竖图，均为第一眼定妆（eager） */
const SLOTS = [
  { kind: 'h' as const, img: OPENING_H },
  { kind: 'v' as const, img: OPENING_V },
];
---

<section aria-labelledby="works-title" class="section gallery-section" id="works">
  <header class="gallery-head reveal">
    <h2 class="gallery-title" id="works-title">
      画廊 <span class="gallery-en">Gallery</span>
    </h2>
    <a class="gallery-more" href="/gallery/">
      更多精彩 <span aria-hidden="true">→</span>
    </a>
  </header>

  <div class="gallery-wall reveal" data-wall style="--reveal-delay:120ms">
    <div aria-label="门厅作品" class="gallery-row" role="group">
      {
        SLOTS.map(cfg => {
          const { img } = cfg;
          const ar = arOf(img).toFixed(4);
          return (
            <figure class:list={['gslot', `gslot--${cfg.kind}`]} data-kind={cfg.kind} style={`--ar:${ar};--fg:${ar}`}>
              <button
                aria-label={`放大查看 ${capOf(img)}`}
                class="shot"
                data-author={img.author}
                data-full={img.src}
                data-title={img.title ?? ''}
                type="button"
              >
                <img
                  alt={altOf(img)}
                  class="gimg is-active"
                  decoding="async"
                  fetchpriority="high"
                  height={img.h}
                  loading="eager"
                  src={img.src}
                  width={img.w}
                />
                <img alt="" aria-hidden="true" class="gimg" decoding="async" />
              </button>
              <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>

  <div aria-label="查看大图" aria-modal="true" class="gl-lightbox" hidden role="dialog">
    <button aria-label="关闭图片查看器" class="gl-btn gl-close" type="button">
      <svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24" width="22"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
    <button aria-label="下一张作品" class="gl-btn gl-next" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M9 18l6-6-6-6" /></svg>
    </button>
    <figure class="gl-stage">
      <img alt="" class="gl-img" decoding="async" />
      <figcaption class="gl-cap"><span class="gl-cap-text"></span></figcaption>
    </figure>
    <button aria-label="上一张作品" class="gl-btn gl-prev" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <p aria-live="polite" class="gl-count"></p>
  </div>
</section>

<script>
  import { startGalleryCycle } from '@/lib/gallery-cycle';
  import { initGalleryLightbox } from '@/lib/gallery-lightbox';
  import { GALLERY_POOL, archiveOrdered, type GalleryImage } from '@/data/gallery';

  const arOf = (img: GalleryImage) => img.w / img.h;
  const H_BAND = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 1.48 && ar <= 1.62;
  });
  const V_BAND = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 0.657 && ar <= 0.686;
  });

  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const isDesktop = () => window.matchMedia('(min-width: 769px)').matches;

  // —— 槽尺寸动画：rAF 指数平滑（沿用丝带版结论）——
  // CSS transition 在高频换图下被反复重定向，ease-in-out 重定向时速度瞬间
  // 归零再加速 = 全墙"刹车再起步"式抖动。指数平滑对目标变化速度天然连续
  // （速度 = k×(tgt−cur)，不归零不超调），静止后自动停循环。
  // 帧率无关：k = 1 − exp(−dt/τ)，τ = 130ms。
  interface SlotAnim {
    el: HTMLElement;
    cur: { w: number; h: number };
    tgt: { w: number; h: number };
    init: boolean;
  }
  const anims = new Map<HTMLElement, SlotAnim>();
  let rafId = 0;
  let animRunning = false;
  let lastTick = 0;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const applySize = (a: SlotAnim) => {
    a.el.style.width = `${a.cur.w.toFixed(1)}px`;
    a.el.style.height = `${a.cur.h.toFixed(1)}px`;
  };

  const tick = () => {
    const now = performance.now();
    const dt = Math.min(64, now - lastTick);
    lastTick = now;
    const k = 1 - Math.exp(-dt / 130);
    let settled = true;
    anims.forEach(a => {
      const dw = a.tgt.w - a.cur.w;
      const dh = a.tgt.h - a.cur.h;
      if (Math.abs(dw) > 0.5 || Math.abs(dh) > 0.5) {
        settled = false;
        a.cur.w += dw * k;
        a.cur.h += dh * k;
        applySize(a);
      } else if (a.cur.w !== a.tgt.w || a.cur.h !== a.tgt.h) {
        a.cur.w = a.tgt.w;
        a.cur.h = a.tgt.h;
        applySize(a);
      }
    });
    if (settled) {
      animRunning = false;
      return;
    }
    rafId = requestAnimationFrame(tick);
  };

  const kick = () => {
    if (animRunning || reducedMotion) {
      return;
    }
    animRunning = true;
    lastTick = performance.now();
    rafId = requestAnimationFrame(tick);
  };

  // 等高定理：行高 H = (行宽 − gaps)/Σar，槽宽 = H × ar
  const layoutRow = (row: Element | null, rowW: number) => {
    if (!row) {return;}
    const slots = [...row.querySelectorAll<HTMLElement>('.gslot')].filter(
      g => getComputedStyle(g).display !== 'none',
    );
    if (slots.length === 0) {return;}
    const sum = slots.reduce(
      (acc, g) => acc + (parseFloat(g.style.getPropertyValue('--fg')) || 0),
      0,
    );
    if (sum <= 0) {return;}
    const gap = parseFloat(getComputedStyle(row).columnGap) || 0;
    const gaps = gap * (slots.length - 1);
    const h = (rowW - gaps) / sum;
    for (const g of slots) {
      const ar = parseFloat(g.style.getPropertyValue('--fg')) || 0;
      if (ar <= 0) {continue;}
      const w = Math.round(h * ar);
      const hh = Math.round(h);
      g.style.flex = '0 0 auto';
      let a = anims.get(g);
      if (!a) {
        // 首次注册：直接落到目标（无入场动画），后续换图走指数平滑
        a = { el: g, cur: { w, h: hh }, tgt: { w, h: hh }, init: true };
        anims.set(g, a);
        applySize(a);
        continue;
      }
      a.tgt = { w, h: hh };
      if (reducedMotion) {
        a.cur = { w, h: hh };
        applySize(a);
      }
    }
    if (!reducedMotion) {
      kick();
    }
  };

  /** 跨断点时清掉内联 px 布局与动画状态，交还给 CSS（移动端兜底） */
  const clearLayout = () => {
    if (animRunning) {
      cancelAnimationFrame(rafId);
      animRunning = false;
    }
    anims.clear();
    wall?.querySelectorAll<HTMLElement>('.gslot').forEach(g => {
      g.style.removeProperty('flex');
      g.style.removeProperty('width');
      g.style.removeProperty('height');
    });
    document.querySelector<HTMLElement>('.gallery-head')?.style.removeProperty('max-width');
  };

  // —— fitWall：双重反解（P0-3 视口高预算 + 白盒余白下限）——
  const WALL_MAX = 1728;
  // 固定开销：区块留白 80（56+24）+ 标题行约 70 + 图注约 27 ≈ 177，取 210 留余量
  const FIXED_BUDGET = 210;
  const ROW_GAP = 24;

  const fitWall = () => {
    if (!wall || !isDesktop()) {
      clearLayout();
      return;
    }
    const slots = [...wall.querySelectorAll<HTMLElement>('.gslot')].filter(
      g => getComputedStyle(g).display !== 'none',
    );
    const sum = slots.reduce(
      (acc, g) => acc + (parseFloat(g.style.getPropertyValue('--fg')) || 0),
      0,
    );
    if (sum <= 0) {return;}
    const gaps = ROW_GAP * Math.max(0, slots.length - 1);
    // 高度预算：行高 = 视口高 − 固定开销（标题/图注/留白）
    const availH = Math.max(360, window.innerHeight - FIXED_BUDGET);
    const byHeight = availH * sum + gaps;
    // 白盒余白下限：美术馆的墙不贴边（两侧 clamp(48px, 6vw, 120px)）
    const margin = Math.min(120, Math.max(48, window.innerWidth * 0.06));
    const byMargin = window.innerWidth - margin * 2;
    const w = Math.min(WALL_MAX, Math.max(320, byHeight), Math.max(320, byMargin));
    wall.style.maxWidth = `${Math.round(w)}px`;
    // 标题牌与展墙共享同一条光学边线（P1-1：美术馆的基本礼貌）
    const head = document.querySelector<HTMLElement>('.gallery-head');
    if (head) {
      head.style.maxWidth = `${Math.round(w)}px`;
    }
    layoutRow(wall.querySelector('.gallery-row'), wall.clientWidth);
  };

  // —— 轮换：槽内比例带 + 视口门控（保定妆）+ 两段式换场 + 错峰 + 洗牌袋 ——
  const cycleSlots = [...document.querySelectorAll<HTMLElement>('.gslot')].map(el => ({
    el,
    pool: el.dataset.kind === 'h' ? H_BAND : V_BAND,
  }));
  startGalleryCycle(cycleSlots, {
    gateEl: document.getElementById('works') ?? undefined,
    // 6–10s：门厅是「少而大」的策展，节奏是策展语气——3–6s 双槽错峰
    // 平均约 2.2s 一次事件像轮播广告，单件 6–10s 才像展厅（Critic P1-3）
    min: 6000,
    max: 10000,
    twoStage: { outMs: 700, gapMs: 150, inMs: 500 },
    exclusive: true,
    shuffle: true,
    onSwap: (el, img) => {
      const ar = arOf(img).toFixed(4);
      el.style.setProperty('--ar', ar);
      el.style.setProperty('--fg', ar);
      fitWall();
    },
  });

  if (wall) {
    fitWall();
    window.addEventListener('resize', fitWall, { passive: true });
  }

  // —— 灯箱：片单 = 档案馆展示序（编号一致），←/→ 翻遍全池，「在档案馆查看 →」——
  const lightbox = document.querySelector<HTMLElement>('.gl-lightbox');
  if (lightbox) {
    const ordered = archiveOrdered();
    const lb = initGalleryLightbox({
      root: lightbox,
      archiveHref: '/gallery/',
      getSlides: () =>
        ordered.map(i => ({ full: i.src, title: i.title ?? '', author: i.author })),
    });
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.shot')) {
      btn.addEventListener('click', () => {
        const idx = ordered.findIndex(i => i.src === btn.dataset.full);
        lb.open(idx >= 0 ? idx : 0);
      });
    }
  }
</script>

<style>
  .gallery-section {
    background: var(--background);
    /* 展厅垂直居中：墙在剩余空间里居中悬挂，而非顶死在标题下方 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .gallery-head {
    max-width: 1728px;
    width: 100%;
    margin: 0 auto 22px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .gallery-title {
    font-family: var(--font-serif-song);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .gallery-en {
    font-family: var(--font-archivo);
    font-size: 0.42em;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 10px;
  }

  .gallery-more {
    font-family: var(--font-archivo);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--link);
    text-decoration: none;
    white-space: nowrap;
  }

  .gallery-more span {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .gallery-more:hover,
  .gallery-more:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .gallery-more:hover span {
    transform: translateX(3px);
  }

  .gallery-more:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  /* —— 白盒墙：flex-grow = ar 是无 JS 兜底；JS 布局用槽宽高 px（见 fitWall）—— */
  .gallery-wall {
    width: 100%;
    max-width: 1728px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .gallery-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    min-width: 0;
    width: 100%;
  }

  .gslot {
    flex: var(--fg) 1 0%;
    min-width: 0;
    margin: 0;
    /* 桌面端槽尺寸由 rAF 指数平滑驱动（见 script），不使用 CSS transition */
  }

  .shot {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ar);
    padding: 0;
    border: 0;
    /* 透明底：两段式换场的"空墙"期由页面底透出，而非露出灰块 */
    background: transparent;
    overflow: hidden;
    cursor: pointer;
    /* 悬浮感：近影定边 + 远影抬升；纯 paint 不参与布局（不引发重排抖动） */
    --shot-shadow:
      0 1px 2px rgba(8, 41, 74, 0.1),
      0 14px 34px -10px rgba(8, 41, 74, 0.22);
    box-shadow: var(--shot-shadow);
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }

  /* 暗色主题：夜景照片边缘会融进深底——极轻的 1px 内描边保住直角形 */
  :global(.dark) .shot::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(234, 244, 255, 0.08);
    opacity: 1;
    transition: opacity 700ms ease;
    pointer-events: none;
  }

  :global(.dark) .shot {
    --shot-shadow:
      0 1px 3px rgba(0, 0, 0, 0.45),
      0 14px 34px -10px rgba(0, 0, 0, 0.55);
  }

  /* 空墙纪律（两段式换场）：画框随旧画一起退场——阴影与暗色内描边
     淡出到零，空墙期真的是墙，不残留幽灵框（Critic P0-1） */
  .gslot.is-swapping .shot {
    box-shadow: none;
    transition:
      box-shadow 700ms ease,
      transform 0.4s ease;
  }

  :global(.dark) .gslot.is-swapping .shot::after {
    opacity: 0;
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .gimg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .gimg.is-active {
    opacity: 1;
  }

  @media (hover: hover) {
    .gimg {
      transition:
        opacity 1.1s ease,
        transform 0.5s ease;
    }

    /* 悬停：照片轻微上浮、阴影加深，强化悬浮层次 */
    .gslot:hover .shot {
      transform: translateY(-4px);
      --shot-shadow:
        0 2px 4px rgba(8, 41, 74, 0.1),
        0 26px 52px -12px rgba(8, 41, 74, 0.3);
    }

    :global(.dark) .gslot:hover .shot {
      --shot-shadow:
        0 2px 5px rgba(0, 0, 0, 0.45),
        0 26px 52px -12px rgba(0, 0, 0, 0.65);
    }
  }

  /* 博物馆标签：衬线小字，克制 */
  .gcap {
    margin-top: 10px;
    font-family: var(--font-serif-song);
    font-size: 12.5px;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gcap-text {
    transition: opacity 0.4s ease;
  }

  /* —— reduced-motion：无轮换（脚本不启动），过渡一并移除 —— */
  @media (prefers-reduced-motion: reduce) {
    .gallery-wall,
    .gslot,
    .shot,
    .gimg,
    .gcap-text {
      transition: none;
      animation: none;
    }
  }

  /* —— 平板：间距收紧 —— */
  @media (max-width: 1023px) {
    .gallery-row {
      gap: 16px;
    }
  }

  /* —— 移动端：竖图按高度预算居中作主视觉，横图隐藏 —— */
  @media (max-width: 768px) {
    .gallery-section {
      padding-top: 48px;
      padding-bottom: 28px;
    }

    .gallery-head {
      margin-bottom: 14px;
    }

    .gallery-title {
      font-size: 1.6rem;
    }

    .gallery-row {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    .gslot--h {
      display: none;
    }

    .gslot--v {
      flex: none;
      width: auto;
    }

    .gslot--v .shot {
      width: min(88vw, calc(56vh * var(--ar)));
      height: auto;
      margin-inline: auto;
    }

    .gcap {
      text-align: center;
      margin-inline: auto;
      font-size: 11.5px;
    }
  }
</style>
