---
import type { CollectionEntry } from 'astro:content';
import MemberSocial from './MemberSocial.astro';

interface Props {
  member: CollectionEntry<'members'>;
  index: number;
}

const { member, index } = Astro.props;
const { name, role, title, avatar, bio, specialties, social } = member.data;
---

<div class="member-card" style={`animation-delay: ${index * 0.1}s`}>
  <div class="member-image-wrapper">
    <img
      alt={name}       class="member-avatar"       loading="lazy"       src={avatar}
    />
  </div>

  <div class="member-info">
    <div class="member-header">
      <h2 class="member-name">{name}</h2>
      <span class="member-role">{role}</span>
    </div>

    <h3 class="member-title">{title}</h3>

    <p class="member-bio">{bio}</p>

    <div class="member-specialties">
      {specialties.map((specialty: string) => (
        <span class="specialty-tag">{specialty}</span>
      ))}
    </div>

    <MemberSocial memberName={name} social={social} />
  </div>
</div>

<style>
  .member-card {
    background: linear-gradient(135deg, rgba(30, 30, 30, 0.8) 0%, rgba(20, 20, 20, 0.8) 100%);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    animation: fadeInUp 0.8s ease-out;
    animation-fill-mode: both;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px;
    min-height: fit-content;
  }

  .member-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(78, 205, 196, 0.2);
    border-color: rgba(78, 205, 196, 0.3);
  }

  .member-image-wrapper {
    position: relative;
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    overflow: hidden;
  }

  .member-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    transition: border-color 0.4s ease;
    border: 4px solid rgba(78, 205, 196, 0.3);
  }

  .member-card:hover .member-avatar {
    border-color: rgba(78, 205, 196, 0.6);
  }

  .member-info {
    flex: 1;
    padding: 0;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .member-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .member-name {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(45deg, #fff, #4ecdc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .member-role {
    display: inline-block;
    padding: 6px 16px;
    background: linear-gradient(45deg, #4ecdc4, #ff6b6b);
    color: #fff;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .member-title {
    font-size: 1.2rem;
    color: #4ecdc4;
    margin: 0 0 20px 0;
    font-weight: 500;
  }

  .member-bio {
    font-size: 1rem;
    line-height: 1.8;
    color: #ccc;
    margin: 0 0 20px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .member-specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .specialty-tag {
    padding: 6px 14px;
    background: rgba(78, 205, 196, 0.15);
    border: 1px solid rgba(78, 205, 196, 0.3);
    border-radius: 15px;
    font-size: 0.875rem;
    color: #4ecdc4;
    transition: all 0.3s ease;
  }

  .specialty-tag:hover {
    background: rgba(78, 205, 196, 0.25);
    border-color: #4ecdc4;
    transform: translateY(-2px);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .member-card {
      flex-direction: column;
      text-align: center;
      padding: 30px 20px;
      gap: 25px;
      max-height: none;
    }

    .member-image-wrapper {
      width: 180px;
      height: 180px;
    }

    .member-info {
      align-items: center;
    }

    .member-name {
      font-size: 1.75rem;
    }

    .member-header {
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    .member-bio {
      -webkit-line-clamp: 4;
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .member-card {
      padding: 25px 15px;
      gap: 20px;
    }

    .member-image-wrapper {
      width: 150px;
      height: 150px;
    }

    .member-name {
      font-size: 1.5rem;
    }

    .member-bio {
      font-size: 0.9rem;
      -webkit-line-clamp: 5;
    }
  }
</style>
