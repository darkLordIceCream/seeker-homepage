---
/**
 * 【SEEKER 07 / DARKROOM】七周年水印海报生成器 · 暗房表现层。
 *
 * 状态机（画布优先，照片为第一主体）：
 * - 未上传：editorial 上传块为主视觉（选择照片 / 拖拽 / 粘贴 / 示例）；
 * - 编辑：大尺寸海报预览 + 控制区在照片下方（FORMAT 比例选择器 / NAME / SCALE）；
 * - 生成：光线扫过动画（reduced-motion 跳过）→ YOUR FRAME IS READY 完成态；
 * - 再做一张：回到上传态。
 *
 * 交互：自动识别横竖版（宽 ≥ 高 → 横版）、昵称双通道（下方输入 + 画布 SAFE AREA 热区
 * 就地编辑）、拖动/双指缩放 + 滑杆双通道。照片仅在浏览器本地处理。
 * 逻辑层：render.ts / gestures.ts / template.ts（零改动）。
 */
import { readFileSync } from 'node:fs';
import { NICKNAME_MAX_LENGTH, WATERMARK_TEMPLATES } from '../../lib/watermark/template';
import stats from '../../data/anniversary/stats.json';

// 位置选择数据：来自构建脚本生成的区域代表点（与地图同源，坐标现成）
interface LocOption {
  value: string;
  name: string;
  lngLat: [number, number];
}
interface LocGroup {
  label: string;
  options: LocOption[];
}

const points = JSON.parse(
  readFileSync('public/geo/anniv-points.json', 'utf8'),
) as {
  features: { geometry: { coordinates: [number, number] }; properties: { nameZh: string; kind: string } }[];
};

const locations: LocGroup[] = [
  {
    label: '中国省级行政区',
    options: points.features
      .filter(f => f.properties.kind === 'province')
      .map(f => ({ value: `p:${f.properties.nameZh}`, name: f.properties.nameZh, lngLat: f.geometry.coordinates })),
  },
  {
    label: '海外',
    options: points.features
      .filter(f => f.properties.kind === 'country')
      .map(f => ({ value: `c:${f.properties.nameZh}`, name: f.properties.nameZh, lngLat: f.geometry.coordinates })),
  },
];
---

<div class="dr" data-darkroom data-darkroom-root data-locations={JSON.stringify(locations)}>
  <!-- 未上传态：带上你的光（上传块） -->
  <section class="dr-empty" id="dr-empty">
    <p class="dr-empty-eyebrow">留下你的光 · A PLACE FOR YOUR LIGHT</p>
    <h2 class="dr-empty-title">带上你的光。</h2>
    <p class="dr-empty-title-en">BRING YOUR LIGHT.</p>
    <p class="dr-empty-sub">把这一刻，留在七周年。</p>
    <button class="dr-upload-btn" id="wm-dropzone" type="button">＋ 添加照片</button>
    <p class="dr-empty-hint">或将照片拖入 / 粘贴到此处 · JPG · PNG · WEBP · 完全在浏览器本地处理</p>
    <button class="dr-sample" id="wm-sample" type="button">没有照片？用示例试试 →</button>
  </section>

  <input accept="image/jpeg,image/png,image/webp" hidden id="wm-file" type="file" />

  <!-- 编辑态 -->
  <section class="dr-editor" hidden id="dr-editor">
    <div class="dr-stage-wrap">
      <div class="dr-stage" id="wm-stage">
        <canvas aria-label="海报预览" id="wm-canvas"></canvas>
        <!-- SAFE AREA：昵称安全区指示 + 就地编辑热区（生成结果不含此元素） -->
        <button
          aria-label="点击修改昵称"
          class="dr-safe"
          data-tip="SAFE AREA · 点击修改昵称"
          hidden
          id="wm-nick-hit"
          type="button"></button>
        <!-- 光线扫过动画层 -->
        <div aria-hidden="true" class="dr-sweep" id="dr-sweep"></div>
      </div>
    </div>

    <!-- 控制区：照片下方 -->
    <div class="dr-controls" id="dr-controls">
      <div class="dr-ctrl dr-ctrl--format">
        <span class="dr-ctrl-label">FORMAT</span>
        <div aria-label="切换海报版式" class="dr-formats" role="group">
          {
            WATERMARK_TEMPLATES.map((t, i) => (
              <button
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="dr-format"
                data-template-id={t.id}
                type="button"
              >
                <span
                  class="dr-format-box"
                  data-portrait={t.frameAxis === 'x' ? 'true' : 'false'}
                />
                <span class="dr-format-name">{t.name.split('·').pop()?.trim() ?? t.name}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="dr-ctrl dr-ctrl--name">
        <span class="dr-ctrl-eyebrow">WHO ARE YOU?</span>
        <label class="dr-ctrl-label" for="wm-nickname">NAME</label>
        <input
          autocomplete="off"
          id="wm-nickname"
          maxlength={NICKNAME_MAX_LENGTH}
          placeholder="你的昵称"
          type="text"
        />
      </div>

      <div class="dr-ctrl dr-ctrl--scale">
        <span class="dr-ctrl-label">SCALE</span>
        <div class="dr-scale-row">
          <button aria-label="缩小" disabled id="wm-zoom-out" type="button">−</button>
          <input
            aria-label="缩放照片"
            disabled
            id="wm-zoom"
            max="4"
            min="1"
            step="0.01"
            type="range"
            value="1"
          />
          <button aria-label="放大" disabled id="wm-zoom-in" type="button">＋</button>
          <button aria-label="重置位置与缩放" class="dr-reset" disabled id="wm-reset" type="button"
            >↺</button
          >
        </div>
      </div>

      <!-- 水印位置：横版上下移 / 竖版左右移（昵称随行，二维码钉死右下角） -->
      <div class="dr-ctrl dr-ctrl--frame">
        <span class="dr-ctrl-label" data-frame-label>FRAME</span>
        <div class="dr-scale-row">
          <button aria-label="左移水印" data-frame-neg type="button">‹</button>
          <input
            aria-label="移动水印"
            id="wm-frame"
            max="1"
            min="-1"
            step="0.01"
            type="range"
            value="0"
          />
          <button aria-label="右移水印" data-frame-pos type="button">›</button>
          <button aria-label="重置水印位置" class="dr-reset" data-frame-reset type="button"
            >↺</button
          >
        </div>
        <p class="dr-frame-hint" data-frame-hint>按住 Shift 拖动画布也可移动水印</p>
      </div>
    </div>

    <div class="dr-actions" id="dr-actions">
      <button class="dr-make" disabled id="wm-generate" type="button">生成纪念帧</button>
      <button class="dr-swap" hidden id="wm-change" type="button">换一张照片</button>
    </div>

    <!-- 完成态 -->
    <div class="dr-ready" hidden id="dr-ready">
      <p class="dr-ready-title">你的纪念帧。</p>
      <p class="dr-ready-title-en">YOUR FRAME.</p>
      <div class="dr-ready-actions">
        <a class="dr-make dr-make--ready" download hidden id="wm-download">下载海报</a>
        <button class="dr-swap" id="dr-again" type="button">再做一张</button>
      </div>
      <div class="dr-loc" data-darkroom-loc hidden>
        <p class="dr-loc-title">你在哪里？</p>
        <p class="dr-loc-title-en">WHERE ARE YOU?</p>
        <p class="dr-loc-sub">选择你最常出没的地区，把你的光点到地图上（仅在本页展示，不会被上传或保存）。</p>
        <div class="dr-loc-row">
          <select aria-label="选择你的位置" class="dr-loc-select" id="wm-loc-select">
            {
              locations.map(group => (
                <optgroup label={group.label}>
                  {group.options.map(o => (
                    <option value={o.value}>{o.name}</option>
                  ))}
                </optgroup>
              ))
            }
          </select>
          <button class="dr-make" data-loc-confirm type="button">点亮我的位置 →</button>
        </div>
        <p class="dr-loc-done" data-loc-done hidden>
          ✦ 你在这里 —— 你的光已经点亮，地图正在等你。
        </p>
      </div>
    </div>

    <p class="dr-note">
      与 {stats.members} 位追光者一起，把光赠予远方 · 照片仅在本地处理，不会上传
    </p>
  </section>

  <!-- 昵称就地编辑 popover -->
  <div class="dr-pop" hidden id="wm-pop">
    <label class="dr-pop-label" for="wm-pop-input">
      昵称
      <span id="wm-pop-count"></span>
    </label>
    <input autocomplete="off" id="wm-pop-input" maxlength={NICKNAME_MAX_LENGTH} type="text" />
    <p class="dr-pop-hint">Enter 确认 · 点击空白处退出</p>
  </div>

  <!-- toast -->
  <div class="dr-toast" hidden id="wm-toast" role="status"></div>
</div>

<script>
  // 暗房懒加载：接近章节才载入图片处理逻辑（页面初始加载零处理成本）
  const root = document.querySelector('[data-darkroom-root]');
  if (root) {
    const io = new IntersectionObserver(
      entries => {
        if (entries.some(e => e.isIntersecting)) {
          io.disconnect();
          import('../../lib/watermark/darkroom').then(m => m.initDarkroom());
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(root);
  }
</script>

<style>
  .dr {
    min-height: 60svh;
    display: flex;
    flex-direction: column;
    background: var(--anniv-bg);
    color: var(--anniv-fg);
  }

  /* —— 未上传态 —— */
  .dr-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
    border: 1px dashed transparent;
    transition: border-color var(--dur-normal) ease;
  }

  .dr-empty.is-dragover {
    border-color: var(--anniv-accent);
  }

  .dr-empty-eyebrow {
    margin: 0 0 1.1rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.38em;
    text-indent: 0.38em;
    color: var(--anniv-accent);
  }

  .dr-empty-title {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(2rem, 6.5vw, 4.2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.1em;
    color: var(--anniv-fg);
  }

  .dr-empty-title-en {
    margin: 0.7rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--anniv-faint);
  }

  .dr-empty-sub {
    margin: 1.4rem 0 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    letter-spacing: 0.16em;
    color: var(--anniv-muted);
  }

  .dr-upload-btn {
    margin-top: 3rem;
    padding: 1rem 4.5rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--anniv-bg);
    background: var(--anniv-fg);
    border: none;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }

  .dr-upload-btn:hover {
    background: var(--anniv-accent);
  }

  .dr-empty-hint {
    margin: 1.3rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    color: var(--anniv-faint);
  }

  .dr-sample {
    margin-top: 2.2rem;
    padding: 0.5rem 0.9rem;
    font: inherit;
    font-size: 0.82rem;
    color: var(--anniv-muted);
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }

  .dr-sample:hover {
    color: var(--anniv-accent);
    border-color: var(--anniv-accent);
  }

  /* —— 编辑态 —— */
  .dr-editor {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.8rem 1rem 2.5rem;
  }

  .dr-stage-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .dr-stage {
    position: relative;
    border: 1px solid var(--anniv-border);
    background: var(--anniv-surface-soft);
    transition:
      background-color var(--dur-normal) ease,
      border-color var(--dur-normal) ease;
  }

  .dr-stage.is-developing {
    outline: 2px dashed var(--anniv-accent);
    outline-offset: -6px;
  }

  /* DEVELOPING：暗房显影（黑 → 灰 → 轮廓 → 完整），reduced-motion 跳过 */
  .dr-stage.is-developing #wm-canvas {
    animation: dr-develop 1.6s var(--ease-enter) both;
  }

  @keyframes dr-develop {
    0% {
      filter: brightness(0.04) contrast(1.4);
    }
    55% {
      filter: brightness(0.45) contrast(1.15) saturate(0.4);
    }
    100% {
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dr-stage.is-developing #wm-canvas {
      animation: none;
    }
  }

  .dr-stage.is-dragover {
    outline: 2px dashed var(--anniv-accent);
    outline-offset: -6px;
  }

  #wm-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 2084 / 3705;
    touch-action: none;
    cursor: grab;
  }

  #wm-canvas:active {
    cursor: grabbing;
  }

  /* SAFE AREA 指示 */
  .dr-safe {
    position: absolute;
    background: transparent;
    border: 1px dashed color-mix(in srgb, var(--anniv-accent) 55%, transparent);
    border-radius: 2px;
    cursor: text;
    opacity: 0;
    transition: opacity var(--dur-normal) ease;
  }

  .dr-safe:hover,
  .dr-safe:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, var(--anniv-accent) 6%, transparent);
    outline: none;
  }

  /* 光线扫过 */
  .dr-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }

  .dr-sweep.is-sweeping {
    opacity: 1;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(58, 157, 255, 0.16) 47%,
      rgba(234, 244, 255, 0.5) 50%,
      rgba(58, 157, 255, 0.16) 53%,
      transparent 65%
    );
    background-size: 250% 100%;
    animation: dr-light-sweep 850ms var(--ease-enter) forwards;
  }

  @keyframes dr-light-sweep {
    from {
      background-position: 160% 0;
    }
    to {
      background-position: -60% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dr-sweep.is-sweeping {
      animation: none;
      opacity: 0;
    }
  }

  /* —— 控制区（照片下方） —— */
  .dr-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: 1.2rem 3rem;
    width: min(100%, 60rem);
    margin-top: 2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--anniv-border);
  }

  .dr-ctrl {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .dr-ctrl-label {
    font-family: 'Archivo', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--anniv-faint);
  }

  .dr-ctrl-eyebrow {
    font-family: 'Archivo', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    color: var(--anniv-accent);
  }

  /* FORMAT 比例选择器 */
  .dr-formats {
    display: flex;
    gap: 0.8rem;
  }

  .dr-format {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    background: transparent;
    border: 1px solid var(--anniv-border);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .dr-format:hover {
    border-color: var(--anniv-muted);
  }

  .dr-format[aria-pressed='true'] {
    border-color: var(--anniv-accent);
    background: color-mix(in srgb, var(--anniv-accent) 6%, transparent);
  }

  .dr-format-box {
    display: block;
    border: 1px solid currentColor;
    color: var(--anniv-fg);
  }

  .dr-format-box[data-portrait='true'] {
    width: 22px;
    height: 30px;
  }

  .dr-format-box[data-portrait='false'] {
    width: 34px;
    height: 22px;
  }

  .dr-format[aria-pressed='true'] .dr-format-box {
    color: var(--anniv-accent);
    background: color-mix(in srgb, var(--anniv-accent) 18%, transparent);
  }

  .dr-format-name {
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    color: var(--anniv-muted);
  }

  .dr-format[aria-pressed='true'] .dr-format-name {
    color: var(--anniv-fg);
  }

  /* NAME */
  .dr-ctrl--name input {
    width: 15rem;
    padding: 0.6rem 0.8rem;
    font: inherit;
    font-size: 0.92rem;
    color: var(--anniv-fg);
    background: var(--anniv-surface);
    border: 1px solid var(--anniv-border);
    border-radius: 0;
  }

  .dr-ctrl--name input:focus-visible {
    outline: 1px solid var(--anniv-accent);
    outline-offset: 1px;
  }

  /* SCALE */
  .dr-scale-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dr-scale-row button {
    width: 2.4rem;
    height: 2.4rem;
    font-size: 1.05rem;
    color: var(--anniv-fg);
    background: var(--anniv-surface);
    border: 1px solid var(--anniv-border);
    border-radius: 0;
    cursor: pointer;
  }

  .dr-reset {
    font-size: 0.95rem;
  }

  #wm-zoom {
    width: clamp(6rem, 14vw, 9rem);
    accent-color: var(--anniv-accent);
  }

  #wm-frame {
    width: clamp(6rem, 14vw, 9rem);
    accent-color: var(--anniv-accent);
  }

  .dr-frame-hint {
    margin: 0.3rem 0 0;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--anniv-faint);
  }

  @media (max-width: 48rem) {
    .dr-frame-hint {
      display: none;
    }
  }

  button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* —— 生成 / 完成态 —— */
  .dr-actions {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2rem;
  }

  .dr-make {
    padding: 1rem 3.2rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--anniv-bg);
    background: var(--anniv-accent);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: filter var(--dur-fast) ease;
  }

  .dr-make:hover:not(:disabled) {
    filter: brightness(1.08);
  }

  .dr-swap {
    padding: 0.6rem 1rem;
    font: inherit;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--anniv-muted);
    background: transparent;
    border: 1px solid var(--anniv-border);
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .dr-swap:hover {
    color: var(--anniv-fg);
    border-color: var(--anniv-muted);
  }

  .dr-ready {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
    margin-top: 2.4rem;
    padding: 2.2rem 2rem;
    border: 1px solid var(--anniv-accent);
    text-align: center;
  }

  .dr-ready-title {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.14em;
    color: var(--anniv-accent);
  }

  .dr-ready-title-en {
    margin: 0.5rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.38em;
    text-indent: 0.38em;
    color: var(--anniv-faint);
  }

  .dr-ready-actions {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  /* —— WHERE ARE YOU? 位置确认（会话内展示，不落库） —— */
  .dr-loc {
    margin-top: 2.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--anniv-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .dr-loc-title {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--anniv-fg);
  }

  .dr-loc-title-en {
    margin: -0.4rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.58rem;
    font-weight: 500;
