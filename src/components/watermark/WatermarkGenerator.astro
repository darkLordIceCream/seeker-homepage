---
/**
 * 七周年水印海报生成器 · 画布优先沉浸式编辑器（竖版 / 横版双模板）。
 *
 * 交互逻辑（画布优先）：
 * 1. 进入即海报舞台；空状态 = 大目标上传卡（点击/拖拽/粘贴）+ 示例照片；
 * 2. 选择照片后自动识别横竖（宽 ≥ 高 → 横版，否则竖版）并自动套用模板，
 *    toast 提示且可在工具条手动覆盖（手动选择保留至下一张照片）；
 * 3. 昵称双通道：工具条常驻输入框 + 点击海报昵称区域就地弹出编辑框；
 * 4. 底部悬浮玻璃工具条收纳全部控件；「生成纪念海报」为唯一主 CTA。
 *
 * 照片只在浏览器内存中处理，不上传服务器。
 * 逻辑层：render.ts（合成/钳制/缩放）· gestures.ts（手势）· template.ts（模板配置）。
 */
import { NICKNAME_MAX_LENGTH, WATERMARK_TEMPLATES } from '../../lib/watermark/template';
---

<div class="wm-app">
  <!-- 左上角品牌/隐私/返回浮标 -->
  <div class="wm-chips">
    <span class="wm-chip wm-chip--brand">水印工坊</span>
    <span class="wm-chip" title="照片只在你自己的浏览器里处理，不会上传到任何服务器">🔒 仅本地处理</span>
    <a class="wm-chip wm-chip--link" href="/7th/">← 七周年板块</a>
  </div>

  <!-- 海报舞台：整页画布 -->
  <div class="wm-stage" id="wm-stage">
    <canvas aria-label="海报预览" id="wm-canvas"></canvas>

    <!-- 昵称就地编辑热区（定位由脚本按模板坐标计算） -->
    <button
      aria-label="点击修改昵称"
      class="wm-nick-hit"
      hidden
      id="wm-nick-hit"
      type="button"
    ></button>

    <!-- 空状态上传卡 -->
    <button class="wm-dropzone" hidden id="wm-dropzone" type="button">
      <span class="wm-dropzone-card">
        <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path d="M4 7h3l2-2.5h6L17 7h3a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"></path>
          <circle cx="12" cy="13" r="3.5"></circle>
        </svg>
        <strong>点击选择照片</strong>
        <span>或拖拽 / 粘贴到此处 · JPG / PNG / WebP</span>
        <span class="wm-dropzone-privacy">照片仅在你的浏览器内处理，不会上传</span>
      </span>
    </button>
    <input accept="image/jpeg,image/png,image/webp" hidden id="wm-file" type="file" />

    <!-- toast（自动识别结果 / 成功 / 错误） -->
    <div class="wm-toast" hidden id="wm-toast" role="status"></div>
  </div>

  <!-- 示例照片入口（空状态时显示在舞台下方） -->
  <div class="wm-sample-row" id="wm-sample-row">
    <button class="wm-text-btn" id="wm-sample" type="button">没有照片？用示例试试 →</button>
  </div>

  <!-- 悬浮玻璃工具条 -->
  <div aria-label="编辑工具" class="wm-toolbar" role="toolbar">
    <div aria-label="切换海报模板" class="wm-seg" role="group">
      {
        WATERMARK_TEMPLATES.map((t, i) => (
          <button
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="wm-seg-btn"
            data-template-id={t.id}
            type="button"
          >
            {t.name.split('·').pop()?.trim() ?? t.name}
          </button>
        ))
      }
    </div>

    <div class="wm-nick-field">
      <label class="wm-sr" for="wm-nickname">昵称</label>
      <input
        autocomplete="off"
        id="wm-nickname"
        maxlength={NICKNAME_MAX_LENGTH}
        placeholder="输入你的昵称"
        type="text"
      />
    </div>

    <div class="wm-zoom-row">
      <button aria-label="缩小" disabled id="wm-zoom-out" type="button">−</button>
      <input aria-label="缩放照片" disabled id="wm-zoom" max="4" min="1" step="0.01" type="range" value="1" />
      <button aria-label="放大" disabled id="wm-zoom-in" type="button">＋</button>
      <button aria-label="重置位置与缩放" disabled id="wm-reset" type="button">↺</button>
    </div>

    <button class="wm-cta" disabled id="wm-generate" type="button">生成纪念海报</button>
    <a class="wm-cta wm-cta--download" download hidden id="wm-download">下载</a>
  </div>

  <!-- 昵称就地编辑 popover -->
  <div class="wm-pop" hidden id="wm-pop">
    <label class="wm-pop-label" for="wm-pop-input">
      昵称
      <span class="wm-pop-count" id="wm-pop-count"></span>
    </label>
    <input autocomplete="off" id="wm-pop-input" maxlength={NICKNAME_MAX_LENGTH} type="text" />
    <p class="wm-pop-hint">Enter 确认 · 点击空白处退出</p>
  </div>
</div>

<script>
  import { attachGestures } from '../../lib/watermark/gestures';
  import {
    buildFileName,
    clampTransform,
    ensureFonts,
    exportImage,
    initialTransform,
    loadPhoto,
    loadTemplate,
    PhotoDecodeError,
    renderComposition,
    zoomAtTransform,
    type LoadedPhoto,
    type PhotoTransform,
  } from '../../lib/watermark/render';
  import {
    DEFAULT_WATERMARK_TEMPLATE,
    NICKNAME_MAX_LENGTH,
    WATERMARK_TEMPLATES,
    type WatermarkTemplate,
  } from '../../lib/watermark/template';

  const MIN_SCALE = 1;
  const MAX_SCALE = 4;
  const ZOOM_STEP = 1.25;

  function required<T extends HTMLElement>(id: string, ctor: new () => T): T {
    const el = document.getElementById(id);
    if (!(el instanceof ctor)) {
      throw new Error(`水印生成器缺少元素 #${id}`);
    }
    return el;
  }

  const stage = required('wm-stage', HTMLDivElement);
  const canvas = required('wm-canvas', HTMLCanvasElement);
  const dropzone = required('wm-dropzone', HTMLButtonElement);
  const fileInput = required('wm-file', HTMLInputElement);
  const nickHit = required('wm-nick-hit', HTMLButtonElement);
  const toastEl = required('wm-toast', HTMLDivElement);
  const sampleBtn = required('wm-sample', HTMLButtonElement);
  const nicknameInput = required('wm-nickname', HTMLInputElement);
  const zoomSlider = required('wm-zoom', HTMLInputElement);
  const zoomInBtn = required('wm-zoom-in', HTMLButtonElement);
  const zoomOutBtn = required('wm-zoom-out', HTMLButtonElement);
  const resetBtn = required('wm-reset', HTMLButtonElement);
  const generateBtn = required('wm-generate', HTMLButtonElement);
  const downloadLink = required('wm-download', HTMLAnchorElement);
  const tplButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.wm-seg-btn[data-template-id]'),
  );
  const popEl = required('wm-pop', HTMLDivElement);
  const popInput = required('wm-pop-input', HTMLInputElement);
  const popCount = required('wm-pop-count', HTMLElement);

  let currentTemplate: WatermarkTemplate = DEFAULT_WATERMARK_TEMPLATE;
  let templateBitmap: ImageBitmap | null = null;
  const overlayCache = new Map<string, ImageBitmap>();
  let photo: LoadedPhoto | null = null;
  let transform: PhotoTransform = initialTransform();
  let downloadUrl: string | null = null;
  let renderQueued = false;
  let sourceFileName = '';
  let toastTimer = 0;

  /** 手势锚点（照片区域中心），切换模板时就地更新 */
  const areaCenter = { x: 0, y: 0 };

  function syncAreaCenter(): void {
    areaCenter.x = currentTemplate.photoArea.x + currentTemplate.photoArea.width / 2;
    areaCenter.y = currentTemplate.photoArea.y + currentTemplate.photoArea.height / 2;
  }

  function setStatus(message: string, isError = false): void {
    toastEl.textContent = message;
    toastEl.classList.toggle('is-error', isError);
    toastEl.classList.add('is-shown');
    if (toastTimer) {
      window.clearTimeout(toastTimer);
    }
    if (message) {
      toastTimer = window.setTimeout(() => {
        toastEl.classList.remove('is-shown');
        window.setTimeout(() => {
          toastEl.hidden = true;
        }, 250);
      }, 2800);
    } else {
      toastEl.hidden = true;
    }
  }

  function toast(message: string): void {
    setStatus(message);
  }

  function requestRender(): void {
    if (renderQueued || !templateBitmap) {
      return;
    }
    renderQueued = true;
    requestAnimationFrame(() => {
      renderQueued = false;
      if (!templateBitmap) {
        return;
      }
      // 预览分辨率：容器 CSS 尺寸 × dPR，长边封顶 1600px 保证交互流畅
      const cssWidth = canvas.clientWidth || stage.clientWidth || 360;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const scale = Math.max(
        Math.min((cssWidth * dpr) / currentTemplate.width, 1600 / currentTemplate.width),
        0.2,
      );
      renderComposition(canvas, {
        template: currentTemplate,
        templateImage: templateBitmap,
        photo,
        transform,
        nickname: nicknameInput.value,
        scale,
      });
    });
  }

  const normalize = (t: PhotoTransform): PhotoTransform =>
    photo ? clampTransform({ template: currentTemplate, photo, transform: t }) : t;

  function syncTplButtons(): void {
    for (const btn of tplButtons) {
      btn.setAttribute('aria-pressed', String(btn.dataset.templateId === currentTemplate.id));
    }
  }

  function syncControls(): void {
    const hasPhoto = photo !== null;
    zoomSlider.value = String(transform.scale);
    zoomSlider.disabled = !hasPhoto;
    zoomInBtn.disabled = !hasPhoto;
    zoomOutBtn.disabled = !hasPhoto;
    resetBtn.disabled = !hasPhoto;
    generateBtn.disabled = !hasPhoto;
    dropzone.hidden = hasPhoto;
    changePhotoVisibility();
  }

  function changePhotoVisibility(): void {
    // 有照片时隐藏示例入口；昵称热区在有模板时始终可用
    document.getElementById('wm-sample-row')?.toggleAttribute('hidden', hasPhotoBool());
  }

  function hasPhotoBool(): boolean {
    return photo !== null;
  }

  /** 围绕照片区域中心缩放（视野中心的内容保持不动，锚点语义随模板 fit） */
  function zoomBy(factor: number): void {
    transform = zoomAtTransform({
      template: currentTemplate,
      photo,
      transform,
      px: areaCenter.x,
      py: areaCenter.y,
      factor,
      minScale: MIN_SCALE,
      maxScale: MAX_SCALE,
    });
    syncControls();
    requestRender();
  }

  function releaseDownload(): void {
    if (downloadUrl) {
      URL.revokeObjectURL(downloadUrl);
      downloadUrl = null;
    }
    downloadLink.hidden = true;
  }

  async function handleFile(file: File | null | undefined): Promise<void> {
    if (!file) {
      return;
    }
    if (!file.type.startsWith('image/')) {
      setStatus('请选择图片文件（JPG / PNG / WebP）', true);
      return;
    }
    setStatus('正在读取照片…');
    try {
      const loaded = await loadPhoto(file);
      photo?.close();
      photo = loaded;
      sourceFileName = file.name;
      releaseDownload();

      transform = initialTransform();
      syncControls();
      requestRender();
      setStatus('');

      // 自动识别横竖版：宽 ≥ 高 → 横版，否则竖版；与当前模板不一致时自动切换
      const detected =
        loaded.width >= loaded.height
          ? WATERMARK_TEMPLATES.find((t) => t.fit.base === 'width')
          : WATERMARK_TEMPLATES.find((t) => t.fit.base === 'height');
      if (detected && detected.id !== currentTemplate.id) {
        await switchTemplate(detected, { silent: true });
        toast(
          `已识别为${loaded.width >= loaded.height ? '横图' : '竖图'}，自动套用${detected.name.split('·').pop()?.trim() ?? ''}模板 · 可在下方工具条切换`,
        );
      }
    } catch (error) {
      setStatus(
        error instanceof PhotoDecodeError
          ? '这张照片无法在浏览器中解码，请改用 JPG / PNG 格式（iPhone 可在「设置 → 相机 → 格式」选「兼容性最佳」后重新保存）。'
          : '照片读取失败，请重试。',
        true,
      );
    }
  }

  async function generate(): Promise<void> {
    if (!templateBitmap || !photo) {
      return;
    }
    generateBtn.disabled = true;
    generateBtn.textContent = '正在生成…';
    setStatus('');
    try {
      const out = document.createElement('canvas');
      renderComposition(out, {
        template: currentTemplate,
        templateImage: templateBitmap,
        photo,
        transform,
        nickname: nicknameInput.value,
      });
      const blob = await exportImage(out, currentTemplate.output);
      releaseDownload();
      downloadUrl = URL.createObjectURL(blob);
      downloadLink.href = downloadUrl;
      downloadLink.download = buildFileName(currentTemplate.output, sourceFileName);
      downloadLink.hidden = false;
      downloadLink.click();
      generateBtn.textContent = '重新生成';
      setStatus(`已生成（${(blob.size / 1024 / 1024).toFixed(1)} MB），已开始下载`);
    } catch {
      setStatus('生成失败，请重试。', true);
    } finally {
      generateBtn.disabled = photo === null;
    }
  }

  async function switchTemplate(
    template: WatermarkTemplate,
    opts: { announce?: boolean; silent?: boolean } = {},
  ): Promise<void> {
    if (template.id === currentTemplate.id && templateBitmap) {
      return;
    }
    if (!opts.silent) {
      setStatus('模板加载中…');
    }
    try {
      let bitmap = overlayCache.get(template.id);
      if (!bitmap) {
        bitmap = await loadTemplate(template.src);
        overlayCache.set(template.id, bitmap);
      }
      currentTemplate = template;
      templateBitmap = bitmap;
      transform = initialTransform();
      releaseDownload();
      canvas.style.aspectRatio = `${template.width} / ${template.height}`;
      layoutStage();
      syncAreaCenter();
      syncTplButtons();
      updateNickHit();
      syncControls();
      requestRender();
      if (!opts.silent) {
        setStatus('');
      }
    } catch {
      setStatus('模板加载失败，请检查网络后刷新重试。', true);
    }
  }

  /** 舞台尺寸：按模板纵横比在「页头以下、工具条以上」的剩余空间内取最大。
   *  高度上限 = 视口高 − 导航 70 − 页头 44 − 底部工具条预留（含安全区间距）。 */
  function layoutStage(): void {
    const aspect = currentTemplate.width / currentTemplate.height;
    const barEl = document.querySelector('.wm-toolbar');
    const barH = barEl ? barEl.getBoundingClientRect().height : 66;
    const NAV = 70;
    const HEAD = 44;
    const RESERVE = 46; // 工具条下边距 + 间隙 + 安全区
    document.documentElement.style.setProperty(
      '--wm-toolbar-reserve',
      `${Math.round(barH + RESERVE)}px`,
    );
    const availW = Math.min(window.innerWidth * 0.92, 1280);
    const availH = Math.max(
      window.innerHeight - NAV - HEAD - barH - RESERVE,
      300,
    );
    const w = Math.min(availW, availH * aspect);
    stage.style.width = `${Math.round(w)}px`;
  }

  /** 昵称就地编辑热区：按模板昵称坐标换算为舞台百分比 */
  function updateNickHit(): void {
    const n = currentTemplate.nickname;
    const estWidth = Math.min(
      n.maxWidth,
      n.fontSize * 0.72 * 6 + n.letterSpacing * 5 + n.fontSize * 1.2,
    );
    nickHit.style.left = `${((n.x - estWidth / 2 - 14) / currentTemplate.width) * 100}%`;
    nickHit.style.top = `${((n.y - n.fontSize * 1.5 - 10) / currentTemplate.height) * 100}%`;
    nickHit.style.width = `${((estWidth + 28) / currentTemplate.width) * 100}%`;
    nickHit.style.height = `${((n.fontSize * 2.1 + 20) / currentTemplate.height) * 100}%`;
  }

  /* ---- 昵称就地编辑 popover ---- */
  function showPop(): void {
    const hit = nickHit.getBoundingClientRect();
    popEl.hidden = false;
    const popW = 240;
    let left = hit.left + hit.width / 2 - popW / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - popW - 8));
    const top = hit.top - popEl.offsetHeight - 10;
    popEl.style.left = `${Math.round(left)}px`;
    popEl.style.top = `${Math.round(Math.max(8, top))}px`;
    popInput.value = nicknameInput.value;
    popCount.textContent = `${nicknameInput.value.length} / ${NICKNAME_MAX_LENGTH}`;
    window.setTimeout(() => popInput.focus(), 0);
  }

  function hidePop(): void {
    popEl.hidden = true;
  }

  nickHit.addEventListener('click', () => {
    if (popEl.hidden) {
      showPop();
    } else {
      hidePop();
    }
  });

  popInput.addEventListener('input', () => {
    nicknameInput.value = popInput.value;
    popCount.textContent = `${popInput.value.length} / ${NICKNAME_MAX_LENGTH}`;
    requestRender();
  });

  popInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      hidePop();
      requestRender();
    } else if (e.key === 'Escape') {
      hidePop();
    }
  });

  document.addEventListener('pointerdown', (e) => {
    if (popEl.hidden) {
      return;
    }
    const t = e.target as Element;
    if (!popEl.contains(t) && t !== nickHit && !nickHit.contains(t)) {
      hidePop();
    }
  });

  // ---- 事件绑定 ----

  for (const btn of tplButtons) {
    const tpl = WATERMARK_TEMPLATES.find((t) => t.id === btn.dataset.templateId);
    btn.addEventListener('click', () => {
      if (!tpl) {
        return;
      }
      void switchTemplate(tpl);
    });
  }

  dropzone.addEventListener('click', () => fileInput.click());

  const SAMPLE_SOURCES: Record<string, string> = {
    'seeker-7th-portrait': '/samples/seeker-sample-portrait.jpg',
    'seeker-7th-landscape': '/samples/seeker-sample-landscape.jpg',
  };
  sampleBtn.addEventListener('click', () => {
    const src =
      SAMPLE_SOURCES[currentTemplate.id] ??
      SAMPLE_SOURCES['seeker-7th-portrait'] ??
      '/samples/seeker-sample-portrait.jpg';
    void (async () => {
      sampleBtn.disabled = true;
      setStatus('正在加载示例照片…');
      try {
        const resp = await fetch(src);
        const blob = await resp.blob();
        await handleFile(new File([blob], 'seeker-sample.jpg', { type: 'image/jpeg' }));
      } catch {
        setStatus('示例照片加载失败，请直接选择本地照片。', true);
      } finally {
        sampleBtn.disabled = false;
      }
    })();
  });

  fileInput.addEventListener('change', () => {
    void handleFile(fileInput.files?.[0]);
    fileInput.value = '';
  });

  stage.addEventListener('dragover', (e) => {
    e.preventDefault();
    stage.classList.add('is-dragover');
  });
  stage.addEventListener('dragleave', () => stage.classList.remove('is-dragover'));
  stage.addEventListener('drop', (e) => {
    e.preventDefault();
    stage.classList.remove('is-dragover');
    void handleFile(e.dataTransfer?.files?.[0]);
  });

  document.addEventListener('paste', (e) => {
    void handleFile(e.clipboardData?.files?.[0]);
  });

  nicknameInput.addEventListener('input', () => {
    popInput.value = nicknameInput.value;
    requestRender();
  });

  zoomSlider.addEventListener('input', () => {
    const scale = Number.parseFloat(zoomSlider.value);
    if (!Number.isFinite(scale)) {
      return;
    }
    transform = zoomAtTransform({
      template: currentTemplate,
      photo,
      transform,
      px: areaCenter.x,
      py: areaCenter.y,
      factor: scale / transform.scale,
      minScale: MIN_SCALE,
      maxScale: MAX_SCALE,
    });
    requestRender();
  });

  zoomInBtn.addEventListener('click', () => zoomBy(ZOOM_STEP));
  zoomOutBtn.addEventListener('click', () => zoomBy(1 / ZOOM_STEP));
  resetBtn.addEventListener('click', () => {
    transform = initialTransform();
    syncControls();
    requestRender();
  });
  generateBtn.addEventListener('click', () => void generate());

  attachGestures(canvas, {
    cssToTemplate: () => currentTemplate.width / (canvas.clientWidth || 1),
    drag: (dx, dy) => {
      transform = normalize({ ...transform, x: transform.x + dx, y: transform.y + dy });
      zoomSlider.value = String(transform.scale);
      requestRender();
    },
    zoomAt: (px, py, factor) => {
      transform = zoomAtTransform({
        template: currentTemplate,
        photo,
        transform,
        px,
        py,
        factor,
        minScale: MIN_SCALE,
        maxScale: MAX_SCALE,
      });
      zoomSlider.value = String(transform.scale);
      requestRender();
    },
  });

  const resizeObserver = new ResizeObserver(() => requestRender());
  resizeObserver.observe(stage);
  window.addEventListener('resize', () => layoutStage());
  // 字体/首屏渲染会改变页头与工具条实高，就绪后二次校准舞台尺寸
  document.fonts.ready.then(() => layoutStage());
  window.addEventListener('load', () => layoutStage());

  // ---- 初始化：字体 → 默认模板 → 首绘 ----
  void (async () => {
    setStatus('正在加载模板…');
    try {
      await ensureFonts(currentTemplate.fonts);
      templateBitmap = await loadTemplate(currentTemplate.src);
      overlayCache.set(currentTemplate.id, templateBitmap);
      canvas.style.aspectRatio = `${currentTemplate.width} / ${currentTemplate.height}`;
      layoutStage();
      syncAreaCenter();
      syncTplButtons();
      syncControls();
      requestRender();
      setStatus('');
    } catch {
      setStatus('模板加载失败，请检查网络后刷新重试。', true);
    }
  })();
</script>

<style>
  .wm-app {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem calc(var(--wm-toolbar-reserve, 100px) + env(safe-area-inset-bottom, 0px));
    background:
      radial-gradient(90% 60% at 50% 0%, rgba(245, 197, 66, 0.07), transparent 60%),
      var(--background);
  }

  /* ---- 左上角浮标 ---- */
  .wm-chips {
    position: absolute;
    top: 84px;
    left: 1rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .wm-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    background: var(--glass-bg);
