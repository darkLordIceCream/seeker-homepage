---
// Banner component with video background and slogan
import bannerPoster from '../assets/images/banner-poster.jpg';
---

<section class="banner" id="home">
  <div class="video-container">
    <video
      autoplay
      class="banner-video"
      loop
      muted
      playsinline
      poster={bannerPoster.src}
    >
      <source src="https://r2.xn--seeker-ng2jm403afb4a.club/videos/banner.mp4" type="video/mp4" />
      您的浏览器不支持视频播放。
    </video>
    <div class="video-overlay"></div>
  </div>

  <div class="banner-content">
    <div class="slogan-container">
      <h1 class="slogan">拍一张照片，交一个朋友</h1>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
  }

  .video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .banner-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.6) 50%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 2;
  }

  .banner-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    max-width: 800px;
    padding: 0 20px;
  }

  .slogan-container {
    animation: fadeInUp 1.5s ease-out;
  }

  .slogan {
    font-size: 3.5rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    background: linear-gradient(45deg, #eaf4ff, #7fc4ff, #2e86de);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    /* 渐变透明文字上 text-shadow 会糊在字上，用 drop-shadow 跟随文字形状 */
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.45));
    line-height: 1.2;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-video {
      display: none;
    }
  }

  /* —— 移动端：杂志式 Hero ——
     横屏视频以 16:9 完整呈现（contain，不再 cover 裁掉中心画面），
     Hero 不再占满整屏；slogan 独立到视频下方，单行响应式字号、禁止换行 */
  @media (max-width: 768px) {
    .banner {
      height: auto;
      display: block;
    }

    .video-container {
      position: relative;
      height: auto;
      aspect-ratio: 16 / 9;
      /* 深藏蓝底把视频黑边融进去，poster 兜底时同样成立；
         视频从屏幕顶端铺起，固定导航照旧覆盖其上（白字对比度不变） */
      background: var(--seeker-navy, #08294a);
    }

    .banner-video {
      object-fit: contain;
    }

    /* slogan 已移出视频，遮罩减淡为轻渐变：顶部稍深保导航白字可读 */
    .video-overlay {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.42) 0%,
        rgba(0, 0, 0, 0.08) 32%,
        rgba(0, 0, 0, 0.22) 100%
      );
    }

    /* slogan 落回页面背景上：改用主题感知的品牌渐变（浅色主题下白字不可读） */
    .banner-content {
      color: var(--foreground);
      padding: 20px clamp(16px, 5vw, 24px) 0;
    }

    .slogan {
      margin: 0;
      white-space: nowrap;
      font-size: clamp(20px, 5.5vw, 32px);
      letter-spacing: -0.02em;
      background: linear-gradient(90deg, var(--grad-a), var(--grad-b));
      -webkit-background-clip: text;
      background-clip: text;
      filter: none;
    }
  }
</style>

<script>
  const video = document.querySelector('.banner-video') as HTMLVideoElement | null;

  // 确保视频在移动设备上自动播放；离屏时暂停省资源
  if (video) {
    video.play().catch(() => {
      // 自动播放被浏览器策略拦截时静默失败，poster 已兜底
    });

    if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.25 },
    );
      videoObserver.observe(video);
    }
  }
</script>
