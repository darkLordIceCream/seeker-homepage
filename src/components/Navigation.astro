---
// Navigation component for Seeker追光者 photography group
import ThemeToggle from './ThemeToggle.astro';

// 首页区块锚点：首页内用 #id 平滑滚动，其他页面跳回首页对应区块
const isHome = Astro.url.pathname.replace(/\/+$/, '') === '';
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<nav aria-label="主导航" class:list={['navigation', { 'navigation--solid': !isHome }]}>
  <div class="nav-container">
    <div class="nav-left">
      <div class="nav-logo">
        <a href="/">Seeker<span class="logo-accent">追光者</span></a>
      </div>

      <div class="nav-menu" id="nav-menu">
        <ul class="nav-list">
          <li class="nav-item">
            <a class="nav-link" data-section="works" href={anchor('works')}>作品展示</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" data-section="activities" href={anchor('activities')}>小组活动</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" data-section="about" href={anchor('about')}>小组简介</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={anchor('join')}>加入小组</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link--anniv" href="/7th/">7周年</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="nav-right">
      <ThemeToggle />

      <button aria-controls="nav-menu" aria-expanded="false" aria-label="切换导航菜单" class="nav-toggle" id="nav-toggle">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</nav>

<style>
  /* ============================================================
     LIQUID GLASS NAVIGATION
     Apple-style glassmorphism。导航顶部悬浮在深色视频上（浅色字），
     滚动落地后切换为主题玻璃条（前景色随主题变量）。
     ============================================================ */

  .navigation {
    /* 顶部悬浮态（深色视频上）：白字 + 天蓝色 hover */
    --nav-fg: #ffffff;
    --nav-hover: #3a9dff;
    --nav-pill-bg: rgba(255, 255, 255, 0.12);
    --nav-pill-border: rgba(255, 255, 255, 0.25);

    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: transparent;
    z-index: 1002;
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  /* 滚过第一屏后：导航「落地」为玻璃条，与下拉菜单同一材质 */
  .navigation.scrolled {
    --nav-fg: var(--foreground);
    --nav-hover: var(--grad-a);
    --nav-pill-bg: var(--glass-bg);
    --nav-pill-border: var(--glass-border);

    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(20px) saturate(200%);
    backdrop-filter: blur(20px) saturate(200%);
    border-bottom-color: var(--glass-border);
  }

  /* 非首页（无深色视频首屏）：导航常驻玻璃底，前景色始终可读 */
  .navigation--solid {
    --nav-fg: var(--foreground);
    --nav-hover: var(--grad-a);
    --nav-pill-bg: var(--glass-bg);
    --nav-pill-border: var(--glass-border);

    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(20px) saturate(200%);
    backdrop-filter: blur(20px) saturate(200%);
    border-bottom-color: var(--glass-border);
  }

  .nav-container {
    position: relative;
    max-width: 1200px;
    margin: 0 60px;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px;
    gap: 48px;
    transition: height 0.3s ease;
  }

  .navigation.scrolled .nav-container {
    height: 58px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 60px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-logo a {
    display: inline-flex;
    align-items: center;
    font-size: 20px;
    font-weight: bold;
    color: var(--nav-fg);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity 0.3s ease;
  }

  .logo-accent {
    background: linear-gradient(45deg, var(--grad-a), var(--grad-b));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nav-logo a:hover {
    opacity: 0.8;
  }

  .nav-menu {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 60px;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--nav-fg);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 0;
    transition: color 0.3s ease;
    display: block;
    letter-spacing: 0.01em;
    position: relative;
  }

  /* 7 周年入口：纪念金胶囊，不参与 scrollspy 下划线 */
  .nav-link--anniv {
    padding: 6px 14px;
    font-weight: 600;
    color: var(--seeker-blue, #0750a8);
    border: 1px solid rgba(7, 80, 168, 0.55);
    border-radius: 999px;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .nav-link--anniv::after {
    display: none;
  }

  .nav-link--anniv:hover {
    color: var(--seeker-blue, #0750a8);
    background: rgba(7, 80, 168, 0.08);
  }

  /* 渐变下划线：hover 滑入，scrollspy 当前区块常驻 */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--grad-a), var(--grad-b));
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--nav-fg);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--nav-hover);
  }

  .nav-link.active:hover,
  .nav-link.active:focus-visible {
    color: var(--nav-fg);
  }

  /* Focus ring for keyboard navigation */
  .nav-link:focus-visible {
    outline: 2px solid var(--nav-hover);
    outline-offset: 4px;
    border-radius: 4px;
  }

  }

  /* ============================================================
     MOBILE TOGGLE
     ============================================================ */
  .nav-toggle {
    display: none;
    flex-direction: column;
    cursor: pointer;
    padding: 5px;
    background: none;
    border: none;
    color: var(--nav-fg);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--nav-hover);
    outline-offset: 2px;
  }

  .bar {
    width: 25px;
    height: 2px;
    background: var(--nav-fg);
    margin: 4px 0;
    transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 2px;
  }

  /* ============================================================
     MOBILE RESPONSIVE
     ============================================================ */
  @media (max-width: 768px) {
    .navigation {
      top: 0;
      left: 0;
      width: 100%;
    }

    .nav-container {
      margin: 0;
      padding: 0 16px;
      justify-content: space-between;
      gap: 0;
      height: 52px;
    }

    .nav-menu {
      position: fixed;
      top: 64px;
      left: -100%;
      width: 100%;
      height: calc(100vh - 72px);

      /* Mobile glass panel */
      -webkit-backdrop-filter: blur(32px) saturate(180%);
      backdrop-filter: blur(32px) saturate(180%);
      background: var(--glass-bg);
      background-image:
        linear-gradient(
          180deg,
          oklch(1 0 0 / 0.04) 0%,
          transparent 30%
        );

      border: 1px solid var(--glass-border);
      border-radius: 14px;
      margin: 0 8px;

      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      padding-top: 24px;
      transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1001;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .nav-menu.active {
      left: 0;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }

    .nav-item {
      width: 100%;
      text-align: center;
    }

    /* 移动端菜单面板自带浅色底，链接固定用主题前景色 */
    .nav-link {
      padding: 16px 20px;
      border-bottom: 1px solid var(--glass-border);
      color: var(--foreground);
    }

    /* 移动端已有分隔线，下划线改为颜色高亮 */
    .nav-link::after {
      display: none;
    }

    .nav-link.active,
    .nav-link:hover {
      color: var(--grad-a);
    }


    .nav-toggle {
      display: flex;
    }

    .nav-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle.active .bar:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .nav-toggle.active .bar:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', () => {
    const navToggle = document.getElementById('nav-toggle');
    const navMenu = document.getElementById('nav-menu');

    if (navToggle && navMenu) {
      navToggle.addEventListener('click', () => {
        const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
        navMenu.classList.toggle('active');
        navToggle.classList.toggle('active');
        navToggle.setAttribute('aria-expanded', String(!isExpanded));
      });

      // Close menu when clicking on a link
      const navLinks = document.querySelectorAll('.nav-link');
      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          navMenu.classList.remove('active');
          navToggle.classList.remove('active');
          navToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });

  // 滚过第一屏 60% 后，导航切换为玻璃实底
  const navigation = document.querySelector('.navigation');
  const onScroll = () => {
    navigation?.classList.toggle('scrolled', window.scrollY > window.innerHeight * 0.6);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scrollspy：当前区块对应的导航项常驻高亮
  const spyLinks = document.querySelectorAll<HTMLElement>('.nav-link[data-section]');
  const linkById = new Map<string, HTMLElement>();
  spyLinks.forEach(link => {
    const id = link.dataset.section;
    if (id) {linkById.set(id, link);}
  });

  const spyTargets = Array.from(document.querySelectorAll<HTMLElement>('section[id]')).filter(
    section => linkById.has(section.id),
);

  if (spyTargets.length > 0 && 'IntersectionObserver' in window) {
    const setActive = (id: string | null) => {
      linkById.forEach((link, linkId) => {
        const isActive = linkId === id;
        link.classList.toggle('active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    // 记录每个目标是否处于视口中线带；都不在（如停在首屏）时清除全部高亮
    const visible = new Map<string, boolean>();

    const spy = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          visible.set(entry.target.id, entry.isIntersecting);
        }
        const current = [...visible.entries()].find(([, isIntersecting]) => isIntersecting);
        setActive(current ? current[0] : null);
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    spyTargets.forEach(target => spy.observe(target));
  }
</script>
