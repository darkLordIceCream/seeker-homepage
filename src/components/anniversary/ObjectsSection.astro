---
/**
 * 【06 留光成物 · ObjectsSection】七周年设计物。
 * 真实资产：PSD 导出的七周年纪念框模板（正/横版，水印工坊线上在用的同一套），
 * 以静物档案方式展示——「设计成为七周年故事的一部分」。
 * Logo 草稿 / 演变 / 周边实物：merchandise.json 就绪前显示占位（不伪造）。
 */
import AwaitNote from './AwaitNote.astro';
import merchandiseData from '../../data/anniversary/merchandise.json';

interface Merch {
  title: string;
  image: string;
  caption: string;
}

const data = merchandiseData as { published: boolean; merch: Merch[] };
const merch = data.published ? data.merch : [];
---

<div class="ob">
  <div class="ob-frames">
    <figure class="ob-frame">
      <img
        alt="七周年纪念框 · 竖版模板"         decoding="async"         height={1853}         loading="lazy"         src="/templates/seeker-7th-portrait.webp"         width={1042}
      />
      <figcaption>
        <span class="ob-cap-no">OBJ. 01</span>
        <span class="ob-cap-text">七周年纪念框 · 竖版 PORTRAIT 3:4</span>
      </figcaption>
    </figure>
    <figure class="ob-frame ob-frame--land">
      <img
        alt="七周年纪念框 · 横版模板"         decoding="async"         height={780}         loading="lazy"         src="/templates/seeker-7th-landscape.webp"         width={1250}
      />
      <figcaption>
        <span class="ob-cap-no">OBJ. 02</span>
        <span class="ob-cap-text">七周年纪念框 · 横版 LANDSCAPE 8:5</span>
      </figcaption>
    </figure>
  </div>
  <p class="ob-note">
    两张纪念框由七周年主视觉 PSD 逐层导出，正在水印工坊里为每一位成员的照片装框。
  </p>

  {
    merch.length > 0 ? (
      <div class="ob-merch">
        {merch.map(m => (
          <figure class="ob-frame">
            <img alt={m.title} decoding="async" loading="lazy" src={m.image} />
            <figcaption>
              <span class="ob-cap-text">{m.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <AwaitNote />
    )
  }
</div>

<style>
  .ob {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .ob-frames {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem;
  }

  .ob-frame {
    margin: 0;
    flex: 0 1 15rem;
  }

  .ob-frame--land {
    flex-basis: 20rem;
  }

  .ob-frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--anniv-border);
    background: var(--anniv-surface);
  }

  .ob-frame figcaption {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--anniv-border);
    margin-top: 0.55rem;
  }

  .ob-cap-no {
    font-family: 'Archivo', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    color: var(--anniv-accent);
    white-space: nowrap;
  }

  .ob-cap-text {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--anniv-muted);
  }

  .ob-note {
    margin: 0;
    max-width: 40em;
    font-size: 0.86rem;
    line-height: 1.9;
    color: var(--anniv-fg-secondary);
  }

  .ob-merch {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
</style>
