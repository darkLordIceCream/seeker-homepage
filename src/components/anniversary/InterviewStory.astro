---
/**
 * 【03 他们的声音 · InterviewStory】单人物采访——摄影杂志人物采访版式。
 * 大幅肖像（可缺省）+ 姓名/身份 + 介绍 + Q/A 正文；问题数量不写死，
 * 短/中/长采访均适配。portrait 缺省时用姓名字框占位。
 */
interface QA {
  question: string;
  answer: string;
}

interface Props {
  name: string;
  role: string;
  portrait?: string;
  intro?: string;
  interview: QA[];
}

const { name, role, portrait, intro, interview } = Astro.props;
---

<article class="iv">
  <div class="iv-side">
    <div class="iv-photo" data-reveal>
      {
        portrait ? (
          <img alt={`${name} 肖像`} decoding="async" loading="lazy" src={portrait} />
        ) : (
          <span aria-hidden="true" class="iv-photo-fallback">
            {name.slice(0, 1)}
          </span>
        )
      }
    </div>
    <p class="iv-name" data-reveal data-reveal-delay="90ms">{name}</p>
    <p class="iv-role" data-reveal data-reveal-delay="150ms">{role}</p>
    {intro && <p class="iv-intro" data-reveal data-reveal-delay="210ms">{intro}</p>}
  </div>
  <div class="iv-qa">
    {
      interview.map((item, i) => (
        <div class="iv-item" data-reveal data-reveal-delay={`${240 + i * 120}ms`}>
          <p class="iv-q">
            <span aria-hidden="true" class="iv-q-mark">Q</span>
            {item.question}
          </p>
          <p class="iv-a">
            <span aria-hidden="true" class="iv-a-mark">A</span>
            {item.answer}
          </p>
        </div>
      ))
    }
  </div>
</article>

<style>
  .iv {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.8rem, 4vw, 2.8rem) 0;
    border-top: 1px solid var(--anniv-border);
  }

  .iv-side {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .iv-photo {
    width: min(100%, 13rem);
    aspect-ratio: 3 / 4;
    margin-bottom: 0.8rem;
    background: var(--anniv-surface);
    border: 1px solid var(--anniv-border);
    overflow: hidden;
  }

  .iv-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .iv-photo-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--anniv-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--anniv-faint);
  }

  .iv-name {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--anniv-fg);
  }

  .iv-role {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    color: var(--anniv-accent);
  }

  .iv-intro {
    margin: 0.8rem 0 0;
    max-width: 32em;
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--anniv-muted);
  }

  .iv-qa {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .iv-item {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .iv-q {
    margin: 0;
    display: flex;
    gap: 0.7rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.8;
    color: var(--anniv-fg);
  }

  .iv-a {
    margin: 0;
    display: flex;
    gap: 0.7rem;
    font-size: 0.92rem;
    line-height: 2;
    color: var(--anniv-fg-secondary);
  }

  .iv-q-mark,
  .iv-a-mark {
    flex-shrink: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78em;
    font-weight: 700;
    line-height: 2.1;
    color: var(--anniv-accent);
  }

  @media (min-width: 56rem) {
    .iv {
      flex-direction: row;
      gap: 4rem;
    }

    .iv-side {
      flex: 1;
      max-width: 17rem;
    }

    .iv-qa {
      flex: 2;
    }
  }
</style>
