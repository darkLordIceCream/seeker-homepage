---
/**
 * 【04 追光印记 · ProjectTimeline】真实项目时间线。
 * 数据：构建期从 activities 集合按年分组 64 期《时间的故事》（期数标签、
 * 封面取当年最新一期真实封面），3 篇公益项目并入——全部真实数据，不伪造项目。
 * 版式：年份大字 + 编辑故事块；时间线深色呈光轨、浅色呈纸面墨线（纯令牌）。
 */
import { getCollection } from 'astro:content';

// 《时间的故事》64 期：按年份分组（期号前四位 = 年份），同年内按期数升序
const activities = (await getCollection('activities')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

interface IssueGroup {
  year: string;
  title: string;
  labels: string;
  count: number;
  cover: string;
  href: string;
}

const groups: IssueGroup[] = [...new Set(activities.map(i => String(i.data.order).slice(0, 4)))].map(
  year => {
    const issues = activities.filter(i => String(i.data.order).slice(0, 4) === year);
    const latest = issues[issues.length - 1];
    return {
      year,
      title: latest?.data.title ?? '时间的故事',
      labels: issues.map(i => i.data.issue).join(' · '),
      count: issues.length,
      cover: latest?.data.cover ?? '',
      href: '/activities/story-of-time/',
    };
  },
);

// 公益项目（真实内容集合）
const welfare = (await getCollection('welfare')).sort((a, b) => a.data.order - b.data.order);
---

<div class="pt">
  {
    groups.map(group => (
      <section class="pt-year">
        <p aria-hidden="true" class="pt-year-no">
          {group.year}
        </p>
        <div class="pt-item">
          <div class="pt-item-text">
            <p class="pt-item-title">
              {group.title}
              <span class="pt-item-count">{group.count} 期</span>
            </p>
            <p class="pt-item-meta">{group.labels}</p>
            <a class="pt-item-link" href={group.href}>
              阅读这一年 →
            </a>
          </div>
          {group.cover && (
            <img
              alt={`《${group.title}》${group.year} 年度封面`}               class="pt-item-cover"               decoding="async"               loading="lazy"               src={group.cover}
            />
          )}
        </div>
      </section>
    ))
  }

  <section class="pt-year">
    <p aria-hidden="true" class="pt-year-no">
      公益
    </p>
    <div class="pt-items">
      {
        welfare.map(w => (
          <div class="pt-item">
            <div class="pt-item-text">
              <p class="pt-item-title">{w.data.title}</p>
              <p class="pt-item-meta">{w.data.excerpt}</p>
              <a class="pt-item-link" href={`/welfare/${w.id}/`}>
                阅读项目 →
              </a>
            </div>
            <img
              alt={`SEEKER 公益 · ${w.data.title} 封面`}               class="pt-item-cover"               decoding="async"               loading="lazy"               src={w.data.cover}
            />
          </div>
        ))
      }
    </div>
  </section>
</div>

<style>
  .pt {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: 1.4rem;
  }

  /* 时间线：深色=光轨，浅色=墨线（同一令牌，主题自适应） */
  .pt::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      var(--anniv-accent) 8%,
      color-mix(in srgb, var(--anniv-accent) 35%, transparent) 50%,
      transparent
    );
  }

  .pt-year {
    padding: 1.8rem 0;
  }

  .pt-year + .pt-year {
    border-top: 1px solid var(--anniv-border);
  }

  .pt-year-no {
    margin: 0 0 0.9rem;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-faint);
    letter-spacing: 0.04em;
  }

  .pt-items {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .pt-item {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .pt-item-text {
    flex: 1;
    min-width: 0;
  }

  .pt-item-cover {
    display: block;
    width: min(100%, 20rem);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--anniv-border);
  }

  .pt-item-title {
    margin: 0 0 0.4rem;
    font-family: var(--anniv-serif);
    font-size: clamp(1.1rem, 2.6vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--anniv-fg);
  }

  .pt-item-count {
    margin-left: 0.6rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--anniv-accent);
  }

  .pt-item-meta {
    margin: 0 0 0.6rem;
    max-width: 44em;
    font-size: 0.84rem;
    line-height: 1.9;
    color: var(--anniv-muted);
  }

  .pt-item-link {
    display: inline-block;
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--anniv-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) ease;
  }

  .pt-item-link:hover {
    border-color: var(--anniv-accent);
  }

  @media (min-width: 48rem) {
    .pt-item {
      flex-direction: row;
      align-items: flex-start;
    }

    .pt-item-cover {
      width: 16rem;
      flex-shrink: 0;
    }
  }
</style>
