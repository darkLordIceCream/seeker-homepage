---
/**
 * 【06 留光成物 · PosterSlideshow】成员巨片走带（左图右文编辑排版）。
 * 左列 = 放映区，海报 contain 原比例展示（自带相框/水印/二维码，绝不裁切），
 * 占满左侧视口；右列 = 引言 + 署名/计数/进度线。
 * 照片的全部运动（入场左飘入、换帧左流、离场左飘出）都发生在左半区与
 * 屏幕左缘外——右侧文字天然不被经过（用户定稿布局）。
 * 交互：可直接抓住照片左右拖动（1:1 跟手），松手带惯性、轻微阻尼
 * 弹簧吸附到格；停留 2s 自动拨动一格——拨动与拖动共用同一套物理模型
 * （poster-slideshow.ts 的 rAF 循环写 [data-poster-track] 内槽位位移，
 * 无 CSS transition，杜绝「生硬」的机械过渡）。
 * 动效分工：滚动引擎（data-story-scene="posters"）只写 [data-poster-stage]——
 * 无 JS / reduced-motion：静态展示首帧与署名（渐进增强，与全页引擎一致）。
 * 首帧不用 loading="lazy"：sticky + overflow:hidden 舞台里 WebKit 懒加载不可靠。
 */
import { POSTERS } from '@/data/anniversary/posters';

const total = POSTERS.length;
const authors = new Set(POSTERS.map(p => p.author)).size;
const first = POSTERS[0];
const pad3 = (n: number): string => String(n).padStart(3, '0');
---

<div class="pss" data-poster-slideshow>
  <div class="pss-right">
    <div class="pss-stage" data-poster-stage>
      {/* 走带不设框：照片带向两侧延展，靠 track 的边缘渐隐 mask 产生
          「左右呼吸感」——右侧淡出区正好铺在文字列下方，照片到文字处
          已近乎透明，延展感与可读性两全 */}
      <div class="pss-track" data-poster-track>
        {
          first && (
            <img
              class="pss-img"
              data-poster-slot
              src={first.src}
              alt={`Seeker 七周年纪念海报 · @${first.author}`}
              width={first.w}
              height={first.h}
              fetchpriority="high"
              decoding="async"
              draggable="false"
            />
          )
        }
        <img class="pss-img" data-poster-slot alt="" aria-hidden="true" draggable="false" />
        <img class="pss-img" data-poster-slot alt="" aria-hidden="true" draggable="false" />
      </div>
    </div>
  </div>
  <div class="pss-side">
    <p class="pss-lead" data-poster-lead>
      过去两周，{authors} 位成员在暗房里把光装进了纪念框。<br />
      以下每一帧，都是一个人的七周年。
      <span class="pss-stay">✦ 请停驻欣赏 · 可左右拖动</span>
    </p>
    <div class="pss-cap" data-poster-cap>
      <span class="pss-no">
        <span data-poster-no>{first ? `NO.${pad3(first.no)}` : 'NO.000'}</span> / {total}
      </span>
      <span class="pss-author" data-poster-author>@{first?.author ?? ''}</span>
      <div class="pss-bar" aria-hidden="true">
        <i data-poster-bar style={`width: ${total > 0 ? ((1 / total) * 100).toFixed(2) : 0}%`}></i>
      </div>
    </div>
  </div>
</div>

<style>
  .pss {
    display: grid;
    /* 放映区在左、文字在右：照片的全部运动（入场/换帧/离场）都发生在
       左半区与屏幕左缘外，右侧文字天然不被经过（用户定稿布局） */
    grid-template-columns: 1fr minmax(18rem, 31%);
    gap: clamp(1.6rem, 3.5vw, 4rem);
    align-items: center;
    width: 100%;
  }

  .pss-side {
    display: flex;
    flex-direction: column;
    gap: clamp(1.2rem, 2.4vw, 2rem);
    position: relative;
    z-index: 3;
  }

  .pss-lead {
    margin: 0;
    font-size: clamp(0.84rem, 1.35vw, 1rem);
    line-height: 1.95;
    letter-spacing: 0.05em;
    color: var(--anniv-muted);
  }

  .pss-stay {
    display: block;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--anniv-fg);
  }

  .pss-stay::first-letter {
    color: var(--anniv-accent);
  }

  .pss-cap {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: clamp(0.6rem, 2vh, 1.6rem);
  }

  .pss-no {
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    color: var(--anniv-muted);
    transition: opacity 0.18s ease;
  }

  .pss-author {
    font-size: clamp(1.05rem, 1.8vw, 1.4rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--anniv-fg);
    transition: opacity 0.18s ease;
  }

  .pss-cap.is-swap .pss-no,
  .pss-cap.is-swap .pss-author {
    opacity: 0;
  }

  .pss-bar {
    width: min(100%, 12rem);
    height: 2px;
    overflow: hidden;
    background: var(--anniv-border);
  }

  .pss-bar i {
    display: block;
    height: 100%;
    background: var(--anniv-accent);
    transition: width 0.8s ease;
  }

  /* 放映区：占满右列（滚动引擎写 stage 外层，走带物理引擎写 track 内槽位）；
     */
  .pss-right {
    position: relative;
    z-index: 1;
    height: min(78vh, 50rem);
  }

  .pss-stage {
    position: absolute;
    inset: 0;
  }

  /* 走带轨道：无遮罩无裁切，照片自然延展（496c632 手感）；文字列在
     右侧且 z 在上层，照片即使延展到其下方也不影响阅读 */
  .pss-track {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .pss-track.is-grabbing {
    cursor: grabbing;
  }

  .pss-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    will-change: transform;
    pointer-events: none;
    /* 3D 纵深：偏离中心的帧由物理引擎写 --pss-dim（1 → 0.6），
       亮度随偏移降低 = 往后退；drop-shadow 留在 CSS 与主题联动 */
    filter: drop-shadow(0 18px 60px rgba(2, 8, 20, 0.6)) brightness(var(--pss-dim, 1));
  }

  :global([data-theme='light']) .pss-img {
    filter: drop-shadow(0 14px 44px rgba(20, 40, 61, 0.3));
  }

  @media (max-width: 48rem) {
    .pss {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      align-items: start;
    }

    /* 移动端单列：文字保持在放映区上方（与桌面左右关系的阅读顺序一致） */
    .pss-side {
      order: -1;
    }

    .pss-right {
      height: min(44vh, 26rem);
    }

    .pss-lead br {
      display: none;
    }
  }
</style>

<script>
  // 走带引擎懒加载：接近板块才载入拖拽/物理逻辑；reduced-motion 保持静态首帧
  const root = document.querySelector('[data-poster-slideshow]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      entries => {
        if (entries.some(e => e.isIntersecting)) {
          io.disconnect();
          import('../../lib/anniversary/poster-slideshow').then(m => m.initPosterSlideshow());
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(root);
  }
</script>
