---
/**
 * 【SEEKER 07 · 章节眉题】编号 / 04 + 中文名大字（衬线）+ 英文辅助小字。
 * 规范 #83：大号中文标题为主，英文只是辅助视觉语言。
 */
interface Props {
  /** 章节号，如 '01' */
  no: string;
  /** 中文章节名（主标题） */
  zh: string;
  /** 英文辅助题（小字） */
  en: string;
}

const { no, zh, en } = Astro.props;
---

<div class="ash">
  <span aria-hidden="true" class="ash-meta">{no} / 04</span>
  <h2 class="ash-zh">{zh}</h2>
  <span class="ash-en">{en}</span>
</div>

<style>
  .ash {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: clamp(2.2rem, 5vw, 3.6rem);
  }

  .ash-meta {
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--anniv-accent);
  }

  .ash-zh {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.9rem, 5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.25;
    color: var(--anniv-fg);
  }

  .ash-en {
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.4em;
    color: var(--anniv-muted);
  }
</style>
