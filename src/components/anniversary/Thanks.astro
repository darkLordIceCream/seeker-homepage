---
/**
 * 【WITH THANKS · Thanks】七周年项目组鸣谢。
 * 数据：src/data/anniversary/thanks.json（published=false 时渲染占位——
 * 名单未确认前不虚构任何姓名）。
 */
import AwaitNote from './AwaitNote.astro';
import thanksData from '../../data/anniversary/thanks.json';

interface ThanksData {
  published: boolean;
  project: string;
  groups: { role: string; people: string[] }[];
}

const data = thanksData as ThanksData;
const published = data.published === true;
const groups = published ? data.groups.filter(g => g.people.length > 0) : [];
---

<div class="th">
  {
    groups.length > 0 ? (
      <div class="th-groups">
        {groups.map(g => (
          <div class="th-group">
            <p class="th-role">{g.role}</p>
            <p class="th-people">{g.people.join('　')}</p>
          </div>
        ))}
      </div>
    ) : (
      <AwaitNote />
    )
  }
</div>

<style>
  .th {
    width: min(100%, 34rem);
  }

  .th-groups {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .th-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .th-role {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--anniv-accent);
  }

  .th-people {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: 0.98rem;
    letter-spacing: 0.12em;
    line-height: 1.9;
    color: var(--anniv-fg-secondary);
  }
</style>
