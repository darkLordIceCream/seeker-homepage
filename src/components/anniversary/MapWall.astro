---
/**
 * 【SEEKER 07 · WHERE WE ARE】成员分布地图 · MapLibre GL 版。
 *
 * 视觉：黑暗中的光点——深黑底 + 深灰陆地 + 低对比边界 + 亮成员辉光（circle+glow，
 * 半径随 memberCount 数据驱动）。无传统地图配色、无 Pin。
 * 交互：cooperativeGestures（普通滚动穿透页面，Ctrl/⌘+滚轮缩放）+ +/- 控件；
 * Hover 高亮 + tooltip（GUANGDONG / 87 SEEKERS）；点击中国区域 FlyTo 下钻省级视野，
 * Back to World 飞回世界。进入时光点渐亮（reduced-motion 直接显示）。
 * 数据：public/geo/anniv-world.json（构建脚本注入 nameZh/memberCount，
 * 与 map-points.ts 同源）；懒加载 maplibre-gl（仅本页）。
 */
import 'maplibre-gl/dist/maplibre-gl.css';
---

<div class="ww" data-where-we-are>
  <div class="ww-frame">
    <div class="ww-map" id="ww-map"></div>
    <div aria-hidden="true" class="ww-skeleton" data-skeleton>
      <span class="ww-skeleton-hint">WHERE WE ARE…</span>
    </div>
    <button class="ww-back" hidden id="ww-back" type="button">← BACK TO WORLD</button>
    <div class="ww-tip" hidden id="ww-tip"></div>
  </div>
  <p class="ww-caption">拖动查看 · Ctrl/⌘ + 滚轮缩放 · 点击中国进入省域视野</p>
</div>

<style>
  .ww {
    width: 100%;
  }

  .ww-frame {
    position: relative;
    width: 100%;
    height: clamp(460px, 82vh, 860px);
    border: 1px solid var(--anniv-border);
    background: #060607;
    overflow: hidden;
  }

  .ww-map {
    position: absolute;
    inset: 0;
  }

  :global(.ww-frame .maplibregl-ctrl-group) {
    background: rgba(14, 14, 17, 0.9);
    border: 1px solid var(--anniv-border);
    border-radius: 0;
  }

  :global(.ww-frame .maplibregl-ctrl-group button) {
    background: transparent;
  }

  :global(.ww-frame .maplibregl-ctrl-group button:hover) {
    background: rgba(242, 240, 235, 0.08);
  }

  :global(.ww-frame .maplibregl-ctrl-group button + button) {
    border-top: 1px solid var(--anniv-border);
  }

  :global(.ww-frame .maplibregl-ctrl-group button span) {
    filter: invert(0.92);
  }

  .ww-skeleton {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #060607;
    z-index: 2;
    transition: opacity var(--dur-normal) ease;
  }

  .ww-skeleton-hint {
    font-family: 'Archivo', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: var(--anniv-faint);
    animation: ww-pulse 1.4s ease-in-out infinite;
  }

  @keyframes ww-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ww-skeleton-hint {
      animation: none;
    }
  }

  .ww-back {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 3;
    padding: 0.55rem 1rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--anniv-fg);
    background: rgba(14, 14, 17, 0.88);
    border: 1px solid var(--anniv-border);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease;
  }

  .ww-back:hover {
    border-color: var(--anniv-accent);
  }

  .ww-tip {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    padding: 0.45rem 0.8rem;
    background: rgba(14, 14, 17, 0.94);
    border: 1px solid var(--anniv-accent);
    color: var(--anniv-fg);
    font-family: 'Archivo', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .ww-tip .ww-tip-count {
    color: var(--anniv-accent);
    margin-left: 0.6em;
  }

  .ww-caption {
    margin: 0.8rem 0.25rem 0;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    color: var(--anniv-muted);
    text-align: center;
  }
</style>

<script>
  /* MapLibre 初始化：懒加载 + 黑暗光点图层 + hover/click/flyTo。 */
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GOLD = '#e8c766';

  function el<T extends HTMLElement>(id: string): T {
    const node = document.getElementById(id);
    if (!node) {
      throw new Error(`缺少元素 #${id}`);
    }
    return node as T;
  }

  const mapContainer = el<HTMLDivElement>('ww-map');
  const skeleton = document.querySelector('[data-skeleton]') as HTMLElement | null;
  const backBtn = el<HTMLButtonElement>('ww-back');
  const tip = el<HTMLDivElement>('ww-tip');

  async function initMap(): Promise<void> {
    const [maplibregl, geo] = await Promise.all([
      import('maplibre-gl'),
      fetch('/geo/anniv-world.json').then(r => {
        if (!r.ok) {
          throw new Error(`地图数据加载失败：HTTP ${r.status}`);
        }
        return r.json();
      }),
    ]);

    const map = new maplibregl.Map({
      container: mapContainer,
      // 内联 style：无外部瓦片服务，GeoJSON 单文件为唯一数据源
      style: {
        version: 8,
        sources: {
          anniv: {
            type: 'geojson',
            data: geo,
            generateId: true,
          },
        },
        layers: [
          { id: 'bg', type: 'background', paint: { 'background-color': '#060607' } },
          {
            id: 'region-fill',
            type: 'fill',
            source: 'anniv',
            paint: {
              'fill-color': [
                'case',
                ['==', ['feature-state', 'hover'], true],
                '#33322f',
                [
                  'interpolate',
                  ['linear'],
                  ['get', 'memberCount'],
                  0,
                  '#141419',
                  10,
                  '#232017',
                  88,
                  '#4a3d1c',
                ],
              ],
              'fill-opacity': 1,
            },
          },
          {
            id: 'region-border',
            type: 'line',
            source: 'anniv',
            paint: {
              'line-color': [
                'case',
                ['==', ['feature-state', 'hover'], true],
                GOLD,
                'rgba(242, 240, 235, 0.14)',
              ],
              'line-width': ['case', ['==', ['feature-state', 'hover'], true], 1.4, 0.6],
            },
          },
          {
            id: 'member-glow',
            type: 'circle',
            source: 'anniv',
            filter: ['>', ['get', 'memberCount'], 0],
            paint: {
              'circle-color': GOLD,
              'circle-opacity': 0.16,
              'circle-blur': 1,
              'circle-radius': [
                'interpolate',
                ['linear'],
                ['get', 'memberCount'],
                1,
                10,
                14,
                16,
                88,
                26,
              ],
            },
          },
          {
            id: 'member-point',
            type: 'circle',
            source: 'anniv',
            filter: ['>', ['get', 'memberCount'], 0],
            paint: {
              'circle-color': '#f5e2a8',
              'circle-opacity': 0.95,
              'circle-radius': [
                'interpolate',
                ['linear'],
                ['get', 'memberCount'],
                1,
                2.6,
                14,
                4.4,
                88,
                7,
              ],
              'circle-stroke-width': 0.6,
              'circle-stroke-color': 'rgba(6, 6, 7, 0.8)',
            },
          },
        ],
      },
      center: [30, 26],
      zoom: 1.15,
      minZoom: 0.8,
      maxZoom: 7,
      cooperativeGestures: true,
      attributionControl: false,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');
    map.on('error', e => {
      console.warn('[ww-map]', e.error?.message ?? e.error);
    });

    const hovered: { id?: number | string } = { id: undefined };

    map.on('mousemove', 'region-fill', e => {
      map.getCanvas().style.cursor = 'pointer';
      const f = e.features?.[0];
      if (!f) {
        return;
      }
      if (hovered.id !== undefined) {
        map.setFeatureState({ source: 'anniv', id: hovered.id }, { hover: false });
      }
      hovered.id = f.id;
      if (hovered.id !== undefined) {
        map.setFeatureState({ source: 'anniv', id: hovered.id }, { hover: true });
      }
      const zh = (f.properties as { nameZh?: string; memberCount?: number }).nameZh;
      const count = (f.properties as { memberCount?: number }).memberCount ?? 0;
      const name = zh ?? (f.properties as { name?: string }).name ?? '';
      tip.innerHTML = `${(name as string).toUpperCase()}<span class="ww-tip-count">${count} SEEKERS</span>`;
      tip.hidden = false;
    });

    map.on('mouseleave', 'region-fill', () => {
      map.getCanvas().style.cursor = '';
      tip.hidden = true;
      if (hovered.id !== undefined) {
        map.setFeatureState({ source: 'anniv', id: hovered.id }, { hover: false });
        hovered.id = undefined;
      }
    });

    map.on('mousemove', e => {
      if (tip.hidden) {
        return;
      }
      tip.style.left = `${e.point.x + 14}px`;
      tip.style.top = `${e.point.y + 12}px`;
    });

    // 点击中国省级区域 → FlyTo 中国视野；其他区域有成员时轻聚焦
    map.on('click', 'region-fill', e => {
      const f = e.features?.[0];
      if (!f) {
        return;
      }
      const nameZh = (f.properties as { nameZh?: string }).nameZh ?? '';
      if (nameZh.endsWith('省') || nameZh.endsWith('市') || nameZh.includes('自治区') || nameZh.includes('特别行政区')) {
        map.flyTo({ center: [104.5, 35.5], zoom: 3.6, duration: REDUCED ? 0 : 1600, essential: true });
        backBtn.hidden = false;
      }
    });

    backBtn.addEventListener('click', () => {
      map.flyTo({ center: [30, 26], zoom: 1.15, duration: REDUCED ? 0 : 1600, essential: true });
      backBtn.hidden = true;
    });

    map.on('load', () => {
      if (skeleton) {
        skeleton.style.opacity = '0';
        window.setTimeout(() => {
          skeleton.style.display = 'none';
        }, 350);
      }
      // 光点渐亮入场（~0.9s；reduced-motion 直接显示）
      if (REDUCED) {
        return;
      }
      const t0 = performance.now();
      const DUR = 900;
      const tick = (now: number) => {
        const t = Math.min((now - t0) / DUR, 1);
        map.setPaintProperty('member-glow', 'circle-opacity', 0.16 * t);
        map.setPaintProperty('member-point', 'circle-opacity', 0.95 * t);
        if (t < 1) {
          requestAnimationFrame(tick);
        }
      };
      map.setPaintProperty('member-glow', 'circle-opacity', 0);
      map.setPaintProperty('member-point', 'circle-opacity', 0);
      requestAnimationFrame(tick);
    });
  }

  const start = () => {
    initMap().catch(() => {
      const hint = skeleton?.querySelector('.ww-skeleton-hint');
      if (hint) {
        hint.textContent = '地图加载失败，请刷新重试';
      }
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
