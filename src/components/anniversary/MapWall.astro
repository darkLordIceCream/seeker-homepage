---
/**
 * 【七周年 · 地图墙】成员分布可视化 · ECharts 版。
 *
 * 交互（画布优先）：两块全宽地图（世界 / 中国），暗色底 + 金色 choropleth +
 * effectScatter 涟漪标记，tooltip 显示地区与人数，滚轮/拖拽缩放漫游。
 * 客户端懒加载 ECharts（仅本页引入），GeoJSON 运行时 fetch 自 public/geo/。
 * 数据：src/data/anniversary/map-points.ts（当前为占位数据，见该文件头注释）。
 */
---

<div class="map-wall" data-map-wall>
  <section aria-label="海外成员分布" class="map-block">
    <div class="map-frame">
      <div class="map-chart" id="map-world"></div>
      <div aria-hidden="true" class="map-skeleton" data-skeleton="world">
        <span class="map-skeleton-hint">地图加载中…</span>
      </div>
    </div>
    <p class="map-caption">海外 · 精确到国家 · 拖动或滚轮缩放漫游</p>
  </section>

  <section aria-label="国内成员分布" class="map-block">
    <div class="map-frame">
      <div class="map-chart" id="map-china"></div>
      <div aria-hidden="true" class="map-skeleton" data-skeleton="china">
        <span class="map-skeleton-hint">地图加载中…</span>
      </div>
    </div>
    <p class="map-caption">国内 · 精确到省 · 拖动或滚轮缩放漫游</p>
  </section>
</div>

<style>
  .map-wall {
    display: grid;
    gap: 2.5rem;
    max-width: 100vw;
  }

  .map-block {
    margin: 0;
  }

  .map-frame {
    position: relative;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .map-chart {
    width: 100%;
    height: clamp(420px, 78vh, 820px);
  }

  .map-skeleton {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      110deg,
      rgba(255, 255, 255, 0.02) 30%,
      rgba(255, 255, 255, 0.06) 50%,
      rgba(255, 255, 255, 0.02) 70%
    );
    background-size: 220% 100%;
    animation: map-shimmer 1.4s ease-in-out infinite;
  }

  @keyframes map-shimmer {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -120% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-skeleton {
      animation: none;
    }
  }

  .map-skeleton-hint {
    font-size: 0.85rem;
    color: rgba(250, 250, 250, 0.45);
    letter-spacing: 0.2em;
  }

  .map-caption {
    margin: 0.75rem 0.25rem 0;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    color: rgba(250, 250, 250, 0.55);
  }

  @media (min-width: 60rem) {
    .map-wall {
      gap: 3rem;
    }
  }
</style>

<script>
  /* 地图墙初始化：ECharts 按需懒加载（仅本页引入）。
     视觉：暗底白线国界 + 金色 choropleth（成员数深浅）+ effectScatter 涟漪；
     prefers-reduced-motion 时涟漪退化为静态标记。 */
  import { COUNTRY_POINTS, PROVINCE_POINTS } from '../../data/anniversary/map-points';

  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GOLD = '#f5c542';

  function el<T extends HTMLElement>(id: string): T {
    const node = document.getElementById(id);
    if (!node) {
      throw new Error(`缺少元素 #${id}`);
    }
    return node as T;
  }

  function skeleton(which: string, visible: boolean): void {
    const el = document.querySelector(`[data-skeleton="${which}"]`);
    if (el) {
      (el as HTMLElement).style.display = visible ? 'flex' : 'none';
    }
  }

  function baseTooltip(): Record<string, unknown> {
    return {
      trigger: 'item',
      backgroundColor: 'rgba(26, 26, 31, 0.96)',
      borderColor: 'rgba(245, 197, 66, 0.45)',
      borderWidth: 1,
      padding: [8, 12],
      textStyle: { color: '#fafafa', fontSize: 12 },
      formatter: (params: { seriesType?: string; name?: string; value?: unknown }) => {
        if (params.seriesType === 'effectScatter') {
          const v = params.value as [number, number, number];
          return `${params.name} · ${v[2]} 位成员`;
        }
        return params.name ?? '';
      },
    };
  }

  async function initMaps(): Promise<void> {
    const [echartsCore, charts, components, renderers, worldJson, chinaJson] = await Promise.all([
      import('echarts/core'),
      import('echarts/charts'),
      import('echarts/components'),
      import('echarts/renderers'),
      fetch('/geo/world-countries.json').then((r) => r.json()),
      fetch('/geo/china-provinces.json').then((r) => r.json()),
    ]);
    echartsCore.use([
      charts.MapChart,
      charts.EffectScatterChart,
      components.GeoComponent,
      components.TooltipComponent,
      components.VisualMapComponent,
      renderers.CanvasRenderer,
    ]);
    // 过滤南极洲：其多边形沿 180° 经线闭合，线性投影下会画出横贯全图的线
    worldJson.features = worldJson.features.filter(
      (f: { properties?: { name?: string } }) => f.properties?.name !== 'Antarctica',
    );
    echartsCore.registerMap('anniv-world', worldJson);
    echartsCore.registerMap('anniv-china', chinaJson);

    const rippleType = REDUCED_MOTION ? 'scatter' : 'effectScatter';

    /* ---- 世界：国家 choropleth + 成员涟漪 ---- */
    const worldChart = echartsCore.init(el<HTMLDivElement>('map-world'));
    worldChart.setOption({
      backgroundColor: 'transparent',
      tooltip: baseTooltip(),
      geo: {
        map: 'anniv-world',
        roam: true,
        zoom: 1,
        scaleLimit: { min: 1, max: 8 },
        itemStyle: {
          areaColor: 'rgba(255, 255, 255, 0.045)',
          borderColor: 'rgba(255, 255, 255, 0.14)',
          borderWidth: 0.6,
        },
        emphasis: {
          itemStyle: { areaColor: 'rgba(245, 197, 66, 0.22)' },
          label: { show: false },
        },
        select: { itemStyle: { areaColor: 'rgba(245, 197, 66, 0.22)' }, label: { show: false } },
        label: { show: false },
      },
      visualMap: {
        type: 'continuous',
        min: 1,
        max: Math.max(...COUNTRY_POINTS.map((c) => c.count)),
        seriesIndex: 0,
        show: false,
        inRange: { color: ['rgba(245, 197, 66, 0.18)', 'rgba(245, 197, 66, 0.55)'] },
      },
      series: [
        {
          type: 'map',
          map: 'anniv-world',
          geoIndex: 0,
          data: COUNTRY_POINTS.filter((c) => c.worldName).map((c) => ({
            name: c.worldName,
            value: c.count,
          })),
        },
        {
          type: rippleType,
          coordinateSystem: 'geo',
          geoIndex: 0,
          itemStyle: { color: GOLD },
          emphasis: { scale: 1.15 },
          data: COUNTRY_POINTS.map((c) => ({
            name: c.name,
            value: [...(c.lngLat ?? [0, 0]), c.count],
          })),
          symbolSize: (val: number[]) => 4 + Math.sqrt((val[2] as number) ?? 1) * 1.7,
          rippleEffect: { brushType: 'stroke', scale: 2.6, period: 4.2 },
          label: { show: false },
        },
      ],
    });
    skeleton('world', false);

    /* ---- 中国：省域 choropleth ---- */
    const chinaChart = echartsCore.init(el<HTMLDivElement>('map-china'));
    chinaChart.setOption({
      backgroundColor: 'transparent',
      tooltip: baseTooltip(),
      visualMap: {
        type: 'continuous',
        min: 1,
        max: Math.max(...PROVINCE_POINTS.map((p) => p.count)),
        calculable: false,
        orient: 'horizontal',
        left: 'center',
        bottom: 6,
        itemWidth: 12,
        itemHeight: 60,
        text: ['人多', '人少'],
        textStyle: { color: 'rgba(250, 250, 250, 0.65)', fontSize: 11 },
        inRange: { color: ['rgba(245, 197, 66, 0.14)', 'rgba(245, 197, 66, 0.5)', '#f5c542'] },
      },
      series: [
        {
          type: 'map',
          map: 'anniv-china',
          roam: true,
          zoom: 1,
          scaleLimit: { min: 1, max: 8 },
          data: PROVINCE_POINTS.map((p) => ({ name: p.name, value: p.count })),
          itemStyle: {
            areaColor: 'rgba(255, 255, 255, 0.04)',
            borderColor: 'rgba(255, 255, 255, 0.16)',
            borderWidth: 0.6,
          },
          emphasis: {
            itemStyle: { areaColor: 'rgba(245, 197, 66, 0.28)' },
            label: { color: '#fafafa' },
          },
          select: { disabled: true },
          label: { show: false },
        },
      ],
    });
    skeleton('china', false);

    const onResize = () => {
      worldChart.resize();
      chinaChart.resize();
    };
    window.addEventListener('resize', onResize);
  }

  const start = () => {
    initMaps().catch(() => {
      skeleton('world', true);
      skeleton('china', true);
      const hint = document.querySelector('[data-skeleton="world"] .map-skeleton-hint');
      if (hint) {
        hint.textContent = '地图加载失败，请刷新重试';
      }
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
