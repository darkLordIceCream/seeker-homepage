---
/**
 * 【03 同行之路 · SharedRoad】品牌合作卡片墙——13 张卡片一屏两行（上 6 下 7）。
 * 卡片品牌名前带 @；滚动视觉：卡片 data-reveal 依次浮现（上排先、下排后，
 * 行内错峰）+ 两行随上下滑动做轻微反向视差（road 工厂 view 模式驱动）。
 * hover 放大镜：内层内容以鼠标位置为原点轻微放大（transform-origin 跟随），
 * 配合镜片高光叠加层；移出恢复。无 JS / reduced-motion：全部直接可见。
 * 文案照录用户提供原文；数据：src/data/anniversary/partners.json。
 */
import partnersData from '../../data/anniversary/partners.json';

interface Partner {
  name: string;
  slug: string;
  kind: 'brand' | 'platform';
  title?: string;
  blurb: string;
}

const data = partnersData as { published: boolean; partners: Partner[] };
const partners = data.published ? data.partners : [];
const ROW_A = partners.slice(0, 6);
const ROW_B = partners.slice(6, 13);
---

<div class="sr">
  <div class="sr-row" data-road-row="top">
    {
      ROW_A.map((p, i) => (
        <article class="sr-card" data-reveal data-reveal-delay={`${i * 0.07}s`}>
          <div class="sr-card-inner">
            <p class="sr-card-brand">
              <span aria-hidden="true" class="sr-at">
                @
              </span>
              {p.name}
              {p.kind === 'platform' && <span class="sr-card-tag">合作平台</span>}
            </p>
            {p.title && <p class="sr-card-title">{p.title}</p>}
            <p class="sr-card-blurb">{p.blurb}</p>
          </div>
        </article>
      ))
    }
  </div>
  <div class="sr-row" data-road-row="bottom">
    {
      ROW_B.map((p, i) => (
        <article class="sr-card" data-reveal data-reveal-delay={`${0.12 + i * 0.06}s`}>
          <div class="sr-card-inner">
            <p class="sr-card-brand">
              <span aria-hidden="true" class="sr-at">
                @
              </span>
              {p.name}
              {p.kind === 'platform' && <span class="sr-card-tag">合作平台</span>}
            </p>
            {p.title && <p class="sr-card-title">{p.title}</p>}
            <p class="sr-card-blurb">{p.blurb}</p>
          </div>
        </article>
      ))
    }
  </div>
  <p class="sr-fineprint" data-reveal>以上排名不分先后。</p>
</div>

<script>
  // 悬浮弹窗卡：悬停时克隆卡片内容为浮层（完整文案、放大展示），叠加在其他
  // 卡片之上；浮层定位在原卡上方（顶部行则向下弹），不推动任何布局；移出即销毁。
  // 无第三方依赖；触屏（hover:none）不触发，手机端维持单列完整阅读。
  const wall = document.querySelector<HTMLElement>('.sr');
  if (wall && window.matchMedia('(hover: hover)').matches) {
    const POPUP_W = 360; // 浮层宽（与 CSS .sr-popup 同步）
    let popup: HTMLElement | null = null;

    const removePopup = () => {
      popup?.remove();
      popup = null;
    };

    wall.querySelectorAll<HTMLElement>('.sr-card').forEach(card => {
      card.addEventListener('mouseenter', () => {
        removePopup();
        const r = card.getBoundingClientRect();
        const pop = document.createElement('div');
        pop.className = 'sr-popup';
        const inner = card.querySelector('.sr-card-inner');
        if (inner) {
          pop.append(inner.cloneNode(true));
        }
        pop.style.width = `${POPUP_W}px`;
        // 水平：优先与原卡左对齐，右溢出则右对齐原卡右缘，再兜底夹回视口
        let { left } = r;
        if (left + POPUP_W > window.innerWidth - 12) {
          left = r.right - POPUP_W;
        }
        left = Math.max(12, Math.min(left, window.innerWidth - POPUP_W - 12));
        // 垂直：上排卡片向上弹，下排向下弹（哪边空间够用哪边）
        const openUp = r.top > window.innerHeight * 0.45;
        pop.style.left = `${left}px`;
        pop.style.top = openUp ? 'auto' : `${r.bottom + 10}px`;
        if (openUp) {
          pop.style.bottom = `${window.innerHeight - r.top + 10}px`;
        }
        document.body.append(pop);
        // 下一帧加可见类，触发淡入上浮过渡
        requestAnimationFrame(() => {
          pop.classList.add('is-open');
        });
        popup = pop;
      });
      card.addEventListener('mouseleave', removePopup);
    });
    window.addEventListener('scroll', removePopup, { passive: true });
  }
</script>

<style>
  .sr {
    width: 100%;
  }

  /* —— 两行网格：上 6 列 / 下 7 列 —— */
  .sr-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.4vw, 1.2rem);
  }

  .sr-row + .sr-row {
    margin-top: clamp(0.8rem, 1.4vw, 1.2rem);
  }

  .sr-row[data-road-row='bottom'] {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  /* —— 品牌卡：纯文字小卡（无图片）；overflow 裁切放大溢出（放大镜看局部） —— */
  .sr-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--anniv-border);
    background: color-mix(in srgb, var(--anniv-surface) 55%, transparent);
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      box-shadow var(--dur-normal) var(--ease-enter);
  }

  .sr-card:hover {
    border-color: var(--anniv-accent);
    box-shadow: 0 0 24px rgba(46, 134, 222, 0.18);
  }

  .sr-card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(0.9rem, 1.6vw, 1.25rem) clamp(0.85rem, 1.5vw, 1.15rem);
  }

  .sr-card:hover {
    background: color-mix(in srgb, var(--anniv-surface) 88%, transparent);
  }

  .sr-card-brand {
    margin: 0 0 0.3rem;
    font-family: var(--anniv-serif);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--anniv-fg);
  }

  .sr-at {
    margin-right: 0.14em;
    color: var(--anniv-accent);
  }

  .sr-card-tag {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.12rem 0.45rem;
    vertical-align: 0.12em;
    font-family: 'Archivo', sans-serif;
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    color: var(--anniv-accent);
    border: 1px solid var(--anniv-border-strong);
    border-radius: 999px;
    white-space: nowrap;
  }

  .sr-card-title {
    margin: 0 0 0.4rem;
    font-family: var(--anniv-serif);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--anniv-accent);
  }

  .sr-card-blurb {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.8;
    letter-spacing: 0.02em;
    text-align: justify;
    color: var(--anniv-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }


  /* —— 悬浮弹窗卡：完整文案、放大展示，叠加在其他卡片之上 ——
     （JS 动态创建的元素不带 Astro scope 哈希，须 :global 命中） */
  :global(.sr-popup) {
    position: fixed;
    z-index: 60;
    max-height: min(60vh, 520px);
    overflow: auto;
    padding: clamp(1.2rem, 2vw, 1.6rem) clamp(1.1rem, 2vw, 1.5rem);
    border: 1px solid var(--anniv-accent);
    background: color-mix(in srgb, var(--anniv-bg) 94%, #061a30);
    box-shadow:
      0 18px 50px rgba(4, 16, 30, 0.6),
      0 0 30px rgba(46, 134, 222, 0.16);
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transition:
      opacity 0.22s ease,
      transform 0.22s var(--ease-enter);
    pointer-events: none;
  }

  :global(.sr-popup.is-open) {
    opacity: 1;
    transform: none;
  }

  :global(.sr-popup) .sr-card-inner {
    padding: 0;
  }

  :global(.sr-popup) .sr-card-brand {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  :global(.sr-popup) .sr-card-title {
    font-size: 0.95rem;
  }

  :global(.sr-popup) .sr-card-blurb {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
    font-size: 0.9rem;
    line-height: 2;
    color: var(--anniv-fg-secondary);
  }

  .sr-fineprint {
    margin: clamp(1.4rem, 2.5vw, 2.2rem) 0 0;
    font-family: var(--anniv-serif);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-align: center;
    color: var(--anniv-muted);
  }

  @media (max-width: 64rem) {
    .sr-row,
    .sr-row[data-road-row='bottom'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sr-card-blurb {
      -webkit-line-clamp: 6;
    }
  }

  @media (max-width: 48rem) {
    /* 手机：单列正常滚动浏览（触屏无 hover，放大镜不生效） */
    .sr-row,
    .sr-row[data-road-row='bottom'] {
      grid-template-columns: 1fr;
    }

    .sr-card {
      padding: 1.1rem 1rem;
    }

    .sr-card-brand {
      font-size: 1.15rem;
    }

    .sr-card-blurb {
      -webkit-line-clamp: unset;
      overflow: visible;
      font-size: 0.88rem;
      line-height: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sr-card {
      transition: none;
    }

    .sr-card-inner {
      transform: none;
      transition: none;
    }
  }
</style>
