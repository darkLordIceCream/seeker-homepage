---
/**
 * 【03 同行之路 · SharedRoad】品牌合作卡片墙——13 张卡片一屏两行（上 6 下 7）。
 * 滚动视觉：卡片 data-reveal 依次浮现（上排先、下排后，行内错峰）；两行随
 * 上下滑动做轻微反向视差（road 工厂 view 模式驱动行容器 transform，transform-only）。
 * hover：卡片上浮点亮、完整合作文案展开（默认截断约 5 行）。
 * 无 JS / reduced-motion：reveal 与视差不生效，卡片直接完整可见（渐进增强契约）。
 * 文案照录用户提供原文；数据：src/data/anniversary/partners.json。
 */
import partnersData from '../../data/anniversary/partners.json';

interface Partner {
  name: string;
  slug: string;
  kind: 'brand' | 'platform';
  title?: string;
  blurb: string;
}

const data = partnersData as { published: boolean; partners: Partner[] };
const partners = data.published ? data.partners : [];
const ROW_A = partners.slice(0, 6);
const ROW_B = partners.slice(6, 13);
---

<div class="sr" data-story-mode="view" data-story-scene="road">
  <div class="sr-row" data-road-row="top">
    {
      ROW_A.map((p, i) => (
        <article class="sr-card" data-reveal data-reveal-delay={`${i * 0.07}s`}>
          <p class="sr-card-brand">
            {p.name}
            {p.kind === 'platform' && <span class="sr-card-tag">合作平台</span>}
          </p>
          {p.title && <p class="sr-card-title">{p.title}</p>}
          <p class="sr-card-blurb">{p.blurb}</p>
        </article>
      ))
    }
  </div>
  <div class="sr-row" data-road-row="bottom">
    {
      ROW_B.map((p, i) => (
        <article class="sr-card" data-reveal data-reveal-delay={`${0.12 + i * 0.06}s`}>
          <p class="sr-card-brand">
            {p.name}
            {p.kind === 'platform' && <span class="sr-card-tag">合作平台</span>}
          </p>
          {p.title && <p class="sr-card-title">{p.title}</p>}
          <p class="sr-card-blurb">{p.blurb}</p>
        </article>
      ))
    }
  </div>
  <p class="sr-fineprint" data-reveal>以上排名不分先后。</p>
</div>

<style>
  .sr {
    width: 100%;
    /* 视差由工厂驱动行容器 transform；此处给两行初始同位 */
    --row-drift: 0px;
  }

  /* —— 两行网格：上 6 列 / 下 7 列 —— */
  .sr-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.4vw, 1.2rem);
    transform: translateY(var(--row-drift));
  }

  .sr-row + .sr-row {
    margin-top: clamp(0.8rem, 1.4vw, 1.2rem);
  }

  .sr-row[data-road-row='bottom'] {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  /* —— 品牌卡：纯文字小卡（无图片） —— */
  .sr-card {
    display: flex;
    flex-direction: column;
    padding: clamp(0.9rem, 1.6vw, 1.25rem) clamp(0.85rem, 1.5vw, 1.15rem);
    border: 1px solid var(--anniv-border);
    background: color-mix(in srgb, var(--anniv-surface) 55%, transparent);
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      transform var(--dur-normal) var(--ease-enter);
  }

  .sr-card:hover {
    border-color: var(--anniv-accent);
    transform: translateY(-4px);
  }

  .sr-card-brand {
    margin: 0 0 0.3rem;
    font-family: var(--anniv-serif);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--anniv-fg);
  }

  .sr-card-tag {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.12rem 0.45rem;
    vertical-align: 0.12em;
    font-family: 'Archivo', sans-serif;
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    color: var(--anniv-accent);
    border: 1px solid var(--anniv-border-strong);
    border-radius: 999px;
    white-space: nowrap;
  }

  .sr-card-title {
    margin: 0 0 0.4rem;
    font-family: var(--anniv-serif);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--anniv-accent);
  }

  .sr-card-blurb {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.8;
    letter-spacing: 0.02em;
    text-align: justify;
    color: var(--anniv-muted);
    /* 默认截断约 5 行保证一屏两行；hover 展开全文 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .sr-card:hover .sr-card-blurb {
    display: block;
    overflow: visible;
    -webkit-line-clamp: unset;
    color: var(--anniv-fg-secondary);
  }

  .sr-fineprint {
    margin: clamp(1.4rem, 2.5vw, 2.2rem) 0 0;
    font-family: var(--anniv-serif);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-align: center;
    color: var(--anniv-muted);
  }

  @media (max-width: 64rem) {
    .sr-row,
    .sr-row[data-road-row='bottom'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sr-card-blurb {
      -webkit-line-clamp: 6;
    }
  }

  @media (max-width: 48rem) {
    /* 手机：单列正常滚动浏览，文案完整展示（一屏 13 卡是桌面形态） */
    .sr-row,
    .sr-row[data-road-row='bottom'] {
      grid-template-columns: 1fr;
      transform: none;
    }

    .sr-card {
      padding: 1.1rem 1rem;
    }

    .sr-card-brand {
      font-size: 1.15rem;
    }

    .sr-card-blurb {
      -webkit-line-clamp: unset;
      overflow: visible;
      font-size: 0.88rem;
      line-height: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sr-card {
      transition: none;
    }
  }
</style>
