---
/**
 * 【03 同行之路 · SharedRoad】品牌关系网——所有品牌以文字节点连接到中心的
 * 「合作品牌」枢纽（无图片、排名不分先后：网络本身无序）。
 * story-on：钉住轨道内滚动依次聚焦每个品牌——节点与连线点亮，顶部放大字
 * 「@品牌名」、下方稍小字体展开合作文案（节拍切换，绝不停在两段之间）。
 * 无 JS / reduced-motion：网络与聚焦区隐藏，回退为普通文档流列表（全部可读）。
 * 文案照录用户提供原文；数据：src/data/anniversary/partners.json。
 */
import partnersData from '../../data/anniversary/partners.json';

interface Partner {
  name: string;
  /** 网络节点的短名（长名品牌用，避免溢出）；缺省用 name */
  short?: string;
  slug: string;
  kind: 'brand' | 'platform';
  title?: string;
  blurb: string;
}

const data = partnersData as { published: boolean; partners: Partner[] };
const partners = data.published ? data.partners : [];
const N = partners.length;

/** 节点在关系网中的分布：椭圆均布（百分比坐标，与 SVG viewBox 等效换算） */
const nodePos = partners.map((_, i) => {
  const ang = (i / N) * Math.PI * 2 - Math.PI / 2;
  return { x: 50 + Math.cos(ang) * 39, y: 50 + Math.sin(ang) * 37 };
});
---

<div class="sr">
  {/* —— 回退形态：普通文档流列表（无 JS / reduced-motion / SEO） —— */}
  <div class="sr-fallback">
    {
      partners.map(p => (
        <article class="sr-item">
          <p class="sr-item-brand">
            {p.name}
            {p.kind === 'platform' && <span class="sr-item-tag">合作平台</span>}
          </p>
          {p.title && <p class="sr-item-title">{p.title}</p>}
          <p class="sr-item-blurb">{p.blurb}</p>
        </article>
      ))
    }
    <p class="sr-fineprint">以上排名不分先后。</p>
  </div>

  {/* —— 关系网形态（story-on 接管）：枢纽 + 品牌节点 + 连线 —— */}
  <div aria-hidden="true" class="sr-net">
    <svg class="sr-links" preserveAspectRatio="none" viewBox="0 0 100 100">
      {
        partners.map((_, i) => (
          <line
            class="sr-link"
            data-road-link
            x1={50}
            x2={nodePos[i]?.x}
            y1={50}
            y2={nodePos[i]?.y}
          />
        ))
      }
    </svg>
    <span class="sr-node sr-node--hub">
      合作品牌
      <span class="sr-node-en">BRAND PARTNERSHIP</span>
    </span>
    {
      partners.map((p, i) => (
        <span
          class="sr-node sr-node--brand"
          data-road-node
          style={`left:${nodePos[i]?.x}%;top:${nodePos[i]?.y}%`}
        >
          {p.short ?? p.name}
        </span>
      ))
    }
  </div>

  {/* —— 聚焦区：顶部放大字 @品牌名，下方稍小字体文案（同格叠放节拍切换） —— */}
  <div class="sr-focus">
    {
      partners.map(p => (
        <article class="sr-focus-item" data-road-focus>
          <p class="sr-at">@{p.name}</p>
          {p.title && <p class="sr-focus-title">{p.title}</p>}
          <p class="sr-focus-blurb">{p.blurb}</p>
        </article>
      ))
    }
  </div>

  <p class="sr-fineprint sr-fineprint--net" data-road-fineprint>以上排名不分先后。</p>
</div>

<style>
  .sr {
    width: 100%;
  }

  /* —— 回退列表（默认形态；story-on 下隐藏） —— */
  .sr-fallback {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    max-width: 46rem;
    margin: 0 auto;
  }

  .sr-item {
    padding-top: 1.6rem;
    border-top: 1px solid var(--anniv-border);
  }

  .sr-item-brand {
    margin: 0 0 0.4rem;
    font-family: var(--anniv-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--anniv-fg);
  }

  .sr-item-title {
    margin: 0 0 0.5rem;
    font-family: var(--anniv-serif);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--anniv-accent);
  }

  .sr-item-blurb {
    margin: 0;
    font-size: 0.9rem;
    line-height: 2;
    letter-spacing: 0.04em;
    color: var(--anniv-muted);
  }

  .sr-item-tag {
    display: inline-block;
    margin-left: 0.7rem;
    padding: 0.18rem 0.6rem;
    vertical-align: 0.15em;
    font-family: 'Archivo', sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--anniv-accent);
    border: 1px solid var(--anniv-border-strong);
    border-radius: 999px;
  }

  .sr-fineprint {
    margin: 1.6rem 0 0;
    font-family: var(--anniv-serif);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-align: center;
    color: var(--anniv-muted);
  }

  /* —— 关系网形态（默认隐藏，story-on 接管） —— */
  .sr-net,
  .sr-focus {
    display: none;
  }

  :global(.story-on) .sr-fallback {
    display: none;
  }

  :global(.story-on) .sr-net {
    display: block;
    position: relative;
    height: min(44svh, 420px);
    margin: 0 auto;
  }

  /* 连线层：拉伸铺满网络区（线宽不受拉伸影响） */
  :global(.story-on) .sr-links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  :global(.story-on) .sr-link {
    stroke: var(--anniv-border);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.45s ease;
  }

  :global(.story-on) .sr-link.is-active {
    stroke: var(--anniv-accent);
  }

  /* 节点：绝对定位在分布点上（translate 居中），激活时点亮放大 */
  :global(.story-on) .sr-node {
    position: absolute;
    transform: translate(-50%, -50%);
    padding: 0.5rem 1rem;
    white-space: nowrap;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--anniv-muted);
    border: 1px solid var(--anniv-border);
    background: color-mix(in srgb, var(--anniv-bg) 72%, transparent);
    transition:
      color 0.45s ease,
      border-color 0.45s ease,
      background-color 0.45s ease,
      box-shadow 0.45s ease;
  }

  :global(.story-on) .sr-node--brand.is-active {
    color: var(--anniv-fg);
    border-color: var(--anniv-accent);
    background: color-mix(in srgb, var(--anniv-surface) 85%, transparent);
    box-shadow: 0 0 20px rgba(46, 134, 222, 0.22);
  }

  :global(.story-on) .sr-node--hub {
    left: 50%;
    top: 50%;
    padding: 0.8rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--anniv-accent);
    border-color: var(--anniv-border-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  :global(.story-on) .sr-node-en {
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    color: var(--anniv-faint);
  }

  /* —— 聚焦区：@品牌名 放大大字 + 稍小文案（同格叠放节拍切换） —— */
  :global(.story-on) .sr-focus {
    display: grid;
    max-width: 44rem;
    margin: clamp(1.6rem, 3.5svh, 2.6rem) auto 0;
  }

  :global(.story-on) .sr-focus-item {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0; /* 初始隐藏，工厂按当前聚焦接管 */
    transition: opacity 0.45s ease;
  }

  :global(.story-on) .sr-at {
    margin: 0 0 0.7rem;
    font-family: var(--anniv-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    color: var(--anniv-fg);
  }

  :global(.story-on) .sr-focus-title {
    margin: 0 0 0.8rem;
    font-family: var(--anniv-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--anniv-accent);
  }

  :global(.story-on) .sr-focus-blurb {
    margin: 0;
    max-width: 40em;
    font-family: var(--anniv-serif);
    font-size: clamp(0.88rem, 1.6vw, 0.98rem);
    line-height: 2;
    letter-spacing: 0.03em;
    text-align: justify;
    color: var(--anniv-fg-secondary);
  }

  :global(.story-on) .sr-fineprint--net {
    margin-top: clamp(1.2rem, 2.5svh, 2rem);
    opacity: 0; /* 全部聚焦完成后由工厂点亮 */
  }

  @media (max-width: 48rem) {
    :global(.story-on) .sr-net {
      height: min(38svh, 330px);
    }

    :global(.story-on) .sr-node {
      padding: 0.4rem 0.7rem;
      font-size: 0.66rem;
      letter-spacing: 0.08em;
    }

    :global(.story-on) .sr-node--hub {
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
    }

    :global(.story-on) .sr-focus-blurb {
      font-size: 0.86rem;
      line-height: 1.9;
    }
  }
</style>
