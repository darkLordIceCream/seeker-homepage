---
/**
 * 【03 同行之路 · SharedRoad】品牌合作卡片墙——13 张品牌/平台卡片网格。
 * 滚动视觉：每张卡 data-reveal 进入视口依次浮现（行内错峰），hover 上浮点亮。
 * 排名不分先后：网格本身无序，文末声明。文案照录用户提供原文。
 * 无 JS / reduced-motion：data-reveal 不生效，卡片直接可见（渐进增强契约）。
 * 数据：src/data/anniversary/partners.json；logo 存 R2 partners/。
 */
import partnersData from '../../data/anniversary/partners.json';

interface Partner {
  name: string;
  slug: string;
  kind: 'brand' | 'platform';
  glyph?: string;
  logo?: string;
  title?: string;
  blurb: string;
}

const data = partnersData as { published: boolean; partners: Partner[] };
const partners = data.published ? data.partners : [];
const COLS = 3;
---

<div class="sr">
  <div class="sr-grid">
    {
      partners.map((p, i) => (
        <article
          class="sr-card"
          data-reveal
          data-reveal-delay={`${(i % COLS) * 0.09}s`}
        >
          <div class="sr-card-media">
            {p.logo ? (
              <img alt={`${p.name} 标识`} decoding="async" loading="lazy" src={p.logo} />
            ) : (
              <span class="sr-glyph" aria-hidden="true">
                {p.glyph ?? p.name.slice(0, 1)}
              </span>
            )}
          </div>
          <div class="sr-card-body">
            <p class="sr-card-brand">
              {p.name}
              {p.kind === 'platform' && <span class="sr-card-tag">合作平台</span>}
            </p>
            {p.title && <p class="sr-card-title">{p.title}</p>}
            <p class="sr-card-blurb">{p.blurb}</p>
          </div>
        </article>
      ))
    }
  </div>
  <p class="sr-fineprint" data-reveal>以上排名不分先后。</p>
</div>

<style>
  .sr {
    width: 100%;
  }

  /* —— 卡片网格：桌面 3 列 / 平板 2 列 / 手机 1 列 —— */
  .sr-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 2rem);
    max-width: 68rem;
    margin: 0 auto;
  }

  .sr-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--anniv-border);
    background: color-mix(in srgb, var(--anniv-surface) 55%, transparent);
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      transform var(--dur-normal) var(--ease-enter);
  }

  .sr-card:hover {
    border-color: var(--anniv-accent);
    transform: translateY(-4px);
  }

  .sr-card:focus-within {
    outline: 2px solid var(--anniv-accent);
    outline-offset: 4px;
  }

  /* 媒体区：浅底内衬，logo 完整显示不裁切；无 logo 用文字球 */
  .sr-card-media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 128px;
    border-bottom: 1px solid var(--anniv-border);
    background:
      radial-gradient(circle at 30% 24%, rgba(46, 134, 222, 0.1), transparent 60%),
      color-mix(in srgb, var(--anniv-surface) 88%, #ffffff);
  }

  .sr-card-media img {
    max-width: 72%;
    max-height: 76%;
    object-fit: contain;
    transition: transform 0.4s var(--ease-enter);
  }

  .sr-card:hover .sr-card-media img {
    transform: scale(1.05);
  }

  .sr-glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--anniv-border-strong);
    background: radial-gradient(circle at 36% 30%, rgba(46, 134, 222, 0.18), rgba(8, 36, 63, 0.9) 70%);
    font-family: var(--anniv-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--anniv-fg);
  }

  .sr-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1rem, 2vw, 1.4rem) clamp(1rem, 2vw, 1.4rem) clamp(1.1rem, 2vw, 1.5rem);
  }

  .sr-card-brand {
    margin: 0 0 0.35rem;
    font-family: var(--anniv-serif);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--anniv-fg);
  }

  .sr-card-tag {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.16rem 0.55rem;
    vertical-align: 0.15em;
    font-family: 'Archivo', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-indent: 0.26em;
    color: var(--anniv-accent);
    border: 1px solid var(--anniv-border-strong);
    border-radius: 999px;
  }

  .sr-card-title {
    margin: 0 0 0.55rem;
    font-family: var(--anniv-serif);
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--anniv-accent);
  }

  .sr-card-blurb {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.95;
    letter-spacing: 0.03em;
    text-align: justify;
    color: var(--anniv-fg-secondary);
  }

  .sr-fineprint {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    font-family: var(--anniv-serif);
    font-size: 0.88rem;
    letter-spacing: 0.2em;
    text-align: center;
    color: var(--anniv-muted);
  }

  @media (max-width: 64rem) {
    .sr-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .sr-grid {
      grid-template-columns: 1fr;
    }

    .sr-card-media {
      height: 108px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sr-card,
    .sr-card-media img {
      transition: none;
    }
  }
</style>
