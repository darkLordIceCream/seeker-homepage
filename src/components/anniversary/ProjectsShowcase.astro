---
// 02 追光印记 · 项目介绍：三大项目拍立得卡片（时间的故事 / 追光之旅 / 带上她的眼睛）。
// 舞台式编排（三槽固定站位，与留光成物同一 3D 思想）：从光影札记滑入时，
// 三张拍立得分别从左、中、右三个站位的后方（深处、缩小、变暗）逐渐走上台前
// 定格；继续滑动各自对称退回后方；三张都退回后一起集体谢幕（暗场退场）。
// 编排逻辑在 scroll-story.ts 的 projects 工厂；卡片为展示卡结构——
// 深色卡体 + 方形照片区（img contain 完整显示，绝不裁切）+ 下方题签写标题。
// 无 JS / reduced-motion：不加 story-on，卡片退化为普通文档流依次排列、全部可见。
// 图文数据与首页活动卡同源（R2 代表图 + 主站路由）。
const PROJECTS = [
  {
    part: 'PART. 01',
    title: '时间的故事',
    href: '/activities/story-of-time/',
    image: 'https://r2.xn--seeker-ng2jm403afb4a.club/activities/2026-08/cover.webp',
    alt: '《时间的故事》八月篇封面——夕光沉远岸，秋意漫画框',
  },
  {
    part: 'PART. 02',
    title: '追光之旅',
    href: '/activities/chasing-light/',
    image: 'https://r2.xn--seeker-ng2jm403afb4a.club/activities/chasing-light/2024/grand-prize/01.webp',
    alt: '2024 追光之旅总冠军《喜马拉雅山的宇宙烟火》——源Dream作品',
  },
  {
    part: 'PART. 03',
    title: '「带上她的眼睛」乡村儿童摄影课',
    href: '/welfare/',
    image: 'https://r2.xn--seeker-ng2jm403afb4a.club/welfare/bring-her-eyes/in-a-faraway-place/01.jpg',
    alt: '「带上她的眼睛」公益项目——乡村摄影课',
  },
] as const;
---

<div class="ps">
  <div class="ps-beats">
    {
      PROJECTS.map(p => (
        <div class="ps-beat" data-project-beat>
          <a class="pol" href={p.href}>
            <span class="pol-photo">
              <img alt={p.alt} decoding="async" loading="lazy" src={p.image} />
            </span>
            <span class="pol-cap">
              <span class="pol-part">{p.part}</span>
              <span class="pol-title">{p.title}</span>
              <span class="pol-cta">
                进入项目
                <svg
                  aria-hidden="true"
                  fill="none"
                  height="13"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="13"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </span>
          </a>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ps {
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
  }

  /* 无 JS / reduced-motion：普通文档流依次排列（渐进增强契约） */
  .ps-beats {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 5rem);
  }

  /* —— story-on：3D 舞台（三张拍立得各占左/中/右一个站位，滚动 = 走位）——
     perspective 在容器层；beats 开 preserve-3d 让卡片的 translateZ 相对镜头生效。
     工厂逐帧写各卡的 translate3d/opacity/--ps-dim（连续 progress 插值，无
     transition：快速/反向滚动都由当前进度直接计算，不跳帧）。 —— */
  :global(.story-on) .ps {
    max-width: 62rem; /* 舞台放宽：三张拍立得并立有左右呼吸 */
    perspective: 1500px;
  }

  @media (max-width: 48rem) {
    :global(.story-on) .ps {
      perspective: 1100px; /* 移动端景深收敛 */
    }
  }

  :global(.story-on) .ps-beats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.1rem, 2.4vw, 2.2rem);
    align-items: center;
    transform-style: preserve-3d;
  }

  :global(.story-on) .ps-beat {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0; /* 初始隐藏，工厂按当前进度写内联样式接管 */
    will-change: opacity, transform;
  }

  /* —— 展示卡：深色卡体 + 方形照片区（contain 完整显示不裁切）+ 下方题签 ——
     卡体用 anniv-surface 深蓝融入暗房色彩；照片区更深一档衬图 */
  .pol {
    display: block;
    width: 100%;
    padding: 3.2% 3.2% 0;
    background: var(--anniv-surface);
    border: 1px solid var(--anniv-border);
    box-shadow: 0 16px 44px rgba(2, 8, 20, 0.5);
    text-decoration: none;
    filter: brightness(var(--ps-dim, 1)); /* 3D 纵深：后方待命/退场时由工厂写暗度 */
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      box-shadow var(--dur-normal) var(--ease-enter);
  }

  .pol:hover {
    border-color: var(--anniv-accent);
    box-shadow: 0 22px 56px rgba(2, 8, 20, 0.62);
  }

  .pol-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background: var(--anniv-bg);
    overflow: hidden;
  }

  .pol-photo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain; /* 完整显示，不裁切 */
    transition: transform 0.5s var(--ease-enter);
  }

  .pol:hover .pol-photo img {
    transform: scale(1.02);
  }

  .pol-cap {
    display: block;
    padding: 0.85rem 0.3rem 1.05rem;
    text-align: center;
  }

  .pol-part {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.38em;
    color: var(--anniv-accent);
  }

  .pol-title {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--anniv-serif);
    font-size: clamp(0.92rem, 1.5vw, 1.12rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--anniv-fg);
  }

  .pol-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.55rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--anniv-muted);
    transition:
      color var(--dur-normal) ease,
      gap var(--dur-normal) ease;
  }

  .pol:hover .pol-cta {
    gap: 0.7rem;
    color: var(--anniv-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pol,
    .pol-photo img,
    .pol-cta {
      transition: none;
    }
  }

  /* 窄屏：拍立得收紧，保证题头 + 卡在 100svh 内同屏 */
  @media (max-width: 48rem) {
    .ps {
      max-width: none;
    }

    .pol-title {
      font-size: 0.88rem;
    }

    .pol-cap {
      padding: 0.6rem 0.2rem 0.8rem;
    }
  }
</style>
