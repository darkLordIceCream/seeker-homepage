---
// 02 追光印记 · 项目介绍：三大项目卡片（时间的故事 / 追光之旅 / 带上她的眼睛）。
// 空间行走式叙事（三块方形展板同存于一个空间）：滚动 = 相机沿展道前移，
// 依次走近、面对、经过 Part 01/02/03——遮挡与近大远小由空间深度自然产生，
// 不是卡片切换。编排逻辑在 scroll-story.ts 的 projects 工厂（相机位置模型）；
// 卡片为方形摄影展板——深色卡体 + 照片区 img contain 完整显示（绝不裁切）
// + 题签；story-on 内 desc 压缩为三行图注（全文在项目页）。
// 无 JS / reduced-motion：不加 story-on，卡片退化为普通文档流依次排列、全部可见。
// 图文数据与首页活动卡同源（R2 代表图 + 主站路由）。
const PROJECTS = [
  {
    part: 'PART. 01',
    title: '时间的故事',
    desc: '“时间的故事”是 Seeker追光者的核心项目。2026 年，新的时间的故事同样汇聚了多元的摄影主题，参与者都可以通过镜头自由表达他们对时间的理解与诠释。今年，在排版上，我们用“日期”替换了以往的“组别”，强化了时间的概念。这个项目不仅展现了时间流逝中的美好，更为Seeker们提供了一个记录和分享他们独特故事的舞台，无论故事来自何处，皆可在此绽放。',
    href: '/activities/story-of-time/',
    image: 'https://r2.xn--seeker-ng2jm403afb4a.club/activities/2026-08/cover.webp',
    alt: '《时间的故事》八月篇封面——夕光沉远岸，秋意漫画框',
  },
  {
    part: 'PART. 02',
    title: '追光之旅',
    desc: '“追光之旅”是 Seeker 追光者举办的年度摄影大赛，也是属于Seeker摄影人的一次年度回望与共同出发。赛事以镜头为舟，向自然、城市与人间烟火追寻光亮，设置自然户外、城市建筑、人文纪实、商业创意、校园学生等赛道，并评选年度总冠军、赛道冠军和优秀作品。它鼓励创作者记录时代的温度，也珍藏每个人心中的微光。',
    href: '/activities/chasing-light/',
    image: 'https://r2.xn--seeker-ng2jm403afb4a.club/activities/chasing-light/2024/grand-prize/01.webp',
    alt: '2024 追光之旅总冠军《喜马拉雅山的宇宙烟火》——源Dream作品',
  },
  {
    part: 'PART. 03',
    title: '「带上她的眼睛」乡村儿童摄影课',
    desc: '“带上她的眼睛”是我们招募有意愿的乡村教师，在乡村中小学创办摄影社团和开展摄影课，我们将提供所需器材与培训指导，期望将影像作为一种美育的方法，培养儿童发现、记录与分享美的能力，将表达的权利交还给儿童本身，由他们自己来记录更真实的乡村生活与环境。',
    href: '/welfare/',
    image: 'https://r2.xn--seeker-ng2jm403afb4a.club/welfare/bring-her-eyes/in-a-faraway-place/01.jpg',
    alt: '「带上她的眼睛」公益项目——乡村摄影课',
  },
] as const;
---

<div class="ps">
  <div class="ps-beats">
    {
      PROJECTS.map(p => (
        <div class="ps-beat" data-project-beat>
          <a class="ps-card" href={p.href}>
            <span class="ps-media" data-project-media>
              <img alt={p.alt} decoding="async" loading="lazy" src={p.image} />
            </span>
            <span class="ps-body">
              <span class="ps-part">{p.part}</span>
              <span class="ps-title">{p.title}</span>
              <p class="ps-desc">{p.desc}</p>
              <span class="ps-cta">
                进入项目
                <svg
                  aria-hidden="true"
                  fill="none"
                  height="13"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="13"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </span>
          </a>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ps {
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
  }

  /* 无 JS / reduced-motion：普通文档流依次排列（渐进增强契约） */
  .ps-beats {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 5rem);
  }

  /* —— story-on：3D 展厅（三块方形展板同存于一个空间，滚动 = 相机前移）——
     perspective 在容器层；beats 开 preserve-3d，三板叠同一格，工厂逐帧写
     各板的 translate3d/opacity/--ps-dim（相机位置模型：progress → 空间位置，
     连续插值无 transition，快速/反向滚动严格连续）。遮挡关系由空间深度
     自然产生：面对 Part 01 时，Part 02 在其后方露出。 —— */
  :global(.story-on) .ps {
    max-width: 62rem; /* 展厅放宽 */
    perspective: 1500px;
  }

  @media (max-width: 48rem) {
    :global(.story-on) .ps {
      perspective: 1100px; /* 移动端景深收敛 */
    }
  }

  :global(.story-on) .ps-beats {
    display: grid;
    transform-style: preserve-3d;
  }

  :global(.story-on) .ps-beat {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0; /* 初始隐藏，工厂按当前进度写内联样式接管 */
    will-change: opacity, transform;
    /* 段落吸附的切换补间：拍与拍之间由 transition 走完，无中间停留态 */
    transition:
      transform 0.7s var(--ease-enter),
      opacity 0.7s ease,
      filter 0.7s ease;
  }

  /* —— 深色展示卡：图上文下横排；照片区深底 contain 完整显示（绝不裁切）—— */
  .ps-card {
    display: block;
    width: 100%;
    text-decoration: none;
    border: 1px solid var(--anniv-border);
    background: var(--anniv-surface);
    box-shadow: 0 14px 40px rgba(2, 8, 20, 0.45);
    filter: brightness(var(--ps-dim, 1)); /* 3D 纵深：后方待命/退场时由工厂写暗度 */
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      box-shadow var(--dur-normal) var(--ease-enter);
  }

  .ps-card:hover {
    border-color: var(--anniv-accent);
    box-shadow: 0 20px 52px rgba(2, 8, 20, 0.58);
  }

  .ps-card:focus-visible {
    outline: 2px solid var(--anniv-accent);
    outline-offset: 4px;
  }

  .ps-media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
    background: var(--anniv-bg);
    overflow: hidden;
    border-bottom: 1px solid var(--anniv-border);
  }

  .ps-media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain; /* 完整显示，不裁切 */
    transition: transform 0.5s var(--ease-enter);
  }

  .ps-card:hover .ps-media img {
    transform: scale(1.02);
  }

  .ps-body {
    display: block;
    padding: clamp(1rem, 2.2vw, 1.5rem) clamp(1.1rem, 2.4vw, 1.7rem);
  }

  .ps-part {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    color: var(--anniv-accent);
  }

  .ps-title {
    display: block;
    margin-top: 0.55rem;
    font-family: var(--anniv-serif);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--anniv-fg);
  }

  .ps-desc {
    margin: 0.7rem 0 0;
    font-family: var(--anniv-serif);
    font-size: clamp(0.84rem, 1.4vw, 0.92rem);
    line-height: 1.9;
    letter-spacing: 0.02em;
    text-align: justify;
    color: var(--anniv-fg-secondary);
  }

  .ps-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.85rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--anniv-muted);
    transition:
      color var(--dur-normal) ease,
      gap var(--dur-normal) ease;
  }

  .ps-card:hover .ps-cta {
    gap: 0.75rem;
    color: var(--anniv-accent);
  }

  /* 方形摄影展板：比例恒定（1:1），稳定完整，像真实存在于空间中的展板 */
  :global(.story-on) .ps-card {
    display: grid;
    grid-template-rows: 1fr auto;
    width: min(60vh, 100%, 32rem);
    aspect-ratio: 1;
  }

  :global(.story-on) .ps-media {
    aspect-ratio: auto;
    height: 100%;
    border-bottom: 1px solid var(--anniv-border);
    border-right: none;
  }

  :global(.story-on) .ps-body {
    padding: clamp(0.8rem, 1.6vh, 1.2rem) clamp(1rem, 2vw, 1.4rem);
  }

  :global(.story-on) .ps-title {
    margin-top: 0.3rem;
    font-size: clamp(1rem, 1.9vw, 1.25rem);
  }

  :global(.story-on) .ps-desc {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  :global(.story-on) .ps-cta {
    margin-top: 0.4rem;
    font-size: 0.62rem;
  }

  @media (max-width: 48rem) {
    :global(.story-on) .ps-card {
      width: min(42vh, 100%, 21rem);
    }

    :global(.story-on) .ps-desc {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .ps-desc {
      font-size: 0.84rem;
      line-height: 1.85;
    }

    .ps-body {
      padding: 1rem 1.05rem 1.1rem;
    }
  }
</style>
