---
/**
 * 【01 七年序章 · AvatarWall】成员头像墙——全屏墙层。
 * 桌面用横版（about/avatar-wall-wide.jpg），移动端竖屏用竖版
 * （about/team-photo.png），`<picture>` 按断点自动切换。
 * 整层作为 01 sticky 舞台的全屏背景（滚动引擎驱动 淡入→停留→淡出），
 * 顶部/底部渐变压暗保证文字可读；摄影本体不加任何 filter。
 */
const VERTICAL = 'https://r2.xn--seeker-ng2jm403afb4a.club/about/team-photo.png';
const WIDE = 'https://r2.xn--seeker-ng2jm403afb4a.club/about/avatar-wall-wide.jpg';
---

<div class="aw" data-intro-wall aria-hidden="true">
  <picture>
    <source media="(min-width: 48rem)" srcset={WIDE} />
    <img src={VERTICAL} alt="" loading="lazy" decoding="async" />
  </picture>
  <div class="aw-scrim"></div>
  <p class="aw-cap" data-wall-cap>
    <span class="aw-cap-zh">成员头像墙</span>
    <span class="aw-cap-en">THE MEMBER WALL</span>
  </p>
</div>

<style>
  .aw {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .aw :global(img),
  .aw :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 顶/底渐变压暗：UI 层，非照片 filter */
  .aw-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--anniv-bg) 62%, transparent) 0%,
      transparent 26%,
      transparent 58%,
      color-mix(in srgb, var(--anniv-bg) 72%, transparent) 100%
    );
  }

  .aw-cap {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(5.4rem, 12vh, 7rem);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    text-align: left;
  }

  .aw-cap-zh {
    font-family: var(--anniv-serif);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--anniv-fg);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.6);
  }

  .aw-cap-en {
    font-family: 'Archivo', sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    color: var(--anniv-fg-secondary);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
  }
</style>
