---
/**
 * 【01 七年序章 · Contact Sheet】胶片接触印样墙。
 * 数据：构建期从 activities 集合（64 期《时间的故事》）抽样——每两期取一帧，
 * 真实成员照片 + 真实作者署名 + 期数标签，跨 2021→2026 均匀分布。
 * 版式：1px 细线网格 + 直角 + FRAME 编号 metadata；照片保持原始画幅
 * （尺寸来自 activity-image-meta，宽高直出零 CLS），懒加载。
 */
import { getCollection } from 'astro:content';
import { activityImageDims } from '@/lib/activityImageMeta';

const issues = (await getCollection('activities')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

interface SheetFrame {
  url: string;
  w: number;
  h: number;
  author: string;
  period: string;
}

const frames: SheetFrame[] = [];
for (let i = 0; i < issues.length; i += 2) {
  const issue = issues[i];
  if (!issue) {
    continue;
  }
  const entry = issue.data.entries.find(e => {
    const first = e.images[0];
    return Boolean(first && activityImageDims(first));
  });
  const url = entry?.images[0];
  const dim = url ? activityImageDims(url) : undefined;
  if (!entry || !url || !dim) {
    continue;
  }
  frames.push({
    url,
    w: dim.w,
    h: dim.h,
    author: entry.author,
    period: issue.data.period ?? String(issue.data.order ?? ''),
  });
}
---

<div class="cs">
  {frames.map((f, i) => (
    <figure class="cs-cell">
      <span aria-hidden="true" class="cs-no">FRAME {String(i + 1).padStart(3, '0')}</span>
      <img
        alt={`《时间的故事》成员作品 · ${f.author}`}         decoding="async"         height={f.h}         loading="lazy"         src={f.url}         width={f.w}
      />
      <figcaption class="cs-cap">
        <span class="cs-author">{f.author}</span>
        <span class="cs-period">{f.period}</span>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  /* 印样网格：1px 细线由容器底色透出，直角、无阴影、无圆角 */
  .cs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1px;
    background: var(--anniv-border);
    border: 1px solid var(--anniv-border);
  }

  .cs-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    background: var(--anniv-bg);
    transition: background-color var(--dur-normal) ease;
  }

  .cs-no {
    padding: 0.45rem 0.6rem 0.4rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    color: var(--anniv-faint);
  }

  .cs-cell img {
    display: block;
    width: 100%;
    /* 统一印样画幅（真实 contact sheet 即等幅小格）：裁切展示，宽高属性仍防 CLS */
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .cs-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.45rem 0.6rem 0.55rem;
  }

  .cs-author {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--anniv-fg-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cs-period {
    font-family: 'Archivo', sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    color: var(--anniv-faint);
    white-space: nowrap;
  }
</style>
