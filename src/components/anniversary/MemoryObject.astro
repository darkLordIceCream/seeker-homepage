---
/**
 * 【06 留光成物 · MemoryObject】纪念物分层舞台。
 * 一件七周年纪念物随滚动逐渐成形：照片 → 相框 → @昵称 → SEEKER 07 → 年份。
 * 照片取真实活动图池的一张竖幅（构建期确定性抽取）；分层为 HTML/CSS 复刻，
 * 与水印模板同一视觉语言（细框 + 金徽标 + 年份）——不是电商商品卡。
 */
import { ACTIVITY_IMAGE_META } from '@/lib/activity-image-meta';

const R2_BASE = 'https://r2.xn--seeker-ng2jm403afb4a.club';
const pool = Object.entries(ACTIVITY_IMAGE_META).filter(([key, dim]) => {
  return (
    !key.includes('cover') && !key.includes('committee') && dim.w >= 800 && dim.h >= 1000 && dim.h > dim.w
  );
});
const pick = pool[Math.floor(pool.length / 2)];
const photo = pick
  ? { url: `${R2_BASE}/${pick[0]}`, w: pick[1].w, h: pick[1].h }
  : null;
---

<div class="memory" data-memory-object>
  <div
    class="memory-stage"
    aria-label="七周年纪念物：照片装上纪念框，署名 SEEKER 07 · 2019 — 2026"
  >
    <div class="memory-mat" data-memory-frame aria-hidden="true"></div>
    <div class="memory-photo" data-memory-photo aria-hidden="true">
      {
        photo && (
          <img
            src={photo.url}
            alt=""
            width={photo.w}
            height={photo.h}
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
    <span class="memory-badge" data-memory-badge>SEEKER 07</span>
    <span class="memory-nick" data-memory-nick>@你的昵称</span>
    <span class="memory-years" data-memory-years>2019 — 2026</span>
  </div>
  <p class="memory-cap">一件纪念物，正在被一点一点制作出来。</p>
</div>

<style>
  .memory {
    width: min(100%, 26rem);
    margin: 0 auto;
  }

  /* 3:4 纪念框；分层绝对定位，各层由滚动引擎依序揭示 */
  .memory-stage {
    position: relative;
    aspect-ratio: 3 / 4;
    height: min(56vh, 30rem);
    max-width: 100%;
    margin: 0 auto;
  }

  .memory-mat,
  .memory-photo,
  .memory-badge,
  .memory-nick,
  .memory-years {
    position: absolute;
  }

  .memory-mat {
    inset: 0;
    background: var(--anniv-surface);
    border: 1px solid var(--anniv-border-strong);
  }

  .memory-photo {
    inset: 12px;
    overflow: hidden;
  }

  .memory-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .memory-badge {
    top: 24px;
    left: 26px;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--anniv-accent);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }

  .memory-nick {
    bottom: 26px;
    right: 28px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--anniv-fg);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  .memory-years {
    top: 26px;
    right: 28px;
    font-family: 'Archivo', sans-serif;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
  }

  .memory-cap {
    margin: 1.1rem 0 0;
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--anniv-muted);
  }
</style>
