---
/**
 * 【七周年 · 首页角落入口】感性入口——"网站角落里藏着一张照片"。
 * 默认：小幅成员摄影作品 + SEEKER 07；桌面 hover 轻展开（主题文案 + ENTER）；
 * 移动端保持小卡，点击直达 /7th/。照片每次加载从真实活动图池随机取一张
 * （构建期从 ACTIVITY_IMAGE_META 抽样，客户端随机；背景图不占布局、零 CLS）。
 * 与 Activities 特殊块（理性入口）角色互补，不做弹窗广告感。
 */
import { ACTIVITY_IMAGE_META } from '@/lib/activity-image-meta';

const R2_BASE = 'https://r2.xn--seeker-ng2jm403afb4a.club';

// 抽样真实成员照片池：过滤封面/组委会图与过小图，跨期数均匀取 ~28 张
const candidates = Object.entries(ACTIVITY_IMAGE_META).filter(([key, dim]) => {
  return !key.includes('cover') && !key.includes('committee') && dim.w >= 960 && dim.h >= 640;
});
const step = Math.max(1, Math.floor(candidates.length / 28));
const pool = candidates
  .filter((_, i) => i % step === 0)
  .slice(0, 28)
  .map(([key]) => ({ url: `${R2_BASE}/${key}` }));
---

<aside aria-label="Seeker 七周年" class="anniv-corner" id="anniv-corner">
  <button aria-label="关闭七周年卡片" class="anniv-corner-close" id="anniv-corner-close" type="button">
    ×
  </button>
  <a aria-label="七周年纪念册：SEEKER 07，光影七载，看见彼此" class="ac" href="/7th/">
    <span aria-hidden="true" class="ac-photo" data-ac-photo>
      <span class="ac-badge">07</span>
    </span>
    <span class="ac-body">
      <span class="ac-title-row">
        <strong class="ac-title">SEEKER 07</strong>
        <span class="ac-range">2019 — 2026</span>
      </span>
      <span class="ac-slogan">光影七载，看见彼此。</span>
      <span class="ac-cta">ENTER ARCHIVE →</span>
    </span>
  </a>
  <script define:vars={{ pool }} is:inline>
    (function () {
      const card = document.getElementById('anniv-corner');
      const close = document.getElementById('anniv-corner-close');
      const photo = card && card.querySelector('[data-ac-photo]');
      if (!card || !close || !photo) {
        return;
      }
      // 每次加载随机取一张真实成员照片（构建期抽样池）
      try {
        const pick = pool[Math.floor(Math.random() * pool.length)];
        if (pick && pick.url) {
          photo.style.backgroundImage = `url('${pick.url}')`;
        }
      } catch (error) {
        /* 图池缺失时保留素底，不影响入口可用 */
      }
      // 轻入场：仅淡入（无位移弹跳），reduced-motion 由 CSS 兜底直显
      window.setTimeout(() => {
        card.classList.add('is-shown');
      }, 700);
      close.addEventListener('click', () => {
        card.remove();
      });
    })();
  </script>
</aside>

<style>
  .anniv-corner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 1200;
    max-width: calc(100vw - 2rem);
    opacity: 0;
  }

  .anniv-corner.is-shown {
    opacity: 1;
    transition: opacity 0.7s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .anniv-corner {
      opacity: 1;
    }

    .anniv-corner.is-shown {
      transition: none;
    }
  }

  .ac {
    display: flex;
    flex-direction: column;
    background: var(--anniv-bg);
    border: 1px solid var(--anniv-border);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.28);
    text-decoration: none;
    transition:
      border-color 0.25s ease;
  }

  .ac:hover,
  .ac:focus-visible {
    border-color: color-mix(in srgb, var(--anniv-accent) 60%, transparent);
  }

  .ac:focus-visible {
    outline: 1px solid var(--anniv-accent);
    outline-offset: 2px;
  }

  .ac-photo {
    position: relative;
    display: block;
    width: 10.5rem;
    height: 7.4rem;
    background-size: cover;
    background-position: center;
    background-color: var(--anniv-surface);
    transition: width 0.32s var(--ease-enter);
  }

  .ac-badge {
    position: absolute;
    right: 0.45rem;
    bottom: 0.3rem;
    font-family: 'Archivo', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-accent);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
  }

  .ac-body {
    display: block;
    padding: 0.6rem 0.75rem 0.7rem;
  }

  .ac-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    white-space: nowrap;
  }

  .ac-title {
    font-family: 'Archivo', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: var(--anniv-fg);
  }

  .ac-range {
    font-family: 'Archivo', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--anniv-faint);
  }

  .ac-slogan,
  .ac-cta {
    display: block;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-2px);
    transition:
      max-height 0.32s var(--ease-enter),
      opacity 0.28s ease,
      transform 0.32s var(--ease-enter);
  }

  .ac-slogan {
    margin-top: 0;
    font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'SimSun', serif;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--anniv-fg);
    white-space: nowrap;
  }

  .ac-cta {
    margin-top: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--anniv-accent);
    white-space: nowrap;
  }

  /* 桌面 hover / 键盘聚焦：轻展开文案（无弹跳、无大幅缩放） */
  @media (hover: hover) {
    .ac:hover .ac-photo,
    .ac:focus-visible .ac-photo {
      width: 13.5rem;
    }

    .ac:hover .ac-slogan,
    .ac:focus-visible .ac-slogan {
      max-height: 1.8rem;
      margin-top: 0.45rem;
      opacity: 1;
      transform: none;
    }

    .ac:hover .ac-cta,
    .ac:focus-visible .ac-cta {
      max-height: 1.4rem;
      margin-top: 0.5rem;
      opacity: 1;
      transform: none;
    }
  }

  .anniv-corner-close {
    position: absolute;
    top: -0.55rem;
    right: -0.55rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.9rem;
    line-height: 1;
    color: rgba(250, 250, 250, 0.9);
    background: rgba(20, 20, 20, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    cursor: pointer;
  }

  .anniv-corner-close:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  /* 移动端：更小的照片卡，点击直达（无 hover 依赖） */
  @media (max-width: 40rem) {
    .anniv-corner {
      right: 0.6rem;
      bottom: 0.6rem;
    }

    .ac-photo {
      width: 6.4rem;
      height: 6.4rem;
    }

    .ac-body {
      display: none;
    }
  }
</style>
