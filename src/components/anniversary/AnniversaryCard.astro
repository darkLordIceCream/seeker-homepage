---
/**
 * 【七周年 · 首页角落入口】俏皮版——半张照片斜插在屏幕右缘外。
 * 隐藏态：卡片约一半斜出屏幕（露出照片左半条）；
 * 桌面 hover / 键盘聚焦 → 回弹滑出完整卡片（SEEKER 07 + 主题句 + 进入档案馆）；
 * 移动端两段式：点窄条先弹出，再点内容才进入 /7th/；× 随时可关。
 * 照片每次加载从成员收集作品池（GALLERY_POOL）随机取一张，零 CLS。
 * reduced-motion：无滑入/摆动/回弹，常驻半藏态，hover/tap 即时切换。
 */
import { GALLERY_POOL } from '@/data/gallery';

// 角卡照片池：成员问卷收集的全量作品（客户端随机取一张）
const pool = GALLERY_POOL.map(img => ({ url: img.src }));
---

<aside aria-label="Seeker 七周年" class="anniv-corner" id="anniv-corner">
  <button aria-label="关闭七周年卡片" class="anniv-corner-close" id="anniv-corner-close" type="button">
    ×
  </button>
  <a aria-label="七周年纪念册：SEEKER 07，光影七载，看见彼此" class="ac" href="/7th/">
    <span class="ac-photo" data-ac-photo>
      <span class="ac-badge">07</span>
    </span>
    <span class="ac-body">
      <span class="ac-title-row">
        <strong class="ac-title">SEEKER 07</strong>
        <span class="ac-range">2019 — 2026</span>
      </span>
      <span class="ac-slogan">光影七载，看见彼此。</span>
      <span class="ac-cta">进入档案馆 →</span>
    </span>
  </a>
  <script define:vars={{ pool }} is:inline>
    (function () {
      const card = document.getElementById('anniv-corner');
      const close = document.getElementById('anniv-corner-close');
      const link = card && card.querySelector('a.ac');
      if (!card || !close || !link) {
        return;
      }
      // 每次加载随机取一张真实成员照片（构建期抽样池）
      try {
        const pick = pool[Math.floor(Math.random() * pool.length)];
        const photo = card.querySelector('[data-ac-photo]');
        if (pick && pick.url && photo) {
          photo.style.backgroundImage = `url('${pick.url}')`;
        }
      } catch (error) {
        /* 图池缺失时保留素底，不影响入口可用 */
      }
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // 入场：从屏幕外滑入到半藏位（reduced-motion 直接就位）
      if (reduced) {
        card.classList.add('is-shown');
      } else {
        window.setTimeout(() => {
          card.classList.add('is-shown');
        }, 900);
      }
      // 移动端两段式：第一击弹出完整卡片，再点内容才进入
      link.addEventListener('click', (e) => {
        const mobile = window.matchMedia('(max-width: 40rem)').matches;
        if (!mobile || card.classList.contains('is-open')) {
          return;
        }
        e.preventDefault();
        card.classList.add('is-open');
      });
      close.addEventListener('click', () => {
        card.remove();
      });
    })();
  </script>
</aside>

<style>
  /* 位置：右缘偏下；默认半藏斜插（露出左条） */
  .anniv-corner {
    position: fixed;
    right: 0;
    bottom: 16vh;
    z-index: 1200;
    width: min(19rem, calc(100vw - 2rem));
    transform: translateX(112%) rotate(10deg);
    transform-origin: left bottom;
  }

  .anniv-corner.is-shown {
    transform: translateX(calc(100% - 8rem)) rotate(7deg);
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .anniv-corner.is-shown:hover,
  .anniv-corner.is-shown:focus-within,
  .anniv-corner.is-open {
    transform: translateX(0) rotate(-2deg);
  }

  .ac {
    position: relative;
    display: block;
    background: var(--anniv-bg);
    border: 1px solid var(--anniv-border);
    border-right-color: transparent; /* 右缘插进屏幕外 */
    border-radius: 8px 0 0 8px;
    text-decoration: none;
    box-shadow: -8px 12px 32px rgba(0, 0, 0, 0.38);
    transform-origin: left bottom;
    animation: ac-waggle 7s ease-in-out 2.8s infinite;
  }

  .anniv-corner:hover .ac,
  .anniv-corner.is-open .ac,
  .anniv-corner:focus-within .ac {
    animation: none;
  }

  .ac-photo {
    position: relative;
    display: block;
    height: 7.4rem;
    background-size: cover;
    background-position: center;
    background-color: var(--anniv-surface);
    border-radius: 7px 0 0 0;
    overflow: hidden;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ac-badge {
    position: absolute;
    right: 0.45rem;
    bottom: 0.3rem;
    font-family: 'Archivo', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-accent);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
  }

  .ac-body {
    display: block;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 0.75rem;
    transition:
      max-height 0.42s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.3s ease,
      padding 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* 展开（hover / 键盘聚焦 / 移动端 is-open）：完整内容 */
  .anniv-corner:hover .ac-body,
  .anniv-corner:focus-within .ac-body,
  .anniv-corner.is-open .ac-body {
    max-height: 7rem;
    opacity: 1;
    padding: 0.6rem 0.75rem 0.7rem;
  }

  .ac-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    white-space: nowrap;
  }

  .ac-title {
    font-family: 'Archivo', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: var(--anniv-fg);
  }

  .ac-range {
    font-family: 'Archivo', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--anniv-faint);
  }

  .ac-slogan {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--anniv-serif);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--anniv-fg);
    white-space: nowrap;
  }

  .ac-cta {
    display: block;
    margin-top: 0.5rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--anniv-accent);
    white-space: nowrap;
  }

  /* hover / 键盘聚焦 / 移动端展开：照片轻微放大 */
  .anniv-corner:hover .ac-photo,
  .anniv-corner:focus-within .ac-photo,
  .anniv-corner.is-open .ac-photo {
    transform: scale(1.03);
  }

  .anniv-corner-close {
    position: absolute;
    top: -0.55rem;
    left: -0.55rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.9rem;
    line-height: 1;
    color: rgba(250, 250, 250, 0.9);
    background: rgba(20, 20, 20, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    cursor: pointer;
  }

  .anniv-corner-close:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  /* 待机小摆动：勾引路过的访客（hover/展开即停） */
  @keyframes ac-waggle {
    0%,
    7%,
    100% {
      transform: rotate(0deg);
    }
    2% {
      transform: rotate(-1.4deg);
    }
    4.5% {
      transform: rotate(1deg);
    }
  }

  /* 移动端：更窄的半藏条；两段式（点窄条弹出，再点内容进入） */
  @media (max-width: 40rem) {
    .anniv-corner {
      bottom: 14vh;
    }

    .anniv-corner.is-shown {
      transform: translateX(calc(100% - 2.6rem)) rotate(7deg);
    }

    .anniv-corner.is-open {
      transform: translateX(0) rotate(-2deg);
    }

    .ac-photo {
      height: 6.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anniv-corner,
    .anniv-corner.is-shown,
    .ac,
    .ac-photo {
      transition: none;
      animation: none;
    }

    .anniv-corner,
    .anniv-corner.is-shown {
      transform: translateX(calc(100% - 8rem)) rotate(7deg);
    }
  }
</style>
