---
// Footer component for Seeker追光者 photography group
import { Image } from 'astro:assets';
import wechatQrcode from '@/assets/images/wechat-qrcode.png';

const year = new Date().getFullYear();

/** 技术支持名单：手工维护，按展示顺序排列；display 可选，缺省显示 @login */
const TECH_SUPPORT: Array<{ login: string; display?: string }> = [
  { login: 'darkLordIceCream', display: '黑暗之王' },
  { login: 'Wenrh2004' },
  { login: 'SimZun6' },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section">
        <h2 class="footer-title">Seeker追光者</h2>
        <p class="footer-description">
          用镜头记录美好，用影像连接心灵。<br />
          拍一张照片，交一个朋友。
        </p>
        <div class="social-links">
          <a
            aria-label="抖音"
            class="social-link"
            href="https://www.douyin.com/user/MS4wLjABAAAANRlQ9wldsHtInuIUqOA55efPkEYP_Gc-1yEsSOKcBHIVP3GQcdPDe6Z02HCNVL59?from_tab_name=main"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24">
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
              ></path>
            </svg>
          </a>
          <a
            aria-label="小红书"
            class="social-link"
            href="https://xhslink.com/m/9TkFaUGGkyD"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24">
              <path
