              ></path>
            </svg>
          </a>
          <a
            aria-label="500px"
            class="social-link"
            href="https://500px.com.cn/page/tribe/detail?tribeId=7482bd0e1bb044c99ddd66007e65644d"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg fill="currentColor" height="24" viewBox="0 0 1024 1024" width="24">
              <path
                d="M397.78 426.11A85.89 85.89 0 1 0 483.67 512a86.66 86.66 0 0 0-85.89-85.89zm0 153.74a67.42 67.42 0 1 1 67-67.85 67.85 67.85 0 0 1-67 67.85zm184.58-153.74A85.89 85.89 0 1 0 668.25 512a85.89 85.89 0 0 0-85.89-85.89zm0 153.74a67.42 67.42 0 1 1 67-67.85 66.74 66.74 0 0 1-65.61 67.84zM250.05 477.64a57.89 57.89 0 0 0-45.52 12v-45.49h77.3c2.58 0 4.29-.86 4.29-8.59s-3.44-7.73-5.15-7.73h-85a7.73 7.73 0 0 0-7.73 7.73v75.58c0 4.29 2.58 5.15 6.87 6a6.53 6.53 0 0 0 7.73-1.72 48.87 48.87 0 0 1 42.95-20.61 44.66 44.66 0 0 1 38.65 37.79 43.46 43.46 0 0 1-37.79 48.1h-5.15a43.8 43.8 0 0 1-40.37-28.34c-.86-2.58-2.58-4.29-9.45-1.72s-7.73 4.29-6.87 6.87a60.32 60.32 0 0 0 113.38-41.23 60.12 60.12 0 0 0-48.14-38.64zM726.66 427a46.55 46.55 0 0 0-41.23 46.38v76.44c0 4.29 3.44 5.15 8.59 5.15s8.59-.86 8.59-5.15v-76.47a28.86 28.86 0 0 1 24.91-29.2A28.26 28.26 0 0 1 749 451a27.4 27.4 0 0 1 9.45 20.61 34.36 34.36 0 0 1-6 16.32 27.06 27.06 0 0 1-24 11.17c-3.44 0-6 0-6.87 7.73 0 5.15 0 7.73 4.29 8.59a42.26 42.26 0 0 0 24.91-5.15 46.12 46.12 0 0 0 24.91-36.07 44.49 44.49 0 0 0-40.63-48l-.77-.06a23.79 23.79 0 0 1-7.63.86zm112.52 44.66 30.92-30.92c.86-.86 3.44-3.44-1.72-9.45a8.59 8.59 0 0 0-6-3.44 4.47 4.47 0 0 0-3.44 1.72L828 460.47l-30.92-31.78c-2.58-2.58-5.15-1.72-9.45 1.72s-4.29 6.87-1.72 9.45l30.92 30.92-31.09 31.78A6.53 6.53 0 0 0 784 506a7.21 7.21 0 0 0 3.44 6 13.83 13.83 0 0 0 6 3.44 9.1 9.1 0 0 0 4.29-1.72l30.92-30.92 30.92 30.92a4.47 4.47 0 0 0 3.44 1.72 8.59 8.59 0 0 0 6-3.44c2.58-3.44 3.44-6.87.86-8.59z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-section">
        <h3 class="footer-subtitle">快速链接</h3>
        <ul class="footer-links">
          <li><a href="/under-construction">作品展示</a></li>
          <li><a href="/under-construction">小组简介</a></li>
          <li><a href="/under-construction">小组活动</a></li>
          <li><a href="/under-construction">加入小组</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3 class="footer-subtitle">联系方式</h3>
        <div class="qrcode-block">
          <Image
            src={wechatQrcode}
            alt="Seeker追光者 微信公众号二维码"
            width={200}
            height={200}
            class="qrcode-image"
            loading="lazy"
          />
          <p class="qrcode-caption">扫码关注微信公众号</p>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <p>&copy; {year} Seeker追光者. All Rights Reserved.</p>
        <p class="tech-support">
          技术支持
          {
            TECH_SUPPORT.map(({ login, display }) => (
              <a
                class="tech-name"
                href={`https://github.com/${login}`}
                rel="noopener noreferrer"
                target="_blank"
              >
                {display ?? `@${login}`}
              </a>
            ))
          }
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--secondary);
    color: var(--foreground);
    padding: 60px 0 20px;
    margin-top: 0;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
  }

  .footer-title {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 15px 0;
    background: linear-gradient(45deg, var(--grad-a), var(--grad-b));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-description {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0 0 20px 0;
  }

  .social-links {
    display: flex;
    gap: 15px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--accent);
    border-radius: 50%;
    color: var(--foreground);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: linear-gradient(45deg, var(--grad-a), var(--grad-b));
    color: var(--on-gradient);
    transform: translateY(-3px);
    box-shadow: var(--glass-hover-shadow);
  }

  .footer-subtitle {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 20px 0;
    color: var(--foreground);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: 10px;
  }

  .footer-links a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--grad-a);
  }

  .qrcode-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .qrcode-image {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .qrcode-caption {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 14px;
  }

  .footer-bottom {
    border-top: 1px solid var(--divider);
    padding-top: 20px;
    text-align: center;
  }

  .footer-copyright {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .footer-copyright p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 14px;
  }

  .tech-support {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }

  .tech-name {
    color: var(--grad-a);
    font-weight: 600;
    background: linear-gradient(45deg, var(--grad-a), var(--grad-b));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 40px 0 20px;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 30px;
      text-align: center;
    }

    .footer-section {
      align-items: center;
    }

    .social-links {
      justify-content: center;
    }

    .qrcode-block {
      align-items: center;
    }

    .footer-copyright {
      flex-direction: column;
      gap: 5px;
    }
  }

  @media (max-width: 480px) {
    .footer {
      padding: 30px 0 15px;
    }

    .footer-title {
      font-size: 24px;
    }

    .footer-description {
      font-size: 14px;
    }

    .footer-copyright p {
      font-size: 12px;
    }
  }
</style>
