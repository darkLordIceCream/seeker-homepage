---
// 追光之旅 · 年度大赛页：结果公示 + 作品赏析合并一页
// 版式参考四大摄影比赛官网（2025-09 调研）：
// - Hero 即总冠军展示位（徕卡 LOBA：全屏黑厅 + 全出血获奖作 + 角标 Photo: © 作者）
// - 结果公示区常暗：组冠军图上文下卡（IPPAWARDS）→ 优秀作品/特别关注密集网格 hover 显注（华为 XMAGE）
// - 作品赏析区跟随站点明暗主题：编辑块图组（哈苏 33/50/66% 栅格）+ 衬线「背后的故事」列
// - 年份导航为一排文字链接（XMAGE）；lightbox 复用 GalleryStory 自研实现
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../Navigation.astro';
import Footer from '../Footer.astro';
import { activityImageDims } from '../../lib/activityImageMeta';

interface Props {
  entry: import('astro:content').CollectionEntry<'lightChasing'>;
  /** 全部届数（按年份倒序），供年份导航与上下届 pager */
  years: import('astro:content').CollectionEntry<'lightChasing'>[];
}

const { entry, years } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

/** 赏析顺序与公示一致：总冠军 → 组冠军 → 优秀作品 → 特别关注奖 */
const allWinners = [data.grandPrize, ...data.groups, ...data.excellence, ...data.attention];

/** 有「背后的故事」的作品：照片点击后展开作品赏析（无故事的照片仍走大图 lightbox） */
const storyWinners = allWinners.filter(w => w.story);
const storyIdx = (w: (typeof allWinners)[number]) => storyWinners.indexOf(w);
/** 浮层用故事数据（构建期内联 JSON，JS 只做显隐；`<` 转义防 script 提前闭合） */
const storiesJson = JSON.stringify(
  storyWinners.map(w => ({
    award: w.award,
    title: w.title,
    author: w.author,
    images: w.images,
    paras: (w.story ?? '').split(/\n+/).filter(Boolean),
  })),
).replace(/</g, '\\u003c');

const newer = years.find(y => y.data.year > data.year);
const older = years.find(y => y.data.year < data.year);

/** hero 图尺寸：内联 aspect-ratio 预留原比例（封顶缩放时配合 object-fit:contain 不裁切） */
const heroDim = activityImageDims(data.cover);

/** 内联 aspect-ratio 样式：照片一律按原始比例渲染 */
const ratioStyle = (dim?: { w: number; h: number }) =>
  dim ? `aspect-ratio:${dim.w} / ${dim.h}` : undefined;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `${data.title} · 结果公示与作品赏析`,
  description: data.excerpt,
  datePublished: data.pubDate.toISOString(),
  image: data.cover,
  numberOfItems: allWinners.length,
  author: { '@type': 'Organization', name: 'Seeker追光者' },
  publisher: { '@type': 'Organization', name: 'Seeker追光者' },
});
---

<Layout
  defaultTheme="dark"
  description={data.excerpt}
  image={data.cover}
  title={data.title}
>
  <Navigation />

  <main class="cl-page" id="main-content">
    <script is:inline set:html={jsonLd} type="application/ld+json" />

    <!-- 年份导航：一排文字链接（XMAGE 式） -->
    <nav aria-label="历届大赛" class="cl-yearnav">
      <a class="yn-back" href="/activities/chasing-light/">← 历届大赛</a>
      <div class="yn-years">
        {years.map(y => (
          <a
            aria-current={y.data.year === data.year ? 'page' : undefined}
            class:list={['yn-year', { 'is-current': y.data.year === data.year }]}
            href={`/activities/chasing-light/${y.data.year}/`}
          >
            {y.data.year}
          </a>
        ))}
      </div>
    </nav>

    <!-- §大赛结果公示（常暗展区）：导语 → 总冠军 C 位 → 获奖作品 -->
    <section aria-label="大赛结果公示" class="cl-results">
      <header class="cl-sec-head">
        <p class="sec-en">RESULTS ANNOUNCEMENT</p>
        <h2 class="sec-title">大赛结果公示</h2>
      </header>

      <div class="cl-intro">
        <div class="cl-prose">
          <Content />
        </div>
        {data.stats && <p class="cl-stats">{data.stats}</p>}
      </div>

      {/* 总冠军 C 位：公示首件展品，原比例完整展示（有故事则 hover 提示可读） */}
      <figure class="cl-grand">
        <button
          aria-label={data.grandPrize.story
            ? `查看作品赏析：《${data.grandPrize.title}》（${data.grandPrize.award}，© ${data.grandPrize.author}）`
            : `查看大图：《${data.grandPrize.title}》`}
          class="grand-shutter"
          data-author={data.grandPrize.author}
          data-full={data.cover}
          data-story-idx={data.grandPrize.story ? storyIdx(data.grandPrize) : undefined}
          data-title={data.grandPrize.title}
          type="button"
        >
          <img
            alt={`《${data.grandPrize.title}》——${data.grandPrize.author}作品（${data.title}${data.grandPrize.award}）`}
            decoding="async"
            fetchpriority="high"
            height={heroDim?.h}
            loading="eager"
            src={data.cover}
            style={ratioStyle(heroDim)}
            width={heroDim?.w}
          />
          {data.grandPrize.story && (
            <span aria-hidden="true" class="story-hint">
              <span class="story-hint-en">BEHIND THE STORY</span>
              点击查看作品赏析
            </span>
          )}
        </button>
        <figcaption class="grand-meta">
          <p class="grand-award">
            {data.grandPrize.award} <span class="grand-award-en">GRAND PRIZE</span>
          </p>
          <h1 class="grand-title">
            <span class="grand-year">{data.year} 追光之旅</span>
            <span class="grand-work">《{data.grandPrize.title}》</span>
          </h1>
          <p class="grand-author">{data.grandPrize.author}</p>
        </figcaption>
      </figure>

      {data.groups.length > 0 && (
        <div class="cl-groups">
          {data.groups.map(w => {
            const dim = activityImageDims(w.cover);
            return (
              <figure class="win-card">
                <button
                  aria-label={w.story
                    ? `查看作品赏析：《${w.title}》（${w.award}，© ${w.author}）`
                    : `查看大图：《${w.title}》`}
                  class="win-shutter"
                  data-author={w.author}
                  data-full={w.cover}
                  data-story-idx={w.story ? storyIdx(w) : undefined}
                  data-title={w.title}
                  type="button"
                >
                  <img
                    alt={`《${w.title}》——${w.author}作品（${w.award}）`}
                    decoding="async"
                    height={dim?.h}
                    loading="lazy"
                    src={w.cover}
                    style={ratioStyle(dim)}
                    width={dim?.w}
                  />
                  {w.story && (
                    <span aria-hidden="true" class="story-hint">
                      <span class="story-hint-en">BEHIND THE STORY</span>
                      点击查看作品赏析
                    </span>
                  )}
                </button>
                <figcaption class="win-meta">
                  <p class="win-award">{w.award}</p>
                  <p class="win-title">《{w.title}》</p>
                  <p class="win-author">{w.author}</p>
                </figcaption>
              </figure>
            );
          })}
        </div>
      )}

      {(data.excellence.length > 0 || data.attention.length > 0) && (
        <div class="cl-minor-groups">
          {([
            ['excellence', 'EXCELLENCE'],
            ['attention', 'SPECIAL MENTION'],
          ] as const).map(([key, en]) => {
            const works = data[key];
            if (works.length === 0) {
              return null;
            }
            return (
              <section class="cl-minor-group">
                <header class="cl-subhead">
                  <h3 class="subhead-title">{works[0]?.award}</h3>
                  <span class="subhead-en">{en}</span>
                  <span aria-hidden="true" class="subhead-line"></span>
                </header>
                <div class="cl-minor">
                  {works.map(w => {
                    const dim = activityImageDims(w.cover);
                    return (
                      <figure class="minor-tile">
                        <button
                          aria-label={w.story
                            ? `查看作品赏析：《${w.title}》（${w.award}，© ${w.author}）`
                            : `查看大图：《${w.title}》（${w.award}，© ${w.author}）`}
                          class="tile-shutter"
                          data-author={w.author}
                          data-full={w.cover}
                          data-story-idx={w.story ? storyIdx(w) : undefined}
                          data-title={w.title}
                          type="button"
                        >
                          <img
                            alt={`《${w.title}》——${w.author}作品（${w.award}）`}
                            decoding="async"
                            height={dim?.h}
                            loading="lazy"
                            src={w.cover}
                            style={ratioStyle(dim)}
                            width={dim?.w}
                          />
                          {w.story && (
                            <span aria-hidden="true" class="story-hint">
                              <span class="story-hint-en">BEHIND THE STORY</span>
                              点击查看作品赏析
                            </span>
                          )}
                        </button>
                        <figcaption class="tile-meta">
                          <p class="tile-author">© {w.author}</p>
                        </figcaption>
                      </figure>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
      )}

      {(data.resultsNote || data.sourceResults) && (
        <aside class="cl-note">
          {data.resultsNote && <p class="note-text">{data.resultsNote}</p>}
          <p class="note-links">
            {data.sourceResults && (
              <a href={data.sourceResults} rel="noopener noreferrer" target="_blank">
                微信原文 · 结果公示 ↗
              </a>
            )}
            {data.sourceStories && (
              <a href={data.sourceStories} rel="noopener noreferrer" target="_blank">
                微信原文 · 作品赏析 ↗
              </a>
            )}
          </p>
        </aside>
      )}
    </section>

    <!-- 赞助鸣谢（最末尾） -->
    {data.sponsors && (
      <aside aria-label="赞助鸣谢" class="cl-sponsors">
        <p class="sp-en">SPONSORS</p>
        <p class="sp-list">本届赞助鸣谢 · {data.sponsors}</p>
      </aside>
    )}

    <!-- 届数 pager + 返回 -->
    <div class="cl-tail">
      <nav aria-label="届数跳转" class="cl-pager">
        <div class="pager-slot">
          {newer ? (
            <a class="pager-card" href={`/activities/chasing-light/${newer.data.year}/`}>
              <span class="pager-kicker">← 上一届 {newer.data.year}</span>
              <strong class="pager-title">《{newer.data.grandPrize.title}》</strong>
              <span class="pager-sub">{newer.data.grandPrize.author}</span>
            </a>
          ) : (
            <div aria-disabled="true" class="pager-card is-empty">
              <span class="pager-kicker">← 上一届</span>
              <strong class="pager-title">已是最近一届</strong>
            </div>
          )}
        </div>
        <div class="pager-slot">
          {older ? (
            <a class="pager-card pager-right" href={`/activities/chasing-light/${older.data.year}/`}>
              <span class="pager-kicker">下一届 {older.data.year} →</span>
              <strong class="pager-title">《{older.data.grandPrize.title}》</strong>
              <span class="pager-sub">{older.data.grandPrize.author}</span>
            </a>
          ) : (
            <div aria-disabled="true" class="pager-card is-empty pager-right">
              <span class="pager-kicker">下一届 →</span>
              <strong class="pager-title">敬请期待</strong>
              <span class="pager-sub">新一届大赛筹备中</span>
            </div>
          )}
        </div>
      </nav>

      <footer class="cl-foot">
        <a class="back-link" href="/activities/chasing-light/">← 返回「追光之旅」历届大赛</a>
      </footer>
    </div>
  </main>

  <div aria-label="查看大图" aria-modal="true" class="lightbox" hidden role="dialog">
    <button aria-label="关闭大图" class="lb-btn lb-close" type="button">
      <svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24" width="22"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
    <button aria-label="下一张" class="lb-btn lb-next" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M9 18l6-6-6-6" /></svg>
    </button>
    <figure class="lb-stage">
      <img alt="" class="lb-img" decoding="async" />
      <figcaption class="lb-cap"></figcaption>
    </figure>
    <button aria-label="上一张" class="lb-btn lb-prev" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <p aria-live="polite" class="lb-count"></p>
  </div>

  <!-- 作品赏析浮层：图文双栏（移动端堆叠），多图可翻页；内容构建期渲染 -->
  <div aria-label="作品赏析" aria-modal="true" class="cl-storyview" hidden role="dialog">
    <button aria-label="关闭作品赏析" class="sv-btn sv-close" type="button">
      <svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24" width="22"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
    <div class="sv-body">
      <figure class="sv-media">
        <img alt="" class="sv-img" decoding="async" />
        <button aria-label="上一张" class="sv-btn sv-nav sv-prev" type="button">
          <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <button aria-label="下一张" class="sv-btn sv-nav sv-next" type="button">
          <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M9 18l6-6-6-6" /></svg>
        </button>
        <figcaption class="sv-cap">
          <span aria-live="polite" class="sv-count"></span>
        </figcaption>
      </figure>
      <div class="sv-text">
        <p class="sv-award"></p>
        <h2 class="sv-title"></h2>
        <p class="sv-author"></p>
        <p class="sv-label">背后的故事 <span aria-hidden="true">HIS STORY</span></p>
        <div class="sv-paras"></div>
      </div>
    </div>
  </div>

  <script set:html={storiesJson} data-stories type="application/json" />

  <Footer />
</Layout>

<script>
  // 两个浮层：大图 lightbox（无故事作品）与作品赏析 storyview（有故事作品）。
  // 均为无依赖渐进增强；故事数据由构建期内联 JSON 提供。
  interface StoryWork {
    award: string;
    title: string;
    author: string;
    images: string[];
    paras: string[];
  }

  const lightbox = document.querySelector<HTMLElement>('.lightbox');
  const storyview = document.querySelector<HTMLElement>('.cl-storyview');
  const stories: StoryWork[] = JSON.parse(
    document.querySelector<HTMLScriptElement>('script[data-stories]')?.text ?? '[]',
  );
  const shutters = [
    ...document.querySelectorAll<HTMLButtonElement>('.win-shutter, .tile-shutter, .grand-shutter'),
  ];
  const slides = shutters.map(btn => ({
    full: btn.dataset.full ?? '',
    title: btn.dataset.title ?? '',
    author: btn.dataset.author ?? '',
  }));
  let current = -1;
  let lastFocus: HTMLElement | null = null;

  const lockScroll = (locked: boolean) => {
    document.documentElement.style.overflow = locked ? 'hidden' : '';
  };

  /* —— 大图 lightbox（无故事作品） —— */
  const renderSlide = () => {
    const img = lightbox?.querySelector<HTMLImageElement>('.lb-img');
    const cap = lightbox?.querySelector<HTMLElement>('.lb-cap');
    const count = lightbox?.querySelector<HTMLElement>('.lb-count');
    const slide = slides[current];
    if (!img || !cap || !count || !slide) {return;}
    img.src = slide.full;
    img.alt = `《${slide.title}》——${slide.author}作品`;
    cap.textContent = `«${slide.title}» @${slide.author}`;
    count.textContent = `${current + 1} / ${slides.length}`;
  };

  const closeLightbox = () => {
    if (!lightbox || lightbox.hidden) {return;}
    lightbox.hidden = true;
    lockScroll(false);
    lastFocus?.focus();
    current = -1;
  };

  const stepLightbox = (delta: number) => {
    if (current < 0 || slides.length === 0) {return;}
    current = (current + delta + slides.length) % slides.length;
    renderSlide();
  };

  const openLightbox = (index: number) => {
    if (!lightbox) {return;}
    current = index;
    renderSlide();
    lastFocus = document.activeElement as HTMLElement | null;
    lockScroll(true);
    lightbox.hidden = false;
    lightbox.querySelector<HTMLElement>('.lb-close')?.focus();
  };

  /* —— 作品赏析 storyview（有故事作品） —— */
  let svWork: StoryWork | null = null;
  let svIndex = 0;

  const renderStory = () => {
    if (!storyview || !svWork) {return;}
    const img = storyview.querySelector<HTMLImageElement>('.sv-img');
    const count = storyview.querySelector<HTMLElement>('.sv-count');
    if (!img || !count) {return;}
    img.src = svWork.images[svIndex] ?? '';
    img.alt = `《${svWork.title}》——${svWork.author}作品`;
    count.textContent = svWork.images.length > 1 ? `${svIndex + 1} / ${svWork.images.length}` : '';
  };

  const closeStory = () => {
    if (!storyview || storyview.hidden) {return;}
    storyview.hidden = true;
    svWork = null;
    lockScroll(false);
    lastFocus?.focus();
  };

  const stepStory = (delta: number) => {
    if (!svWork) {return;}
    svIndex = (svIndex + delta + svWork.images.length) % svWork.images.length;
    renderStory();
  };

  const openStory = (idx: number) => {
    const work = stories[idx];
    if (!storyview || !work) {return;}
    svWork = work;
    svIndex = 0;
    storyview.querySelector<HTMLElement>('.sv-award')!.textContent = work.award;
    storyview.querySelector<HTMLElement>('.sv-title')!.textContent = `《${work.title}》`;
    storyview.querySelector<HTMLElement>('.sv-author')!.textContent = work.author;
    const paras = storyview.querySelector<HTMLElement>('.sv-paras')!;
    paras.replaceChildren(
      ...work.paras.map(t => {
        const p = document.createElement('p');
        p.className = 'sv-para';
        p.textContent = t;
        return p;
      }),
    );
    const multi = work.images.length > 1;
    storyview.querySelector<HTMLElement>('.sv-prev')?.toggleAttribute('hidden', !multi);
    storyview.querySelector<HTMLElement>('.sv-next')?.toggleAttribute('hidden', !multi);
    renderStory();
    lastFocus = document.activeElement as HTMLElement | null;
    lockScroll(true);
    storyview.hidden = false;
    storyview.querySelector<HTMLElement>('.sv-close')?.focus();
  };

  shutters.forEach((btn, i) => {
    btn.addEventListener('click', () => {
      const storyAttr = btn.dataset.storyIdx;
      if (storyAttr !== undefined) {
        openStory(Number(storyAttr));
      } else {
        openLightbox(i);
      }
    });
  });
  lightbox?.querySelector('.lb-close')?.addEventListener('click', closeLightbox);
  lightbox?.querySelector('.lb-prev')?.addEventListener('click', () => stepLightbox(-1));
  lightbox?.querySelector('.lb-next')?.addEventListener('click', () => stepLightbox(1));
  lightbox?.addEventListener('click', e => {
    if (e.target === lightbox) {closeLightbox();}
  });
  storyview?.querySelector('.sv-close')?.addEventListener('click', closeStory);
  storyview?.querySelector('.sv-prev')?.addEventListener('click', () => stepStory(-1));
  storyview?.querySelector('.sv-next')?.addEventListener('click', () => stepStory(1));
  storyview?.addEventListener('click', e => {
    if (e.target === storyview) {closeStory();}
  });
  document.addEventListener('keydown', e => {
    const lbOpen = lightbox && !lightbox.hidden;
    const svOpen = storyview && !storyview.hidden;
    if (!lbOpen && !svOpen) {return;}
    if (e.key === 'Escape') {
      if (lbOpen) {closeLightbox();}
      if (svOpen) {closeStory();}
    } else if (e.key === 'ArrowRight') {
      lbOpen ? stepLightbox(1) : stepStory(1);
    } else if (e.key === 'ArrowLeft') {
      lbOpen ? stepLightbox(-1) : stepStory(-1);
    }
  });
</script>

<style>
  .cl-page {
    min-height: 100vh;
    padding-top: 70px;
    /* 整页跟随站点明暗主题（进入本页默认深色，见 Layout defaultTheme）；
       仅照片上的文字用固定浅色（压暗渐变保证两套主题下可读） */
    --cl-bg: var(--background);
    --cl-fg: var(--foreground);
    --cl-fg2: var(--muted-foreground);
    --cl-muted: var(--muted-foreground);
    --cl-faint: var(--muted-foreground);
    --cl-border: var(--divider);
    --cl-accent: var(--grad-a);
    --edge: max(6vw, calc((100vw - 1360px) / 2 + 56px));
    --font-serif-song: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', 'SimSun', Georgia, serif;
    background: var(--cl-bg);
    color: var(--cl-fg);
  }

  /* —— 年份导航 —— */
  .cl-yearnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px var(--edge);
    border-bottom: 1px solid var(--cl-border);
    background: var(--cl-bg);
  }

  .yn-back {
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--cl-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .yn-back:hover {
    color: var(--cl-fg);
  }

