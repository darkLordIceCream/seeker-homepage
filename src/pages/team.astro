---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import Layout from '../layouts/Layout.astro';

/**
 * 团队成员数据模板
 * 
 * 使用说明：
 * 1. 将下面的示例数据替换为实际团队成员信息
 * 2. 头像图片：可以将图片放在 src/assets/images/team/ 目录下，然后使用相对路径引用
 *    例如：avatar: '/src/assets/images/team/member1.jpg'
 *    或者使用外部图片链接
 * 3. 可以添加多个团队成员，只需在数组中添加新的对象即可
 * 4. social 字段支持以下平台：douyin（抖音）、xiaohongshu（小红书）、500px
 *    链接可以留空（使用 '#'）或删除不需要的社交媒体
 */
const teamMembers = [
  {
    id: 1,
    name: '倾斜的地平线', // 成员姓名
    role: '主理人', // 角色/职位
    title: 'Founder', // 职位标题（可选）
    avatar: '/src/assets/images/team/倾斜的地平线.jpg', // 头像图片URL
    bio: 'Seeker追光者主理人，热爱旅行的摄影爱好者。', // 个人简介
    specialties: ['摄影', '后期制作'], // 专长标签（数组，可以添加多个）
    social: {
      douyin: 'https://www.douyin.com/user/MS4wLjABAAAAFBocprvYBZK2-qDS11JsPWHvJSy2ml42fdwTMHcLtfE?from_tab_name=main', // 抖音链接（可选）
      xiaohongshu: 'https://www.xiaohongshu.com/user/profile/628faad000000000210215a3?xsec_token=ABoohJ5vh3xlJ7NO0avQdRwessnZoQu9rFI37zWSJX3dY%3D&xsec_source=pc_search', // 小红书链接（可选）
      '500px': 'https://500px.com.cn/community/user-details/e0d68e46345d193cdd488616da7cb8489' // 500px链接（可选）
    },
  },
  // 示例：添加更多团队成员
  // {
  //   id: 2,
  //   name: '成员姓名',
  //   role: '核心成员',
  //   title: '职位',
  //   avatar: '/src/assets/images/team/member2.jpg',
  //   bio: '成员简介...',
  //   specialties: ['摄影', '后期制作'],
  //   social: {
  //     douyin: '#', // 抖音链接
  //     xiaohongshu: '#', // 小红书链接
  //     '500px': '#', // 500px链接
  //   },
  // },
];
---

<Layout>
  <Navigation />
  
  <main class="team-page">
    <!-- 页面标题区域 -->
    <section class="team-hero">
      <div class="hero-content">
        <h1 class="hero-title">主理人团队</h1>
        <p class="hero-subtitle">用镜头记录美好，用影像连接心灵</p>
      </div>
    </section>

    <!-- 团队成员介绍区域 -->
    <section class="team-section">
      <div class="team-container">
        {teamMembers.map((member) => (
          <div class="member-card">
            <div class="member-image-wrapper">
              <img 
                src={member.avatar} 
                alt={member.name}
                class="member-avatar"
                loading="lazy"
              />
              <div class="member-overlay"></div>
            </div>
            
            <div class="member-info">
              <div class="member-header">
                <h2 class="member-name">{member.name}</h2>
                <span class="member-role">{member.role}</span>
              </div>
              
              <h3 class="member-title">{member.title}</h3>
              
              <p class="member-bio">{member.bio}</p>
              
              <div class="member-specialties">
                {member.specialties.map((specialty) => (
                  <span class="specialty-tag">{specialty}</span>
                ))}
              </div>
              
              <div class="member-social">
                {member.social.douyin && (
                  <a 
                    href={member.social.douyin} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="social-icon"
                    aria-label={`${member.name} 的抖音`}
                  >
                    <svg fill="currentColor" viewBox="0 0 24 24" width="20" height="20">
                      <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                    </svg>
                  </a>
                )}
                {member.social.xiaohongshu && (
                  <a 
                    href={member.social.xiaohongshu} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="social-icon"
                    aria-label={`${member.name} 的小红书`}
                  >
                    <svg fill="currentColor" viewBox="0 0 256 256" width="20" height="20">
                      <path d="M 29,0.33332825 C 13.959937,3.4666748 1.5356731,15.204498 0,31 -1.586103,47.314209 0,64.597672 0,81 v 102 c 0,18.76035 -4.7369685,44.19888 7.3333335,60 C 20.372129,260.06897 44.156731,256 63,256 h 111 35 c 5.78276,0 12.33244,0.84741 18,-0.33333 15.0401,-3.13336 27.46432,-14.87115 29,-30.66667 1.58612,-16.31419 0,-33.59769 0,-50 V 73 C 256,54.239685 260.73697,28.801102 248.66667,13 235.62787,-4.0689697 211.84329,0 193,0 H 82 47 C 41.217228,0 34.667561,-0.84741211 29,0.33332825 M 120,91 l -7,19 h 12 l -10,24 9,1 c -0.98794,2.68155 -2.31718,7.73317 -4.33334,9.83334 C 118.18945,146.3721 115.92654,146 114,146 c -4.35942,0 -13.16798,1.80539 -15.5,-3 -1.069664,-2.20416 0.465553,-4.98451 1.333336,-7 1.813624,-4.21228 4.222554,-8.51549 5.166664,-13 -2.17548,0 -4.92464,0.42967 -7,-0.33333 -7.778526,-2.85974 0.874031,-15.36435 2.66666,-19.66667 1.25875,-3.020981 2.75652,-9.584732 5.5,-11.5 C 110.01874,88.810822 115.88325,90.674988 120,91 m -79,63 c 2.750713,0 6.837379,0.81721 8.5,-2 1.769028,-2.99753 0.5,-9.58963 0.5,-13 V 106 C 50,102.90659 48.438198,93.464493 51.166668,91.5 53.41069,89.884308 62.832935,90.226166 63.833332,93 65.47065,97.539825 64,105.16241 64,110 v 32 c 0,5.48389 0.949112,11.8645 -1.333332,17 -2.177158,4.89861 -12.303417,9.27243 -17.333336,5.5 C 43.120155,162.84012 41.545292,156.59013 41,154 M 193,91 v 5 c 3.72887,0 8.4108,-0.763367 12,0.333328 11.97635,3.659424 11,15.422502 11,25.666672 1.99706,0 4.04419,-0.15562 6,0.33333 11.49335,2.87334 10,14.36401 10,23.66667 0,4.95615 0.93086,10.82184 -2.33333,15 -3.59567,4.60246 -9.48195,4 -14.66667,4 -1.6116,0 -4.26318,0.51051 -5.66667,-0.5 -2.62326,-1.88875 -3.78159,-7.50485 -4.33333,-10.5 3.28711,0 9.2179,1.12517 11.83333,-1.33334 C 219.9164,149.76859 218.65411,138.43454 215,136.5 c -1.93661,-1.02527 -4.88672,-0.5 -7,-0.5 h -15 v 29 h -14 v -29 h -14 v -14 h 14 v -12 h -9 V 96 h 9 v -5 h 14 m -32,5 v 14 h -8 v 42 h 13 v 13 H 120 L 125.33334,152.5 138,152 v -42 h -8 V 96 h 31 m 57,14 c 0,-2.84204 -0.51608,-6.25871 0.33333,-9 3.34434,-10.793121 19.61577,-2.093994 11.5,6.83333 -0.92279,1.01507 -2.54419,1.51106 -3.83333,1.83334 C 223.43948,110.30679 220.61993,110 218,110 M 41,110 36.833332,147 30,159 24,143 27,110 h 14 m 46,0 3,33 -6,15 h -2 c -5.366936,-8.49765 -6.053299,-17.26251 -7,-27 -0.672195,-6.91406 -2,-14.04004 -2,-21 h 14 m 106,0 v 12 h 9 v -12 h -9 m -75,42 -5,13 H 91 L 96.333336,151.5 104,151.66666 Z"/>
                    </svg>
                  </a>
                )}
                {member.social['500px'] && (
                  <a 
                    href={member.social['500px']} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="social-icon"
                    aria-label={`${member.name} 的 500px`}
                  >
                    <svg fill="currentColor" viewBox="0 0 24 24" width="20" height="20">
                      <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 22.5c-5.79 0-10.5-4.71-10.5-10.5S6.21 1.5 12 1.5 22.5 6.21 22.5 12 17.79 22.5 12 22.5zm0-18c-4.14 0-7.5 3.36-7.5 7.5s3.36 7.5 7.5 7.5 7.5-3.36 7.5-7.5S16.14 4.5 12 4.5zm0 13.5c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm0-10.5c-2.48 0-4.5 2.02-4.5 4.5s2.02 4.5 4.5 4.5 4.5-2.02 4.5-4.5S14.48 7.5 12 7.5z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .team-page {
    min-height: 100vh;
    background: #000;
    padding-top: 70px; /* 为固定导航栏留出空间 */
  }

  /* 页面标题区域 */
  .team-hero {
    position: relative;
    width: 100%;
    padding: 60px 20px 40px;
    text-align: center;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(30, 30, 30, 0.9) 50%,
      rgba(0, 0, 0, 0.9) 100%
    );
    overflow: hidden;
  }

  .team-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 50%, rgba(78, 205, 196, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(255, 107, 107, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    background: linear-gradient(45deg, #fff, #4ecdc4, #ff6b6b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: fadeInUp 1s ease-out;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: #ccc;
    margin: 0;
    font-weight: 300;
    letter-spacing: 1px;
    animation: fadeInUp 1.2s ease-out;
  }

  /* 团队成员区域 */
  .team-section {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .team-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* 成员卡片 */
  .member-card {
    background: linear-gradient(135deg, rgba(30, 30, 30, 0.8) 0%, rgba(20, 20, 20, 0.8) 100%);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    animation: fadeInUp 0.8s ease-out;
    animation-fill-mode: both;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px;
    min-height: fit-content;
  }

  .member-card:nth-child(1) {
    animation-delay: 0.1s;
  }

  .member-card:nth-child(2) {
    animation-delay: 0.2s;
  }

  .member-card:nth-child(3) {
    animation-delay: 0.3s;
  }

  .member-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(78, 205, 196, 0.2);
    border-color: rgba(78, 205, 196, 0.3);
  }

  /* 成员头像区域 */
  .member-image-wrapper {
    position: relative;
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    overflow: hidden;
  }

  .member-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    transition: border-color 0.4s ease;
    border: 4px solid rgba(78, 205, 196, 0.3);
  }

  .member-card:hover .member-avatar {
    border-color: rgba(78, 205, 196, 0.6);
  }

  .member-overlay {
    display: none;
  }

  /* 成员信息区域 */
  .member-info {
    flex: 1;
    padding: 0;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .member-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .member-name {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(45deg, #fff, #4ecdc4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .member-role {
    display: inline-block;
    padding: 6px 16px;
    background: linear-gradient(45deg, #4ecdc4, #ff6b6b);
    color: #fff;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .member-title {
    font-size: 1.2rem;
    color: #4ecdc4;
    margin: 0 0 20px 0;
    font-weight: 500;
  }

  .member-bio {
    font-size: 1rem;
    line-height: 1.8;
    color: #ccc;
    margin: 0 0 20px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 专长标签 */
  .member-specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .specialty-tag {
    padding: 6px 14px;
    background: rgba(78, 205, 196, 0.15);
    border: 1px solid rgba(78, 205, 196, 0.3);
    border-radius: 15px;
    font-size: 0.875rem;
    color: #4ecdc4;
    transition: all 0.3s ease;
  }

  .specialty-tag:hover {
    background: rgba(78, 205, 196, 0.25);
    border-color: #4ecdc4;
    transform: translateY(-2px);
  }

  /* 社交媒体链接 */
  .member-social {
    display: flex;
    gap: 15px;
    padding-top: 15px;
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .social-icon:hover {
    background: linear-gradient(45deg, #4ecdc4, #ff6b6b);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(78, 205, 196, 0.3);
  }

  /* 动画 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .team-hero {
      padding: 50px 20px 30px;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.2rem;
    }

    .team-section {
      padding: 30px 20px;
    }

    .team-container {
      gap: 30px;
    }

    .member-card {
      flex-direction: column;
      text-align: center;
      padding: 30px 20px;
      gap: 25px;
      max-height: none;
    }

    .member-image-wrapper {
      width: 180px;
      height: 180px;
    }

    .member-info {
      align-items: center;
    }

    .member-name {
      font-size: 1.75rem;
    }

    .member-header {
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    .member-bio {
      -webkit-line-clamp: 4;
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .member-card {
      padding: 25px 15px;
      gap: 20px;
    }

    .member-image-wrapper {
      width: 150px;
      height: 150px;
    }

    .member-name {
      font-size: 1.5rem;
    }

    .member-bio {
      font-size: 0.9rem;
      -webkit-line-clamp: 5;
    }
  }
</style>

