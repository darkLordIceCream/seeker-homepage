---
/**
 * Gallery 2.0 · Demo B「聚光舞台」（gallery-2.0 分支临时 demo 页，整合时删除）。
 * 主角解：一张主视觉立于上半屏（锁高约 48svh，宽 = 高 × ar，从横池随机轮换，
 * 宽度与比例数值过渡产生呼吸）——"一眼抓眼球"由主视觉的绝对面积保证；
 * 下半辅带 4 槽（2 横 2 竖）用等高丝带定理（flex-grow = ar）承接节奏。
 * 移动端：主视觉满宽并切换竖池（竖图在窄屏才有冲击力，--ar-m 断点变量），
 * 辅带收为三槽矮带。无 JS 时静态首图，布局公式与 JS 同源。
 */
import Layout from '@/layouts/Layout.astro';
import DemoBar from '@/components/gallery-demos/DemoBar.astro';
import Lightbox from '@/components/gallery-demos/Lightbox.astro';
import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

const arOf = (img: GalleryImage) => img.w / img.h;
const H_POOL = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 1.2 && ar < 2.2;
});
const V_POOL = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 0.5 && ar < 0.85;
});

const pick = (pool: readonly GalleryImage[], key: string): GalleryImage => {
  const hit = pool.find(i => i.src.includes(key));
  if (!hit) {
    throw new Error(`聚光 demo 首图缺失：${key}`);
  }
  return hit;
};

/** 主视觉：桌面横池首图（满月楼阁）；移动端竖池首图（深圳之眼，--ar-m） */
const SPOT_H = pick(H_POOL, '柠檬茶Jayalt');
const SPOT_V = pick(V_POOL, '月某人');

interface SlotCfg {
  kind: 'h' | 'v';
  first: GalleryImage;
  mHide?: boolean;
}

/** 辅带 2 横 2 竖（Σ≈4.3 → 行高约 22–30svh）；移动端显示 2 横 1 竖矮带 */
const AUX_SLOTS: SlotCfg[] = [
  { kind: 'h', first: pick(H_POOL, '阿帆') },
  { kind: 'v', first: pick(V_POOL, 'Ferman') },
  { kind: 'h', first: pick(H_POOL, 'Forever逍遥') },
  { kind: 'v', first: pick(V_POOL, '南迦巴瓦'), mHide: true },
];

const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
const capOf = (img: GalleryImage) =>
  img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`;
---

<Layout description="Seeker Gallery 2.0 方向 B：聚光舞台——主视觉呼吸的零裁切随机轮换画廊 demo" title="Gallery 2.0 · 方向 B 聚光舞台">
  <meta content="noindex" name="robots" slot="head" />
  <DemoBar current="spotlight" />

  <main class="spot-main" id="main-content">
    <header class="wall-head">
      <p class="kicker">Gallery · Featured</p>
      <h1 class="wall-title">画廊 · 追光者</h1>
      <p class="wall-lead">一张主视觉正在随机轮换，配角环绕承衬——每一帧都来自成员的真实拍摄。</p>
    </header>

    <figure class="spot" data-spot>
      <button
        aria-label={`放大查看 ${capOf(SPOT_H)}`}
        class="shot shot--spot"
        data-author={SPOT_H.author}
        data-full={SPOT_H.src}
        data-title={SPOT_H.title ?? ''}
        style={`--ar:${arOf(SPOT_H).toFixed(4)};--ar-m:${arOf(SPOT_V).toFixed(4)}`}         type="button"
      >
        <img
          alt={altOf(SPOT_H)}
          class="gimg is-active"
          decoding="async"
          height={SPOT_H.h}
          loading="eager"
          src={SPOT_H.src}
          width={SPOT_H.w}
        />
        <img alt="" aria-hidden="true" class="gimg" decoding="async" />
      </button>
      <figcaption class="spot-cap"><span class="gcap-text">{capOf(SPOT_H)}</span></figcaption>
    </figure>

    <section aria-label="辅带作品" class="ribbon-row">
      {
        AUX_SLOTS.map(cfg => {
          const img = cfg.first;
          const ar = arOf(img).toFixed(4);
          return (
            <figure class:list={['gslot', cfg.mHide && 'gslot--mhide']} data-kind={cfg.kind} style={`--ar:${ar};--fg:${ar}`}>
              <button
                aria-label={`放大查看 ${capOf(img)}`}
                class="shot"
                data-author={img.author}
                data-full={img.src}
                data-title={img.title ?? ''}
                type="button"
              >
                <img
                  alt={altOf(img)}
                  class="gimg is-active"
                  decoding="async"
                  height={img.h}
                  loading={cfg.mHide ? 'lazy' : 'eager'}
                  src={img.src}
                  width={img.w}
                />
                <img alt="" aria-hidden="true" class="gimg" decoding="async" />
              </button>
              <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
            </figure>
          );
        })
      }
    </section>
  </main>

  <Lightbox />
</Layout>

<script>
  import { startGalleryCycle } from '@/lib/gallery-cycle';
  import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

  const arOf = (img: GalleryImage) => img.w / img.h;
  const H_POOL = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 1.2 && ar < 2.2;
  });
  const V_POOL = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 0.5 && ar < 0.85;
  });

  // 主视觉：移动端换竖池（比例写入 --ar-m 供断点样式取用），桌面横池写 --ar。
  // 注意引擎槽元素必须是包含 img/button/caption 的容器（figure），不能是 button 本身
  const spotBtn = document.querySelector<HTMLElement>('[data-spot] .shot');
  const spotFig = document.querySelector<HTMLElement>('[data-spot]');
  const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

  const slots = [...document.querySelectorAll<HTMLElement>('.gslot')].map(el => ({
    el,
    pool: el.dataset.kind === 'v' ? V_POOL : H_POOL,
  }));
  if (spotFig) {
    slots.unshift({ el: spotFig, pool: isMobile() ? V_POOL : H_POOL });
  }
  startGalleryCycle(slots, {
    // 移动端主视觉需从横池首图尽快换到竖池（SSR 首图按桌面横池渲染）
    immediateEls: isMobile() && spotFig ? [spotFig] : [],
    onSwap: (el, img) => {
      const ar = arOf(img).toFixed(4);
      if (el === spotFig) {
        spotBtn?.style.setProperty(isMobile() ? '--ar-m' : '--ar', ar);
      } else {
        el.style.setProperty('--ar', ar);
        el.style.setProperty('--fg', ar);
      }
    },
  });
</script>

<style>
  .spot-main {
    max-width: 1264px;
    margin: 0 auto;
    padding: 24px 24px 32px;
  }

  .wall-head {
    text-align: center;
    margin-bottom: 14px;
  }

  .kicker {
    margin: 0 0 6px;
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--link);
  }

  .wall-title {
    margin: 0 0 6px;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--foreground);
  }

  .wall-lead {
    margin: 0 auto;
    max-width: 560px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  /* —— 主视觉：锁高呼吸，宽随比例走 —— */
  .spot {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .shot.shot--spot {
    width: min(100%, calc(42svh * var(--ar)));
    aspect-ratio: var(--ar);
    transition:
      width 0.9s ease,
      aspect-ratio 0.9s ease;
  }

  .spot-cap {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted-foreground);
  }

  /* —— 辅带：等高丝带定理（同方向 A），限宽控制任何组合的行高上限 —— */
  .ribbon-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 22px;
    max-width: 1060px;
    margin-left: auto;
    margin-right: auto;
  }

  .gslot {
    flex: var(--fg) 1 0%;
    min-width: 0;
    margin: 0;
    transition: flex-grow 0.9s ease;
  }

  .shot {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar);
    padding: 0;
    border: 0;
    background: var(--muted);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: aspect-ratio 0.9s ease;
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .gimg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .gimg.is-active {
    opacity: 1;
  }

  .gcap {
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .gslot,
    .shot,
    .shot.shot--spot,
    .gimg {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .spot-main {
      padding: 32px 20px 56px;
    }

    .ribbon-row {
      gap: 10px;
    }
  }

  /* —— 手机：主视觉满宽换竖图，辅带三槽矮带 —— */
  @media (max-width: 768px) {
    .spot-main {
      padding: 28px 16px 56px;
    }

    .shot.shot--spot {
      width: 100%;
      aspect-ratio: var(--ar-m);
    }

    .ribbon-row {
      gap: 8px;
      margin-top: 20px;
    }

    .gslot--mhide {
      display: none;
    }

    .gcap {
      font-size: 11px;
    }
  }
</style>
