---
/**
 * Gallery 2.0 · 方向对比板 · 第二轮（gallery-2.0 分支临时 demo 页，整合时删除）。
 * 本轮命题：随机轮换播放（延续线上机制）+ 零裁切 + 比例各异的照片在一屏内
 * 和谐展示 + 移动端优化。三个 demo 共享轮换引擎 src/lib/gallery-cycle.ts
 * 与 39 张真实图池（按比例分池），区别只在编排解法。
 */
import Layout from '@/layouts/Layout.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Direction {
  key: string;
  href: string;
  name: string;
  answer: string;
  detail: string;
  mobile: string;
  tradeoff: string;
}

const DIRECTIONS: Direction[] = [
  {
    key: 'A',
    href: '/gallery-demos/ribbon/',
    name: 'A · 丝带呼吸',
    answer: '数学解：行高 = 容器宽 ÷ 各图宽高比之和',
    detail:
      '每行所有图严格等高、行永远满宽——不同比例的照片由公式保证恰好拼满一行，零裁切不靠运气。轮换时整面墙如呼吸般重排（flex-grow 数值过渡，全浏览器支持）。桌面 8 张同屏（主带 3 + 辅带 5），任何轮换组合都不超一屏。',
    mobile: '手机：主带留竖槽满宽（竖图在窄屏才有冲击力），辅带收为 2 横 1 竖矮带',
    tradeoff: '取舍：等高抹平了主次，没有唯一的"主视觉"',
  },
  {
    key: 'B',
    href: '/gallery-demos/spotlight/',
    name: 'B · 聚光舞台',
    answer: '主角解：一张主视觉 + 等高丝带配角带',
    detail:
      '主视觉锁高约一屏一半、宽随比例呼吸（横池 15 张随机轮换），"一眼抓眼球"由绝对面积保证；下半 4 槽配角用与 A 相同的丝带定理承衬。最接近"品牌官网主视觉"的层级语言。',
    mobile: '手机：主视觉满宽并换竖池（--ar-m 断点变量，竖图满屏），辅带三槽矮带',
    tradeoff: '取舍：辅带视觉权重低，图片总数 5 张少于 A/C',
  },
  {
    key: 'C',
    href: '/gallery-demos/waterfall/',
    name: 'C · 瀑布长廊',
    answer: '密度解：超宽横幅锚点 + 三列错宽瀑布长墙',
    detail:
      '顶部满宽超宽横幅（全场唯一 2.47:1，静态主角）压阵，下方三列错宽瀑布 10 张照片——masonry 天然零裁切，任意视口切片内的画面都和谐。照片数量最多、信息量最大，"往下拉才看完"的沉浸长墙。',
    mobile: '手机：收为两列瀑布，横幅满宽压阵',
    tradeoff: '取舍：整段超过一屏（长墙定位），没有严格的"一屏收齐"',
  },
];
---

<Layout description="Seeker Gallery 2.0 方向对比板（第二轮）：随机轮换零裁切画廊三解法" title="Gallery 2.0 · 方向对比板">
  <meta content="noindex" name="robots" slot="head" />
  <header class="board-bar">
    <p class="board-brand">Seeker · Gallery 2.0 方向对比板 · 第二轮</p>
    <div class="board-theme">
      <ThemeToggle />
    </div>
  </header>

  <main class="board-main" id="main-content">
    <section class="board-intro">
      <h1>同一个命题，三种解法</h1>
      <p>
        命题：<strong>随机轮换播放 + 零裁切 + 比例各异的照片在一屏内和谐展示</strong>。
        三个 demo 共享轮换引擎（每槽 3–6s 独立随机间隔、预载后交叉淡入、hover 暂停、
        页面不可见即暂停）与 39 张真实图池（按宽高比分池：横 15 / 竖 15 / 近方 2 / 超宽 1，
        轮换只在同池取图，比例波动天然受控）。
      </p>
      <ul class="rules">
        <li><strong>零裁切</strong>：墙与灯箱一律原图比例</li>
        <li><strong>随机播放</strong>：盯着看 10 秒，会看到它呼吸/轮换</li>
        <li><strong>灯箱</strong>：点击任意照片；Esc 关闭、←→ 切换、焦点归还</li>
        <li><strong>双主题</strong>：右上角切换明暗</li>
      </ul>
    </section>

    <section aria-label="三个候选方向" class="board-grid">
      {
        DIRECTIONS.map(d => (
          <article class="dir-card">
            <a aria-label={`打开完整 demo：${d.name}`} class="pv-frame" href={d.href}>
              <iframe loading="lazy" src={d.href} title={`${d.name} 预览`} />
            </a>
            <div class="dir-body">
              <h2><a href={d.href}>{d.name}</a></h2>
              <p class="answer">{d.answer}</p>
              <p class="tagline">{d.detail}</p>
              <p class="meta">{d.mobile}</p>
              <p class="meta meta--ref">{d.tradeoff}</p>
              <a class="open" href={d.href}>
                打开完整 demo
                <svg aria-hidden="true" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <section aria-label="怎么选" class="board-howto">
      <h2>建议的评选路径</h2>
      <ol>
        <li>每个页面停留 15 秒以上，看轮换瞬间整面墙是否保持和谐、有没有跳动或裁切</li>
        <li>把窗口缩到手机宽度：A/B 的移动端是"竖图满屏"方案，C 是两列瀑布</li>
        <li>点开灯箱确认看到的就是墙上那张，再用 ←→ 多翻几张</li>
        <li>可以混搭：例如「B 的主视觉 + A 的丝带辅带」，选定后下一轮落进首页 #works</li>
      </ol>
      <p class="gate-note">
        展示记录与选择将归档在 <code>design-demos/homepage-gallery/direction-approved.md</code>。
      </p>
    </section>
  </main>
</Layout>

<script>
  // 预览缩放：iframe 按 1440 宽渲染，缩放至卡片实宽（ResizeObserver 跟随窗口变化）
  document.querySelectorAll<HTMLElement>('.pv-frame').forEach(frame => {
    const ifr = frame.querySelector('iframe');
    if (!ifr) {return;}
    const fit = () => {
      const s = frame.clientWidth / 1440;
      ifr.style.transform = `scale(${s})`;
    };
    if ('ResizeObserver' in window) {
      new ResizeObserver(fit).observe(frame);
    }
    fit();
    window.addEventListener('resize', fit, { passive: true });
  });
</script>

<style>
