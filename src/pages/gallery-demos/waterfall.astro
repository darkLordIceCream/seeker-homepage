---
/**
 * Gallery 2.0 · Demo C「瀑布长廊」（gallery-2.0 分支临时 demo 页，整合时删除）。
 * 密度解：顶部满宽超宽横幅（全场唯一的 2.47:1 静态主角）+ 三列错宽瀑布
 * （1.05/1.25/0.85fr × 每列 3 张 = 10 张照片的长墙）。masonry 天然零裁切，
 * 任意视口切片内的画面都和谐——整段是"往下拉才看完"的沉浸长墙。
 * 轮换限定在相近比例子池（±0.08，构建期计算），槽位高度波动最小化；
 * 单图池（横幅）引擎自然跳过。移动端收为两列。
 */
import Layout from '@/layouts/Layout.astro';
import DemoBar from '@/components/gallery-demos/DemoBar.astro';
import Lightbox from '@/components/gallery-demos/Lightbox.astro';
import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

const arOf = (img: GalleryImage) => img.w / img.h;

const pick = (key: string): GalleryImage => {
  const hit = GALLERY_POOL.find(i => i.src.includes(key));
  if (!hit) {
    throw new Error(`瀑布 demo 首图缺失：${key}`);
  }
  return hit;
};

interface ColCfg {
  fr: string;
  cls: string;
  items: GalleryImage[];
}

const COLS: ColCfg[] = [
  {
    fr: '1.05',
    cls: 'wf-col--1',
    items: [pick('南迦巴瓦'), pick('日行性猫猫'), pick('Zijie-Chen')],
  },
  {
    fr: '1.25',
    cls: 'wf-col--2',
    items: [pick('阿帆'), pick('纯黑的林桑'), pick('LUee')],
  },
  {
    fr: '0.85',
    cls: 'wf-col--3',
    items: [pick('舒克大地瓜'), pick('Tommic'), pick('Ferman')],
  },
];

const BANNER = pick('Feiyu');
const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
const capOf = (img: GalleryImage) =>
  img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`;
---

<Layout description="Seeker Gallery 2.0 方向 C：瀑布长廊——三列错宽零裁切密度墙 demo" title="Gallery 2.0 · 方向 C 瀑布长廊">
  <meta content="noindex" name="robots" slot="head" />
  <DemoBar current="waterfall" />

  <main class="wf-main" id="main-content">
    <header class="wall-head">
      <p class="kicker">Gallery · Featured</p>
      <h1 class="wall-title">画廊 · 追光者</h1>
      <p class="wall-lead">十张照片的长墙，正在随机轮换——往下慢慢拉。</p>
    </header>

    <figure class="banner">
      <button
        aria-label={`放大查看 ${capOf(BANNER)}`}
        class="shot shot--banner"
        data-author={BANNER.author}
        data-full={BANNER.src}
        data-title={BANNER.title ?? ''}
        style={`--ar:${arOf(BANNER).toFixed(4)}`}         type="button"
      >
        <img
          alt={altOf(BANNER)}
          class="gimg is-active"
          decoding="async"
          fetchpriority="high"
          height={BANNER.h}
          loading="eager"
          src={BANNER.src}
          width={BANNER.w}
        />
        <img alt="" aria-hidden="true" class="gimg" decoding="async" />
      </button>
      <figcaption class="gcap"><span class="gcap-text">{capOf(BANNER)}</span></figcaption>
    </figure>

    <div class="wf-grid">
      {
        COLS.map(col => (
          <div class:list={['wf-col', col.cls]} style={`--fr:${col.fr}`}>
            {col.items.map(img => {
              const ar = arOf(img).toFixed(4);
              return (
                <figure class="gslot" style={`--ar:${ar}`}>
                  <button
                    aria-label={`放大查看 ${capOf(img)}`}
                    class="shot"
                    data-author={img.author}
                    data-full={img.src}
                    data-title={img.title ?? ''}
                    type="button"
                  >
                    <img
                      alt={altOf(img)}
                      class="gimg is-active"
                      decoding="async"
                      height={img.h}
                      loading="lazy"
                      src={img.src}
                      width={img.w}
                    />
                    <img alt="" aria-hidden="true" class="gimg" decoding="async" />
                  </button>
                  <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
                </figure>
              );
            })}
          </div>
        ))
      }
    </div>

    <footer class="wall-foot">
      <a class="explore" href="/#works">
        探索全部作品
        <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    </footer>
  </main>

  <Lightbox />
</Layout>

<script>
  import { startGalleryCycle } from '@/lib/gallery-cycle';
  import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

  const arOf = (img: GalleryImage) => img.w / img.h;

  // 槽位池 = 相近比例子池（±0.08），与构建期同规则
  const slots = [...document.querySelectorAll<HTMLElement>('.gslot')].map(el => {
    const active = el.querySelector<HTMLImageElement>('img.gimg.is-active');
    const src = active?.getAttribute('src') ?? '';
    const ref = GALLERY_POOL.find(i => i.src === src);
    const pool = ref
      ? GALLERY_POOL.filter(i => Math.abs(arOf(i) - arOf(ref)) <= 0.08)
      : GALLERY_POOL;
    return { el, pool };
  });
  startGalleryCycle(slots, {
    onSwap: (el, img) => {
      el.style.setProperty('--ar', arOf(img).toFixed(4));
    },
  });
</script>

<style>
  .wf-main {
    max-width: 1328px;
    margin: 0 auto;
    padding: 40px 24px 72px;
  }

  .wall-head {
    text-align: center;
    margin-bottom: 24px;
  }

  .kicker {
    margin: 0 0 10px;
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--link);
  }

  .wall-title {
    margin: 0 0 10px;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--foreground);
  }

  .wall-lead {
    margin: 0 auto;
    max-width: 520px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .banner {
    margin: 0;
  }

  .wf-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.25fr 0.85fr;
    gap: 14px;
    align-items: start;
    margin-top: 28px;
  }

  .wf-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .gslot {
    margin: 0;
  }

  .shot {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar);
    padding: 0;
    border: 0;
    background: var(--muted);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: aspect-ratio 0.9s ease;
  }

  .shot--banner {
    aspect-ratio: var(--ar);
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .gimg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .gimg.is-active {
    opacity: 1;
  }

  .gcap {
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wall-foot {
    margin-top: 48px;
    text-align: center;
  }

  .explore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--foreground);
    font-size: 13px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .explore:hover {
    border-color: var(--link);
    color: var(--link);
  }

  .explore:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot,
    .gimg {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .wf-main {
      padding: 32px 20px 56px;
    }

    .wf-grid {
      gap: 10px;
    }

    .wf-col {
      gap: 12px;
    }
  }

  /* —— 手机：收为两列（第三列隐藏） —— */
  @media (max-width: 768px) {
    .wf-main {
      padding: 28px 16px 56px;
    }

    .wf-grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 20px;
    }

    .wf-col--3 {
      display: none;
    }

    .wf-col {
      gap: 12px;
    }

    .gcap {
      font-size: 11px;
    }
  }
</style>
