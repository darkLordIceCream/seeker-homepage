---
/**
 * Gallery 2.0 · Demo A「舞台聚光」（gallery-2.0 分支临时 demo 页，整合时删除）。
 * 方向定位：哈苏式品牌精选墙——一张主视觉立于中央舞台，五张作品以
 * 居中组团 + 轻错位收尾，全部原图比例零裁切；节奏来自宽度与留白。
 * 移动端：主视觉满幅 + 其余五张横向吸附卡轨（符合站内移动端横滑偏好）。
 */
import Layout from '@/layouts/Layout.astro';
import DemoBar from '@/components/gallery-demos/DemoBar.astro';
import Lightbox from '@/components/gallery-demos/Lightbox.astro';
import { GALLERY_FEATURED, type GalleryImage } from '@/data/gallery';

const must = (i: number): GalleryImage => {
  const img = GALLERY_FEATURED[i];
  if (!img) {
    throw new Error(`GALLERY_FEATURED[${i}] 缺失`);
  }
  return img;
};

/** 策展顺序：No.01 超宽峡谷（舞台主角）→ 02–06 依次环绕 */
const [hero, w2, w3, w4, w5, w6] = [must(0), must(1), must(2), must(3), must(4), must(5)];

const no = (i: number) => String(i + 1).padStart(2, '0');
const credit = (img: GalleryImage) => (img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`);
const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
---

<Layout description="Seeker Gallery 2.0 方向 A：舞台聚光——零裁切编辑式精选墙 demo" title="Gallery 2.0 · 方向 A 舞台聚光">
  <meta content="noindex" name="robots" slot="head" />
  <DemoBar current="stage" />

  <main class="demo-main" id="main-content">
    <header class="wall-head">
      <p class="kicker">Gallery · Featured</p>
      <h1 class="wall-title">画廊 · 本季精选</h1>
      <p class="wall-lead">六张作品，来自社群成员的真实视线。点击任意照片进入沉浸观看。</p>
    </header>

    <figure class="hero-fig work">
      <button
        aria-label={`放大查看 ${credit(hero)}`}
        class="shot"
        data-author={hero.author}
        data-full={hero.src}
        data-title={hero.title ?? ''}
        type="button"
      >
        <img
          alt={altOf(hero)}
          decoding="async"
          fetchpriority="high"
          height={hero.h}
          loading="eager"
          src={hero.src}
          width={hero.w}
        />
      </button>
      <figcaption><span class="no">No.{no(0)}</span>{credit(hero)}</figcaption>
    </figure>

    <div aria-label="更多精选作品" class="wall-sats" role="region" tabindex="0">
      <div class="sat-row sat-row--i">
        <figure class="work work--t1">
          <button
            aria-label={`放大查看 ${credit(w2)}`}
            class="shot"
            data-author={w2.author}
            data-full={w2.src}
            data-title={w2.title ?? ''}
            type="button"
          >
            <img alt={altOf(w2)} decoding="async" height={w2.h} loading="lazy" src={w2.src} width={w2.w} />
          </button>
          <figcaption><span class="no">No.{no(1)}</span>{credit(w2)}</figcaption>
        </figure>
        <figure class="work work--m1">
          <button
            aria-label={`放大查看 ${credit(w3)}`}
            class="shot"
            data-author={w3.author}
            data-full={w3.src}
            data-title={w3.title ?? ''}
            type="button"
          >
            <img alt={altOf(w3)} decoding="async" height={w3.h} loading="lazy" src={w3.src} width={w3.w} />
          </button>
          <figcaption><span class="no">No.{no(2)}</span>{credit(w3)}</figcaption>
        </figure>
        <figure class="work work--t2">
          <button
            aria-label={`放大查看 ${credit(w4)}`}
            class="shot"
            data-author={w4.author}
            data-full={w4.src}
            data-title={w4.title ?? ''}
            type="button"
          >
            <img alt={altOf(w4)} decoding="async" height={w4.h} loading="lazy" src={w4.src} width={w4.w} />
          </button>
          <figcaption><span class="no">No.{no(3)}</span>{credit(w4)}</figcaption>
        </figure>
      </div>

      <div class="sat-row sat-row--ii">
        <figure class="work work--m2">
          <button
            aria-label={`放大查看 ${credit(w5)}`}
            class="shot"
            data-author={w5.author}
            data-full={w5.src}
            data-title={w5.title ?? ''}
            type="button"
          >
            <img alt={altOf(w5)} decoding="async" height={w5.h} loading="lazy" src={w5.src} width={w5.w} />
          </button>
          <figcaption><span class="no">No.{no(4)}</span>{credit(w5)}</figcaption>
        </figure>
        <figure class="work work--t3">
          <button
            aria-label={`放大查看 ${credit(w6)}`}
            class="shot"
            data-author={w6.author}
            data-full={w6.src}
            data-title={w6.title ?? ''}
            type="button"
          >
            <img alt={altOf(w6)} decoding="async" height={w6.h} loading="lazy" src={w6.src} width={w6.w} />
          </button>
          <figcaption><span class="no">No.{no(5)}</span>{credit(w6)}</figcaption>
        </figure>
      </div>
    </div>

    <footer class="wall-foot">
      <a class="explore" href="/#works">
        探索全部作品
        <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    </footer>
  </main>

  <Lightbox />
</Layout>

<script>
  // 入场：进入视口一次后定格（无 IO 或 reduced-motion 时直接可见）
  const items = document.querySelectorAll('.work');
  if ('IntersectionObserver' in window) {
    const reveal = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            reveal.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    items.forEach(item => reveal.observe(item));
  } else {
    items.forEach(item => item.classList.add('is-visible'));
  }
</script>

<style>
  .demo-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 72px 24px 120px;
  }

  /* —— 头部：中轴舞台式 —— */
  .wall-head {
    text-align: center;
  }

  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--link);
  }

  .wall-title {
    margin: 0 0 14px;
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--foreground);
  }

  .wall-lead {
    margin: 0 auto;
    max-width: 560px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  /* —— 作品通用：零裁切（width:100% + height:auto + 原始宽高属性） —— */
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 4px;
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.22s ease;
  }

  .shot:hover img {
    transform: scale(1.015);
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  .work {
    margin: 0;
  }

  .work figcaption {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  .work .no {
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--foreground);
  }

  /* —— 主视觉：中央舞台 —— */
  .hero-fig {
    width: min(100%, 1100px);
    margin: 56px auto 0;
  }

  /* —— 星位组团：居中排布 + 尾排轻错位 —— */
  .sat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .sat-row--i {
    margin-top: 96px;
  }

  .sat-row--ii {
    margin-top: 104px;
  }

  .work--t1 { flex: 0 1 24%; }
  .work--m1 { flex: 0 1 44%; }
  .work--t2 { flex: 0 1 22%; }
  .work--m2 { flex: 0 1 38%; }
  .work--t3 {
    flex: 0 1 24%;
    margin-top: 96px;
  }

  /* —— 尾部入口 —— */
  .wall-foot {
    margin-top: 128px;
    text-align: center;
  }

  .explore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--foreground);
    font-size: 14px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .explore:hover {
    border-color: var(--link);
    color: var(--link);
  }

  .explore:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  /* —— 入场动效 —— */
  html.js .work {
    opacity: 0;
    transform: translateY(18px);
  }

  html.js .work.is-visible {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .work {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .shot img,
    .explore {
      transition: none;
    }
  }

  /* —— 平板 —— */
  @media (max-width: 1199px) and (min-width: 769px) {
    .demo-main {
      padding: 56px 24px 96px;
    }

    .sat-row--i {
      margin-top: 64px;
    }

    .sat-row--ii {
      margin-top: 72px;
    }

    .work--t1 { flex-basis: 27%; }
    .work--m1 { flex-basis: 46%; }
    .work--t2 { flex-basis: 25%; }
    .work--m2 { flex-basis: 42%; }
    .work--t3 {
      flex-basis: 26%;
      margin-top: 64px;
    }

    .wall-foot {
      margin-top: 88px;
    }
  }

  /* —— 手机：主视觉满幅 + 横向吸附卡轨 —— */
  @media (max-width: 768px) {
    .demo-main {
      padding: 48px 20px 80px;
    }

    .hero-fig {
      width: 100%;
      margin-top: 36px;
    }

    .wall-sats {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      margin: 40px -20px 0;
      padding: 8px 20px 16px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .sat-row {
      display: contents;
    }

    .wall-sats .work {
      flex: 0 0 min(74vw, 420px);
      scroll-snap-align: start;
      margin: 0;
    }

    .wall-sats .work figcaption {
      justify-content: flex-start;
    }

    .wall-foot {
      margin-top: 64px;
    }
  }
</style>
