---
/**
 * Gallery 2.0 · Demo A「丝带呼吸」（gallery-2.0 分支临时 demo 页，整合时删除）。
 * 等高丝带定理：一行内所有图等高时，行高 = 容器宽 ÷ 各图宽高比之和（Σar）。
 * 实现：槽 flex-grow = 自身 ar、aspect-ratio = 自身 ar → 行永远满宽、等高、
 * 零裁切，与塞进什么比例无关。轮换只在横/竖同池内取图，比例波动受控；
 * 换图时 flex-grow 与 aspect-ratio 数值过渡，整面墙如呼吸般重排。
 * 移动端：主带只留竖槽满宽（竖图在窄屏才有冲击力），辅带收为三槽矮带。
 * 无 JS 时为静态首图（SSR 兜底公式与 JS 同源，依旧零裁切和谐）。
 */
import Layout from '@/layouts/Layout.astro';
import DemoBar from '@/components/gallery-demos/DemoBar.astro';
import Lightbox from '@/components/gallery-demos/Lightbox.astro';
import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

/** 比例分池：横 1.2–2.2 / 竖 0.5–0.85（超宽与近方各成一类不入轮换池）。
 *  主带竖槽用 V_MAIN（0.6–0.85，排除 0.56 极端竖图），保证任何轮换组合行高
 *  ≤ 480px——整页任何组合都不超一屏 */
const arOf = (img: GalleryImage) => img.w / img.h;
const H_POOL = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 1.2 && ar < 2.2;
});
const V_POOL = GALLERY_POOL.filter(i => {
  const ar = arOf(i);
  return ar >= 0.5 && ar < 0.85;
});
const V_MAIN = V_POOL.filter(i => arOf(i) >= 0.6);

/** 按文件名片段取指定首图（真实池内引用，不复制字段） */
const pick = (pool: readonly GalleryImage[], key: string): GalleryImage => {
  const hit = pool.find(i => i.src.includes(key));
  if (!hit) {
    throw new Error(`丝带 demo 首图缺失：${key}`);
  }
  return hit;
};

interface SlotCfg {
  kind: 'h' | 'v' | 'v-main';
  first: GalleryImage;
  /** 移动端是否隐藏 */
  mHide?: boolean;
}

/** 主带 1 横 2 竖（V_MAIN 池，Σ≈2.53–3.28 → 行高 371–480px）；辅带 3 横 2 竖。
 *  移动端只保留第一个竖槽满宽（h 与第二个竖槽 mHide） */
const MAIN_SLOTS: SlotCfg[] = [
  { kind: 'h', first: pick(H_POOL, '心游万仞'), mHide: true },
  { kind: 'v-main', first: pick(V_MAIN, 'Henry浩麟') },
  { kind: 'v-main', first: pick(V_MAIN, '南迦巴瓦'), mHide: true },
];
const AUX_SLOTS: SlotCfg[] = [
  { kind: 'h', first: pick(H_POOL, 'Michelle_Chen') },
  { kind: 'h', first: pick(H_POOL, 'Tommic'), mHide: true },
  { kind: 'v', first: pick(V_POOL, '镜中') },
  { kind: 'h', first: pick(H_POOL, '王哼哼') },
  { kind: 'v', first: pick(V_POOL, 'Ferman'), mHide: true },
];

const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
const capOf = (img: GalleryImage) =>
  img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`;
---

<Layout description="Seeker Gallery 2.0 方向 A：丝带呼吸——等高丝带定理下的零裁切随机轮换画廊 demo" title="Gallery 2.0 · 方向 A 丝带呼吸">
  <meta content="noindex" name="robots" slot="head" />
  <DemoBar current="ribbon" />

  <main class="ribbon-main" id="main-content">
    <header class="wall-head">
      <p class="kicker">Gallery · Featured</p>
      <h1 class="wall-title">画廊 · 追光者</h1>
      <p class="wall-lead">
        照片按原始比例随机轮换，等高丝带让任何比例都恰好填满一行——盯着看，它在呼吸。
      </p>
    </header>

    <section aria-label="主带作品" class="ribbon-row ribbon-row--main">
      {
        MAIN_SLOTS.map(cfg => {
          const img = cfg.first;
          const ar = arOf(img).toFixed(4);
          return (
            <figure class:list={['gslot', cfg.mHide && 'gslot--mhide']} data-kind={cfg.kind} style={`--ar:${ar};--fg:${ar}`}>
              <button
                aria-label={`放大查看 ${capOf(img)}`}
                class="shot"
                data-author={img.author}
                data-full={img.src}
                data-title={img.title ?? ''}
                type="button"
              >
                <img
                  alt={altOf(img)}
                  class="gimg is-active"
                  decoding="async"
                  height={img.h}
                  loading="eager"
                  src={img.src}
                  width={img.w}
                />
                <img alt="" aria-hidden="true" class="gimg" decoding="async" />
              </button>
              <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
            </figure>
          );
        })
      }
    </section>

    <section aria-label="辅带作品" class="ribbon-row ribbon-row--aux">
      {
        AUX_SLOTS.map(cfg => {
          const img = cfg.first;
          const ar = arOf(img).toFixed(4);
          return (
            <figure class:list={['gslot', cfg.mHide && 'gslot--mhide']} data-kind={cfg.kind} style={`--ar:${ar};--fg:${ar}`}>
              <button
                aria-label={`放大查看 ${capOf(img)}`}
                class="shot"
                data-author={img.author}
                data-full={img.src}
                data-title={img.title ?? ''}
                type="button"
              >
                <img
                  alt={altOf(img)}
                  class="gimg is-active"
                  decoding="async"
                  height={img.h}
                  loading={cfg.mHide ? 'lazy' : 'eager'}
                  src={img.src}
                  width={img.w}
                />
                <img alt="" aria-hidden="true" class="gimg" decoding="async" />
              </button>
              <figcaption class="gcap"><span class="gcap-text">{capOf(img)}</span></figcaption>
            </figure>
          );
        })
      }
    </section>
  </main>

  <Lightbox />
</Layout>

<script>
  import { startGalleryCycle } from '@/lib/gallery-cycle';
  import { GALLERY_POOL, type GalleryImage } from '@/data/gallery';

  const arOf = (img: GalleryImage) => img.w / img.h;
  const H_POOL = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 1.2 && ar < 2.2;
  });
  const V_POOL = GALLERY_POOL.filter(i => {
    const ar = arOf(i);
    return ar >= 0.5 && ar < 0.85;
  });
  const V_MAIN = V_POOL.filter(i => arOf(i) >= 0.6);

  // 轮换：换图后更新槽位比例变量 → flex-grow / aspect-ratio 过渡 → 整行呼吸重排
  const slots = [...document.querySelectorAll<HTMLElement>('.gslot')].map(el => ({
    el,
    pool:
      el.dataset.kind === 'h'
        ? H_POOL
        : el.dataset.kind === 'v-main'
          ? V_MAIN
          : V_POOL,
  }));
  startGalleryCycle(slots, {
    onSwap: (el, img) => {
      const ar = arOf(img).toFixed(4);
      el.style.setProperty('--ar', ar);
      el.style.setProperty('--fg', ar);
    },
  });
</script>

<style>
  .ribbon-main {
    max-width: 1264px;
    margin: 0 auto;
    padding: 28px 24px 40px;
  }

  .wall-head {
    text-align: center;
    margin-bottom: 16px;
  }

  .kicker {
    margin: 0 0 6px;
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--link);
  }

  .wall-title {
    margin: 0 0 6px;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--foreground);
  }

  .wall-lead {
    margin: 0 auto;
    max-width: 560px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  /* —— 丝带行：flex-grow = ar → 等高丝带定理 —— */
  .ribbon-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .ribbon-row--aux {
    margin-top: 16px;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .gslot {
    flex: var(--fg) 1 0%;
    min-width: 0;
    margin: 0;
    transition: flex-grow 0.9s ease;
  }

  .shot {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar);
    padding: 0;
    border: 0;
    background: var(--muted);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: aspect-ratio 0.9s ease;
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .gimg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .gimg.is-active {
    opacity: 1;
  }

  .gcap {
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gcap-text {
    transition: opacity 0.4s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .gslot,
    .shot,
    .gimg,
    .gcap-text {
      transition: none;
    }
  }

  /* —— 平板：辅带藏一槽 —— */
  @media (max-width: 1023px) {
    .ribbon-main {
      padding: 32px 20px 56px;
    }

    .ribbon-row {
      gap: 10px;
    }
  }

  /* —— 手机：主带留竖槽满宽，辅带收为 2 横 1 竖矮带 —— */
  @media (max-width: 768px) {
    .ribbon-main {
      padding: 28px 16px 56px;
    }

    .ribbon-row {
      gap: 8px;
    }

    .gslot--mhide {
      display: none;
    }

    .ribbon-row--main .gslot[data-kind='h'] {
      display: none;
    }

    /* 移动端主带只剩单槽：绕开单 item flex-grow 分配怪癖，强制满宽 */
    .ribbon-row--main .gslot:not(.gslot--mhide) {
      flex: 1 1 100%;
    }

    .ribbon-row--aux {
      margin-top: 12px;
    }

    .gcap {
      font-size: 11px;
    }
  }
</style>
