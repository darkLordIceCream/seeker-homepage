---
// 公益项目二级页：项目介绍 + 项目图文手记（拍立得堆叠卡片）
// 卡片点击进入具体文章页 /welfare/[slug]
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const articles = (await getCollection('welfare')).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf() || a.data.order - b.data.order,
);

const fmtDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<Layout description="Seeker公益「带上她的眼睛」——山村中的摄影课，把相机交到大山孩子手里" title="Seeker公益 · 带上她的眼睛">
  <Navigation />

  <main class="welfare-page" id="main-content">
    <header class="welfare-hero">
      <p class="hero-kicker">SEEKER 公益 · WELFARE</p>
      <h1 class="hero-title">
        带上<span class="hero-accent">她的眼睛</span>
      </h1>
      <p class="hero-line">山村中的摄影课</p>
      <p class="hero-desc">
        我们把相机交到大山孩子的手里。光影不问出处——山野、云海、苞谷地和门前的路，
        在孩子们的镜头里长成一首首具体的诗。摄影课教的不只是拍照，
        更是让每一份平凡生活的感受力，被看见、被表达、被记住。
      </p>
    </header>

    <section aria-labelledby="records-title" class="records-section">
      <header class="records-head">
        <h2 class="records-title" id="records-title">
          图文手记 <span class="records-en">Records</span>
        </h2>
        <span class="records-count">{articles.length} 篇</span>
      </header>

      <div class="photo-stack">
        {articles.map((article, index) => (
          <a
            aria-label={`${article.data.title}：${article.data.excerpt}`}
            class:list={['stack-card', { active: articles.length > 1 && index === Math.min(1, articles.length - 1) }]}
            data-stack-card
            href={`/welfare/${article.id}/`}
            style={`--rot:${(index % 2 === 0 ? -1 : 1) * (2 + (index % 3))}deg;--dy:${index % 2 === 0 ? 10 : -6}px`}
          >
            <span class="stack-img ph-tile" style={`background-image:url('${article.data.cover}')`}>
              <span class="stack-tag">{fmtDate(article.data.pubDate)}</span>
            </span>
            <span class="stack-meta">
              <strong>{article.data.title}</strong>
              <small>{article.data.subtitle}</small>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .welfare-page {
    min-height: 100vh;
    background: var(--background);
    padding-top: 70px;
  }

  /* —— 项目介绍 —— */
  .welfare-hero {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 24px 48px;
    text-align: center;
    overflow: hidden;
  }

  .welfare-hero::before {
    content: '';
    position: absolute;
    inset: -40% -20%;
    background:
      radial-gradient(circle at 25% 30%, var(--glow-a) 0%, transparent 45%),
      radial-gradient(circle at 75% 70%, var(--glow-b) 0%, transparent 45%);
    pointer-events: none;
  }

  .hero-kicker {
    position: relative;
    margin: 0 0 18px;
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--grad-a);
  }

  .hero-title {
    position: relative;
    margin: 0 0 14px;
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--foreground);
  }

  .hero-accent {
    background: linear-gradient(45deg, var(--grad-a), var(--grad-b));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-line {
    position: relative;
    margin: 0 0 26px;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    color: var(--muted-foreground);
  }

  .hero-desc {
    position: relative;
    margin: 0 auto;
    max-width: 560px;
    font-size: 14.5px;
    line-height: 2;
    color: var(--muted-foreground);
    text-align: justify;
  }

  /* —— 图文手记 —— */
  .records-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 24px 96px;
  }

  .records-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .records-title {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--foreground);
  }

  .records-en {
    margin-left: 6px;
    font-family: 'Archivo', sans-serif;
    font-size: 0.65em;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .records-count {
    font-size: 13px;
    color: var(--muted-foreground);
  }

  /* 拍立得堆叠：与首页活动卡片同一语言 */
  .photo-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding: 30px 0 12px;
  }

  .stack-card {
    position: relative;
    width: min(86%, 360px);
    aspect-ratio: 4 / 3.9;
    background: #fff;
    padding: 10px 10px 56px;
    border-radius: 6px;
    box-shadow: 0 14px 38px rgba(76, 79, 105, 0.28);
    transform: rotate(var(--rot)) translateY(var(--dy));
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
    text-decoration: none;
  }

  .stack-card + .stack-card {
    margin-left: -4%;
  }

  .stack-card.active {
    transform: rotate(0deg) translateY(calc(var(--dy) - 18px)) scale(1.05);
    z-index: 10;
    box-shadow: 0 28px 60px rgba(76, 79, 105, 0.38);
  }

  .stack-card:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
  }

  .stack-img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 3px;
    background-size: cover;
    background-position: center;
    background-color: var(--secondary);
  }

  .stack-tag {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 3px 10px;
    border-radius: 999px;
    /* 深色玻璃底：浅色照片上白字也可读 */
    background: rgba(30, 34, 46, 0.42);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: 'Archivo', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #fff;
  }

  .stack-meta {
    position: absolute;
    left: 16px;
    right: 12px;
    bottom: 17px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .stack-meta strong {
    font-size: 15px;
    color: #3a3f55;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stack-meta small {
    font-size: 11px;
    color: #9093a8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .welfare-hero {
      padding: 48px 20px 36px;
    }

    .records-section {
      padding: 16px 20px 72px;
    }

    .stack-card + .stack-card {
      margin-left: 0;
      margin-top: -30px;
    }
  }
</style>

<script>
  // 突出状态跟随鼠标/焦点：放到哪张哪张突出，移开后保持，直到放到其他卡片
  const cards = document.querySelectorAll<HTMLElement>('[data-stack-card]');

  if (cards.length > 0) {
    const setActive = (card: HTMLElement) => {
      cards.forEach(c => c.classList.toggle('active', c === card));
    };

    cards.forEach(card => {
      card.addEventListener('mouseenter', () => setActive(card));
      card.addEventListener('focus', () => setActive(card));
    });
  }
</script>
