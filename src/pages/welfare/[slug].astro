---
// 公益文章路由：按 frontmatter layout 字段分发到对应模板
// - editorial（默认）：画册/编辑部风格（不对称头版 + 衬线正文 + drop cap）
// - hasselblad：哈苏式图集排版（居中头版 + 宽字距章节 + 等高图组 + 居中正文）
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleEditorial from '../../components/welfare/ArticleEditorial.astro';
import ArticleHasselblad from '../../components/welfare/ArticleHasselblad.astro';

export async function getStaticPaths() {
  const articles = await getCollection('welfare');
  return articles.map(article => ({
    params: { slug: article.id },
    props: {
      article,
      others: articles
        .filter(a => a.id !== article.id)
        .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()),
    },
  }));
}

const { article, others } = Astro.props;
const description = article.data.excerpt;
const ogImage = article.data.cover;
const title = `${article.data.title} | Seeker公益`;
---

<Layout description={description} image={ogImage} title={title}>
  {article.data.layout === 'hasselblad' ? <ArticleHasselblad article={article} others={others} /> : <ArticleEditorial article={article} others={others} />}
</Layout>
