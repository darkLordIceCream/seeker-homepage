---
// 公益项目文章页：哈苏（Hasselblad）式图集排版
// 居中头版 → 全宽封面 → 居中宽字距章节标题 → 统一比例等高图组 → 居中窄列文字
// 配色沿用站点 Catppuccin 令牌；右侧保留「延伸阅读」小模块
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('welfare');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const fmtDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(article.data.pubDate);

/** 延伸阅读占位卡：标题派生自项目真实素材，文章就位后替换为 getCollection 链接 */
const upcoming = [
  {
    title: '第一台相机的旅程',
    g: 'radial-gradient(circle at 70% 25%, rgba(45,212,191,0.5), transparent 55%), linear-gradient(120deg, #22303a 0%, #101a20 100%)',
  },
  {
    title: '每人一本摄影集',
    g: 'radial-gradient(circle at 25% 30%, rgba(251,191,36,0.4), transparent 55%), linear-gradient(120deg, #2b2418 0%, #171208 100%)',
  },
  {
    title: '明信片的另一端',
    g: 'radial-gradient(circle at 75% 70%, rgba(244,114,182,0.4), transparent 55%), linear-gradient(120deg, #2b1f2a 0%, #150f14 100%)',
  },
];
---

<Layout
  description={article.data.excerpt}
  image={article.data.cover}
  title={`${article.data.title} | Seeker公益`}
>
  <Navigation />

  <main class="article-page" id="main-content">
    <header class="article-hero">
      <p class="hero-kicker">SEEKER · {article.data.kicker}</p>
      <h1 class="hero-title">{article.data.title}</h1>
      {article.data.subtitle && <p class="hero-dek">{article.data.subtitle}</p>}
      <div class="hero-meta">
        <span>{fmtDate}</span>
        <span aria-hidden="true" class="meta-dot">·</span>
        <span>{article.data.author}</span>
        <span aria-hidden="true" class="meta-dot">·</span>
        <span>Seeker公益</span>
      </div>
    </header>

    <figure class="hero-media">
      <Image
        alt={`${article.data.title}——${article.data.coverLine ?? '项目封面'}`}
        fetchpriority="high"
        height={720}
        loading="eager"
        src={article.data.cover}
        width={1080}
      />
    </figure>

    <div class="article-body">
      <div class="article-layout">
        <div class="prose-col">
          {article.data.quote && (
            <figure class="pull-quote">
              <blockquote>{article.data.quote}</blockquote>
              {article.data.quoteAuthor && <figcaption>——{article.data.quoteAuthor}</figcaption>}
            </figure>
          )}

          <div class="welfare-prose">
            <Content />
          </div>

          <footer class="article-foot">
            <a class="back-link" href="/welfare/">← 返回「带上她的眼睛」</a>
          </footer>
        </div>

        <aside aria-label="延伸阅读" class="side-col">
          <p class="side-title">
            延伸阅读 <span class="side-en">MORE STORIES</span>
          </p>
          <ul class="side-list">
            {upcoming.map(item => (
              <li class="side-card">
                <span aria-hidden="true" class="side-thumb ph-tile" style={`background:${item.g}`} />
                <span class="side-card-title">{item.title}</span>
                <span class="side-card-status">即将上线 · 素材整理中</span>
              </li>
            ))}
          </ul>
          <a class="side-back" href="/welfare/">了解 Seeker公益 →</a>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // 正文图片统一懒加载（md 渲染产物，构建期无法注入属性）
  document
    .querySelectorAll<HTMLImageElement>('.welfare-prose img')
    .forEach(img => {
      img.loading = 'lazy';
      img.decoding = 'async';
    });

  // 图组等高比例：首张图加载后判断组方向——竖图组 3:4，横图组 1:1
  document
    .querySelectorAll<HTMLElement>('.welfare-prose p:has(img + img)')
    .forEach(row => {
      const first = row.querySelector('img');
      if (!first) {return;}
      const classify = () => {
        if (first.naturalWidth > 0 && first.naturalWidth < first.naturalHeight) {
          row.classList.add('img-row-pt');
        }
      };
      if (first.complete) {
        classify();
      } else {
        first.addEventListener('load', classify, { once: true });
      }
    });
</script>

<style>
  .article-page {
    min-height: 100vh;
    background: var(--background);
    padding-top: 70px;
    color: var(--foreground);
    /* 头版、正文、图组共用左基线；超宽屏容器居中 */
    --edge: max(6vw, calc((100vw - 1360px) / 2 + 56px));
  }

  /* —— 居中头版 —— */
  .article-hero {
    max-width: 860px;
    margin: 0 auto;
    padding: 72px 24px 44px;
    text-align: center;
  }

  .hero-kicker {
    margin: 0 0 24px;
    font-family: 'Archivo', sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--grad-a);
  }

  .hero-title {
    margin: 0 0 16px;
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-indent: 0.14em;
    line-height: 1.35;
    color: var(--foreground);
  }

  .hero-dek {
    margin: 0 0 30px;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--muted-foreground);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Archivo', -apple-system, sans-serif;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .meta-dot {
    opacity: 0.6;
  }

  /* —— 全宽封面 —— */
  .hero-media {
    margin: 0 var(--edge);
  }

  .hero-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  /* —— 正文 —— */
  .article-body {
    padding: 72px var(--edge) 0;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 1fr;
    column-gap: 80px;
    align-items: start;
  }

  .prose-col {
    max-width: 760px;
  }

  /* 金句：居中大字（哈苏无装饰，留白即层次） */
  .pull-quote {
    margin: 0 0 56px;
    text-align: center;
  }

  .pull-quote blockquote {
    margin: 0;
    font-size: 1.18rem;
    line-height: 2;
    letter-spacing: 0.06em;
    color: var(--foreground);
  }

  .pull-quote figcaption {
    margin-top: 12px;
    font-family: 'Archivo', -apple-system, sans-serif;
    font-size: 12.5px;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
  }

  /* —— 正文：居中窄列、无衬线（哈苏式） —— */
  .welfare-prose {
    font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    font-size: 16px;
    line-height: 2.1;
    color: var(--foreground);
  }

  .welfare-prose :global(p) {
    margin: 0 0 1.9em;
    text-align: center;
  }

  /* 章节标题：居中 + 宽字距（哈苏章节名） */
  .welfare-prose :global(h2) {
    margin: 3.4em 0 2em;
    text-align: center;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--foreground);
  }

  /* 引文（歌词 / 诗句 / 章节引言）：居中淡色 */
  .welfare-prose :global(blockquote) {
    margin: 2.4em auto;
    padding: 0;
    border: none;
    max-width: 560px;
    text-align: center;
    font-size: 14.5px;
    line-height: 2.2;
    color: var(--muted-foreground);
  }

  /* 照片：全列宽大图，直角 */
  .welfare-prose :global(p:has(> img:only-child)) {
    margin: 2.4em 0;
  }

  .welfare-prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  /* 成组作品：统一 1:1 等高裁切（竖图组由 JS 切 3:4），窄间距 */
  .welfare-prose :global(p:has(img + img)) {
    display: flex;
    align-items: stretch;
    gap: 10px;
    margin: 2.4em 0;
  }

  .welfare-prose :global(p:has(img + img) img) {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .welfare-prose :global(p.img-row-pt img) {
    aspect-ratio: 3 / 4;
  }

  /* 图注：紧跟照片的斜体行，居中小字 */
  .welfare-prose :global(p:has(> img) + p em) {
    display: block;
    font-style: normal;
    font-family: 'Archivo', -apple-system, sans-serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1.8;
    text-align: center;
    color: var(--muted-foreground);
    margin-top: -0.9em;
  }

  /* 鸣谢 / 名单（最后一个章节后的段落）：小一号、更淡 */
  .welfare-prose :global(h2:last-of-type ~ p) {
    font-size: 13.5px;
    line-height: 2.1;
    color: var(--muted-foreground);
  }

  /* —— 延伸阅读侧栏：右侧留白区内居中的一小块，不跟随滚动 —— */
  .side-col {
    width: min(300px, 100%);
    margin-inline: auto;
    padding-top: 8px;
  }

  .side-title {
    margin: 0;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--divider);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--foreground);
  }

  .side-en {
    margin-left: 4px;
    font-family: 'Archivo', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .side-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 横排小卡：小缩略图 + 右侧文字 */
  .side-card {
    display: grid;
    grid-template-columns: 74px 1fr;
    column-gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--divider);
  }

  .side-thumb {
    display: block;
    width: 74px;
    aspect-ratio: 5 / 6;
    border-radius: 2px;
  }

  .side-card-title {
    grid-column: 2;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.5;
    color: var(--foreground);
  }

  .side-card-status {
    grid-column: 2;
    display: block;
    margin-top: 5px;
    font-family: 'Archivo', -apple-system, sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .side-back {
    display: inline-block;
    margin-top: 18px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--grad-a);
    text-decoration: none;
  }

  .side-back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .side-back:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* —— 尾部 —— */
  .article-foot {
    margin-top: 88px;
    padding: 36px 0 88px;
    border-top: 1px solid var(--divider);
    text-align: center;
  }

  .back-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--grad-a);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .back-link:focus-visible {
    outline: 2px solid var(--grad-a);
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 1279px) {
    /* 窄屏放不下双栏：侧栏移到正文下方 */
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side-col {
      width: min(560px, 100%);
      margin: 56px 0 0;
    }

    .side-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .side-card {
      padding: 12px 0 0;
      border-bottom: none;
    }
  }

  @media (max-width: 900px) {
    .article-hero {
      padding: 48px 24px 36px;
    }

    .article-body {
      padding: 48px 24px 0;
    }

    /* 手机上组图退回单列，恢复原比例 */
    .welfare-prose :global(p:has(img + img)) {
      flex-direction: column;
      gap: 18px;
    }

    .welfare-prose :global(p:has(img + img) img),
    .welfare-prose :global(p.img-row-pt img) {
      aspect-ratio: auto;
    }

    .side-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
