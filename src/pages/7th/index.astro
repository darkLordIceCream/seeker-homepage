// HERO 首帧摄影作品：从真实活动图池确定性抽一张横幅图（不随构建随机跳动）
const heroPool = Object.entries(ACTIVITY_IMAGE_META).filter(([key, dim]) => {
  return (
    !key.includes('cover') &&
    !key.includes('committee') &&
    dim.w >= 960 &&
    dim.h >= 640 &&
    dim.w > dim.h
  );
});
const heroPick = heroPool[Math.floor(heroPool.length / 2)];
const heroPhoto = heroPick
  ? { url: `https://r2.xn--seeker-ng2jm403afb4a.club/${heroPick[0]}`, w: heroPick[1].w, h: heroPick[1].h }
  : null;
