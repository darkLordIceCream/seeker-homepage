---
/**
 * /7th/ — SEEKER 07 · 七周年「摄影档案」首页。
 * 设计语言：LIGHT / FRAME / FILM / DARKROOM / ARCHIVE——不是活动页，是七年的档案。
 * 结构：档案 Hero（07 主视觉）→ 01 ANNIVERSARY（水印工坊）→ 02 PEOPLE（地图墙 + 统计）
 *       → 03 MEMORY（手记档案）→ Ending（2019 → 7 → 2026 叙事收尾）。
 * 统计数字从 map-points.ts 派生（单一数据源），进入视口 Count Up。
 */
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import stats from '../../data/anniversary/stats.json';
---

<Layout
  description="SEEKER 07 · YEARS OF LIGHT · 2019—2026。追光七载，把光赠予远方——七年摄影档案：水印工坊、成员地图墙、七周年手记。"
  title="Seeker 七周年"
>
  <Navigation />
  <main class="arc" id="main-content">
    <!-- 档案 Hero -->
    <header class="arc-hero">
      <p class="arc-hero-brand">SEEKER</p>
      <p aria-hidden="true" class="arc-hero-num">07</p>
      <p class="arc-hero-years">YEARS OF LIGHT</p>
      <p class="arc-hero-range">2019 — 2026</p>
      <h1 class="arc-hero-slogan">追光七载，把光赠予远方</h1>
      <a class="arc-enter" href="#archive">ENTER ARCHIVE ↓</a>
    </header>

    <div class="arc-body" id="archive">
      <!-- 01 / ANNIVERSARY -->
      <section aria-labelledby="sec-anniversary" class="arc-sec">
        <div class="arc-sec-head">
          <span class="arc-sec-no">01</span>
          <h2 class="arc-sec-title" id="sec-anniversary">
            ANNIVERSARY<span class="arc-sec-zh">纪念</span>
          </h2>
        </div>
        <div class="arc-sec-body arc-sec-body--tilt">
          <div class="arc-copy">
            <p class="arc-copy-lead">把这一刻，留在七周年。</p>
            <p class="arc-copy-text">
              每一张照片，都是留下的痕迹。走进暗房，为你最好的一帧装上七周年纪念框，@上你的名字——它将成为这份档案的一部分。
            </p>
            <a class="arc-link" href="/7th/watermark/">ENTER DARKROOM →</a>
          </div>
          <div aria-hidden="true" class="arc-visual">
            <span class="arc-visual-frame"></span>
            <span class="arc-visual-seven">07</span>
          </div>
        </div>
      </section>

      <!-- 02 / PEOPLE -->
      <section aria-labelledby="sec-people" class="arc-sec">
        <div class="arc-sec-head">
          <span class="arc-sec-no">02</span>
          <h2 class="arc-sec-title" id="sec-people">
            PEOPLE<span class="arc-sec-zh">追光者</span>
          </h2>
        </div>
        <div class="arc-sec-body">
          <p class="arc-copy-lead">每一个光点，都是一个追光者。</p>
          <dl class="arc-stats" data-countup>
            <div class="arc-stat">
              <dd data-count-to={stats.members}>{stats.members}</dd>
              <dt>SEEKERS</dt>
            </div>
            <div class="arc-stat">
              <dd data-count-to={stats.countries}>{stats.countries}</dd>
              <dt>COUNTRIES</dt>
            </div>
            <div class="arc-stat">
              <dd data-count-to={stats.regions}>{stats.regions}</dd>
              <dt>REGIONS</dt>
            </div>
          </dl>
          <a class="arc-link" href="/7th/map/">WHERE WE ARE →</a>
        </div>
      </section>

      <!-- 03 / MEMORY -->
      <section aria-labelledby="sec-memory" class="arc-sec">
        <div class="arc-sec-head">
          <span class="arc-sec-no">03</span>
          <h2 class="arc-sec-title" id="sec-memory">MEMORY<span class="arc-sec-zh">档案</span></h2>
        </div>
        <div class="arc-sec-body">
          <p class="arc-memory-title">THE ARCHIVE</p>
          <p class="arc-copy-lead arc-copy-lead--serif">七年的故事，还没有结束。</p>
          <p class="arc-memory-range">2019 — 2026</p>
          <p class="arc-memory-continues">THE STORY CONTINUES.</p>
        </div>
      </section>

      <!-- Ending -->
      <section aria-label="七周年结语" class="arc-ending">
        <div class="arc-ending-line">
          <span class="arc-ending-year">2019</span>
          <span class="arc-ending-cap">WE STARTED</span>
        </div>
        <p aria-hidden="true" class="arc-ending-seven">7</p>
        <div class="arc-ending-line">
          <span class="arc-ending-year">2026</span>
          <span class="arc-ending-cap">THE NEXT FRAME IS YOURS.</span>
        </div>
        <div class="arc-ending-brand">
          <p class="arc-ending-slogan">拍一张照片，交一个朋友。</p>
          <a class="arc-link" href="/7th/watermark/">留下你的痕迹 →</a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Count Up：HTML 直出终值（no-JS / 未进入视口恒显真实数字），JS 增强仅在
  // 元素进入视口后从 0 滚动到终值（reduced-motion 不做动画，保持直出值）
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-countup] [data-count-to]');
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo ?? '0');
    if (REDUCED) {
      return;
    }
    el.textContent = '0';
    const start = performance.now();
    const DUR = 900;
    const tick = (now: number) => {
      const t = Math.min((now - start) / DUR, 1);
      const eased = 1 - (1 - t) ** 3;
      el.textContent = String(Math.round(target * eased));
      if (t < 1) {
        requestAnimationFrame(tick);
      }
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 }
  );
  nums.forEach(n => io.observe(n));
</script>

<style>
  .arc {
    padding-top: 70px; /* 固定导航高度预留 */
    background: var(--anniv-bg);
    color: var(--anniv-fg);
  }

  /* —— 档案 Hero：07 为主视觉，纯编辑排版 —— */
  .arc-hero {
    min-height: calc(100svh - 70px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
  }

  .arc-hero-brand {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.55em;
    text-indent: 0.55em;
    color: var(--anniv-fg);
  }

  .arc-hero-num {
    margin: 0.4rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(9rem, 34vw, 22rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--anniv-fg);
  }

  .arc-hero-years {
    margin: 0.6rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.72rem, 1.6vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    color: var(--anniv-accent);
  }

  .arc-hero-range {
    margin: 1.1rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--anniv-muted);
  }

  .arc-hero-slogan {
    margin: 1.6rem 0 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.25rem, 3.4vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--anniv-fg);
  }

  .arc-enter {
    margin-top: 3rem;
    padding: 0.85rem 2.2rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--anniv-fg);
    border: 1px solid var(--anniv-border);
    text-decoration: none;
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      color var(--dur-normal) var(--ease-enter);
  }

  .arc-enter:hover {
    border-color: var(--anniv-accent);
    color: var(--anniv-accent);
  }

  /* —— 章节体 —— */
  .arc-body {
    border-top: 1px solid var(--anniv-border);
  }

  .arc-sec {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 7.5rem) 1.5rem;
    border-bottom: 1px solid var(--anniv-border);
  }

  .arc-sec-head {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .arc-sec-no {
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--anniv-accent);
  }

  .arc-sec-no::after {
    content: ' /';
    color: var(--anniv-faint);
  }

  .arc-sec-title {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--anniv-fg);
  }

  .arc-sec-zh {
    margin-left: 1.1rem;
    font-family: var(--anniv-serif);
    font-size: 0.5em;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--anniv-muted);
  }

  .arc-sec-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .arc-copy-lead {
    margin: 0 0 0.9rem;
    max-width: 34em;
    font-size: clamp(1.15rem, 2.6vw, 1.55rem);
    line-height: 1.7;
    color: var(--anniv-fg);
  }

  .arc-copy-lead--serif {
    font-family: var(--anniv-serif);
    letter-spacing: 0.06em;
  }

  .arc-copy-text {
    margin: 0 0 1.6rem;
    max-width: 30em;
    line-height: 2;
    color: var(--anniv-muted);
  }

  .arc-link {
    display: inline-block;
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--anniv-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) ease;
  }

  .arc-link:hover {
    border-color: var(--anniv-accent);
  }

  /* 01 的非对称排版：左文右相框 */
  .arc-visual {
    position: relative;
    align-self: flex-end;
    width: min(100%, 22rem);
    aspect-ratio: 3 / 4;
  }

  .arc-visual-frame {
    position: absolute;
    inset: 0;
    border: 1px solid var(--anniv-border);
  }

  .arc-visual-frame::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid var(--anniv-faint);
  }

  .arc-visual-seven {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -52%);
    font-family: 'Archivo', sans-serif;
    font-size: clamp(4rem, 9vw, 6.5rem);
    font-weight: 700;
    color: var(--anniv-accent);
    opacity: 0.85;
  }

  /* 02 统计 */
  .arc-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 7vw, 5.5rem);
    margin: 0 0 2.2rem;
  }

  .arc-stat {
    display: flex;
    flex-direction: column;
  }

  .arc-stat dd {
    order: -1;
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(3rem, 8vw, 5.2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-fg);
  }

  .arc-stat dt {
    margin-top: 0.6rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    color: var(--anniv-muted);
  }

  /* 03 档案 */
  .arc-memory-title {
    margin: 0 0 1.4rem;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    font-weight: 600;
    letter-spacing: 0.42em;
    color: var(--anniv-faint);
  }

  .arc-memory-range {
    margin: 1.4rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    color: var(--anniv-muted);
  }

  .arc-memory-continues {
    margin: 0.5rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--anniv-accent);
  }

  /* —— Ending —— */
  .arc-ending {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4.5rem, 11vw, 8rem) 1.5rem clamp(5rem, 12vw, 9rem);
    text-align: center;
  }

  .arc-ending-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1.4rem;
  }

  .arc-ending-year {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.3rem, 3.4vw, 2rem);
    font-weight: 700;
    color: var(--anniv-fg);
  }

  .arc-ending-cap {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.72rem, 1.6vw, 0.9rem);
    letter-spacing: 0.32em;
    color: var(--anniv-muted);
  }

  .arc-ending-seven {
    margin: clamp(0.8rem, 2.5vw, 1.4rem) 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(4.5rem, 13vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-accent);
  }

  .arc-ending-brand {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }

  .arc-ending-slogan {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.05rem, 2.6vw, 1.4rem);
    letter-spacing: 0.18em;
    color: var(--anniv-fg);
  }

  @media (min-width: 56rem) {
    .arc-sec-body--tilt {
      flex-direction: row;
      align-items: stretch;
      gap: 4rem;
    }

    .arc-sec-body--tilt .arc-copy {
      flex: 1.2;
    }

    .arc-sec-body--tilt .arc-visual {
      flex: 1;
      align-self: stretch;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-enter,
    .arc-link {
      transition: none;
    }
  }
</style>
