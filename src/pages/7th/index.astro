---
/**
 * /7th/ — SEEKER 07 · 七周年「数字摄影纪念册」。
 * 主题：光影七载，看见彼此（2019 — 2026）。
 * 叙事结构：HERO → 01 七年序章 → 02 光影札记 → 03 他们的声音 → 04 追光印记
 *   → 05 同行之路 → LEAVE YOUR FRAME → 06 留光成物 → 07 光影七载 → WITH THANKS。
 * 一本可以在网页中阅读的摄影纪念册——不是活动页。
 * 统计唯一数据源：src/data/anniversary/stats.json（占位数据，待真实统计）。
 */
import Layout from '../../layouts/Layout.astro';
import AnniversaryHeader from '../../components/anniversary/AnniversaryHeader.astro';
import AnniversaryFooter from '../../components/anniversary/AnniversaryFooter.astro';
import SectionHead from '../../components/anniversary/SectionHead.astro';
import AwaitNote from '../../components/anniversary/AwaitNote.astro';
import stats from '../../data/anniversary/stats.json';
---

<Layout
  description="SEEKER 07 · YEARS OF LIGHT · 2019—2026。光影七载，看见彼此——SEEKER 七年数字摄影纪念册：七年序章、光影札记、他们的声音、追光印记、同行之路、留光成物。"
  title="Seeker 七周年 · 光影七载"
>
  <!-- 7th 独立主题防闪烁：渲染前落 data-theme（默认 dark），与主站主题无关 -->
  <script is:inline slot="head">
    try {
      document.documentElement.dataset.theme =
        localStorage.getItem('seeker-7th-theme') === 'light' ? 'light' : 'dark';
    } catch {
      document.documentElement.dataset.theme = 'dark';
    }
  </script>
  <AnniversaryHeader />
  <main class="arc" id="main-content">
    <!-- HERO：SEEKER 07 主视觉 -->
    <header class="arc-hero">
      <p class="arc-hero-brand">SEEKER</p>
      <p aria-hidden="true" class="arc-hero-num">07</p>
      <p class="arc-hero-years">YEARS OF LIGHT</p>
      <p class="arc-hero-range">2019 — 2026</p>
      <h1 class="arc-hero-slogan">光影七载，看见彼此。</h1>
      <a class="arc-enter" href="#archive">ENTER ARCHIVE ↓</a>
    </header>

    <div class="arc-body" id="archive">
      <!-- 01 / 七年序章：看见我们（印样墙 + 统计 + 地图导语） -->
      <section aria-labelledby="sec-intro" class="arc-sec">
        <SectionHead no="01" zh="七年序章" en="SEVEN YEARS, MANY FRAMES" />
        <div class="arc-sec-body">
          <p class="arc-copy-lead">
            七年，我们拍下了很多照片。<br />也因此，看见了很多彼此。
          </p>
          <!-- ContactSheet 印样墙（真实活动照片 + 作者署名） -->
          <!-- 地图导语 + 静态预览 -->
          <dl class="arc-stats" data-countup>
            <div class="arc-stat">
              <dd data-count-to={stats.members}>{stats.members}</dd>
              <dt>SEEKERS</dt>
            </div>
            <div class="arc-stat">
              <dd data-count-to={stats.countries}>{stats.countries}</dd>
              <dt>COUNTRIES</dt>
            </div>
            <div class="arc-stat">
              <dd data-count-to={stats.regions}>{stats.regions}</dd>
              <dt>REGIONS</dt>
            </div>
          </dl>
          <a class="arc-link" href="/7th/map/">EXPLORE THE MAP →</a>
        </div>
      </section>

      <!-- 02 / 光影札记：主理人寄语 -->
      <section aria-labelledby="sec-note" class="arc-sec">
        <SectionHead no="02" zh="光影札记" en="A NOTE FROM SEEKER" />
        <div class="arc-sec-body">
          <AwaitNote />
        </div>
      </section>

      <!-- 03 / 他们的声音：成员采访 -->
      <section aria-labelledby="sec-voices" class="arc-sec">
        <SectionHead no="03" zh="他们的声音" en="THEIR VOICES" />
        <div class="arc-sec-body">
          <AwaitNote />
        </div>
      </section>

      <!-- 04 / 追光印记：项目时间线 -->
      <section aria-labelledby="sec-projects" class="arc-sec">
        <SectionHead no="04" zh="追光印记" en="WHAT WE HAVE MADE" />
        <div class="arc-sec-body">
          <AwaitNote />
        </div>
      </section>

      <!-- 05 / 同行之路：合作关系 -->
      <section aria-labelledby="sec-road" class="arc-sec">
        <SectionHead no="05" zh="同行之路" en="THE PEOPLE WHO WALKED WITH US" />
        <div class="arc-sec-body">
          <AwaitNote />
        </div>
      </section>

      <!-- LEAVE YOUR FRAME：参与入口（水印工坊 CTA） -->
      <section aria-labelledby="sec-frame" class="arc-cta">
        <p class="arc-cta-en" id="sec-frame">LEAVE YOUR FRAME</p>
        <p class="arc-cta-zh">光影七载，<br />当然也应该有你的一帧。</p>
        <a class="arc-cta-btn" href="/7th/watermark/">进入七周年暗房 →</a>
      </section>

      <!-- 06 / 留光成物：Logo 与周边 -->
      <section aria-labelledby="sec-objects" class="arc-sec">
        <SectionHead no="06" zh="留光成物" en="A FRAME TO KEEP" />
        <div class="arc-sec-body">
          <AwaitNote />
        </div>
      </section>

      <!-- 07 / 光影七载：Ending -->
      <section aria-labelledby="sec-ending" class="arc-ending">
        <SectionHead no="07" zh="光影七载" en="SEVEN YEARS LATER" />
        <div class="arc-ending-line">
          <span class="arc-ending-year">2019</span>
          <span class="arc-ending-cap">WE STARTED</span>
        </div>
        <p aria-hidden="true" class="arc-ending-seven">7</p>
        <div class="arc-ending-line">
          <span class="arc-ending-year">2026</span>
          <span class="arc-ending-cap">THE NEXT FRAME IS YOURS.</span>
        </div>
        <div class="arc-ending-brand">
          <p class="arc-ending-slogan">光影七载，看见彼此。</p>
          <p class="arc-ending-sub">追光七载，把光赠予远方</p>
        </div>
      </section>

      <!-- WITH THANKS：鸣谢 -->
      <section aria-labelledby="sec-thanks" class="arc-thanks">
        <p class="arc-thanks-en" id="sec-thanks">WITH THANKS</p>
        <p class="arc-thanks-zh">七周年项目组</p>
        <AwaitNote />
      </section>
    </div>
  </main>
  <AnniversaryFooter />
</Layout>

<script>
  // Count Up：HTML 直出终值（no-JS / 未进入视口恒显真实数字），JS 增强仅在
  // 元素进入视口后从 0 滚动到终值（reduced-motion 不做动画，保持直出值）
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-countup] [data-count-to]');
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo ?? '0');
    if (REDUCED) {
      return;
    }
    el.textContent = '0';
    const start = performance.now();
    const DUR = 900;
    const tick = (now: number) => {
      const t = Math.min((now - start) / DUR, 1);
      const eased = 1 - (1 - t) ** 3;
      el.textContent = String(Math.round(target * eased));
      if (t < 1) {
        requestAnimationFrame(tick);
      }
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 },
  );
  nums.forEach(n => io.observe(n));
</script>

<style>
  .arc {
    background: var(--anniv-bg);
    color: var(--anniv-fg);
    transition:
      background-color var(--dur-normal) ease,
      color var(--dur-normal) ease;
  }

  /* —— HERO：07 为主视觉，纯编辑排版 —— */
  .arc-hero {
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
  }

  .arc-hero-brand {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.55em;
    text-indent: 0.55em;
    color: var(--anniv-fg);
  }

  .arc-hero-num {
    margin: 0.4rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(9rem, 34vw, 22rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--anniv-fg);
  }

  .arc-hero-years {
    margin: 0.6rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.72rem, 1.6vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    color: var(--anniv-accent);
  }

  .arc-hero-range {
    margin: 1.1rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--anniv-muted);
  }

  .arc-hero-slogan {
    margin: 1.6rem 0 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.25rem, 3.4vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--anniv-fg);
  }

  .arc-enter {
    margin-top: 3rem;
    padding: 0.85rem 2.2rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--anniv-fg);
    border: 1px solid var(--anniv-border);
    text-decoration: none;
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      color var(--dur-normal) var(--ease-enter);
  }

  .arc-enter:hover {
    border-color: var(--anniv-accent);
    color: var(--anniv-accent);
  }

  /* —— 章节体 —— */
  .arc-body {
    border-top: 1px solid var(--anniv-border);
  }

  .arc-sec {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 7.5rem) 1.5rem;
    border-bottom: 1px solid var(--anniv-border);
  }

  .arc-sec-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .arc-copy-lead {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.15rem, 2.6vw, 1.55rem);
    line-height: 1.7;
    color: var(--anniv-fg);
  }

  .arc-link {
    display: inline-block;
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--anniv-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) ease;
  }

  .arc-link:hover {
    border-color: var(--anniv-accent);
  }

  /* 统计 */
  .arc-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 7vw, 5.5rem);
    margin: 0;
  }

  .arc-stat {
    display: flex;
    flex-direction: column;
  }

  .arc-stat dd {
    order: -1;
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(3rem, 8vw, 5.2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-fg);
  }

  .arc-stat dt {
    margin-top: 0.6rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    color: var(--anniv-muted);
  }

  /* —— LEAVE YOUR FRAME CTA —— */
  .arc-cta {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 7.5rem) 1.5rem;
    border-bottom: 1px solid var(--anniv-border);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }

  .arc-cta-en {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--anniv-accent);
  }

  .arc-cta-zh {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
  }

  .arc-cta-btn {
    margin-top: 0.8rem;
    padding: 0.9rem 2.4rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--anniv-bg);
    background: var(--anniv-accent);
    text-decoration: none;
    transition: filter var(--dur-fast) ease;
  }

  .arc-cta-btn:hover {
    filter: brightness(1.08);
  }

  /* —— Ending —— */
  .arc-ending {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4.5rem, 11vw, 8rem) 1.5rem clamp(5rem, 12vw, 9rem);
    text-align: center;
  }

  .arc-ending :global(.ash) {
    align-items: center;
    margin-bottom: clamp(3rem, 8vw, 5rem);
  }

  .arc-ending-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1.4rem;
  }

  .arc-ending-year {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.3rem, 3.4vw, 2rem);
    font-weight: 700;
    color: var(--anniv-fg);
  }

  .arc-ending-cap {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.72rem, 1.6vw, 0.9rem);
    letter-spacing: 0.32em;
    color: var(--anniv-muted);
  }

  .arc-ending-seven {
    margin: clamp(0.8rem, 2.5vw, 1.4rem) 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(4.5rem, 13vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--anniv-accent);
  }

  .arc-ending-brand {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .arc-ending-slogan {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.05rem, 2.6vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--anniv-fg);
  }

  .arc-ending-sub {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--anniv-muted);
  }

  /* —— WITH THANKS —— */
  .arc-thanks {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 9vw, 6.5rem) 1.5rem clamp(4.5rem, 11vw, 8rem);
    border-top: 1px solid var(--anniv-border);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  .arc-thanks .await {
    width: min(100%, 30rem);
  }

  .arc-thanks-en {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--anniv-accent);
  }

  .arc-thanks-zh {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-enter,
    .arc-link {
      transition: none;
    }
  }
</style>
