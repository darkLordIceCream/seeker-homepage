<script>
  // Count Up：HTML 直出终值（no-JS / 未进入视口恒显真实数字），JS 增强仅在
  // 元素进入视口后从 0 滚动到终值（reduced-motion 不做动画，保持直出值）
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-countup] [data-count-to]');
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo ?? '0');
    if (REDUCED) {
      return;
    }
    el.textContent = '0';
    const start = performance.now();
    const DUR = 900;
    const tick = (now: number) => {
      const t = Math.min((now - start) / DUR, 1);
      const eased = 1 - (1 - t) ** 3;
      el.textContent = String(Math.round(target * eased));
      if (t < 1) {
        requestAnimationFrame(tick);
      }
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 },
  );
  nums.forEach(n => io.observe(n));

  // Scroll Story：reduced-motion 时不初始化，页面保持静态形态
  if (!REDUCED) {
    import('../../lib/anniversary/scroll-story').then(({ initScrollStory }) => initScrollStory());
  }
</script>

