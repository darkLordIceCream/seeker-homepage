---
/**
 * /7th/ — SEEKER 07 · 七周年「数字摄影纪念册」。
 * 主题：光影七载，看见彼此（2019 — 2026）。
 * 叙事结构：HERO → 头像墙过渡 → 01 光影札记 → 02 追光印记（三大项目）
 *   → 03 同行之路 → 04 七载光影（留光成物 + LEAVE YOUR FRAME 暗房）→ 成员地图压轴。
 * 一本可以在网页中阅读的摄影纪念册——不是活动页。
 */
import Layout from '../../layouts/Layout.astro';
import AnniversaryHeader from '../../components/anniversary/AnniversaryHeader.astro';
import AnniversaryFooter from '../../components/anniversary/AnniversaryFooter.astro';
import SectionHead from '../../components/anniversary/SectionHead.astro';
import AvatarWall from '../../components/anniversary/AvatarWall.astro';
import AnniversaryMap from '../../components/anniversary/AnniversaryMap.astro';
import FounderNote from '../../components/anniversary/FounderNote.astro';
import ProjectsShowcase from '../../components/anniversary/ProjectsShowcase.astro';
import SharedRoad from '../../components/anniversary/SharedRoad.astro';
import PosterSlideshow from '../../components/anniversary/PosterSlideshow.astro';
import WatermarkGenerator from '../../components/watermark/WatermarkGenerator.astro';
import { GALLERY_POOL } from '@/data/gallery';

// HERO 首帧摄影作品：取成员收集池中最宽的横幅（全幅背景，构建期确定）
const heroCandidates = [...GALLERY_POOL].filter(i => i.w > i.h).sort((a, b) => b.w - a.w);
const heroPick = heroCandidates[0];
const heroPhoto = heroPick ? { url: heroPick.src, w: heroPick.w, h: heroPick.h } : null;
---

<Layout
  description="SEEKER 07 · YEARS OF LIGHT · 2019—2026。光影七载，看见彼此——SEEKER 七年数字摄影纪念册：光影札记、追光印记、同行之路、七载光影。"
  title="Seeker 七周年 · 光影七载"
>
  <!-- 7th 独立主题防闪烁：渲染前落 data-theme（默认 dark），与主站主题无关 -->
  <script is:inline slot="head">
    try {
      document.documentElement.dataset.theme =
        localStorage.getItem('seeker-7th-theme') === 'light' ? 'light' : 'dark';
    } catch {
      document.documentElement.dataset.theme = 'dark';
    }
  </script>
  <AnniversaryHeader />
  <main class="arc" id="main-content" data-story-root>
    <!-- HERO：滚动叙事舞台（sticky），滚动即时间轴 -->
    <header class="arc-hero" data-story-scene="hero">
      <div class="arc-hero-stage">
        <div class="arc-hero-photo" data-hero-photo aria-hidden="true">
          {
            heroPhoto && (
              <img
                src={heroPhoto.url}
                alt=""
                width={heroPhoto.w}
                height={heroPhoto.h}
                loading="lazy"
                decoding="async"
              />
            )
          }
        </div>
        <div class="arc-hero-core" data-hero-core>
          <p class="arc-hero-brand">SEEKER</p>
          <p aria-hidden="true" class="arc-hero-num" data-hero-num>07</p>
          <p class="arc-hero-years">YEARS OF LIGHT</p>
          <p class="arc-hero-range">2019 — 2026</p>
        </div>
        <h1 class="arc-hero-slogan" data-hero-slogan>光影七载，看见彼此。</h1>
        <a class="arc-enter" href="#archive">进入档案馆 ↓</a>
      </div>
    </header>

    <div class="arc-body" id="archive">
      <!-- 头像墙过渡：HERO 之后全屏停留一帧「看见彼此」（无文字章节，纯影像） -->
      <section aria-label="成员头像墙" class="arc-sec arc-sec--intro">
        <div class="intro-track" data-story-scene="intro">
          <div class="intro-stage">
            <AvatarWall />
          </div>
        </div>
      </section>

      <!-- 01 / 光影札记：主理人寄语（Cinematic：暗场 → 肖像 → 寄语） -->
      <section aria-labelledby="sec-note" class="arc-sec">
        <div class="story-track story-track--founder" data-story-scene="founder">
          <div class="story-stage">
            <SectionHead en="Message from the founder" no="01" sub="主理人寄语" zh="光影札记" />
            <FounderNote />
          </div>
        </div>
      </section>

      <!-- 02 / 追光印记：三大项目（钉住节拍吸附——整卡切换，可点击进入主站） -->
      <section aria-labelledby="sec-projects" class="arc-sec">
        <div class="story-track story-track--projects" data-story-scene="projects">
          <div class="story-stage">
            <SectionHead en="Projects" no="02" sub="项目介绍" zh="追光印记" />
            <ProjectsShowcase />
          </div>
        </div>
      </section>

      <!-- 03 / 同行之路：品牌合作（钉住——关系网络在轨道内生长后驻留） -->
      <section aria-labelledby="sec-road" class="arc-sec">
        <div class="story-track story-track--road" data-story-scene="road">
          <div class="story-stage">
            <SectionHead en="Brand Partnership" no="03" sub="品牌合作" zh="同行之路" />
            <SharedRoad />
          </div>
        </div>
      </section>

      <!-- 04 / 七载光影：留光成物（成员巨片幻灯片墙）+ 暗房（LEAVE YOUR FRAME） -->
      <section aria-labelledby="sec-posters" class="arc-sec">
        <SectionHead en="Anniversary Poster" no="04" sub="周年海报" zh="七载光影" />
        <div class="story-track story-track--posters" data-story-scene="posters">
          <div class="story-stage">
            <PosterSlideshow />
          </div>
        </div>
        <p class="arc-handoff" data-reveal>你的那一帧，还差你。</p>
        <!-- LEAVE YOUR FRAME：WHERE ARE YOU? 暗房（上传→显影→昵称→生成→位置→✦） -->
        <div class="drk-opening" id="leave-your-frame" data-reveal>
          <p class="drk-eyebrow">LEAVE YOUR FRAME</p>
          <h2 class="drk-title">你在哪里？</h2>
          <p class="drk-title-en">WHERE ARE YOU?</p>
          <p class="drk-sub">
            光影七载，当然也应该有你的一帧。<br />留下你的照片、你的名字，和你的位置。
          </p>
        </div>
        <WatermarkGenerator />
      </section>

      <!-- 压轴 / 成员地图：五阶段灯光 + ✦ YOU ARE HERE（与暗房位置确认联动） -->
      <AnniversaryMap />
    </div>
  </main>
  <AnniversaryFooter />
</Layout>

<script>
  // Scroll Story：reduced-motion 时不初始化，页面保持静态形态
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    import('../../lib/anniversary/scroll-story').then(({ initScrollStory }) => initScrollStory());
  }
</script>

<style>
  .arc {
    background: var(--anniv-bg);
    color: var(--anniv-fg);
    transition:
      background-color var(--dur-normal) ease,
      color var(--dur-normal) ease;
  }

  /* —— HERO：track + sticky 舞台（滚动叙事；无 JS 时为普通首屏） —— */
  .arc-hero {
    min-height: calc(100svh - 64px);
    text-align: center;
  }

  .story-on .arc-hero {
    height: 180vh; /* 滚动轨道：钉住舞台的叙事时长 */
  }

  @media (max-width: 48rem) {
    .story-on .arc-hero {
      height: 150vh; /* 移动端缩短钉住时长 */
    }
  }

  .arc-hero-stage {
    position: sticky;
    top: 0;
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(64px + 2rem) 1.5rem 2.5rem;
    overflow: hidden;
  }

  /* 首帧摄影作品：装饰层，基础态隐藏（仅滚动叙事引擎揭示） */
  .arc-hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
  }

  .arc-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 压暗层保证文字可读（UI 层，非照片 filter） */
  .arc-hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--anniv-bg) 52%, transparent);
  }

  .arc-hero-core,
  .arc-hero-slogan,
  .arc-enter {
    position: relative;
    z-index: 1;
  }

  .story-on .arc-hero-slogan {
    opacity: 0; /* 初始隐藏，由引擎在进度后段浮现（内联样式接管） */
    text-shadow: 0 1px 28px rgba(0, 0, 0, 0.5); /* 压在照片上时的可读性 */
  }

  .arc-hero-brand {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.55em;
    text-indent: 0.55em;
    color: var(--anniv-fg);
  }

  .arc-hero-num {
    margin: 0.4rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(9rem, 34vw, 22rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--anniv-fg);
  }

  .arc-hero-years {
    margin: 0.6rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.72rem, 1.6vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    color: var(--anniv-accent);
  }

  .arc-hero-range {
    margin: 1.1rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--anniv-muted);
  }

  .arc-hero-slogan {
    margin: 1.6rem 0 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.25rem, 3.4vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--anniv-fg);
  }

  .arc-enter {
    margin-top: 3rem;
    padding: 0.85rem 2.2rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--anniv-fg);
    border: 1px solid var(--anniv-border);
    text-decoration: none;
    transition:
      border-color var(--dur-normal) var(--ease-enter),
      color var(--dur-normal) var(--ease-enter);
  }

  .arc-enter:hover {
    border-color: var(--anniv-accent);
    color: var(--anniv-accent);
  }

  /* —— 章节体 —— */
  .arc-body {
    border-top: 1px solid var(--anniv-border);
  }

  .arc-sec {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 7.5rem) 1.5rem;
    border-bottom: 1px solid var(--anniv-border);
  }

  /* —— 头像墙过渡：sticky 舞台（全出血，头像墙铺满整屏） —— */
  .story-on .arc-sec--intro {
    max-width: none;
    padding: 0; /* 叙事模式下解除容器限宽 */
    border-bottom: none;
  }

  .story-on .intro-track {
    height: 180vh; /* 纯影像停留：淡入 → 驻留 → 交棒 */
  }

  @media (max-width: 48rem) {
    .story-on .intro-track {
      height: 150vh;
    }
  }

  .intro-stage {
    position: sticky;
    top: 0;
    min-height: 100svh;
    overflow: hidden;
  }

  /* —— 滚动叙事通用舞台（sticky 钉住，track 高度按场景区分） —— */
  .story-stage {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.6rem;
    padding: calc(64px + 2rem) 0 2rem;
    overflow: hidden;
  }

  .story-on .story-track--founder {
    height: 300vh; /* 五拍节拍轮换（bio + 三段寄语 + 落款） */
  }

  .story-on .story-track--projects {
    height: 320vh; /* 三段项目记忆：进入 → 驻留 → 退为残影的重叠时间轴 */
  }

  .story-on .story-track--road {
    height: 240vh; /* 关系网络生长 + 完成后驻留 */
  }

  .story-on .story-track--posters {
    height: 320vh; /* 入场装框 + 驻留（轮播由定时器接管，滚动只管进出） */
  }

  @media (max-width: 48rem) {
    .story-on .story-track--founder {
      height: 240vh;
    }

    .story-on .story-track--projects {
      height: 250vh;
    }

    .story-on .story-track--road {
      height: 200vh;
    }

    .story-on .story-track--posters {
      height: 240vh;
    }
  }

  /* 04 巨片墙 → 暗房的交接句（data-reveal 渐显，接「你在哪里？」） */
  .arc-handoff {
    margin: clamp(1.5rem, 4vw, 2.5rem) auto;
    text-align: center;
    font-family: var(--anniv-serif);
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    letter-spacing: 0.14em;
    color: var(--anniv-fg);
  }

  /* —— LEAVE YOUR FRAME · WHERE ARE YOU? 暗房章节开场 —— */
  .drk-opening {
    max-width: 72rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4.5rem);
    padding: 0 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.3rem;
  }

  .drk-eyebrow {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--anniv-accent);
  }

  .drk-title {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .drk-title-en {
    margin: -0.6rem 0 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--anniv-muted);
  }

  .drk-sub {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(0.98rem, 2.2vw, 1.2rem);
    line-height: 1.9;
    letter-spacing: 0.12em;
    color: var(--anniv-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-enter {
      transition: none;
    }
  }
</style>
