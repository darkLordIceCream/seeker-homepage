---
/**
 * /7th/watermark — 【SEEKER 07 / DARKROOM】七周年水印工坊。
 * 暗房工具页（版式保留暗房身份）；使用 7th 独立主题系统；生成逻辑见 src/lib/watermark/。
 */
import Layout from '../../layouts/Layout.astro';
import AnniversaryHeader from '../../components/anniversary/AnniversaryHeader.astro';
import WatermarkGenerator from '../../components/watermark/WatermarkGenerator.astro';
---

<Layout
  description="上传一张照片、写下你的昵称，生成 Seeker 追光者七周年纪念海报。全程在你的浏览器本地完成，照片不会上传服务器。"
  title="Seeker 七周年 · 水印工坊"
>
  <!-- 7th 独立主题防闪烁：渲染前落 data-theme（默认 dark），与主站主题无关 -->
  <script is:inline slot="head">
    try {
      document.documentElement.dataset.theme =
        localStorage.getItem('seeker-7th-theme') === 'light' ? 'light' : 'dark';
    } catch {
      document.documentElement.dataset.theme = 'dark';
    }
  </script>
  <AnniversaryHeader />
  <main class="dr-page" id="main-content">
    <WatermarkGenerator />
  </main>
</Layout>

<style>
  .dr-page {
    min-height: 100dvh;
    background: var(--anniv-bg);
    transition:
      background-color var(--dur-normal) ease,
      color var(--dur-normal) ease;
  }
</style>
