---
/**
 * /7th/watermark — Seeker 七周年水印工坊。
 * 面向七周年板块的独立工具页：入口暂不挂导航/首页（板块上线时再接），
 * 页面先 noindex，上线时移除下方 robots meta 并添加入口。
 */
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import WatermarkGenerator from '../../components/watermark/WatermarkGenerator.astro';
---

<Layout
  description="上传一张照片、写下你的昵称，生成 Seeker 追光者七周年纪念海报。全程在你的浏览器本地完成，照片不会上传服务器。"   title="Seeker 七周年 · 水印工坊"
>
  <meta content="noindex, nofollow" name="robots" slot="head" />
  <Navigation />
  <main class="wm-page" id="main-content">
    <header class="wm-hero">
      <p class="wm-hero-eyebrow">SEEKER · 7TH ANNIVERSARY</p>
      <h1 class="wm-hero-title grad-text">七周年水印工坊</h1>
      <p class="wm-hero-sub">
        选一张你最满意的照片，套上七周年纪念框，@上你的名字——三步生成属于你的 Seeker
        七周年纪念海报。
      </p>
    </header>

    <WatermarkGenerator />

    <section aria-label="使用步骤" class="wm-how">
      <ol>
        <li>
          <span class="wm-how-num">1</span>
          <strong>选择照片</strong>
          <p>点击、拖拽或粘贴上传一张照片，照片不会离开你的设备。</p>
        </li>
        <li>
          <span class="wm-how-num">2</span>
          <strong>写下昵称</strong>
          <p>输入你想展示的昵称，拖动和缩放照片到满意的位置。</p>
        </li>
        <li>
          <span class="wm-how-num">3</span>
          <strong>生成下载</strong>
          <p>一键生成纪念海报并保存，转发朋友圈一起为 Seeker 庆生。</p>
        </li>
      </ol>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .wm-page {
    padding-top: 70px; /* 固定导航栏高度预留，与 welfare 页一致 */
  }

  .wm-hero {
    max-width: 46rem;
    margin-inline: auto;
    padding: 3.5rem 1.5rem 2.5rem;
    text-align: center;
  }

  .wm-hero-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--muted-foreground);
  }

  .wm-hero-title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
  }

  .wm-hero-sub {
    margin: 0 auto;
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .wm-how {
    max-width: 46rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .wm-how ol {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wm-how li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.9rem;
    align-items: center;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .wm-how-num {
    grid-row: 1 / 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    font-weight: 700;
    color: var(--on-gradient, #fff);
    background: linear-gradient(45deg, var(--grad-a), var(--grad-b));
    border-radius: 50%;
  }

  .wm-how strong {
    font-size: 1rem;
  }

  .wm-how p {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 48rem) {
    .wm-how ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
