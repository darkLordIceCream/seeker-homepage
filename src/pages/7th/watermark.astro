---
/**
 * /7th/watermark — 【七周年板块 · 水印工坊】。
 * 页面结构：暗色沉浸 hero（海报幽灵字背景）+ 浅色工具区（WatermarkGenerator）。
 * 生成逻辑与模板配置见 src/lib/watermark/；本页只负责壳与视觉。
 * 七周年板块已上线：入口在导航与首页周年卡，无需 noindex。
 */
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import WatermarkGenerator from '../../components/watermark/WatermarkGenerator.astro';
---

<Layout
  description="上传一张照片、写下你的昵称，生成 Seeker 追光者七周年纪念海报。全程在你的浏览器本地完成，照片不会上传服务器。"   title="Seeker 七周年 · 水印工坊"
>
  <Navigation />
  <main class="wm-page" id="main-content">
    <section class="wm-hero">
      <div class="wm-hero-inner">
        <p class="wm-hero-eyebrow">SEEKER · 7TH ANNIVERSARY</p>
        <h1 class="wm-hero-title">
          七周年<span class="wm-hero-dot">·</span>水印工坊
        </h1>
        <p class="wm-hero-slogan">追光七载，把光赠予远方</p>
        <p class="wm-hero-sub">
          选一张你最满意的照片做背景，套上七周年纪念框，@上你的名字——
          三步生成专属纪念海报。
        </p>
      </div>
    </section>

    <section aria-label="水印海报生成器" class="wm-tool">
      <WatermarkGenerator />
    </section>

    <nav aria-label="七周年板块导航" class="wm-plate-nav">
      <a href="/7th/map/">去看看成员地图墙 →</a>
      <a href="/7th/">← 返回七周年板块</a>
    </nav>
  </main>
  <Footer />
</Layout>

<style>
  .wm-page {
    padding-top: 70px; /* 固定导航高度预留 */
    background: var(--background);
  }

  /* ---- 暗色沉浸 hero：海报幽灵字 + 纪念金点缀 ---- */
  .wm-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 9vw, 6rem) 1.5rem;
    text-align: center;
    background:
      radial-gradient(90% 130% at 50% -10%, rgba(245, 197, 66, 0.12), transparent 55%),
      #050507;
    color: #fafafa;
  }

  .wm-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/templates/seeker-7th-landscape.webp') center 38% / 130% auto no-repeat;
    opacity: 0.13;
    pointer-events: none;
  }

  .wm-hero-inner {
    position: relative;
    z-index: 1;
  }

  .wm-hero-eyebrow {
    margin: 0 0 0.9rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.38em;
    color: rgba(250, 250, 250, 0.5);
  }

  .wm-hero-title {
    margin: 0 0 0.9rem;
    font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', 'SimSun', serif;
    font-size: clamp(1.9rem, 6vw, 3.4rem);
    font-weight: 700;
    color: #fafafa;
  }

  .wm-hero-dot {
    margin-inline: 0.2em;
    color: #f5c542;
  }

  @media (max-width: 30rem) {
    .wm-hero-eyebrow {
      font-size: 0.6rem;
      letter-spacing: 0.16em;
    }
  }

  .wm-hero-slogan {
    margin: 0 0 1.1rem;
    font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', 'SimSun', serif;
    font-size: clamp(1.1rem, 2.6vw, 1.45rem);
    letter-spacing: 0.14em;
    background: linear-gradient(45deg, #ffe9a8, #f5c542 60%, #f38ba8);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wm-hero-sub {
    max-width: 34rem;
    margin: 0 auto;
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(250, 250, 250, 0.65);
  }

  /* ---- 浅色工具区：跟随主站浅色主题 ---- */
  .wm-tool {
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    background: var(--background);
  }

  .wm-plate-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.75rem;
    padding: 0.5rem 1.5rem 4rem;
    font-size: 0.95rem;
  }

  .wm-plate-nav a {
    color: var(--muted-foreground);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .wm-plate-nav a:hover {
    color: var(--primary);
  }
</style>
