---
/**
 * /7th/map — 【SEEKER 07 · WHERE WE ARE】成员分布地图。
 * 黑暗中的光点：MapLibre + 单一融合 GeoJSON（世界国家 + 中国省域）。
 * 数据：map-points.ts（占位）→ build-map-geo.mjs 注入 → anniv-world.json。
 */
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import MapWall from '../../components/anniversary/MapWall.astro';
import stats from '../../data/anniversary/stats.json';
---

<Layout
  title="Seeker 七周年 · WHERE WE ARE"
  description="每一个光点，都是一个追光者。SEEKER 追光者七年间的成员分布：825 位追光者，15 个国家，34 个省级行政区。"
>
  <Navigation />
  <main class="ww-page" id="main-content">
    <header class="ww-hero">
      <p class="ww-eyebrow">SEEKER 07 / WHERE WE ARE</p>
      <h1 class="ww-title">每一个光点，<br />都是一个追光者。</h1>
      <dl class="ww-stats" data-countup>
        <div class="ww-stat">
          <dd data-count-to={stats.members}>{stats.members}</dd>
          <dt>SEEKERS</dt>
        </div>
        <div class="ww-stat">
          <dd data-count-to={stats.countries}>{stats.countries}</dd>
          <dt>COUNTRIES</dt>
        </div>
        <div class="ww-stat">
          <dd data-count-to={stats.regions}>{stats.regions}</dd>
          <dt>REGIONS</dt>
        </div>
      </dl>
    </header>

    <MapWall />

    <section class="ww-outro" aria-label="板块导航">
      <a class="ww-cta" href="/7th/watermark/">留下你的痕迹 →</a>
      <a class="ww-back" href="/7th/">← 七周年档案</a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Count Up（与 /7th/ 同一模式：直出终值，进入视口才从 0 增强）
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-countup] [data-count-to]');
  const animate = (node: HTMLElement) => {
    const target = Number(node.dataset.countTo ?? '0');
    if (REDUCED) {
      return;
    }
    node.textContent = '0';
    const start = performance.now();
    const DUR = 900;
    const tick = (now: number) => {
      const t = Math.min((now - start) / DUR, 1);
      node.textContent = String(Math.round(target * (1 - (1 - t) ** 3)));
      if (t < 1) {
        requestAnimationFrame(tick);
      }
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 }
  );
  nums.forEach(n => io.observe(n));
</script>

<style>
  .ww-page {
    min-height: 100dvh;
    padding-top: 70px;
    background: var(--anniv-bg);
    color: var(--anniv-fg);
  }

  .ww-hero {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .ww-eyebrow {
    margin: 0 0 1rem;
    width: 100%;
    font-family: 'Archivo', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    color: var(--anniv-accent);
  }

  .ww-title {
    margin: 0;
    font-family: var(--anniv-serif);
    font-size: clamp(1.7rem, 4.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.08em;
  }

  .ww-stats {
    display: flex;
    gap: clamp(1.6rem, 4vw, 3.5rem);
    margin: 0;
  }

  .ww-stat {
    display: flex;
    flex-direction: column;
    text-align: right;
  }

  .ww-stat dd {
    order: -1;
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1;
  }

  .ww-stat dt {
    margin-top: 0.5rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    color: var(--anniv-muted);
  }

  .ww-outro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    padding: clamp(2.5rem, 6vw, 4rem) 1.5rem clamp(3.5rem, 8vw, 5.5rem);
  }

  .ww-cta {
    padding: 0.85rem 2rem;
    font-family: 'Archivo', sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--anniv-bg);
    background: var(--anniv-accent);
    text-decoration: none;
  }

  .ww-cta:hover {
    filter: brightness(1.08);
  }

  .ww-back {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--anniv-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .ww-back:hover {
    color: var(--anniv-fg);
    border-color: var(--anniv-muted);
  }

  @media (max-width: 48rem) {
    .ww-hero {
      flex-direction: column;
      align-items: flex-start;
    }

    .ww-stat {
      text-align: left;
    }
  }
</style>
