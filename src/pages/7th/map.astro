---
/**
 * /7th/map — 【七周年板块 · 地图墙】成员分布地球仪。
 * 整屏沉浸：一颗实时晨昏线地球仪占满导航以下全部视口（类似首页整屏体验），
 * 信息以浮动玻璃面板叠加。数据为占位数据（见 map-points.ts）。
 */
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import MapGlobe from '../../components/anniversary/MapGlobe.astro';
---

<Layout
  description="七年，我们把快门声带到了世界的各个角落。看看 Seeker 追光者的成员遍布哪些国家和省份。"   title="Seeker 七周年 · 地图墙"
>
  <Navigation />
  <main class="map-page" id="main-content">
    <MapGlobe />
  </main>
</Layout>

<style>
  /* 整屏沉浸：地球仪占满导航以下全部视口，无滚动（类似首页整屏体验） */
  .map-page {
    height: calc(100dvh - 70px);
    overflow: hidden;
    background: #020206;
  }
</style>
