---
/**
 * 【独立暗房部署】七周年纪念帧生成器（release/darkroom-preview 分支专用）。
 * 本分支只为分享水印功能：根路径即暗房，无任何站点导航与其它内容。
 * 水印逻辑层（render/gestures/template + darkroom 懒加载）零改动；
 * 组件与主分支完全同源，修复随 cherry-pick 同步。
 * 主题固定暗房暗色：head 内联脚本无条件 data-theme="dark"。
 */
import Layout from '../layouts/Layout.astro';
import WatermarkGenerator from '../components/watermark/WatermarkGenerator.astro';
---

<Layout
  description="上传一张照片、写下你的昵称，生成 Seeker 追光者七周年纪念海报。全程在你的浏览器本地完成，照片不会上传服务器。"
  title="SEEKER 追光者 · 七周年纪念帧"
>
  <!-- 独立部署：固定暗房暗色（不读 storage、无切换） -->
  <script is:inline slot="head">
    document.documentElement.dataset.theme = 'dark';
  </script>

  <main class="dk" id="main-content">
    <header class="dk-bar">
      <p class="dk-brand">
        SEEKER <span class="dk-brand-dot">·</span> 追光者七周年
        <span class="dk-brand-en">DARKROOM</span>
      </p>
      <p class="dk-privacy" title="照片只在你自己的浏览器里处理，不会上传到任何服务器">
        完全在浏览器本地处理
      </p>
    </header>
    <WatermarkGenerator />
    <footer class="dk-foot">照片仅在浏览器本地处理，不会上传 · SEEKER 追光者</footer>
  </main>
</Layout>

<style>
  .dk {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--anniv-bg);
    color: var(--anniv-fg);
  }

  .dk-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--anniv-border);
  }

  .dk-brand {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--anniv-fg);
  }

  .dk-brand-dot {
    color: var(--anniv-accent);
  }

  .dk-brand-en {
    margin-left: 0.9em;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    color: var(--anniv-accent);
  }

  .dk-privacy {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--anniv-faint);
  }

  .dk-foot {
    padding: 1.4rem 1.5rem 1.8rem;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--anniv-faint);
    border-top: 1px solid var(--anniv-border);
  }

  @media (max-width: 40rem) {
    .dk-privacy {
      display: none;
    }
  }
</style>
