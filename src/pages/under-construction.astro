---
import Layout from '../layouts/Layout.astro';
---

<Layout description="这个页面正在建设中，追光者正在捕捉精彩" title="正在施工">
  <meta content="noindex" name="robots" slot="head" />

  <main class="construction-page">
    <div class="construction-container">
      <!-- Photography SVG Decorations -->
      <div class="decoration decoration-1">
        <svg fill="none" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="40" stroke="url(#camera-gradient)" stroke-width="2" />
          <circle cx="50" cy="50" r="15" stroke="url(#camera-gradient)" stroke-width="2" />
          <rect fill="url(#camera-gradient)" height="8" rx="2" width="30" x="35" y="20" />
          <defs>
            <linearGradient id="camera-gradient" x1="0" x2="100" y1="0" y2="100">
              <stop offset="0%" stop-color="#179299" />
              <stop offset="100%" stop-color="#d20f39" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <div class="decoration decoration-2">
        <svg fill="none" viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg">
          <rect height="30" rx="4" stroke="url(#film-gradient)" stroke-width="2" width="120" x="0" y="5" />
          <circle cx="10" cy="20" fill="url(#film-gradient)" r="3" />
          <circle cx="30" cy="20" fill="url(#film-gradient)" r="3" />
          <circle cx="50" cy="20" fill="url(#film-gradient)" r="3" />
          <circle cx="70" cy="20" fill="url(#film-gradient)" r="3" />
          <circle cx="90" cy="20" fill="url(#film-gradient)" r="3" />
          <circle cx="110" cy="20" fill="url(#film-gradient)" r="3" />
          <defs>
            <linearGradient id="film-gradient" x1="0" x2="120" y1="0" y2="0">
              <stop offset="0%" stop-color="#d20f39" />
              <stop offset="100%" stop-color="#179299" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <div class="decoration decoration-3">
        <svg fill="none" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
          <circle cx="40" cy="40" r="35" stroke="url(#lens-gradient)" stroke-width="2" />
          <circle cx="40" cy="40" r="20" stroke="url(#lens-gradient)" stroke-width="1.5" />
          <circle cx="40" cy="40" fill="url(#lens-gradient)" r="8" />
          <line stroke="url(#lens-gradient)" stroke-width="2" x1="40" x2="40" y1="5" y2="15" />
          <line stroke="url(#lens-gradient)" stroke-width="2" x1="40" x2="40" y1="65" y2="75" />
          <line stroke="url(#lens-gradient)" stroke-width="2" x1="5" x2="15" y1="40" y2="40" />
          <line stroke="url(#lens-gradient)" stroke-width="2" x1="65" x2="75" y1="40" y2="40" />
          <defs>
            <linearGradient id="lens-gradient" x1="0" x2="80" y1="0" y2="80">
              <stop offset="0%" stop-color="#179299" />
              <stop offset="50%" stop-color="#d20f39" />
              <stop offset="100%" stop-color="#179299" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <div class="decoration decoration-4">
        <svg fill="none" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
          <path d="M30 5 L35 25 L55 30 L35 35 L30 55 L25 35 L5 30 L25 25 Z" fill="none" stroke="url(#aperture-gradient)" stroke-width="2" />
          <circle cx="30" cy="30" r="8" stroke="url(#aperture-gradient)" stroke-width="1.5" />
          <defs>
            <linearGradient id="aperture-gradient" x1="0" x2="60" y1="0" y2="60">
              <stop offset="0%" stop-color="#d20f39" />
              <stop offset="100%" stop-color="#179299" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Main Content -->
      <div class="content">
        <h1 class="title">正在施工</h1>
        <p class="subtitle">大鳄鱼正在收集素材，敬请期待 ✨</p>
        
        <a class="return-button" href="/">
          <span>返回首页</span>
          <svg class="arrow-icon" fill="none" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 5L17 10M17 10L12 15M17 10H3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
          </svg>
        </a>

        <p class="bottom-copy">每一张好照片都值得等待，我们的新页面也是 📷</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .construction-page {
    min-height: 100vh;
    width: 100%;
    background: var(--background);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 20px;
  }

  .construction-page::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
      radial-gradient(circle at 20% 30%, var(--glow-a) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, var(--glow-b) 0%, transparent 40%);
    animation: rotate 30s linear infinite;
    pointer-events: none;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .construction-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 800px;
  }

  .decoration {
    position: absolute;
    opacity: 0.6;
    pointer-events: none;
  }

  .decoration-1 {
    top: 10%;
    left: 10%;
    width: 80px;
    height: 80px;
    animation: float 6s ease-in-out infinite;
  }

  .decoration-2 {
    top: 15%;
    right: 15%;
    width: 100px;
    height: 35px;
    animation: float 7s ease-in-out infinite reverse;
  }

  .decoration-3 {
    bottom: 20%;
    left: 15%;
    width: 70px;
    height: 70px;
    animation: float 8s ease-in-out infinite;
  }

  .decoration-4 {
    bottom: 25%;
    right: 10%;
    width: 50px;
    height: 50px;
    animation: float 6.5s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  .content {
    text-align: center;
    padding: 60px 20px;
  }

  .title {
    font-size: 4rem;
    font-weight: 700;
    margin: 0 0 24px 0;
    background: linear-gradient(90deg, var(--grad-a), var(--foreground), var(--grad-b));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .subtitle {
    font-size: 1.5rem;
    color: var(--foreground);
    margin: 0 0 40px 0;
    font-weight: 300;
    letter-spacing: 1px;
    animation: fadeInUp 0.8s ease-out 0.1s forwards;
    opacity: 0;
  }

  .return-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 12px;
    transition: all 0.3s ease;
    box-shadow: var(--glass-shadow);
    animation: fadeInUp 0.8s ease-out 0.2s forwards;
    opacity: 0;
  }

  .return-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--glass-hover-shadow);
    filter: brightness(1.05);
  }

  .return-button:active {
    transform: translateY(0);
  }

  .arrow-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .return-button:hover .arrow-icon {
    transform: translateX(4px);
  }

  .bottom-copy {
    margin-top: 40px;
    font-size: 1rem;
    color: var(--muted-foreground);
    font-style: italic;
    animation: fadeInUp 0.8s ease-out 0.3s forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .title {
      font-size: 2.5rem;
    }

    .subtitle {
      font-size: 1.2rem;
    }

    .return-button {
      padding: 12px 24px;
      font-size: 1rem;
    }

    .decoration-1 {
      width: 60px;
      height: 60px;
      top: 5%;
      left: 5%;
    }

    .decoration-2 {
      width: 80px;
      height: 28px;
      top: 10%;
      right: 5%;
    }

    .decoration-3 {
      width: 50px;
      height: 50px;
      bottom: 15%;
      left: 5%;
    }

    .decoration-4 {
      width: 40px;
      height: 40px;
      bottom: 18%;
      right: 5%;
    }
  }

  @media (max-width: 480px) {
    .construction-page {
      padding: 15px;
    }

    .title {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
      margin-bottom: 30px;
    }

    .return-button {
      padding: 10px 20px;
      font-size: 0.95rem;
    }

    .bottom-copy {
      margin-top: 30px;
      font-size: 0.9rem;
    }

    .decoration {
      opacity: 0.4;
    }

    .decoration-1 {
      width: 50px;
      height: 50px;
    }

    .decoration-2 {
      width: 70px;
      height: 24px;
    }

    .decoration-3 {
      width: 40px;
      height: 40px;
    }

    .decoration-4 {
      width: 35px;
      height: 35px;
    }
  }
</style>
