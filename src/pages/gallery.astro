---
/**
 * /gallery 档案馆：全量作品「接触印样墙」（Gallery 3.1 二级展厅）。
 * 排版 = 等高行 justified rows（Magnum / Leica Gallery 的挂墙方式）：行内
 * 按宽高比分配宽度——flex-grow 与 flex-basis 均以 --ar 表达，浏览器换行
 * 后行内等高——零裁切、直角、行序即阅读序。
 * 挂墙顺序每次点开随机（用户 2026-11-14 裁决）：SSR 固定序仅作无 JS 兜底，
 * hydration 即 Fisher-Yates 洗牌重挂 DOM；灯箱片单与翻页序随洗牌后的
 * DOM 序（墙上位置 ↔ 灯箱位置始终联动）。
 * 图注只留作品名 @作者（用户裁决：藏品编号已删；无题作品仅 @作者）。
 * 灯箱与首页门厅共用 src/lib/gallery-lightbox.ts 与 gallery-lightbox.css。
 * 网格读缩略图（thumbs/<key>.webp，长边 960 WebP，管线
 * scripts/make-gallery-thumbs.mjs），原图只进灯箱；lazy + 宽高属性防 CLS。
 */
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/gallery-lightbox.css';
import { archiveOrdered, thumbOf, type GalleryImage } from '@/data/gallery';

const ordered = archiveOrdered();
const capOf = (img: GalleryImage) =>
  img.title ? `《${img.title}》 @${img.author}` : `@${img.author}`;
const altOf = (img: GalleryImage) => `${img.alt}（作者：${img.author}）`;
---

<Layout
  description="Seeker追光者作品档案——小组成员的摄影作品目录，拍一张照片，交一个朋友"
  title="作品档案 · Gallery — Seeker追光者"
>
  <Fragment slot="head">
    <!-- 揭幕门控（Critic P1-1）：墙在洗牌完成前不可见——观众不许看见布展员
         挂画（SSR 固定序闪现 + 2094 节点重排位移都被这层吃掉）。
         2.5s 强制揭幕兜底：模块脚本失败也不许把墙永久藏掉。 -->
    <script is:inline>
      document.documentElement.classList.add('gallery-shuffling');
      window.setTimeout(() => {
        document.documentElement.classList.remove('gallery-shuffling');
        document.documentElement.classList.add('gallery-shuffled');
      }, 2500);
    </script>
  </Fragment>
  <Navigation />

  <main class="archive-page" id="main-content">
    <header class="arch-head">
      <p class="arch-kicker">作品档案 · Collection</p>
      <h1 class="arch-title">画廊 <span class="arch-en">Gallery</span></h1>
    </header>

    <section aria-label="全部作品" class="arch-wall">
      {
        ordered.map(img => (
          <figure class="arch-item" style={`--ar:${(img.w / img.h).toFixed(4)}`}>
            <button
              aria-label={`放大查看 ${capOf(img)}`}
              class="shot"
              data-author={img.author}
              data-full={img.src}
              data-series={img.series ?? ''}
              data-title={img.title ?? ''}
              type="button"
            >
              <img
                alt={altOf(img)}
                decoding="async"
                height={img.h}
                loading="lazy"
                src={thumbOf(img)}
                width={img.w}
              />
            </button>
            <figcaption class="arch-cap">
              <span class="arch-label">{capOf(img)}</span>
            </figcaption>
          </figure>
        ))
      }
    </section>
  </main>

  <Footer />

  <div aria-label="查看大图" aria-modal="true" class="gl-lightbox" hidden role="dialog">
    <button aria-label="关闭图片查看器" class="gl-btn gl-close" type="button">
      <svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24" width="22"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
    <button aria-label="下一张作品" class="gl-btn gl-next" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M9 18l6-6-6-6" /></svg>
    </button>
    <figure class="gl-stage">
      <img alt="" class="gl-img" decoding="async" />
      <figcaption class="gl-cap"><span class="gl-cap-text"></span></figcaption>
    </figure>
    <button aria-label="上一张作品" class="gl-btn gl-prev" type="button">
      <svg aria-hidden="true" fill="none" height="26" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="26"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <p aria-live="polite" class="gl-count"></p>
  </div>
</Layout>

<script>
  import { initGalleryLightbox } from '@/lib/gallery-lightbox';

  const lightbox = document.querySelector<HTMLElement>('.gl-lightbox');
  const wall = document.querySelector<HTMLElement>('.arch-wall');
  const figures = [...(wall?.querySelectorAll<HTMLElement>('.arch-item') ?? [])];

  // —— 每次点开随机排墙（用户 2026-11-14 裁决）：Fisher-Yates 洗牌后按
  // 新序重挂 DOM（SSR 固定序仅无 JS 兜底）；灯箱片单随洗牌后的 DOM 序，
  // 墙上位置 ↔ 灯箱位置始终联动 ——
  for (let i = figures.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const a = figures[i]!;
    const b = figures[j]!;
    figures[i] = b;
    figures[j] = a;
  }
  for (const fig of figures) {
    wall?.appendChild(fig);
  }

  // 揭幕：洗牌完成，墙亮出来
  document.documentElement.classList.remove('gallery-shuffling');
  document.documentElement.classList.add('gallery-shuffled');

  /** 灯箱片单 = 洗牌后的墙上序（重挂后 DOM 已冻结，缓存一次与现读等价） */
  const slides = figures.map(fig => {
    const d = fig.querySelector<HTMLButtonElement>('.shot')?.dataset;
    return {
      full: d?.full ?? '',
      title: d?.title ?? '',
      series: d?.series || undefined,
      author: d?.author ?? '',
    };
  });

  if (lightbox) {
    const lb = initGalleryLightbox({ root: lightbox, getSlides: () => slides });
    for (const fig of figures) {
      fig.querySelector('.shot')?.addEventListener('click', () => {
        const idx = figures.indexOf(fig);
        lb.open(idx >= 0 ? idx : 0);
      });
    }
  }
</script>

<style>
  .archive-page {
    max-width: 1728px;
    margin: 0 auto;
    padding: 120px clamp(24px, 6vw, 96px) 120px;
  }

  /* —— 头部：大标题 —— */
  .arch-kicker {
    font-family: var(--font-archivo);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0 0 16px;
  }

  .arch-title {
    font-family: var(--font-serif-song);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--foreground);
    margin: 0;
    line-height: 1.15;
  }

  .arch-en {
    font-family: var(--font-archivo);
    font-size: 0.42em;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-left: 12px;
  }

  /* —— 等高行 justified rows：grow/basis 均以 --ar 表达，换行后行内等高 —— */
  .arch-wall {
    --row-h: 300px;
    display: flex;
    flex-wrap: wrap;
    gap: 34px 24px;
    align-items: flex-start;
    width: 100%;
    margin-top: 44px;
  }

  .arch-item {
    flex: var(--ar) 1 calc(var(--ar) * var(--row-h));
    min-width: 0;
    margin: 0;
  }

  .shot {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    --shot-shadow:
      0 1px 2px rgba(8, 41, 74, 0.08),
      0 10px 26px -10px rgba(8, 41, 74, 0.18);
    box-shadow: var(--shot-shadow);
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(.dark) .shot::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(234, 244, 255, 0.08);
    pointer-events: none;
  }

  :global(.dark) .shot {
    --shot-shadow:
      0 1px 3px rgba(0, 0, 0, 0.45),
      0 10px 26px -10px rgba(0, 0, 0, 0.5);
  }

  .shot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .arch-item:hover .shot {
      transform: translateY(-3px);
      --shot-shadow:
        0 2px 4px rgba(8, 41, 74, 0.08),
        0 20px 40px -12px rgba(8, 41, 74, 0.26);
    }

    :global(.dark) .arch-item:hover .shot {
      --shot-shadow:
        0 2px 5px rgba(0, 0, 0, 0.45),
        0 20px 40px -12px rgba(0, 0, 0, 0.6);
    }
  }

  /* —— 揭幕门控（Critic P1-1）：洗牌完成前墙不可见（占位保留，滚动条不跳） —— */
  :global(html.gallery-shuffling:not(.gallery-shuffled)) .arch-wall {
    visibility: hidden;
  }

  /* —— 博物馆标签：作品名 @作者（藏品编号已按用户裁决移除） —— */
  .arch-cap {
    margin-top: 10px;
  }

  .arch-label {
    font-family: var(--font-serif-song);
    font-size: 12.5px;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
    /* 窄幅竖图下标签不截断作品名——两行 clamp（Critic P2） */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
  }

  /* —— 响应式行高 —— */
  @media (max-width: 1023px) {
    .arch-wall {
      --row-h: 230px;
    }
  }

  @media (max-width: 768px) {
    .archive-page {
      padding-top: 96px;
      padding-bottom: 80px;
    }

    .arch-wall {
      --row-h: 170px;
      gap: 26px 16px;
    }
  }

  /* 小屏：一行一件（美术馆的移动端也是一个展位一件作品） */
  @media (max-width: 560px) {
    .arch-item {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }
  }
</style>
